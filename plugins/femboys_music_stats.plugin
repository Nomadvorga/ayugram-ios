# ───────────────────────── Обложки ─────────────────────────

def _bitmap_classes():
    return (jclass("android.graphics.Bitmap"), jclass("android.graphics.Bitmap$Config"),
            jclass("android.graphics.Canvas"), jclass("android.graphics.Paint"),
            jclass("android.graphics.RectF"))


def square_scaled(src, size):
    Bitmap = jclass("android.graphics.Bitmap")
    w, h = src.getWidth(), src.getHeight()
    side = min(w, h)
    sq = Bitmap.createBitmap(src, (w - side) // 2, (h - side) // 2, side, side)
    return Bitmap.createScaledBitmap(sq, size, size, True)


def round_bitmap(src, size, radius):
    Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
    BitmapShader = jclass("android.graphics.BitmapShader")
    TileMode = jclass("android.graphics.Shader$TileMode")
    scaled = square_scaled(src, size)
    out = Bitmap.createBitmap(size, size, Config.ARGB_8888)
    c = Canvas(out)
    p = Paint()
    p.setAntiAlias(True)
    p.setShader(BitmapShader(scaled, TileMode.CLAMP, TileMode.CLAMP))
    c.drawRoundRect(RectF(0.0, 0.0, float(size), float(size)), float(radius), float(radius), p)
    return out


def placeholder_bitmap(size, radius, pal):
    Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
    Align = jclass("android.graphics.Paint$Align")
    out = Bitmap.createBitmap(size, size, Config.ARGB_8888)
    c = Canvas(out)
    p = Paint()
    p.setAntiAlias(True)
    p.setColor(jint(with_alpha(pal["accent"], 60)))
    c.drawRoundRect(RectF(0.0, 0.0, float(size), float(size)), float(radius), float(radius), p)
    p.setColor(jint(pal["accent"]))
    p.setTextAlign(Align.CENTER)
    p.setTextSize(size * 0.5)
    c.drawText("♪", size / 2.0, size * 0.66, p)
    return out


def save_cover(bmp, path):
    scaled = square_scaled(bmp, 384)
    fos = jclass("java.io.FileOutputStream")(path)
    try:
        scaled.compress(jclass("android.graphics.Bitmap$CompressFormat").JPEG, 88, fos)
        fos.flush()
    finally:
        fos.close()


# ───────────────────────── Тексты песен (несколько источников + офлайн-кэш) ─────────────────────────

LRCLIB = "https://lrclib.net/api"
_LRC_TS = re.compile(r"\[(\d{1,3}):(\d{2}(?:[.:]\d{1,3})?)\]")
_BROWSER_UA = ("Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 "
               "(KHTML, like Gecko) Chrome/124.0 Mobile Safari/537.36")
_PLUGIN_UA = "MusicStatsPlugin/3.3.1 (exteraGram plugin by PA3MA3AH)"
LYRICS_DEADLINE = 30.0          # общий лимит времени на поиск по всем источникам, сек


class _LyricsOffline(Exception):
    """Ни один из источников не ответил (нет сети / все сервисы недоступны)."""


def _http_get(url, headers=None, timeout=8):
    hdr = {"User-Agent": _PLUGIN_UA}
    if headers:
        hdr.update(headers)
    req = urllib.request.Request(url, headers=hdr)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


def _http_json(url, headers=None, timeout=8):
    return json.loads(_http_get(url, headers, timeout))


def parse_lrc(text):
    out = []
    for raw in text.splitlines():
        stamps = _LRC_TS.findall(raw)
        if not stamps:
            continue
        line = _LRC_TS.sub("", raw).strip() or "♪"
        for mm, ss in stamps:
            out.append((int(mm) * 60 + float(ss.replace(":", ".")), line))
    out.sort(key=lambda x: x[0])
    return out


def _lrc_ok(text):
    """Похоже ли это на настоящий синхронизированный текст (а не на пустышку с тегами)."""
    try:
        return bool(text) and len(parse_lrc(text)) >= 3
    except Exception:
        return False


def _strip_lrc(text):
    """Убирает тайм-коды и служебные теги [ti:..] — получается обычный текст."""
    out = []
    for raw in (text or "").splitlines():
        s = _LRC_TS.sub("", raw).strip()
        if re.fullmatch(r"\[[a-zA-Z]{2,8}:.*\]", s):
            continue
        out.append(s)
    return "\n".join(out).strip()


def _pick_lyrics(results, duration):
    results = [r for r in (results or []) if r.get("syncedLyrics") or r.get("plainLyrics")]
    if not results:
        return None

    def score(r):
        synced = 0 if r.get("syncedLyrics") else 1
        dd = abs((r.get("duration") or 0) - duration) if duration else 0
        return (synced, dd)

    return min(results, key=score)


# ----- сопоставление найденных треков -----

def _simp(s):
    s = norm_text(s)
    s = re.sub(r"[\(\[\{][^\)\]\}]*[\)\]\}]", " ", s)
    s = re.sub(r"\b(feat|ft|featuring)\b\.?.*$", " ", s)
    s = re.sub(r"\s[-–—]\s.*(remaster|version|edit|mix|live|radio).*$", " ", s)
    s = re.sub(r"[^\w\s]", " ", s)
    return re.sub(r"\s+", " ", s).strip()


def _is_unknown(artist):
    return str(artist).startswith("Неизвестн")


def _title_match(want, got):
    a, b = _simp(want), _simp(got)
    return bool(a and b and (a == b or a in b or b in a))


def _artist_match(want, names):
    if _is_unknown(want):
        return True
    w = _simp(want)
    parts = [p.strip() for p in re.split(r"[,&;/]| и | x | feat\.? ", w) if p.strip()] or [w]
    for n in names:
        nn = _simp(n)
        if not nn:
            continue
        if nn in w or w in nn or any(p in nn or nn in p for p in parts):
            return True
    return False


def _rank(cands, artist, title, duration):
    """Оставляет подходящих кандидатов: совпало название, длительность и (по возможности) исполнитель."""
    out = []
    for c in cands:
        if not c.get("id") or not _title_match(title, c.get("name", "")):
            continue
        d = float(c.get("dur") or 0)
        dd = abs(d - duration) if (duration and d) else 0.0
        if duration and d and dd > 10:
            continue
        a_ok = _artist_match(artist, c.get("artists") or [])
        if not a_ok and not (duration and d and dd <= 3):
            continue
        out.append((0 if a_ok else 1, dd, c))
    out.sort(key=lambda x: (x[0], x[1]))
    return [c for _a, _b, c in out[:3]]


def _query(artist, title):
    return title if _is_unknown(artist) else "%s %s" % (artist, title)


def _pack(synced, plain):
    if synced and _lrc_ok(synced):
        return {"synced": synced, "plain": plain or _strip_lrc(synced) or None}
    if plain and len(plain.strip()) > 20:
        return {"synced": None, "plain": plain.strip()}
    return None


# ----- источники -----

def _src_lrclib(artist, title, duration):
    attempts = []
    prm = {"track_name": title}
    if not _is_unknown(artist):
        prm["artist_name"] = artist
    attempts.append(prm)
    attempts.append({"q": _query(artist, title)})
    item = None
    for prm in attempts:
        try:
            res = _http_json(LRCLIB + "/search?" + urllib.parse.urlencode(prm))
        except urllib.error.HTTPError as e:
            if e.code == 404:
                continue
            raise
        item = _pick_lyrics(res, duration)
        if item:
            break
    if not item:
        return None
    return _pack(item.get("syncedLyrics"), item.get("plainLyrics"))


def _src_netease(artist, title, duration):
    hdr = {"Referer": "https://music.163.com/", "User-Agent": _BROWSER_UA}
    url = "https://music.163.com/api/search/get/web?" + urllib.parse.urlencode(
        {"s": _query(artist, title), "type": 1, "limit": 8, "offset": 0})
    data = _http_json(url, hdr)
    songs = ((data or {}).get("result") or {}).get("songs") or []
    cands = []
    for s in songs:
        arts = s.get("artists") or s.get("ar") or []
        cands.append({"id": s.get("id"), "name": s.get("name", ""),
                      "artists": [a.get("name", "") for a in arts],
                      "dur": float(s.get("duration") or s.get("dt") or 0) / 1000.0})
    plain = None
    for c in _rank(cands, artist, title, duration):
        d = _http_json("https://music.163.com/api/song/lyric?" + urllib.parse.urlencode(
            {"id": c["id"], "lv": 1, "kv": 1, "tv": -1}), hdr)
        lrc = ((d or {}).get("lrc") or {}).get("lyric") or ""
        res = _pack(lrc, None)
        if res and res["synced"]:
            return res
        if res and plain is None:
            plain = res
    return plain


def _qq_text(raw):
    if not raw:
        return ""
    t = raw
    if not t.lstrip().startswith("["):
        try:
            t = base64.b64decode(t).decode("utf-8", "replace")
        except Exception:
            pass
    return _html.unescape(t)


def _src_qq(artist, title, duration):
    hdr = {"Referer": "https://y.qq.com/", "User-Agent": _BROWSER_UA}
    url = "https://c.y.qq.com/soso/fcgi-bin/client_search_cp?" + urllib.parse.urlencode(
        {"w": _query(artist, title), "format": "json", "p": 1, "n": 8, "cr": 1, "new_json": 1})
    data = _http_json(url, hdr)
    songs = (((data or {}).get("data") or {}).get("song") or {}).get("list") or []
    cands = []
    for s in songs:
        singers = s.get("singer") or []
        cands.append({"id": s.get("songmid") or s.get("mid"),
                      "name": s.get("songname") or s.get("name") or s.get("title") or "",
                      "artists": [x.get("name", "") for x in singers],
                      "dur": float(s.get("interval") or 0)})
    plain = None
    for c in _rank(cands, artist, title, duration):
        d = _http_json("https://c.y.qq.com/lyric/fcgi-bin/fcg_query_lyric_new.fcg?" + urllib.parse.urlencode(
            {"songmid": c["id"], "format": "json", "nobase64": 1, "g_tk": 5381}), hdr)
        lrc = _qq_text((d or {}).get("lyric") or "")
        res = _pack(lrc, None)
        if res and res["synced"]:
            return res
        if res and plain is None:
            plain = res
    return plain


def _src_kugou(artist, title, duration):
    hdr = {"User-Agent": _BROWSER_UA}
    q = _query(artist, title)
    data = _http_json("https://mobileservice.kugou.com/api/v3/search/song?" + urllib.parse.urlencode(
        {"format": "json", "keyword": q, "page": 1, "pagesize": 8}), hdr)
    infos = ((data or {}).get("data") or {}).get("info") or []
    cands = [{"id": s.get("hash"), "name": s.get("songname", ""),
              "artists": [x for x in re.split(r"[、,&]", s.get("singername", "") or "") if x.strip()],
              "dur": float(s.get("duration") or 0)} for s in infos]
    plain = None
    for c in _rank(cands, artist, title, duration):
        ms = int((c.get("dur") or duration or 0) * 1000)
        found = _http_json("https://lyrics.kugou.com/search?" + urllib.parse.urlencode(
            {"ver": 1, "man": "yes", "client": "pc", "keyword": q, "duration": ms, "hash": c["id"]}), hdr)
        for cand in ((found or {}).get("candidates") or [])[:2]:
            d = _http_json("https://lyrics.kugou.com/download?" + urllib.parse.urlencode(
                {"ver": 1, "client": "pc", "id": cand.get("id"), "accesskey": cand.get("accesskey"),
                 "fmt": "lrc", "charset": "utf8"}), hdr)
            try:
                lrc = base64.b64decode((d or {}).get("content") or "").decode("utf-8", "replace").lstrip("\ufeff")
            except Exception:
                lrc = ""
            res = _pack(lrc, None)
            if res and res["synced"]:
                return res
            if res and plain is None:
                plain = res
    return plain


def _src_ovh(artist, title, duration):
    if _is_unknown(artist):
        return None
    url = "https://api.lyrics.ovh/v1/%s/%s" % (
        urllib.parse.quote(artist, safe=""), urllib.parse.quote(title, safe=""))
    try:
        data = _http_json(url, timeout=8)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise
    txt = ((data or {}).get("lyrics") or "").replace("\r\n", "\n").strip()
    return _pack(None, txt)


LYRIC_ORDER = ("lrclib", "netease", "qq", "kugou", "ovh")
LYRIC_SOURCES = {
    "lrclib": ("LRCLIB", _src_lrclib),
    "netease": ("NetEase", _src_netease),
    "qq": ("QQ Музыка", _src_qq),
    "kugou": ("KuGou", _src_kugou),
    "ovh": ("lyrics.ovh", _src_ovh),
}


def fetch_lyrics_online(artist, title, duration, sources):
    """Идёт по источникам по порядку. Синхронизированный текст берём сразу,
    обычный запоминаем и берём, только если синхронизированного нигде нет."""
    best_plain = None
    tried = errors = 0
    t_end = time.time() + LYRICS_DEADLINE
    for key in LYRIC_ORDER:
        if key not in sources:
            continue
        if time.time() > t_end:
            break
        tried += 1
        label, fn = LYRIC_SOURCES[key]
        try:
            res = fn(artist, title, duration)
        except Exception as e:
            errors += 1
            log("lyrics source %s failed: %r" % (key, e))
            continue
        if not res:
            continue
        res["source"] = label
        if res.get("synced"):
            return res
        if best_plain is None and res.get("plain"):
            best_plain = res
    if best_plain is not None:
        return best_plain
    if tried and errors == tried:
        raise _LyricsOffline()
    return None


# ----- офлайн-кэш на устройстве -----

def lyrics_dir():
    return sub_dir("music_stats_lyrics")


def _lyr_path(artist, title):
    h = hashlib.sha1(norm_key(artist, title).encode("utf-8")).hexdigest()[:24]
    return os.path.join(lyrics_dir(), h + ".json")


def lyrics_cache_load(artist, title):
    try:
        with open(_lyr_path(artist, title), "r", encoding="utf-8") as f:
            d = json.load(f)
        if d.get("synced") or d.get("plain"):
            return d
    except Exception:
        pass
    return None


def lyrics_cache_save(artist, title, raw):
    try:
        data = {"artist": artist, "title": title, "source": raw.get("source", ""),
                "synced": raw.get("synced"), "plain": raw.get("plain"), "saved": time.time()}
        path = _lyr_path(artist, title)
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False)
        os.replace(tmp, path)
    except Exception as e:
        log("lyrics cache save failed: %r" % (e,))


def lyrics_cache_stats():
    n = size = 0
    try:
        d = lyrics_dir()
        for name in os.listdir(d):
            if name.endswith(".json"):
                n += 1
                size += os.path.getsize(os.path.join(d, name))
    except Exception:
        pass
    return n, size


def lyrics_cache_clear():
    n = 0
    try:
        d = lyrics_dir()
        for name in os.listdir(d):
            if name.endswith(".json") or name.endswith(".tmp"):
                try:
                    os.remove(os.path.join(d, name))
                    n += 1
                except Exception:
                    pass
    except Exception:
        pass
    return n


def _lyrics_entry(raw, cached):
    lines = parse_lrc(raw["synced"]) if raw.get("synced") else []
    plain = raw.get("plain") or None
    if not lines and not plain:
        return None
    return {"status": "ok", "lines": lines, "times": [t for t, _ in lines], "plain": plain,
            "source": raw.get("source") or "", "cached": bool(cached)}


def fetch_lyrics(artist, title, duration, sources=None, use_cache=True):
    """Сначала память устройства, потом сеть. Если сети нет — отдаём сохранённое."""
    sources = list(sources) if sources is not None else list(LYRIC_ORDER)
    cached = lyrics_cache_load(artist, title) if use_cache else None
    if cached and cached.get("synced") and _lrc_ok(cached["synced"]):
        return _lyrics_entry(cached, True)

    raw = None
    try:
        raw = fetch_lyrics_online(artist, title, duration, sources) if sources else None
    except _LyricsOffline:
        if cached:
            return _lyrics_entry(cached, True)
        return {"status": "error", "lines": [], "times": [], "plain": None}

    if raw:
        if use_cache:
            lyrics_cache_save(artist, title, raw)
        entry = _lyrics_entry(raw, False)
        if entry:
            return entry
    if cached:
        return _lyrics_entry(cached, True)
    return {"status": "none", "lines": [], "times": [], "plain": None}


# ───────────────────────── Даты, периоды, цвета, файлы ─────────────────────────

PERIODS = (("day", "Сегодня"), ("week", "Неделя"), ("month", "Месяц"), ("year", "Год"), ("all", "Всё"))
PERIOD_TITLES = {"day": "сегодня", "week": "7 дней", "month": "30 дней", "year": "год", "all": "всё время"}
PERIOD_PREV = {"day": "вчера", "week": "прошлым 7 дням", "month": "прошлым 30 дням", "year": "прошлому году"}
PERIOD_ALIASES = {
    "day": "day", "today": "day", "сегодня": "day", "день": "day",
    "week": "week", "неделя": "week", "7": "week",
    "month": "month", "месяц": "month", "30": "month",
    "year": "year", "год": "year",
    "all": "all", "всё": "all", "все": "all",
}
_EPOCH_ORD = 719163
COLOR_UP = hex_color("#43A047")
COLOR_DOWN = hex_color("#E53935")


def _gmtoff(ts):
    try:
        return int(time.localtime(ts).tm_gmtoff or 0)
    except Exception:
        return 0


def local_day(ts):
    ts = int(ts)
    return (ts + _gmtoff(ts)) // 86400


def day_date(day):
    return datetime.date.fromordinal(int(day) + _EPOCH_ORD)


def day_start(day):
    d = day_date(day)
    return int(time.mktime((d.year, d.month, d.day, 0, 0, 0, 0, 0, -1)))


def hour_start(day, hod):
    d = day_date(day)
    return int(time.mktime((d.year, d.month, d.day, int(hod), 0, 0, 0, 0, -1)))


def day_wd(day):
    return (int(day) + 3) % 7


def day_label_d(day):
    d = day_date(day)
    return "%d %s" % (d.day, MONTHS[d.month - 1])


def period_bounds(period, now):
    if period == "day":
        t0 = day_start(local_day(now))
        return t0, t0 - 86400
    n = {"week": 7, "month": 30, "year": 365}.get(period)
    if n:
        return now - n * 86400, now - 2 * n * 86400
    return 0, None


def trend_info(cur, prev):
    if prev is None or prev <= 0:
        return None
    ch = (cur - prev) / float(prev) * 100.0
    if abs(ch) < 1.0:
        return ("≈ как раньше", None)
    return ("%s %d%%" % ("▲" if ch > 0 else "▼", int(round(abs(ch)))), ch > 0)


def norm_text(s):
    s = str(s).casefold().replace("ё", "е")
    s = re.sub(r"[\u200b\u200c\u200d\ufeff]", "", s)
    return re.sub(r"\s+", " ", s).strip()


def norm_key(artist, title):
    return norm_text(artist) + "\x1f" + norm_text(title)


def short(s, n):
    s = str(s)
    return s if len(s) <= n else s[: max(1, n - 1)] + "…"


def rgb_int(r, g, b):
    v = 0xFF000000 | (int(r) << 16) | (int(g) << 8) | int(b)
    return v - (1 << 32) if v >= (1 << 31) else v


def slice_colors(accent, n):
    a = int(accent) & 0xFFFFFF
    h, s, v = colorsys.rgb_to_hsv(((a >> 16) & 255) / 255.0, ((a >> 8) & 255) / 255.0, (a & 255) / 255.0)
    s, v = max(s, 0.55), max(v, 0.8)
    n = max(1, n)
    out = []
    for i in range(n):
        r, g, b = colorsys.hsv_to_rgb((h + 0.85 * i / float(n)) % 1.0, s, v)
        out.append(rgb_int(r * 255, g * 255, b * 255))
    return out


def blurred_card_bitmap(src, w, h, radius, overlay, overlay_alpha):
    Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
    BitmapShader = jclass("android.graphics.BitmapShader")
    TileMode = jclass("android.graphics.Shader$TileMode")
    small = square_scaled(src, 20)
    big = Bitmap.createScaledBitmap(small, int(w), int(h), True)
    out = Bitmap.createBitmap(int(w), int(h), Config.ARGB_8888)
    c = Canvas(out)
    p = Paint()
    p.setAntiAlias(True)
    rect = RectF(0.0, 0.0, float(w), float(h))
    p.setShader(BitmapShader(big, TileMode.CLAMP, TileMode.CLAMP))
    c.drawRoundRect(rect, float(radius), float(radius), p)
    p.setShader(None)
    p.setColor(jint(with_alpha(overlay, overlay_alpha)))
    c.drawRoundRect(rect, float(radius), float(radius), p)
    return out


def cover_file_for(store, artist, title):
    path = store.cover_path(artist, title)
    return path if os.path.exists(path) else None


def base_dir():
    try:
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        return str(ctx.getFilesDir().getAbsolutePath())
    except Exception:
        return os.path.expanduser("~")


def sub_dir(name):
    p = os.path.join(base_dir(), name)
    try:
        os.makedirs(p, exist_ok=True)
    except Exception as e:
        log("mkdir %s failed: %r" % (name, e))
    return p


def save_public(src_path, name, mime):
    try:
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        res = ctx.getContentResolver()
        values = jclass("android.content.ContentValues")()
        values.put("_display_name", name)
        values.put("mime_type", mime)
        values.put("relative_path", "Download/")
        uri = res.insert(jclass("android.provider.MediaStore$Downloads").EXTERNAL_CONTENT_URI, values)
        if uri is None:
            raise RuntimeError("MediaStore вернул пустой uri")
        out = res.openOutputStream(uri)
        try:
            try:
                Files = jclass("java.nio.file.Files")
                Files.copy(jclass("java.nio.file.Paths").get(src_path), out)
            except Exception:
                with open(src_path, "rb") as f:
                    out.write(jarray(jbyte)(f.read()))
        finally:
            out.close()
        return "Загрузки/" + name
    except Exception as e:
        log("save_public failed: %r" % (e,))
    try:
        env = jclass("android.os.Environment")
        d = str(env.getExternalStoragePublicDirectory("Download").getAbsolutePath())
        dst = os.path.join(d, name)
        shutil.copyfile(src_path, dst)
        return dst
    except Exception as e:
        log("save_public fallback failed: %r" % (e,))
    return None


def send_file_to_saved(path, mime, caption=""):
    acc = selected_account()
    AI = jclass("org.telegram.messenger.AccountInstance").getInstance(acc)
    uid = int(jclass("org.telegram.messenger.UserConfig").getInstance(acc).getClientUserId())
    SMH = jclass("org.telegram.messenger.SendMessagesHelper")
    ObjCls = jclass("java.lang.Object")
    Long, Integer, Boolean = jclass("java.lang.Long"), jclass("java.lang.Integer"), jclass("java.lang.Boolean")
    methods = SMH.getClass().getDeclaredMethods()
    last = "метод prepareSendingDocument не найден"
    cands = []
    for i in range(len(methods)):
        m = methods[i]
        if str(m.getName()) == "prepareSendingDocument":
            cands.append(m)
    cands.sort(key=lambda m: len(m.getParameterTypes()))
    for m in cands:
        try:
            m.setAccessible(True)
            strings = [path, path, caption or None, mime]
            si = 0
            seen_long = seen_bool = False
            args = []
            for pt in m.getParameterTypes():
                n = str(pt.getName())
                if n == "org.telegram.messenger.AccountInstance":
                    args.append(AI)
                elif n == "java.lang.String":
                    args.append(strings[si] if si < len(strings) else None)
                    si += 1
                elif n == "long":
                    args.append(Long(uid if not seen_long else 0))
                    seen_long = True
                elif n == "int":
                    args.append(Integer(0))
                elif n == "boolean":
                    args.append(Boolean(not seen_bool))
                    seen_bool = True
                else:
                    args.append(None)
            m.invoke(None, jarray(ObjCls)(args))
            return True, ""
        except Exception as e:
            last = repr(e)
            log("send overload failed: %r" % (e,))
    return False, last


def summary_text(snap, period):
    lines = ["Музыка · %s" % PERIOD_TITLES.get(period, period)]
    tr = trend_info(snap["p_total"], snap.get("p_prev"))
    lines.append("Прослушано: %s%s" % (fmt_smart(snap["p_total"]), (" (%s)" % tr[0]) if tr else ""))
    if snap["plays"] or snap["skips"]:
        lines.append("Прослушиваний: %d · пропусков: %d" % (snap["plays"], snap["skips"]))
    if snap["top_tracks"]:
        lines.append("")
        lines.append("Топ треков:")
        for i, (a, t, s) in enumerate(snap["top_tracks"][:5], 1):
            lines.append("%d. %s — %s (%s)" % (i, a, t, fmt_smart(s)))
    if snap["top_artists"]:
        lines.append("")
        lines.append("Топ исполнителей:")
        for i, (a, s) in enumerate(snap["top_artists"][:3], 1):
            lines.append("%d. %s (%s)" % (i, a, fmt_smart(s)))
    if snap["streak"] > 1:
        lines.append("")
        lines.append("Стрик: %d дн подряд" % snap["streak"])
    return "\n".join(lines)


def fmt_recap(s):
    s = int(s)
    h, m = divmod(s // 60, 60)
    if h >= 24:
        return "%d дн %d ч" % (h // 24, h % 24)
    if h:
        return "%d ч %02d мин" % (h, m)
    return "%d мин" % max(1, m)


# ───────────────────────── Хранилище ─────────────────────────

SCHEMA_VERSION = 3
SESSION_MIN_SECS = 2.0
PLAY_MIN_SECS = 30.0


def db_path(acc=0):
    name = "music_stats.db" if int(acc) == 0 else "music_stats_%d.db" % int(acc)
    return os.path.join(base_dir(), name)


def cover_dir():
    return sub_dir("music_stats_covers")


class Store:
    def __init__(self, path, covers, acc=0):
        self.path = path
        self.acc = int(acc)
        self.lock = threading.RLock()
        self.pending = {}
        self.added = 0.0
        self.added_track = {}
        self.added_artist = {}
        self.cover_dir = covers
        self._canon = {}
        self._cache = {}
        self.dirty = 0
        self.db = sqlite3.connect(path, check_same_thread=False)
        try:
            bak = path + ".pre_v3.bak"
            if (os.path.getsize(path) > 0 and not os.path.exists(bak)
                    and self.db.execute("PRAGMA user_version").fetchone()[0] < SCHEMA_VERSION):
                dst = sqlite3.connect(bak)
                try:
                    self.db.backup(dst)
                finally:
                    dst.close()
        except Exception as e:
            log("pre-migration backup error: %r" % (e,))
        try:
            self.db.execute("PRAGMA journal_mode=WAL")
            self.db.execute("PRAGMA synchronous=NORMAL")
        except Exception as e:
            log("pragma error: %r" % (e,))
        self._migrate()

    def _migrate(self):
        db = self.db
        ver = db.execute("PRAGMA user_version").fetchone()[0]
        db.execute(
            "CREATE TABLE IF NOT EXISTS listens("
            "ts INTEGER NOT NULL, artist TEXT NOT NULL, title TEXT NOT NULL, "
            "secs REAL NOT NULL, day INTEGER, hod INTEGER, PRIMARY KEY(ts, artist, title))"
        )
        cols = [r[1] for r in db.execute("PRAGMA table_info(listens)").fetchall()]
        if "day" not in cols:
            db.execute("ALTER TABLE listens ADD COLUMN day INTEGER")
        if "hod" not in cols:
            db.execute("ALTER TABLE listens ADD COLUMN hod INTEGER")
        db.execute(
            "CREATE TABLE IF NOT EXISTS tracks("
            "artist TEXT NOT NULL, title TEXT NOT NULL, duration INTEGER NOT NULL, "
            "PRIMARY KEY(artist, title))"
        )
        db.execute("CREATE TABLE IF NOT EXISTS canon(k TEXT PRIMARY KEY, artist TEXT NOT NULL, title TEXT NOT NULL)")
        db.execute(
            "CREATE TABLE IF NOT EXISTS sessions("
            "id INTEGER PRIMARY KEY AUTOINCREMENT, start INTEGER NOT NULL, end INTEGER NOT NULL, "
            "artist TEXT NOT NULL, title TEXT NOT NULL, secs REAL NOT NULL, dur INTEGER NOT NULL DEFAULT 0, "
            "pct REAL NOT NULL DEFAULT 0, counted INTEGER NOT NULL DEFAULT 0, src INTEGER)"
        )
        db.execute("CREATE TABLE IF NOT EXISTS sources(id INTEGER PRIMARY KEY, name TEXT NOT NULL)")
        db.execute("CREATE INDEX IF NOT EXISTS idx_listens_ts ON listens(ts)")
        db.execute("CREATE INDEX IF NOT EXISTS idx_listens_day ON listens(day)")
        db.execute("CREATE INDEX IF NOT EXISTS idx_listens_at ON listens(artist, title)")
        db.execute("CREATE INDEX IF NOT EXISTS idx_sessions_start ON sessions(start)")
        db.execute("CREATE INDEX IF NOT EXISTS idx_sessions_at ON sessions(artist, title)")
        db.execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_sessions_uq ON sessions(start, artist, title)")
        if ver < SCHEMA_VERSION:
            try:
                self._upgrade_data()
            except Exception as e:
                log("upgrade error: %r" % (e,))
            db.execute("PRAGMA user_version=%d" % SCHEMA_VERSION)
        db.commit()

    def _upgrade_data(self):
        db = self.db
        rows = db.execute("SELECT rowid, ts FROM listens WHERE day IS NULL OR hod IS NULL").fetchall()
        upd = []
        for rid, ts in rows:
            lt = time.localtime(ts)
            upd.append(((int(ts) + int(lt.tm_gmtoff or 0)) // 86400, lt.tm_hour, rid))
        if upd:
            db.executemany("UPDATE listens SET day=?, hod=? WHERE rowid=?", upd)
        pairs = db.execute(
            "SELECT artist, title, SUM(secs) AS s FROM listens GROUP BY artist, title ORDER BY s DESC"
        ).fetchall()
        seen = {}
        for a, t, _s in pairs:
            k = norm_key(a, t)
            if k not in seen:
                seen[k] = (a, t)
                db.execute("INSERT OR IGNORE INTO canon(k, artist, title) VALUES(?,?,?)", (k, a, t))
                continue
            ca, ct = seen[k]
            rows = db.execute("SELECT ts, secs, day, hod FROM listens WHERE artist=? AND title=?", (a, t)).fetchall()
            db.executemany(
                "INSERT INTO listens(ts, artist, title, secs, day, hod) VALUES(?,?,?,?,?,?) "
                "ON CONFLICT(ts, artist, title) DO UPDATE SET secs = secs + excluded.secs",
                [(r[0], ca, ct, r[1], r[2], r[3]) for r in rows],
            )
            db.execute("DELETE FROM listens WHERE artist=? AND title=?", (a, t))
            d = db.execute("SELECT duration FROM tracks WHERE artist=? AND title=?", (a, t)).fetchone()
            if d:
                db.execute("INSERT OR IGNORE INTO tracks(artist, title, duration) VALUES(?,?,?)", (ca, ct, d[0]))
                db.execute("DELETE FROM tracks WHERE artist=? AND title=?", (a, t))

    def close(self):
        with self.lock:
            try:
                self._flush_locked()
                self.db.close()
            except Exception as e:
                log("store close error: %r" % (e,))

    def canon(self, artist, title):
        key = norm_key(artist, title)
        hit = self._canon.get(key)
        if hit is not None:
            return hit
        with self.lock:
            row = self.db.execute("SELECT artist, title FROM canon WHERE k=?", (key,)).fetchone()
            if row:
                res = (row[0], row[1])
            else:
                res = (artist, title)
                self.db.execute("INSERT OR IGNORE INTO canon(k, artist, title) VALUES(?,?,?)", (key, artist, title))
                self.db.commit()
            self._canon[key] = res
        return res

    def cover_path(self, artist, title):
        h = hashlib.sha1(("%s|%s" % (artist, title)).encode("utf-8")).hexdigest()
        return os.path.join(self.cover_dir, h + ".jpg")

    def add(self, ts, artist, title, secs):
        with self.lock:
            key = (ts, artist, title)
            rec = self.pending.get(key)
            if rec is None:
                lt = time.localtime(ts)
                rec = self.pending[key] = [0.0, (int(ts) + int(lt.tm_gmtoff or 0)) // 86400, lt.tm_hour]
            rec[0] += secs
            self.added += secs
            tk = (artist, title)
            self.added_track[tk] = self.added_track.get(tk, 0.0) + secs
            self.added_artist[artist] = self.added_artist.get(artist, 0.0) + secs

    def set_duration(self, artist, title, dur):
        with self.lock:
            self.db.execute(
                "INSERT INTO tracks(artist, title, duration) VALUES(?,?,?) "
                "ON CONFLICT(artist, title) DO UPDATE SET duration = excluded.duration",
                (artist, title, int(dur)),
            )
            self.db.commit()

    def add_session(self, start, end, artist, title, secs, dur, pct, counted, src):
        with self.lock:
            self.db.execute(
                "INSERT OR IGNORE INTO sessions(start, end, artist, title, secs, dur, pct, counted, src) "
                "VALUES(?,?,?,?,?,?,?,?,?)",
                (int(start), int(end), artist, title, float(secs), int(dur), float(pct), int(counted),
                 int(src) if src else None),
            )
            self.db.commit()
            self.dirty += 1

    def set_source(self, sid, name):
        with self.lock:
            self.db.execute(
                "INSERT INTO sources(id, name) VALUES(?,?) ON CONFLICT(id) DO UPDATE SET name = excluded.name",
                (int(sid), str(name)),
            )
            self.db.commit()

    def flush(self):
        with self.lock:
            self._flush_locked()

    def _flush_locked(self):
        if not self.pending:
            return
        items = list(self.pending.items())
        self.pending.clear()
        try:
            self.db.executemany(
                "INSERT INTO listens(ts, artist, title, secs, day, hod) VALUES(?,?,?,?,?,?) "
                "ON CONFLICT(ts, artist, title) DO UPDATE SET secs = secs + excluded.secs",
                [(k[0], k[1], k[2], v[0], v[1], v[2]) for k, v in items],
            )
            self.db.commit()
            self.dirty += 1
        except Exception as e:
            log("flush error: %r" % (e,))
            for k, v in items:
                cur = self.pending.get(k)
                if cur is None:
                    self.pending[k] = v
                else:
                    cur[0] += v[0]

    def reset(self):
        with self.lock:
            self.pending.clear()
            self.db.execute("DELETE FROM listens")
            self.db.execute("DELETE FROM sessions")
            self.db.execute("DELETE FROM tracks")
            self.db.commit()
            self.added = 0.0
            self.added_track.clear()
            self.added_artist.clear()
            self._cache.clear()
            self.dirty += 1

    def snapshot(self, period="all"):
        now = int(time.time())
        today = local_day(now)
        ck = (period, today)
        with self.lock:
            c = self._cache.get(ck)
            if c is not None and c["_dirty"] == self.dirty and now - c["now"] < 10:
                return c
            self._flush_locked()
            q = self.db.execute
            t0, prev0 = period_bounds(period, now)
            midnight = day_start(today)

            def total_since(ts):
                return q("SELECT COALESCE(SUM(secs), 0) FROM listens WHERE ts >= ?", (ts,)).fetchone()[0]

            dh = q("SELECT day, hod, SUM(secs) FROM listens WHERE day IS NOT NULL GROUP BY day, hod").fetchall()
            daily, dh_map, monthly = {}, {}, {}
            for d, h, s in dh:
                dh_map[(d, h)] = s
                daily[d] = daily.get(d, 0.0) + s
            for d, s in daily.items():
                dd = day_date(d)
                monthly[(dd.year, dd.month)] = monthly.get((dd.year, dd.month), 0.0) + s

            streak = 0
            d = today if daily.get(today, 0.0) >= 60 else today - 1
            while daily.get(d, 0.0) >= 60:
                streak += 1
                d -= 1
            best_day = max(daily.items(), key=lambda kv: kv[1]) if daily else None
            first_day = min(daily) if daily else today
            total = q("SELECT COALESCE(SUM(secs), 0) FROM listens").fetchone()[0]

            p_total = total_since(t0) if t0 else total
            p_prev = None
            if prev0 is not None:
                p_prev = q("SELECT COALESCE(SUM(secs), 0) FROM listens WHERE ts >= ? AND ts < ?",
                           (prev0, t0)).fetchone()[0]
            sr = q("SELECT COALESCE(SUM(counted), 0), COALESCE(SUM(1 - counted), 0), COALESCE(MAX(secs), 0) "
                   "FROM sessions WHERE start >= ?", (t0,)).fetchone()
            new_tracks = new_artists = None
            if t0:
                new_tracks = q("SELECT COUNT(*) FROM (SELECT MIN(ts) m FROM listens GROUP BY artist, title) "
                               "WHERE m >= ?", (t0,)).fetchone()[0]
                new_artists = q("SELECT COUNT(*) FROM (SELECT MIN(ts) m FROM listens GROUP BY artist) "
                                "WHERE m >= ?", (t0,)).fetchone()[0]
            stuck = q("SELECT artist, title, COUNT(*) n FROM sessions WHERE counted = 1 AND start >= ? "
                      "GROUP BY artist, title ORDER BY n DESC LIMIT 1", (t0,)).fetchone()
            skipped = q("SELECT artist, title, COUNT(*) n FROM sessions WHERE counted = 0 AND start >= ? "
                        "GROUP BY artist, title ORDER BY n DESC LIMIT 3", (t0,)).fetchall()
            sources = q("SELECT s.src, COALESCE(n.name, ''), SUM(s.secs) AS t FROM sessions s "
                        "LEFT JOIN sources n ON n.id = s.src WHERE s.start >= ? AND s.src IS NOT NULL "
                        "GROUP BY s.src ORDER BY t DESC LIMIT 5", (t0,)).fetchall()

            snap = {
                "period": period, "now": now, "added_at": self.added,
                "total": total, "today": total_since(midnight),
                "week": total_since(now - 7 * 86400), "month": total_since(now - 30 * 86400),
                "tracks": q("SELECT COUNT(*) FROM (SELECT 1 FROM listens GROUP BY artist, title)").fetchone()[0],
                "p_total": p_total, "p_prev": p_prev,
                "p_tracks": q("SELECT COUNT(*) FROM (SELECT 1 FROM listens WHERE ts >= ? GROUP BY artist, title)",
                              (t0,)).fetchone()[0],
                "p_artists": q("SELECT COUNT(*) FROM (SELECT 1 FROM listens WHERE ts >= ? GROUP BY artist)",
                               (t0,)).fetchone()[0],
                "plays": int(sr[0]), "skips": int(sr[1]), "longest": float(sr[2]),
                "new_tracks": new_tracks, "new_artists": new_artists,
                "stuck": stuck if stuck and stuck[2] >= 3 else None,
                "skipped": [r for r in skipped if r[2] >= 2],
                "sources": sources,
                "top_tracks": q("SELECT artist, title, SUM(secs) AS s FROM listens WHERE ts >= ? "
                                "GROUP BY artist, title ORDER BY s DESC LIMIT 8", (t0,)).fetchall(),
                "top_artists": q("SELECT artist, SUM(secs) AS s FROM listens WHERE ts >= ? "
                                 "GROUP BY artist ORDER BY s DESC LIMIT 8", (t0,)).fetchall(),
                "last": q("SELECT artist, title FROM listens ORDER BY ts DESC LIMIT 1").fetchone(),
                "daily": daily, "dh": dh, "dh_map": dh_map, "monthly": monthly,
                "streak": streak, "best_day": best_day, "first_day": first_day,
                "avg_day": total / float(max(1, today - first_day + 1)) if daily else 0.0,
            }
            snap["_dirty"] = self.dirty
            if len(self._cache) > 12:
                self._cache.clear()
            self._cache[ck] = snap
            return snap

    def top_tracks(self, since, limit=500):
        with self.lock:
            self._flush_locked()
            return self.db.execute(
                "SELECT artist, title, SUM(secs) AS s FROM listens WHERE ts >= ? "
                "GROUP BY artist, title ORDER BY s DESC LIMIT ?", (since, limit)).fetchall()

    def top_artists(self, since, limit=500):
        with self.lock:
            self._flush_locked()
            return self.db.execute(
                "SELECT artist, SUM(secs) AS s FROM listens WHERE ts >= ? "
                "GROUP BY artist ORDER BY s DESC LIMIT ?", (since, limit)).fetchall()

    def tracks_for_bucket(self, bucket):
        with self.lock:
            self._flush_locked()
            q = self.db.execute
            if bucket["kind"] == "range":
                return q(
                    "SELECT artist, title, SUM(secs) AS s FROM listens "
                    "WHERE ts >= ? AND ts < ? GROUP BY artist, title ORDER BY s DESC",
                    (bucket["t0"], bucket["t1"]),
                ).fetchall()
            return q(
                "SELECT artist, title, SUM(secs) AS s FROM listens WHERE ((day + 3) % 7) = ? "
                "GROUP BY artist, title ORDER BY s DESC", (int(bucket["wday"]),)).fetchall()

    def artist_snapshot(self, artist):
        with self.lock:
            self._flush_locked()
            rows = self.db.execute(
                "SELECT artist, title, SUM(secs) AS s FROM listens WHERE artist = ? "
                "GROUP BY title ORDER BY s DESC", (artist,)
            ).fetchall()
            return rows, self.added_artist.get(artist, 0.0)

    def track_stats(self, artist, title):
        with self.lock:
            self._flush_locked()
            q = self.db.execute
            row = q(
                "SELECT COALESCE(SUM(secs), 0), MIN(ts), MAX(ts) FROM listens "
                "WHERE artist = ? AND title = ?", (artist, title)
            ).fetchone()
            dh = q(
                "SELECT day, hod, SUM(secs) FROM listens WHERE artist = ? AND title = ? "
                "AND day IS NOT NULL GROUP BY day, hod", (artist, title)
            ).fetchall()
            drow = q("SELECT duration FROM tracks WHERE artist = ? AND title = ?", (artist, title)).fetchone()
            sr = q(
                "SELECT COUNT(*), COALESCE(SUM(counted), 0), COALESCE(AVG(pct), 0), "
                "COALESCE(SUM(CASE WHEN pct >= 0.9 THEN 1 ELSE 0 END), 0), COALESCE(MAX(secs), 0) "
                "FROM sessions WHERE artist = ? AND title = ?", (artist, title)
            ).fetchone()
            added_at = self.added_track.get((artist, title), 0.0)
        return {
            "total": row[0], "first": row[1], "last": row[2], "dh": dh,
            "duration": drow[0] if drow else 0, "added_at": added_at,
            "sessions": int(sr[0]), "plays": int(sr[1]), "skips": int(sr[0]) - int(sr[1]),
            "avg_pct": float(sr[2]), "full": int(sr[3]), "longest": float(sr[4]),
        }

    def export_data(self):
        with self.lock:
            self._flush_locked()
            q = self.db.execute
            return {
                "app": "femboy_music_stats", "schema": SCHEMA_VERSION, "exported": int(time.time()),
                "listens": [list(r) for r in q("SELECT ts, artist, title, secs FROM listens ORDER BY ts")],
                "tracks": [list(r) for r in q("SELECT artist, title, duration FROM tracks")],
                "sessions": [list(r) for r in q(
                    "SELECT start, end, artist, title, secs, dur, pct, counted, src FROM sessions ORDER BY start")],
                "sources": [list(r) for r in q("SELECT id, name FROM sources")],
            }

    def export_csv(self):
        with self.lock:
            self._flush_locked()
            rows = self.db.execute("SELECT ts, artist, title, secs FROM listens ORDER BY ts").fetchall()
        out = ["date,time,artist,title,seconds"]
        for ts, a, t, s in rows:
            lt = time.localtime(ts)
            out.append('%s,%s,"%s","%s",%.1f' % (
                time.strftime("%Y-%m-%d", lt), time.strftime("%H:%M", lt),
                a.replace('"', '""'), t.replace('"', '""'), s))
        return "\n".join(out)

    def import_data(self, data):
        if not isinstance(data, dict) or not isinstance(data.get("listens"), list):
            raise ValueError("это не файл экспорта Music Stats")
        rows = []
        for r in data["listens"]:
            ts, a, t, s = int(r[0]), str(r[1]), str(r[2]), float(r[3])
            a, t = self.canon(a, t)
            lt = time.localtime(ts)
            rows.append((ts, a, t, s, (ts + int(lt.tm_gmtoff or 0)) // 86400, lt.tm_hour))
        with self.lock:
            self._flush_locked()
            self.db.executemany(
                "INSERT INTO listens(ts, artist, title, secs, day, hod) VALUES(?,?,?,?,?,?) "
                "ON CONFLICT(ts, artist, title) DO UPDATE SET secs = MAX(secs, excluded.secs)", rows)
            for r in data.get("tracks") or []:
                a, t = self.canon(str(r[0]), str(r[1]))
                self.db.execute(
                    "INSERT INTO tracks(artist, title, duration) VALUES(?,?,?) "
                    "ON CONFLICT(artist, title) DO UPDATE SET duration = excluded.duration", (a, t, int(r[2])))
            ss = []
            for r in data.get("sessions") or []:
                a, t = self.canon(str(r[2]), str(r[3]))
                ss.append((int(r[0]), int(r[1]), a, t, float(r[4]), int(r[5]), float(r[6]), int(r[7]),
                           int(r[8]) if r[8] else None))
            self.db.executemany(
                "INSERT OR IGNORE INTO sessions(start, end, artist, title, secs, dur, pct, counted, src) "
                "VALUES(?,?,?,?,?,?,?,?,?)", ss)
            for r in data.get("sources") or []:
                self.db.execute(
                    "INSERT INTO sources(id, name) VALUES(?,?) ON CONFLICT(id) DO UPDATE SET name = excluded.name",
                    (int(r[0]), str(r[1])))
            self.db.commit()
            self._cache.clear()
            self.dirty += 1
        return len(rows)

    def backup_to(self, path):
        with self.lock:
            self._flush_locked()
            dst = sqlite3.connect(path)
            try:
                self.db.backup(dst)
            finally:
                dst.close()


# ───────────────────────── Данные для графиков ─────────────────────────

def _first_day(snap):
    d = snap["daily"]
    return min(d) if d else local_day(snap["now"])


def build_series(snap, mode, offset=0):
    now = snap["now"]
    today = local_day(now)
    daily = snap["daily"]
    first = _first_day(snap)
    vals, labels, buckets = [], [], []

    if mode == "hour":
        cur_h = time.localtime(now).tm_hour
        end = today * 24 + cur_h - offset * 24
        dh_map = snap["dh_map"]
        for i in range(24):
            d, h = divmod(end - 23 + i, 24)
            t0 = hour_start(d, h)
            vals.append(dh_map.get((d, h), 0.0))
            labels.append("%02d" % h if i % 3 == 0 else "")
            buckets.append({"kind": "range", "t0": t0, "t1": t0 + 3600,
                            "label": "%s, %02d:00–%02d:00" % (day_label_d(d), h, (h + 1) % 24)})
        d1, d2 = (end - 23) // 24, end // 24
        if offset == 0:
            title = "Последние 24 часа · по часам"
        else:
            title = "24 часа · " + (day_label_d(d2) if d1 == d2 else day_label_d(d1) + " – " + day_label_d(d2))
        return title, vals, labels, buckets, max(0, (today * 24 + cur_h - first * 24) // 24)

    if mode == "days":
        end = today - offset * 30
        for i in range(30):
            d = end - 29 + i
            t0 = day_start(d)
            vals.append(daily.get(d, 0.0))
            labels.append(str(day_date(d).day) if i % 5 == 0 else "")
            buckets.append({"kind": "range", "t0": t0, "t1": day_start(d + 1),
                            "label": "%s, %s" % (WDAYS[day_wd(d)], day_label_d(d))})
        title = "Последние 30 дней" if offset == 0 else "30 дней · %s – %s" % (day_label_d(end - 29), day_label_d(end))
        return title, vals, labels, buckets, max(0, (today - first) // 30)

    if mode == "weeks":
        cur_w = (today + 3) // 7
        end_w = cur_w - offset * 12
        for i in range(12):
            ds = (end_w - 11 + i) * 7 - 3
            vals.append(sum(daily.get(ds + k, 0.0) for k in range(7)))
            labels.append(str(day_date(ds).day) if i % 2 == 0 else "")
            buckets.append({"kind": "range", "t0": day_start(ds), "t1": day_start(ds + 7),
                            "label": "Неделя %s – %s" % (day_label_d(ds), day_label_d(ds + 6))})
        title = "Последние 12 недель" if offset == 0 else "12 недель · до %s" % day_label_d(end_w * 7 - 3 + 6)
        return title, vals, labels, buckets, max(0, (cur_w - (first + 3) // 7) // 12)

    if mode == "wday":
        sums = [0.0] * 7
        for d, s in daily.items():
            sums[day_wd(d)] += s
        buckets = [{"kind": "wday", "wday": i, "label": WDAYS_PLURAL[i] + " · все недели"} for i in range(7)]
        return "По дням недели · всё время", sums, list(WDAYS), buckets, 0

    lt = time.localtime(now)
    cur_i = lt.tm_year * 12 + lt.tm_mon - 1
    end_i = cur_i - offset * 12
    monthly = snap["monthly"]
    for i in range(12):
        yy, mm = divmod(end_i - 11 + i, 12)
        mm += 1
        t0 = int(time.mktime((yy, mm, 1, 0, 0, 0, 0, 0, -1)))
        ny, nm = (yy + 1, 1) if mm == 12 else (yy, mm + 1)
        t1 = int(time.mktime((ny, nm, 1, 0, 0, 0, 0, 0, -1)))
        vals.append(monthly.get((yy, mm), 0.0))
        labels.append(MONTHS[mm - 1])
        buckets.append({"kind": "range", "t0": t0, "t1": t1, "label": "%s %d" % (MONTHS_FULL[mm - 1], yy)})
    fd = day_date(first)
    max_off = max(0, (cur_i - (fd.year * 12 + fd.month - 1)) // 12)
    title = "Последние 12 месяцев" if offset == 0 else "12 месяцев · до %s %d" % (
        MONTHS[(end_i % 12)], end_i // 12)
    return title, vals, labels, buckets, max_off


def track_series(arrays):
    def get(mode, offset=0):
        if mode == "hour":
            labels = ["%02d" % i if i % 3 == 0 else "" for i in range(24)]
            bk = [{"kind": "none", "label": "%02d:00–%02d:00" % (i, (i + 1) % 24)} for i in range(24)]
            return "По времени суток · всё время", arrays["hod"], labels, bk, 0
        if mode == "wday":
            bk = [{"kind": "none", "label": WDAYS_PLURAL[i]} for i in range(7)]
            return "По дням недели · всё время", arrays["wd"], list(WDAYS), bk, 0
        bk = [{"kind": "none", "label": MONTHS_FULL[i]} for i in range(12)]
        return "По месяцам года · всё время", arrays["moy"], list(MONTHS), bk, 0
    return get


def build_segments(rows, with_artist):
    total = sum(r[2] for r in rows) or 1.0
    top = rows if len(rows) <= 4 else rows[:3]
    segs = []
    for k, (a, t, secs) in enumerate(top):
        parts = [a] if with_artist else []
        parts += [fmt_smart(secs), "%d%%" % round(secs * 100.0 / total)]
        segs.append({"name": "%d. %s" % (k + 1, t), "sub": " · ".join(parts),
                     "share": secs / total, "first": k == 0})
    rest = rows[len(top):]
    if rest:
        rs = sum(r[2] for r in rest)
        segs.append({"name": "Другие треки (%d)" % len(rest),
                     "sub": "%s · %d%%" % (fmt_smart(rs), round(rs * 100.0 / total)),
                     "share": rs / total, "first": False})
    return segs


# ───────────────────────── Рисование графика ─────────────────────────

class ChartRenderer:
    def __init__(self, w, h, density):
        Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
        self.Align = jclass("android.graphics.Paint$Align")
        self.Style = jclass("android.graphics.Paint$Style")
        self.LinearGradient = jclass("android.graphics.LinearGradient")
        self.TileMode = jclass("android.graphics.Shader$TileMode")
        self.Dash = jclass("android.graphics.DashPathEffect")
        self.w, self.h, self.d = int(w), int(h), float(density)
        self.bmp = Bitmap.createBitmap(self.w, self.h, Config.ARGB_8888)
        self.c = Canvas(self.bmp)
        self.p = Paint()
        self.p.setAntiAlias(True)
        self.rect = RectF()
        self.style = "bars"
        self._cum = []

    def bounds(self):
        d = self.d
        return 42.0 * d, self.w - 6.0 * d, 30.0 * d, self.h - 24.0 * d

    def _donut_geom(self):
        d = self.d
        cx, cy = self.w / 2.0, self.h / 2.0
        R = min(self.w, self.h) / 2.0 - 12.0 * d
        return cx, cy, R, R * 0.36

    def hit(self, x, y, n):
        if n <= 0:
            return None
        if self.style == "donut":
            cx, cy, R, th = self._donut_geom()
            dist = math.hypot(x - cx, y - cy)
            if dist > R + 6.0 * self.d or dist < R - th * 1.25 or not self._cum:
                return None
            frac = ((math.degrees(math.atan2(y - cy, x - cx)) + 90.0) % 360.0) / 360.0
            i = bisect.bisect_right(self._cum, frac) - 1
            return min(max(i, 0), n - 1)
        left, right, _t, _b = self.bounds()
        if x < left or x > right:
            return None
        return min(n - 1, int((x - left) / ((right - left) / n)))

    def donut_mid(self, i):
        cx, cy, R, th = self._donut_geom()
        if not self._cum or i + 1 >= len(self._cum):
            return cx, cy
        a = math.radians(-90.0 + (self._cum[i] + self._cum[i + 1]) / 2.0 * 360.0)
        r = R - th / 2.0
        return cx + r * math.cos(a), cy + r * math.sin(a)

    def draw(self, vals, labels, pal, progress, selected=-1, names=None, tip=False):
        self.bmp.eraseColor(jint(0))
        if self.style == "donut":
            self._draw_donut(vals, labels, pal, progress, selected, names or labels, tip)
        else:
            self._draw_bars(vals, labels, pal, progress, selected, names or labels, tip)

    def _empty(self, pal):
        c, p, d, Align = self.c, self.p, self.d, self.Align
        p.setShader(None)
        p.setColor(jint(pal["gray"]))
        p.setTextAlign(Align.CENTER)
        p.setTextSize(15.0 * d)
        c.drawText("Пока пусто", self.w / 2.0, self.h / 2.0, p)
        p.setTextSize(12.0 * d)
        c.drawText("Включи музыку в Telegram", self.w / 2.0, self.h / 2.0 + 22.0 * d, p)

    def _draw_bars(self, vals, labels, pal, progress, selected, names, tip):
        c, p, d, Align = self.c, self.p, self.d, self.Align
        w = float(self.w)
        left, right, top, bottom = self.bounds()
        accent, gray = pal["accent"], pal["gray"]
        mx = max(vals) if vals else 0
        if mx <= 0:
            self._empty(pal)
            return

        p.setShader(None)
        p.setTextSize(10.5 * d)
        for i in range(4):
            frac = i / 3.0
            y = bottom - frac * (bottom - top)
            p.setColor(jint(with_alpha(gray, 50 if i else 110)))
            p.setStrokeWidth(max(1.0, 0.8 * d))
            c.drawLine(left, y, right, y, p)
            if i:
                p.setColor(jint(gray))
                p.setTextAlign(Align.RIGHT)
                c.drawText(fmt_short(mx * frac), left - 6.0 * d, y + 4.0 * d, p)

        n = len(vals)
        slot = (right - left) / n
        bw = slot * (0.62 if n <= 12 else 0.7)
        radius = min(bw / 2.0, 6.0 * d)

        if selected >= 0:
            self.rect.set(left + selected * slot + 1.0 * d, top - 8.0 * d,
                          left + (selected + 1) * slot - 1.0 * d, bottom + 2.0 * d)
            p.setShader(None)
            p.setColor(jint(with_alpha(accent, 38)))
            c.drawRoundRect(self.rect, 8.0 * d, 8.0 * d, p)

        shader = self.LinearGradient(
            0.0, top, 0.0, bottom, jint(accent), jint(with_alpha(accent, 110)), self.TileMode.CLAMP)
        stagger = 0.55
        max_i = max(range(n), key=lambda k: vals[k])

        for i, v in enumerate(vals):
            if v <= 0:
                continue
            local = progress * (1.0 + stagger) - (i / float(n)) * stagger
            e = ease_out(local)
            full = (v / mx) * (bottom - top)
            hh = max(full, 2.5 * d) * e
            if hh <= 0.5:
                continue
            x0 = left + i * slot + (slot - bw) / 2.0
            self.rect.set(x0, bottom - hh, x0 + bw, bottom)
            p.setShader(shader)
            p.setColor(jint(accent))
            p.setAlpha(120 if (selected >= 0 and i != selected) else 255)
            c.drawRoundRect(self.rect, radius, radius, p)
            p.setShader(None)

            if (n <= 12 or i == max_i or i == selected) and e > 0.6 and not (tip and i == selected):
                p.setTextAlign(Align.CENTER)
                p.setTextSize(10.5 * d)
                alpha = int(255 * min(1.0, (e - 0.6) / 0.4))
                p.setColor(jint(with_alpha(accent if i in (max_i, selected) else pal["text"], alpha)))
                c.drawText(fmt_short(v), x0 + bw / 2.0, bottom - hh - 6.0 * d, p)

        avg = sum(vals) / float(n)
        if avg > 0 and n >= 5 and progress > 0.9:
            y = bottom - (avg / mx) * (bottom - top)
            p.setColor(jint(with_alpha(pal["text"], 150)))
            p.setStrokeWidth(max(1.2, 1.2 * d))
            p.setPathEffect(self.Dash(jarray(jfloat)([6.0 * d, 5.0 * d]), 0.0))
            c.drawLine(left, y, right, y, p)
            p.setPathEffect(None)
            p.setTextAlign(Align.RIGHT)
            p.setTextSize(9.5 * d)
            p.setColor(jint(with_alpha(pal["text"], 190)))
            c.drawText("ср. " + fmt_short(avg), right, y - 4.0 * d, p)

        p.setShader(None)
        p.setTextAlign(Align.CENTER)
        p.setTextSize(10.5 * d)
        for i, lab in enumerate(labels):
            if lab:
                p.setColor(jint(accent if i == selected else gray))
                c.drawText(lab, left + i * slot + slot / 2.0, bottom + 17.0 * d, p)

        if tip and 0 <= selected < n:
            txt = "%s · %s" % (short(names[selected], 26), fmt_dur(vals[selected]))
            p.setTextSize(11.5 * d)
            p.setTextAlign(Align.CENTER)
            tw = p.measureText(txt) + 18.0 * d
            cx = left + selected * slot + slot / 2.0
            x0 = min(max(cx - tw / 2.0, 2.0 * d), w - tw - 2.0 * d)
            self.rect.set(x0, 2.0 * d, x0 + tw, 24.0 * d)
            p.setColor(jint(accent))
            c.drawRoundRect(self.rect, 8.0 * d, 8.0 * d, p)
            p.setColor(jint(pal["white"]))
            c.drawText(txt, x0 + tw / 2.0, 17.0 * d, p)

    def _draw_donut(self, vals, labels, pal, progress, selected, names, tip):
        c, p, d, Align, Style = self.c, self.p, self.d, self.Align, self.Style
        n = len(vals)
        total = sum(vals)
        p.setShader(None)
        p.setPathEffect(None)
        if total <= 0:
            self._cum = []
            self._empty(pal)
            return
        cx, cy, R, th = self._donut_geom()
        colors = slice_colors(pal["accent"], n)
        e = ease_out(progress)
        gap = 2.2 if n <= 12 else (1.0 if n <= 24 else 0.5)
        cum = [0.0]
        acc = 0.0
        for v in vals:
            acc += v / total
            cum.append(acc)
        self._cum = cum

        p.setStyle(Style.STROKE)
        for i, v in enumerate(vals):
            if v <= 0:
                continue
            sel = i == selected
            r = R - th / 2.0 + (th * 0.06 if sel else 0.0)
            start = -90.0 + cum[i] * 360.0 * e + gap / 2.0
            sweep = (cum[i + 1] - cum[i]) * 360.0 * e - gap
            if sweep <= 0.2:
                continue
            self.rect.set(cx - r, cy - r, cx + r, cy + r)
            p.setStrokeWidth(th * 1.12 if sel else th)
            p.setColor(jint(colors[i]))
            p.setAlpha(110 if (selected >= 0 and not sel) else 255)
            c.drawArc(self.rect, float(start), float(sweep), False, p)
        p.setStyle(Style.FILL)

        if e > 0.9:
            p.setTextAlign(Align.CENTER)
            p.setTextSize(10.0 * d)
            p.setColor(jint(pal["white"]))
            r = R - th / 2.0
            for i, v in enumerate(vals):
                lab = labels[i] if i < len(labels) else ""
                if not lab or v <= 0 or (cum[i + 1] - cum[i]) * 360.0 < 16.0:
                    continue
                a = math.radians(-90.0 + (cum[i] + cum[i + 1]) / 2.0 * 360.0)
                c.drawText(lab, cx + r * math.cos(a), cy + r * math.sin(a) + 3.5 * d, p)

        p.setTextAlign(Align.CENTER)
        if 0 <= selected < n and vals[selected] > 0:
            p.setColor(jint(pal["gray"]))
            p.setTextSize(11.5 * d)
            c.drawText(short(names[selected], 24), cx, cy - 10.0 * d, p)
            p.setColor(jint(pal["text"]))
            p.setTextSize(19.0 * d)
            p.setFakeBoldText(True)
            c.drawText(fmt_smart(vals[selected]), cx, cy + 14.0 * d, p)
            p.setFakeBoldText(False)
            p.setColor(jint(pal["gray"]))
            p.setTextSize(11.5 * d)
            c.drawText("%d%%" % round(vals[selected] * 100.0 / total), cx, cy + 32.0 * d, p)
        else:
            p.setColor(jint(pal["gray"]))
            p.setTextSize(12.0 * d)
            c.drawText("Всего", cx, cy - 8.0 * d, p)
            p.setColor(jint(pal["accent"]))
            p.setTextSize(22.0 * d)
            p.setFakeBoldText(True)
            c.drawText(fmt_smart(total * e), cx, cy + 18.0 * d, p)
            p.setFakeBoldText(False)


class HeatRenderer:
    COLS = 24

    def __init__(self, w, density):
        Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
        self.Align = jclass("android.graphics.Paint$Align")
        self.Style = jclass("android.graphics.Paint$Style")
        self.w, self.d = int(w), float(density)
        self.left, self.top = 26.0 * self.d, 16.0 * self.d
        self.cell = (self.w - self.left) / float(self.COLS)
        self.h = int(self.top + 7 * self.cell + 4.0 * self.d)
        self.bmp = Bitmap.createBitmap(self.w, self.h, Config.ARGB_8888)
        self.c = Canvas(self.bmp)
        self.p = Paint()
        self.p.setAntiAlias(True)
        self.rect = RectF()

    def _color(self, v, mx, pal):
        empty = mix(pal["card"], pal["gray"], 0.18)
        if v <= 0 or mx <= 0:
            return empty
        lvl = min(1.0, (v / mx) ** 0.6)
        return mix(empty, pal["accent"], 0.2 + 0.8 * lvl)

    def _cell(self, col, row, color):
        d, p, c = self.d, self.p, self.c
        g = max(1.0, 1.2 * d)
        x0 = self.left + col * self.cell
        y0 = self.top + row * self.cell
        self.rect.set(x0 + g / 2.0, y0 + g / 2.0, x0 + self.cell - g / 2.0, y0 + self.cell - g / 2.0)
        p.setColor(jint(color))
        c.drawRoundRect(self.rect, 2.5 * d, 2.5 * d, p)

    def _row_labels(self, pal, rows=(0, 2, 4)):
        p, c, d = self.p, self.c, self.d
        p.setColor(jint(pal["gray"]))
        p.setTextSize(9.0 * d)
        p.setTextAlign(self.Align.RIGHT)
        for r in rows:
            c.drawText(WDAYS[r], self.left - 4.0 * d, self.top + r * self.cell + self.cell * 0.75, p)

    def week_of_col(self, col, today):
        return (today + 3) // 7 - (self.COLS - 1 - col)

    def draw_calendar(self, daily, today, pal, selected_day=None):
        self.bmp.eraseColor(jint(0))
        p, c, d = self.p, self.c, self.d
        vis_max = 0.0
        for col in range(self.COLS):
            ds = self.week_of_col(col, today) * 7 - 3
            for r in range(7):
                if ds + r <= today:
                    vis_max = max(vis_max, daily.get(ds + r, 0.0))
        p.setShader(None)
        last_lab = -10
        p.setTextSize(9.0 * d)
        for col in range(self.COLS):
            ds = self.week_of_col(col, today) * 7 - 3
            for r in range(7):
                day = ds + r
                if day > today:
                    continue
                self._cell(col, r, self._color(daily.get(day, 0.0), vis_max, pal))
                if selected_day == day:
                    p.setStyle(self.Style.STROKE)
                    p.setStrokeWidth(max(1.5, 1.6 * d))
                    p.setColor(jint(pal["text"]))
                    x0, y0 = self.left + col * self.cell, self.top + r * self.cell
                    self.rect.set(x0 + 1, y0 + 1, x0 + self.cell - 1, y0 + self.cell - 1)
                    c.drawRoundRect(self.rect, 2.5 * d, 2.5 * d, p)
                    p.setStyle(self.Style.FILL)
            dd = day_date(ds)
            if dd.day <= 7 and col - last_lab >= 3:
                last_lab = col
                p.setColor(jint(pal["gray"]))
                p.setTextAlign(self.Align.LEFT)
                c.drawText(MONTHS[dd.month - 1], self.left + col * self.cell, self.top - 4.0 * d, p)
        self._row_labels(pal)

    def day_at(self, x, y, today):
        col = int((x - self.left) // self.cell)
        row = int((y - self.top) // self.cell)
        if not (0 <= col < self.COLS and 0 <= row < 7) or x < self.left or y < self.top:
            return None
        day = self.week_of_col(col, today) * 7 - 3 + row
        return day if day <= today else None

    def draw_grid(self, dh, pal):
        self.bmp.eraseColor(jint(0))
        p, c, d = self.p, self.c, self.d
        grid = [[0.0] * 24 for _ in range(7)]
        for day, hod, s in dh:
            grid[day_wd(day)][int(hod)] += s
        mx = max(max(r) for r in grid)
        p.setShader(None)
        for r in range(7):
            for h in range(24):
                self._cell(h, r, self._color(grid[r][h], mx, pal))
        p.setTextSize(9.0 * d)
        p.setTextAlign(self.Align.LEFT)
        p.setColor(jint(pal["gray"]))
        for h in (0, 6, 12, 18):
            c.drawText("%02d" % h, self.left + h * self.cell, self.top - 4.0 * d, p)
        self._row_labels(pal, rows=(0, 2, 4, 6))
        if mx <= 0:
            return None
        for r in range(7):
            for h in range(24):
                if grid[r][h] == mx:
                    return r, h
        return None


class Pills:
    def __init__(self, ui, pal, parent, items, current, on_select, size=14):
        dp = ui.dp
        self.ui, self.pal, self.mode, self.on_select = ui, pal, current, on_select
        self.views = {}
        box = ui.hbox()
        box.setBackground(ui.rounded(pal["page"], 12))
        box.setPadding(dp(3), dp(3), dp(3), dp(3))
        parent.addView(box, ui.lp(-1, -2))
        for key, name in items:
            tv = ui.text(name, size, pal["gray"], True)
            tv.setGravity(17)
            tv.setSingleLine(True)
            tv.setPadding(dp(2), dp(9), dp(2), dp(9))
            tv.setOnClickListener(_Click(lambda k=key: self.select(k)))
            self.views[key] = tv
            box.addView(tv, ui.lp(0, -2, 1.0))
        self.restyle()

    def restyle(self):
        for k, tv in self.views.items():
            if k == self.mode:
                tv.setBackground(self.ui.rounded(self.pal["accent"], 10))
                tv.setTextColor(jint(self.pal["white"]))
            else:
                tv.setBackgroundColor(jint(0))
                tv.setTextColor(jint(self.pal["gray"]))

    def bounce(self, v):
        Overshoot = jclass("android.view.animation.OvershootInterpolator")
        v.animate().scaleX(0.9).scaleY(0.9).setDuration(80).withEndAction(
            _Run(lambda: v.animate().scaleX(1.0).scaleY(1.0).setDuration(220)
                 .setInterpolator(Overshoot(3.0)).start())
        ).start()

    def select(self, key):
        self.mode = key
        self.restyle()
        self.bounce(self.views[key])
        self.on_select(key)


# ───────────────────────── Блок графика с вкладками ─────────────────────────

class ChartBox:
    def __init__(self, ui, pal, handler, card, modes, get_series, width, height, default,
                 get_style=None, on_style=None, nav=True, pill_size=14):
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        dp = ui.dp
        self.ui, self.pal, self.handler = ui, pal, handler
        self.get_series, self.get_style, self.on_style = get_series, get_style, on_style
        self.nav = nav
        self.mode = default
        self.offset = 0
        self.maxoff = 0
        self.sel = -1
        self.series = ([], [], [])
        self.alive = True
        self.anim = None
        self.on_tap = None
        self.on_mode = None
        self._down = (0.0, 0.0)
        self._moved = False
        self._scrub = False
        self._tok = 0

        self.pills = Pills(ui, pal, card, modes, default, self.select_mode, pill_size)

        row = ui.hbox()
        row.setGravity(16)
        self.left = ui.text("‹", 26, pal["accent"], True)
        self.left.setPadding(dp(10), 0, dp(10), dp(3))
        self.left.setOnClickListener(_Click(lambda: self.shift(1)))
        self.right = ui.text("›", 26, pal["accent"], True)
        self.right.setPadding(dp(10), 0, dp(10), dp(3))
        self.right.setOnClickListener(_Click(lambda: self.shift(-1)))
        self.title_tv = ui.text("", 13, pal["gray"], single=True)
        self.title_tv.setGravity(17 if nav else 3)
        if nav:
            row.addView(self.left, ui.lp(-2, -2))
        row.addView(self.title_tv, ui.lp(0, -2, 1.0))
        if nav:
            row.addView(self.right, ui.lp(-2, -2))
        self.style_btn = ui.text("", 12, pal["accent"], True)
        self.style_btn.setPadding(dp(8), dp(4), dp(2), dp(4))
        if on_style is not None:
            self.style_btn.setOnClickListener(_Click(self._toggle_style))
            row.addView(self.style_btn, ui.lp(-2, -2))
        card.addView(row, ui.lp(-1, -2, t=8, b=2))

        self.renderer = ChartRenderer(width, height, ui.d)
        self.image = ImageView(ui.act)
        self.image.setScaleType(ImageScale.FIT_XY)
        self.image.setImageBitmap(self.renderer.bmp)
        self.image.setOnTouchListener(_Touch(self._touch))
        card.addView(self.image, ui.lp(width, height))
        self._sync_style()

    def _sync_style(self):
        st = self.get_style() if self.get_style else "bars"
        self.renderer.style = st
        self.style_btn.setText("▮ Столбцы" if st == "donut" else "◔ Кольцо")

    def _toggle_style(self):
        self.on_style()
        self._sync_style()
        self.sel = -1
        self.animate()

    def restyle(self):
        self._sync_style()

    def _touch(self, v, ev):
        a = int(ev.getAction())
        x, y = float(ev.getX()), float(ev.getY())
        slop = self.ui.dp(14)
        if a == 0:
            self._down = (x, y)
            self._moved = False
            self._scrub = False
            self._tok += 1
            tok = self._tok
            self.handler.postDelayed(_Run(lambda: self._start_scrub(tok, v)), 320)
            return True
        if a == 2:
            if self._scrub:
                idx = self.renderer.hit(x, y, len(self.series[0]))
                if idx is not None and idx != self.sel:
                    self.sel = idx
                    self.draw(1.0, tip=True)
                return True
            if abs(x - self._down[0]) > slop or abs(y - self._down[1]) > slop:
                self._moved = True
                self._tok += 1
            return True
        if a in (1, 3):
            self._tok += 1
            if self._scrub:
                self._scrub = False
                self.sel = -1
                self.draw(1.0)
                return True
            if a == 1:
                dx, dy = x - self._down[0], y - self._down[1]
                if self.nav and abs(dx) > self.ui.dp(70) and abs(dx) > 2 * abs(dy):
                    self.shift(1 if dx > 0 else -1)
                elif not self._moved:
                    idx = self.renderer.hit(x, y, len(self.series[0]))
                    if idx is not None and self.on_tap is not None:
                        self.on_tap(idx)
        return True

    def _start_scrub(self, tok, v):
        if tok != self._tok or self._moved or not self.alive:
            return
        idx = self.renderer.hit(self._down[0], self._down[1], len(self.series[0]))
        if idx is None:
            return
        self._scrub = True
        self.sel = idx
        try:
            v.performHapticFeedback(0)
            v.getParent().requestDisallowInterceptTouchEvent(True)
        except Exception:
            pass
        self.draw(1.0, tip=True)

    def bar_rect(self, i):
        vals = self.series[0]
        n = len(vals)
        loc = jarray(jint)([0, 0])
        self.image.getLocationOnScreen(loc)
        d = self.renderer.d
        if self.renderer.style == "donut":
            mx_, my_ = self.renderer.donut_mid(i)
            return (loc[0] + mx_ - 8 * d, loc[1] + my_ - 8 * d, loc[0] + mx_ + 8 * d, loc[1] + my_ + 8 * d)
        left, right, top, bottom = self.renderer.bounds()
        slot = (right - left) / n
        bw = slot * (0.62 if n <= 12 else 0.7)
        mx = max(vals) or 1.0
        hh = max((vals[i] / mx) * (bottom - top), 2.5 * d)
        x0 = loc[0] + left + i * slot + (slot - bw) / 2.0
        return (x0, loc[1] + bottom - hh, x0 + bw, loc[1] + bottom)

    def draw(self, progress, tip=False):
        title, vals, labels, buckets, maxoff = self.get_series(self.mode, self.offset)
        self.maxoff = maxoff
        self.series = (vals, labels, buckets)
        names = [(buckets[i]["label"] if i < len(buckets) else labels[i]) for i in range(len(vals))]
        self.title_tv.setText(title)
        self.left.setAlpha(1.0 if self.offset < self.maxoff else 0.25)
        self.right.setAlpha(1.0 if self.offset > 0 else 0.25)
        self.renderer.draw(vals, labels, self.pal, progress, self.sel, names, tip or self._scrub)
        self.image.invalidate()

    def animate(self):
        ValueAnimator = jclass("android.animation.ValueAnimator")
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        if self.anim is not None:
            try:
                self.anim.cancel()
            except Exception:
                pass
        anim = ValueAnimator.ofFloat(jarray(jfloat)([0.0, 1.0]))
        anim.setDuration(700)
        anim.setInterpolator(Decelerate(1.2))
        anim.addUpdateListener(_AnimListener(lambda v: self.alive and self.draw(v)))
        self.anim = anim
        anim.start()

    def running(self):
        try:
            return self.anim is not None and self.anim.isRunning()
        except Exception:
            return False

    def shift(self, delta):
        if not self.nav:
            return
        new = min(max(self.offset + delta, 0), self.maxoff)
        if new == self.offset:
            return
        self.offset = new
        self.sel = -1
        self.animate()

    def select_mode(self, mode):
        self.mode = mode
        self.offset = 0
        self.sel = -1
        self.animate()
        if self.on_mode is not None:
            self.on_mode()

    def stop(self):
        self.alive = False
        self._tok += 1
        try:
            if self.anim is not None:
                self.anim.cancel()
        except Exception:
            pass


class HeatBox:
    def __init__(self, ui, pal, card, width, get_snap, on_day):
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        self.ui, self.pal, self.get_snap, self.on_day = ui, pal, get_snap, on_day
        self.mode = "cal"
        self.sel_day = None
        self.pills = Pills(ui, pal, card, (("cal", "Календарь"), ("grid", "Час × день недели")), "cal",
                           self.select, 13)
        self.renderer = HeatRenderer(width, ui.d)
        self.image = ImageView(ui.act)
        self.image.setScaleType(ImageScale.FIT_XY)
        self.image.setImageBitmap(self.renderer.bmp)
        self.image.setOnTouchListener(_Touch(self._touch))
        card.addView(self.image, ui.lp(width, self.renderer.h, t=10))
        self.caption = ui.text("", 12, pal["gray"])
        card.addView(self.caption, ui.lp(-2, -2, t=6))
        self._down = (0.0, 0.0)

    def select(self, mode):
        self.mode = mode
        self.sel_day = None
        self.redraw()

    def redraw(self):
        snap = self.get_snap()
        if not snap:
            return
        today = local_day(snap["now"])
        if self.mode == "cal":
            self.renderer.draw_calendar(snap["daily"], today, self.pal, self.sel_day)
            if self.sel_day is not None:
                self.caption.setText("%s: %s" % (day_label_d(self.sel_day),
                                                 fmt_smart(snap["daily"].get(self.sel_day, 0.0))))
            else:
                self.caption.setText("Нажми на день, чтобы увидеть треки за него")
        else:
            peak = self.renderer.draw_grid(snap["dh"], self.pal)
            if peak:
                self.caption.setText("Пик: %s, %02d:00–%02d:00" % (WDAYS_PLURAL[peak[0]].lower(), peak[1],
                                                                  (peak[1] + 1) % 24))
            else:
                self.caption.setText("Пока нет данных")
        self.image.invalidate()

    def _touch(self, v, ev):
        a = int(ev.getAction())
        if a == 0:
            self._down = (float(ev.getX()), float(ev.getY()))
            return True
        if a == 1 and self.mode == "cal":
            x, y = float(ev.getX()), float(ev.getY())
            slop = self.ui.dp(12)
            if abs(x - self._down[0]) < slop and abs(y - self._down[1]) < slop:
                snap = self.get_snap()
                if snap:
                    day = self.renderer.day_at(x, y, local_day(snap["now"]))
                    if day is not None:
                        self.sel_day = day
                        self.redraw()
                        self.on_day(day)
        return True


def make_meter_row(act, ui, pal, box, rank, title, subtitle, value, share, on_click=None):
    dp, lp, text = ui.dp, ui.lp, ui.text
    wrap = ui.vbox()
    wrap.setPadding(0, dp(7), 0, dp(7))
    row = ui.hbox()
    row.setGravity(16)
    rk = text(str(rank), 15, pal["accent"], True)
    rk.setMinWidth(dp(26))
    row.addView(rk, lp(-2, -2))
    mid = ui.vbox()
    mid.addView(text(title, 15, pal["text"], True, single=True))
    if subtitle:
        mid.addView(text(subtitle, 12.5, pal["gray"], single=True))
    row.addView(mid, lp(0, -2, 1.0, l=4, r=8))
    row.addView(text(value, 13, pal["gray"], True), lp(-2, -2))
    wrap.addView(row)
    share = max(0.03, min(1.0, share))
    meter = ui.hbox()
    meter.setWeightSum(1.0)
    fill = View(act)
    fill.setBackground(ui.rounded(pal["accent"], 2))
    meter.addView(fill, lp(0, dp(3), share))
    if share < 1.0:
        meter.addView(View(act), lp(0, dp(3), 1.0 - share))
    wrap.addView(meter, lp(-1, dp(3), t=6, l=30))
    if on_click is not None:
        wrap.setOnClickListener(_Click(on_click))
    box.addView(wrap)


def render_recap(snap, period, pal, cover_of):
    Bitmap, Config, Canvas, Paint, RectF = _bitmap_classes()
    Align = jclass("android.graphics.Paint$Align")
    Typeface = jclass("android.graphics.Typeface")
    LinearGradient = jclass("android.graphics.LinearGradient")
    TileMode = jclass("android.graphics.Shader$TileMode")
    BitmapFactory = jclass("android.graphics.BitmapFactory")
    W, H, PAD = 1080, 1920, 72
    bmp = Bitmap.createBitmap(W, H, Config.ARGB_8888)
    c = Canvas(bmp)
    p = Paint()
    p.setAntiAlias(True)
    black = hex_color("#000000")
    white = hex_color("#FFFFFF")
    acc = pal["accent"]
    p.setShader(LinearGradient(0.0, 0.0, 0.0, float(H), jint(mix(acc, black, 0.45)), jint(mix(acc, black, 0.9)),
                               TileMode.CLAMP))
    c.drawRect(0.0, 0.0, float(W), float(H), p)
    p.setShader(None)

    def T(txt, x, y, size, alpha=255, bold=False, align=Align.LEFT, maxw=None):
        p.setTypeface(Typeface.DEFAULT_BOLD if bold else Typeface.DEFAULT)
        p.setTextSize(float(size))
        p.setTextAlign(align)
        p.setColor(jint(with_alpha(white, alpha)))
        txt = str(txt)
        if maxw:
            while len(txt) > 1 and p.measureText(txt) > maxw:
                txt = txt[:-2] + "…"
        c.drawText(txt, float(x), float(y), p)

    T("ИТОГИ · " + PERIOD_TITLES.get(period, period).upper(), PAD, 140, 40, 190, True)
    T(fmt_recap(snap["p_total"]), PAD, 320, 150, 255, True)
    tr = trend_info(snap["p_total"], snap.get("p_prev"))
    T("прослушано" + (("  ·  %s к %s" % (tr[0], PERIOD_PREV.get(period, ""))) if tr else ""), PAD, 392, 38, 200)

    stats = [(str(snap["plays"] or "—"), "прослушиваний"), (str(snap["p_tracks"]), "треков"),
             (str(snap["p_artists"]), "исполнителей")]
    colw = (W - 2 * PAD) / 3.0
    for i, (v, cap) in enumerate(stats):
        T(v, PAD + i * colw, 520, 64, 255, True)
        T(cap, PAD + i * colw, 566, 32, 170)

    T("ТОП ТРЕКОВ", PAD, 690, 34, 170, True)
    y = 730
    for i, (a, t, s) in enumerate(snap["top_tracks"][:5], 1):
        T(str(i), PAD, y + 82, 56, 255, True)
        cp = cover_of(a, t)
        size = 120
        x0 = PAD + 70
        drawn = False
        if cp:
            try:
                src = BitmapFactory.decodeFile(cp)
                if src is not None:
                    c.drawBitmap(round_bitmap(src, size, 22.0), float(x0), float(y), None)
                    drawn = True
            except Exception as e:
                log("recap cover error: %r" % (e,))
        if not drawn:
            c.drawBitmap(placeholder_bitmap(size, 22.0, pal), float(x0), float(y), None)
        T(t, x0 + size + 28, y + 54, 44, 255, True, maxw=W - PAD - (x0 + size + 28) - 170)
        T(a, x0 + size + 28, y + 100, 34, 175, maxw=W - PAD - (x0 + size + 28) - 170)
        T(fmt_smart(s), W - PAD, y + 76, 36, 220, True, Align.RIGHT)
        y += 150

    T("ТОП ИСПОЛНИТЕЛЕЙ", PAD, 1560, 34, 170, True)
    yy = 1620
    for i, (a, s) in enumerate(snap["top_artists"][:3], 1):
        T("%d. %s" % (i, a), PAD, yy, 44, 255, True, maxw=W - 2 * PAD - 220)
        T(fmt_smart(s), W - PAD, yy, 38, 200, False, Align.RIGHT)
        yy += 64

    foot = []
    if snap["streak"] > 1:
        foot.append("стрик %d дн" % snap["streak"])
    foot.append("Femboy Music Stats")
    T("  ·  ".join(foot), W / 2.0, 1866, 30, 150, False, Align.CENTER)
    return bmp


# ───────────────────────── UI-кит ─────────────────────────

class UIKit:
    def __init__(self, act):
        self.act = act
        self.d = float(act.getResources().getDisplayMetrics().density)
        self.LinearLayout = jclass("android.widget.LinearLayout")
        self.TextView = jclass("android.widget.TextView")
        self.GradientDrawable = jclass("android.graphics.drawable.GradientDrawable")
        self.TruncateAt = jclass("android.text.TextUtils$TruncateAt")

    def dp(self, x):
        return int(x * self.d)

    def lp(self, w, h, weight=None, l=0, t=0, r=0, b=0):
        LP = self.LinearLayout.LayoutParams
        p = LP(w, h) if weight is None else LP(w, h, float(weight))
        p.setMargins(self.dp(l), self.dp(t), self.dp(r), self.dp(b))
        return p

    def text(self, txt, size, color, bold=False, single=False):
        tv = self.TextView(self.act)
        tv.setText(txt)
        tv.setTextSize(float(size))
        tv.setTextColor(jint(color))
        if bold:
            tv.setTypeface(tv.getTypeface(), 1)
        if single:
            tv.setMaxLines(1)
            tv.setEllipsize(self.TruncateAt.END)
        return tv

    def vbox(self):
        b = self.LinearLayout(self.act)
        b.setOrientation(self.LinearLayout.VERTICAL)
        return b

    def hbox(self):
        b = self.LinearLayout(self.act)
        b.setOrientation(self.LinearLayout.HORIZONTAL)
        return b

    def rounded(self, color, radius):
        gd = self.GradientDrawable()
        gd.setColor(jint(color))
        gd.setCornerRadius(float(self.dp(radius)))
        return gd


class Win:
    pass


def make_fullscreen_dialog(act, pal):
    Dialog = jclass("android.app.Dialog")
    RStyle = jclass("android.R$style")
    ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
    dlg = Dialog(act, RStyle.Theme_DeviceDefault_NoActionBar)
    try:
        win = dlg.getWindow()
        win.setLayout(-1, -1)
        win.setBackgroundDrawable(ColorDrawable(jint(pal["page"])))
        win.setStatusBarColor(jint(pal["bar"]))
        win.setNavigationBarColor(jint(pal["page"]))
        flags = 0
        if luminance(pal["bar"]) > 0.6:
            flags |= 0x2000
        if luminance(pal["page"]) > 0.6:
            flags |= 0x10
        win.getDecorView().setSystemUiVisibility(jint(flags))
    except Exception as e:
        log("window setup error: %r" % (e,))
    return dlg


def setup_window(act, pal, title):
    w = Win()
    ui = UIKit(act)
    dp = ui.dp
    w.ui = ui
    w.dlg = make_fullscreen_dialog(act, pal)
    w.root = ui.vbox()
    w.root.setBackgroundColor(jint(pal["page"]))
    w.bar = ui.hbox()
    w.bar.setBackgroundColor(jint(pal["bar"]))
    w.bar.setGravity(16)
    back = ui.text("←", 26, pal["bar_text"], True)
    back.setPadding(dp(18), dp(12), dp(18), dp(12))
    back.setOnClickListener(_Click(lambda: w.dlg.dismiss()))
    w.bar.addView(back, ui.lp(-2, -2))
    w.title_tv = ui.text(title, 20, pal["bar_text"], True, single=True)
    w.bar.addView(w.title_tv, ui.lp(0, -2, 1.0))
    w.root.addView(w.bar, ui.lp(-1, dp(56)))
    w.cbs = []

    def on_insets(top, bottom):
        w.bar.setPadding(0, top, 0, 0)
        p = w.bar.getLayoutParams()
        p.height = dp(56) + top
        w.bar.setLayoutParams(p)
        for cb in w.cbs:
            try:
                cb(top, bottom)
            except Exception as e:
                log("inset callback error: %r" % (e,))

    w.root.setOnApplyWindowInsetsListener(_Insets(on_insets))
    try:
        w.root.requestApplyInsets()
    except Exception:
        pass
    return w


class Screen:
    def __init__(self, plugin, title, transparent=False):
        act = plugin._activity()
        if act is None:
            raise RuntimeError("не найдено окно приложения")
        self.act = act
        self.pal = get_palette()
        self.win = setup_window(act, self.pal, title)
        self.ui, self.dlg, self.root = self.win.ui, self.win.dlg, self.win.root
        self.dp, self.lp, self.text = self.ui.dp, self.ui.lp, self.ui.text
        Handler = jclass("android.os.Handler")
        Looper = jclass("android.os.Looper")
        self.handler = Handler(Looper.getMainLooper())
        self.alive = True
        self.cards = []
        self.on_dismiss = None
        if transparent:
            try:
                ColorDrawable = jclass("android.graphics.drawable.ColorDrawable")
                self.dlg.getWindow().setBackgroundDrawable(ColorDrawable(jint(0)))
            except Exception as e:
                log("transparent window error: %r" % (e,))
        self.scroll = jclass("android.widget.ScrollView")(act)
        self.scroll.setVerticalScrollBarEnabled(False)
        self.content = self.ui.vbox()
        self.content.setPadding(self.dp(12), self.dp(12), self.dp(12), self.dp(20))
        self.scroll.addView(self.content)
        self.root.addView(self.scroll, self.lp(-1, 0, 1.0))
        self.win.cbs.append(
            lambda t, b: self.content.setPadding(self.dp(12), self.dp(12), self.dp(12), self.dp(20) + b))
        self.dlg.setOnDismissListener(_Dismiss(self._dismiss))

    def card(self, pad=16):
        c = self.ui.vbox()
        c.setBackground(self.ui.rounded(self.pal["card"], 16))
        c.setPadding(self.dp(pad), self.dp(pad), self.dp(pad), self.dp(pad))
        self.cards.append(c)
        return c

    def add(self, view, lp=None):
        self.content.addView(view, lp if lp is not None else self.lp(-1, -2, b=12))
        return view

    def pill(self, label, fn, size=13):
        tv = self.text(label, size, self.pal["accent"], True)
        tv.setBackground(self.ui.rounded(with_alpha(self.pal["accent"], 40), 12))
        tv.setPadding(self.dp(14), self.dp(8), self.dp(14), self.dp(8))
        tv.setOnClickListener(_Click(fn))
        return tv

    def header_button(self, label, fn):
        btn = self.text(label, 20, self.pal["bar_text"], True)
        btn.setPadding(self.dp(14), self.dp(10), self.dp(14), self.dp(10))
        btn.setOnClickListener(_Click(fn))
        self.win.bar.addView(btn, self.ui.lp(-2, -2, r=6))
        return btn

    def ticker(self, fn, delay=1000):
        def step():
            if not self.alive:
                return
            try:
                fn()
            except Exception as e:
                log("tick error: %r" % (e,))
            self.handler.postDelayed(_Run(step), delay)

        self.handler.postDelayed(_Run(step), delay)

    def show(self):
        self.dlg.setContentView(self.root)
        self.dlg.show()
        self.win.bar.setAlpha(0.0)
        self.win.bar.animate().alpha(1.0).setDuration(250).start()
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        for i, c in enumerate(self.cards):
            c.setAlpha(0.0)
            c.setTranslationY(float(self.dp(28)))
            c.animate().alpha(1.0).translationY(0.0).setStartDelay(60 * i + 80).setDuration(420) \
                .setInterpolator(Decelerate(2.0)).start()

    def _dismiss(self):
        self.alive = False
        try:
            self.handler.removeCallbacksAndMessages(None)
        except Exception:
            pass
        if self.on_dismiss is not None:
            try:
                self.on_dismiss()
            except Exception as e:
                log("dismiss error: %r" % (e,))


# ───────────────────────── Раскладка интерфейса ─────────────────────────

TAB_NAMES = ("Обзор", "Графики", "Топы")
SIZE_LABELS = {1: "S", 2: "M", 3: "L"}
CHART_HEIGHTS_DP = {1: 170, 2: 220, 3: 280}
LIST_ROWS = {1: 3, 2: 5, 3: 8}

WIDGET_DEFS = {
    "hero":        {"title": "Итого за всё время",        "min_w": 2, "min_h": 1, "max_h": 1},
    "top_track":   {"title": "Самый прослушиваемый трек", "min_w": 2, "min_h": 1, "max_h": 1},
    "now":         {"title": "Сейчас играет",             "min_w": 1, "min_h": 1, "max_h": 1},
    "overview":    {"title": "Обзор периода",             "min_w": 2, "min_h": 1, "max_h": 2},
    "chart":       {"title": "График",                    "min_w": 2, "min_h": 1, "max_h": 3},
    "heat":        {"title": "Календарь активности",      "min_w": 2, "min_h": 1, "max_h": 1},
    "top_tracks":  {"title": "Топ треков",                "min_w": 1, "min_h": 1, "max_h": 3},
    "top_artists": {"title": "Топ исполнителей",          "min_w": 1, "min_h": 1, "max_h": 3},
    "sources":     {"title": "Откуда слушаешь",           "min_w": 1, "min_h": 1, "max_h": 2},
}
DEFAULT_LAYOUT = [
    {"id": "hero", "vis": True, "tab": 0, "w": 2, "h": 1},
    {"id": "top_track", "vis": True, "tab": 0, "w": 2, "h": 1},
    {"id": "now", "vis": True, "tab": 0, "w": 2, "h": 1},
    {"id": "overview", "vis": True, "tab": 0, "w": 2, "h": 2},
    {"id": "chart", "vis": True, "tab": 1, "w": 2, "h": 2},
    {"id": "heat", "vis": True, "tab": 1, "w": 2, "h": 1},
    {"id": "top_tracks", "vis": True, "tab": 2, "w": 2, "h": 3},
    {"id": "top_artists", "vis": True, "tab": 2, "w": 2, "h": 3},
    {"id": "sources", "vis": True, "tab": 2, "w": 2, "h": 2},
]


def default_layout():
    return [dict(x) for x in DEFAULT_LAYOUT]


def min_size_text(wid):
    d = WIDGET_DEFS[wid]
    parts = ["вся ширина" if d["min_w"] == 2 else "½ ширины"]
    parts.append("размер " + SIZE_LABELS[d["min_h"]] if d["max_h"] > 1 else "размер фиксирован")
    return "минимум: " + ", ".join(parts)


def normalize_layout(raw):
    out, seen = [], set()
    if isinstance(raw, list):
        for it in raw:
            try:
                wid = it["id"]
                d = WIDGET_DEFS.get(wid)
                if d is None or wid in seen:
                    continue
                seen.add(wid)
                w = max(2 if int(it.get("w", 2)) >= 2 else 1, d["min_w"])
                h = min(max(int(it.get("h", d["max_h"])), d["min_h"]), d["max_h"])
                tab = min(max(int(it.get("tab", 0)), 0), len(TAB_NAMES) - 1)
                out.append({"id": wid, "vis": bool(it.get("vis", True)), "tab": tab, "w": w, "h": h})
            except Exception:
                continue
    for dflt in DEFAULT_LAYOUT:
        if dflt["id"] not in seen:
            out.append(dict(dflt))
    return out


# ───────────────────────── Окно статистики из виджетов ─────────────────────────

class StatsWindow:
    def __init__(self, plugin, snap):
        self.p = plugin
        self.scr = Screen(plugin, "Музыка в Telegram")
        scr = self.scr
        self.ui, self.pal, self.dp, self.lp, self.text = scr.ui, scr.pal, scr.dp, scr.lp, scr.text
        self.act = scr.act
        self.store = plugin.store
        self.screen_w = int(self.act.getResources().getDisplayMetrics().widthPixels)
        self.state = {"snap": snap, "busy": False, "ticks": 0, "f": 0.0, "period": snap["period"]}
        self.snap_cbs, self.tick_cbs = [], []
        self.charts = []
        self.tab_cbs = {}
        self.pages = {}
        self.shown_tabs = set()
        self.alive = True
        self.mode = plugin.ui_mode()
        self.layout = plugin.load_layout()
        self.pills_in_overview = False
        self._placing_tab = -1
        self.current_tab = -1
        self._build()

    def _build(self):
        scr, ui, pal, dp, lp = self.scr, self.ui, self.pal, self.dp, self.lp
        vis = [c for c in self.layout if c["vis"]]
        used_tabs = [i for i in range(len(TAB_NAMES)) if any(c["tab"] == i for c in vis)]
        tabbed = self.mode == "tabs" and len(used_tabs) > 1
        has_overview = any(c["id"] == "overview" for c in vis)
        self.pills_in_overview = (not tabbed) and has_overview

        scr.header_button("✎", self._open_editor)
        scr.header_button("⇄", self._toggle_mode)

        idx = 1
        if tabbed:
            tb = ui.vbox()
            tb.setPadding(dp(12), dp(8), dp(12), dp(0))
            start = self.p.stats_tab if self.p.stats_tab in used_tabs else used_tabs[0]
            self.tab_pills = Pills(ui, pal, tb, [(i, TAB_NAMES[i]) for i in used_tabs],
                                   start, self._on_tab, 13.5)
            scr.root.addView(tb, idx, lp(-1, -2))
            idx += 1
        if tabbed or not self.pills_in_overview:
            pb = ui.vbox()
            pb.setPadding(dp(12), dp(8), dp(12), dp(4))
            Pills(ui, pal, pb, PERIODS, self.state["period"], self._on_period, 12.5)
            scr.root.addView(pb, idx, lp(-1, -2))

        if not vis:
            scr.add(self.text("Все виджеты скрыты. Открой редактор (✎) и включи нужные.", 14, pal["gray"]),
                    lp(-1, -2, t=40))
        elif tabbed:
            first = self.tab_pills.mode
            for i in used_tabs:
                page = ui.vbox()
                page.setVisibility(0 if i == first else 8)
                scr.add(page, lp(-1, -2))
                self.pages[i] = page
                self._place(page, [c for c in vis if c["tab"] == i], i)
            self.current_tab = first
            self.shown_tabs.add(first)
        else:
            page = ui.vbox()
            scr.add(page, lp(-1, -2))
            self.pages[-1] = page
            self._place(page, vis, -1)
            self.current_tab = -1
            self.shown_tabs.add(-1)

        scr.on_dismiss = self._on_dismiss
        self._apply(self.state["snap"])
        for ch in self.charts:
            ch.draw(0.0)
        scr.show()
        self._start_count_animation()
        self.scr.handler.postDelayed(_Run(self._first_show), 350)
        scr.ticker(self._tick)

    def _first_show(self):
        if self.alive:
            for fn in self.tab_cbs.get(self.current_tab, []):
                fn()

    def _on_tab(self, i):
        self.p.stats_tab = i
        for k, page in self.pages.items():
            page.setVisibility(0 if k == i else 8)
        self.current_tab = i
        try:
            self.scr.scroll.scrollTo(0, 0)
        except Exception:
            pass
        if i not in self.shown_tabs:
            self.shown_tabs.add(i)
            for fn in self.tab_cbs.get(i, []):
                fn()

    def _open_editor(self):
        self.scr.dlg.dismiss()
        self.p.open_layout_editor(True)

    def _toggle_mode(self):
        self.p.set_setting("ui_classic", self.mode == "tabs")
        self.scr.dlg.dismiss()
        self.p.open_stats()

    def _on_dismiss(self):
        self.alive = False
        for ch in self.charts:
            ch.stop()

    def _place(self, page, items, tab_id=-1):
        self._placing_tab = tab_id
        dp, lp = self.dp, self.lp
        full_w = self.screen_w - dp(24)
        half_w = (full_w - dp(8)) // 2
        i = 0
        while i < len(items):
            cfg = items[i]
            nxt = items[i + 1] if i + 1 < len(items) else None
            if cfg["w"] == 1 and nxt is not None and nxt["w"] == 1:
                row = self.ui.hbox()
                row.setBaselineAligned(False)
                row.setWeightSum(2.0)
                row.addView(self._build_widget(cfg, half_w, True), lp(0, -2, 1.0, r=4))
                row.addView(self._build_widget(nxt, half_w, True), lp(0, -2, 1.0, l=4))
                page.addView(row, lp(-1, -2, b=12))
                i += 2
            else:
                page.addView(self._build_widget(cfg, full_w, False), lp(-1, -2, b=12))
                i += 1

    def _build_widget(self, cfg, W, half):
        fn = getattr(self, "w_" + cfg["id"])
        return fn(W, cfg["h"], half)

    def _apply(self, s):
        self.state["snap"] = s
        for cb in list(self.snap_cbs):
            try:
                cb(s)
            except Exception:
                log("widget update error: " + traceback.format_exc())

    def _on_period(self, p):
        self.state["period"] = p
        self.p.stats_period = p

        def work():
            try:
                s = self.store.snapshot(p)
                run_on_ui_thread(lambda: self.alive and self.state["period"] == p and self._apply(s))
            except Exception as e:
                log("period switch error: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def _refresh(self):
        if self.state["busy"] or not self.alive:
            return
        self.state["busy"] = True

        def work():
            try:
                s = self.store.snapshot(self.state["period"])
                if s is not self.state["snap"]:
                    run_on_ui_thread(lambda: self.alive and s["period"] == self.state["period"] and self._apply(s))
            except Exception as e:
                log("refresh error: %r" % (e,))
            finally:
                self.state["busy"] = False

        threading.Thread(target=work, daemon=True).start()

    def _tick(self):
        if not self.alive:
            return
        self.state["ticks"] += 1
        for cb in list(self.tick_cbs):
            try:
                cb()
            except Exception as e:
                log("tick widget error: %r" % (e,))
        if self.state["ticks"] % 3 == 0:
            self._refresh()

    def _start_count_animation(self):
        ValueAnimator = jclass("android.animation.ValueAnimator")
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        count = ValueAnimator.ofFloat(jarray(jfloat)([0.0, 1.0]))
        count.setDuration(1100)
        count.setInterpolator(Decelerate(2.0))

        def on_count(v):
            self.state["f"] = v
            if self.alive:
                for cb in list(self.tick_cbs):
                    try:
                        cb()
                    except Exception:
                        pass

        count.addUpdateListener(_AnimListener(on_count))
        count.start()

    def _live_delta(self):
        return max(0.0, self.store.added - self.state["snap"]["added_at"])

    def _tab_of_current(self):
        return getattr(self, "_placing_tab", -1)

    # ───────── виджеты ─────────
    def w_hero(self, W, hl, half):
        ui, pal, lp, text, act = self.ui, self.pal, self.lp, self.text, self.act
        c = self.scr.card()
        c.addView(text("Всего прослушано", 13, pal["gray"]))
        total_tv = text("0с", 34, pal["accent"], True)
        c.addView(total_tv, lp(-2, -2, t=2))
        tracks_tv = text("", 13, pal["gray"])
        c.addView(tracks_tv, lp(-2, -2, t=2))
        sep = View(act)
        sep.setBackgroundColor(jint(pal["divider"]))
        c.addView(sep, lp(-1, 1, t=14, b=12))
        row = ui.hbox()
        vals = {}
        for key, cap in (("today", "Сегодня"), ("week", "7 дней"), ("month", "30 дней")):
            col = ui.vbox()
            v = text("0с", 17, pal["text"], True)
            col.addView(v)
            col.addView(text(cap, 12, pal["gray"]))
            vals[key] = v
            row.addView(col, lp(0, -2, 1.0))
        c.addView(row)

        def live():
            s = self.state["snap"]
            d, f = self._live_delta(), self.state["f"]
            total_tv.setText(fmt_hms((s["total"] + d) * f))
            vals["today"].setText(fmt_hms((s["today"] + d) * f))
            vals["week"].setText(fmt_dur((s["week"] + d) * f))
            vals["month"].setText(fmt_dur((s["month"] + d) * f))
            tracks_tv.setText("уникальных треков: %d" % s["tracks"])

        self.tick_cbs.append(live)
        self.snap_cbs.append(lambda s: live())
        return c

    def w_top_track(self, W, hl, half):
        ui, pal, dp, lp, text, act = self.ui, self.pal, self.dp, self.lp, self.text, self.act
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        BitmapFactory = jclass("android.graphics.BitmapFactory")
        BitmapDrawable = jclass("android.graphics.drawable.BitmapDrawable")
        c = self.scr.card()
        row = ui.hbox()
        row.setGravity(16)
        size = dp(92)
        iv = ImageView(act)
        iv.setScaleType(ImageScale.FIT_XY)
        row.addView(iv, lp(size, size, r=14))
        col = ui.vbox()
        label = text("Самый прослушиваемый трек", 12, pal["gray"])
        col.addView(label)
        title = text("—", 18, pal["text"], True)
        title.setMaxLines(2)
        title.setEllipsize(ui.TruncateAt.END)
        col.addView(title, lp(-2, -2, t=3))
        artist = text("", 14, pal["gray"], single=True)
        col.addView(artist)
        tm = text("", 14, pal["accent"], True)
        col.addView(tm, lp(-2, -2, t=4))
        row.addView(col, lp(0, -2, 1.0))
        c.addView(row)
        sig = {"v": None}

        def open_top():
            tt = self.state["snap"]["top_tracks"]
            if tt:
                self.p.open_track_stats(tt[0][0], tt[0][1])

        c.setOnClickListener(_Click(open_top))

        def on_snap(s):
            label.setText("Самый прослушиваемый трек · " + PERIOD_TITLES[s["period"]])
            path, exists = None, False
            if s["top_tracks"]:
                a, t, secs = s["top_tracks"][0]
                title.setText(t)
                artist.setText(a)
                tm.setText("прослушано %s" % fmt_dur(secs))
                path = self.store.cover_path(a, t)
                exists = os.path.exists(path)
                key = (a, t, exists)
            else:
                title.setText("Пока нет данных")
                artist.setText("")
                tm.setText("")
                key = ("none",)
            if sig["v"] == key:
                return
            sig["v"] = key
            bmp, bg = None, None
            if exists:
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, size, float(dp(14)))
                        bg = BitmapDrawable(act.getResources(),
                                            blurred_card_bitmap(src, W, dp(124), dp(16), self.pal["card"], 200))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(size, float(dp(14)), pal)
            iv.setImageBitmap(bmp)
            c.setBackground(bg if bg is not None else ui.rounded(pal["card"], 16))

        self.snap_cbs.append(on_snap)
        return c

    def w_now(self, W, hl, half):
        ui, pal, lp, text = self.ui, self.pal, self.lp, self.text
        c = self.scr.card()
        row = ui.hbox()
        row.setGravity(16)
        dot = text("●", 16, pal["accent"])
        row.addView(dot, lp(-2, -2, r=12))
        col = ui.vbox()
        np_title = text("Ничего не играет", 16, pal["text"], True, single=True)
        np_artist = text("Включи музыку в Telegram", 13, pal["gray"], single=True)
        col.addView(np_title)
        col.addView(np_artist)
        row.addView(col, lp(0, -2, 1.0))
        c.addView(row)
        btns = ui.vbox() if half else ui.hbox()
        for label, fn in (("Текст песни", lambda: self.p.open_lyrics()),
                          ("Статистика трека", lambda: self.p.open_current_track_stats()),
                          ("Итоги", lambda: self.p.open_recap(self.state["period"]))):
            if half:
                btns.addView(self.scr.pill(label, fn), lp(-2, -2, b=6))
            else:
                btns.addView(self.scr.pill(label, fn), lp(-2, -2, r=8))
        c.addView(btns, lp(-2, -2, t=12))

        def live():
            s = self.state["snap"]
            np = self.p.now_playing
            if np:
                np_title.setText(np[1])
                np_artist.setText(np[0])
            elif self.p.cur:
                np_title.setText(self.p.cur[1])
                np_artist.setText("На паузе · " + self.p.cur[0])
            else:
                np_title.setText("Ничего не играет")
                np_artist.setText("Последний: %s — %s" % (s["last"][0], s["last"][1]) if s["last"]
                                  else "Включи музыку в Telegram")
            try:
                dot.animate().alpha((0.25 if self.state["ticks"] % 2 else 1.0) if np else 0.25).setDuration(800).start()
            except Exception:
                pass

        self.tick_cbs.append(live)
        self.snap_cbs.append(lambda s: live())
        return c

    def w_overview(self, W, hl, half):
        ui, pal, lp, text = self.ui, self.pal, self.lp, self.text
        c = self.scr.card()
        c.addView(text("Обзор", 17, pal["text"], True), lp(-2, -2, b=8))
        if self.pills_in_overview:
            Pills(ui, pal, c, PERIODS, self.state["period"], self._on_period, 12.5)

        def tile_row():
            row = ui.hbox()
            c.addView(row, lp(-1, -2, t=14))
            out = []
            for _ in range(3):
                col = ui.vbox()
                v = text("—", 17, pal["text"], True)
                cap = text("", 12, pal["gray"])
                sub = text("", 11.5, pal["gray"], True)
                col.addView(v)
                col.addView(cap)
                col.addView(sub)
                row.addView(col, lp(0, -2, 1.0))
                out.append((v, cap, sub))
            return out

        row1 = tile_row()
        row2 = tile_row() if hl >= 2 else None
        extra = ui.vbox()
        if hl >= 2:
            c.addView(extra, lp(-1, -2, t=12))

        def fill(s):
            per = s["period"]
            tr = trend_info(s["p_total"], s.get("p_prev"))
            v, cp, sb = row1[0]
            v.setText(fmt_smart(s["p_total"] + self._live_delta()))
            cp.setText("время")
            if tr:
                sb.setText("%s к %s" % (tr[0], PERIOD_PREV.get(per, "")))
                sb.setTextColor(jint(COLOR_UP if tr[1] else (COLOR_DOWN if tr[1] is False else pal["gray"])))
            else:
                sb.setText("")
            v, cp, sb = row1[1]
            v.setText(str(s["plays"]))
            cp.setText("прослушиваний")
            sb.setText("≥30 с или половина трека")
            v, cp, sb = row1[2]
            v.setText(str(s["skips"]))
            cp.setText("пропусков")
            ts = s["plays"] + s["skips"]
            sb.setText("%d%% сеансов" % round(s["skips"] * 100.0 / ts) if ts else "")
            if row2 is None:
                return
            v, cp, sb = row2[0]
            if per == "all":
                v.setText(str(s["tracks"]))
                cp.setText("уникальных треков")
                sb.setText("исполнителей: %d" % s["p_artists"])
            else:
                v.setText("+%d" % (s["new_tracks"] or 0))
                cp.setText("новых треков")
                sb.setText("новых исполнителей: %d" % (s["new_artists"] or 0))
            v, cp, sb = row2[1]
            v.setText("%d дн" % s["streak"])
            cp.setText("стрик")
            bd = s["best_day"]
            sb.setText("рекорд дня: %s" % fmt_smart(bd[1]) if bd else "")
            v, cp, sb = row2[2]
            v.setText(fmt_smart(s["longest"]) if s["longest"] else "—")
            cp.setText("макс. сеанс")
            sb.setText("в среднем %s/день" % fmt_smart(s["avg_day"]) if s["avg_day"] else "")
            extra.removeAllViews()
            if s["stuck"]:
                extra.addView(text("Залипание: %s — %s (×%d)" % (s["stuck"][0], s["stuck"][1], s["stuck"][2]),
                                   13, pal["gray"]), lp(-1, -2, t=4))
            if s["skipped"]:
                extra.addView(text("Чаще всего пропускаешь: " + ", ".join(
                    "%s — %s (×%d)" % (a, t, n) for a, t, n in s["skipped"]), 13, pal["gray"]), lp(-1, -2, t=4))

        def live():
            row1[0][0].setText(fmt_smart(self.state["snap"]["p_total"] + self._live_delta()))

        self.snap_cbs.append(fill)
        self.tick_cbs.append(live)
        return c

    def w_chart(self, W, hl, half):
        ui, pal, dp, lp, text = self.ui, self.pal, self.dp, self.lp, self.text
        c = self.scr.card()
        chart = ChartBox(
            ui, pal, self.scr.handler, c,
            (("hour", "Часы"), ("days", "30 дн."), ("weeks", "Нед."), ("month", "Мес."), ("wday", "Пн–Вс")),
            lambda mode, off: build_series(self.state["snap"], mode, off), W - dp(32), dp(CHART_HEIGHTS_DP[hl]), "hour",
            get_style=lambda: "donut" if self.p.chart_donut() else "bars",
            on_style=lambda: self.p.set_chart_donut(not self.p.chart_donut()),
            nav=True, pill_size=12.5,
        )
        c.addView(text("Тап — треки за период · удержание — подсказка · свайп — другой период", 12, pal["gray"]),
                  lp(-2, -2, t=6))
        self.charts.append(chart)

        def select_bar(i):
            vals, labels, buckets = chart.series
            if not (0 <= i < len(vals)):
                return
            chart.sel = i
            if not chart.running():
                chart.draw(1.0)
            try:
                origin = chart.bar_rect(i)
            except Exception as e:
                log("bar rect error: %r" % (e,))
                origin = None
            self.p.open_bucket_breakdown(list(buckets), i, origin)

        chart.on_tap = select_bar

        def on_snap(s):
            if not chart.running():
                chart.draw(1.0)

        self.snap_cbs.append(on_snap)
        self.tab_cbs.setdefault(self._tab_of_current(), []).append(chart.animate)
        return c

    def w_heat(self, W, hl, half):
        pal = self.pal
        c = self.scr.card()

        def on_day(day):
            today = local_day(self.state["snap"]["now"])
            first = heat.renderer.week_of_col(0, today) * 7 - 3
            buckets = [{"kind": "range", "t0": day_start(d), "t1": day_start(d + 1),
                        "label": "%s, %s" % (WDAYS[day_wd(d)], day_label_d(d))} for d in range(first, today + 1)]
            self.p.open_bucket_breakdown(buckets, day - first, None)

        heat = HeatBox(self.ui, pal, c, W - self.dp(32), lambda: self.state["snap"], on_day)
        self.snap_cbs.append(lambda s: heat.redraw())
        return c

    def _top_widget(self, kind, W, hl, half):
        ui, pal, lp, text, act = self.ui, self.pal, self.lp, self.text, self.act
        c = self.scr.card()
        base = {"top_tracks": "Топ треков", "top_artists": "Топ исполнителей", "sources": "Откуда слушаешь"}[kind]
        title = text(base, 17, pal["text"], True)
        c.addView(title, lp(-2, -2, b=6))
        box = ui.vbox()
        c.addView(box)
        if kind != "sources":
            c.addView(self.scr.pill("Показать все · поиск",
                                    lambda: self.p.open_full_list("tracks" if kind == "top_tracks" else "artists",
                                                                  self.state["period"]), 12.5), lp(-2, -2, t=8))
        n = LIST_ROWS[hl]

        def fill(s):
            title.setText("%s · %s" % (base, PERIOD_TITLES[s["period"]]))
            box.removeAllViews()
            if kind == "top_tracks":
                rows = s["top_tracks"][:n]
                if not rows:
                    box.addView(text("Пока нет данных", 14, pal["gray"]))
                    return
                mx = max(r[2] for r in rows) or 1.0
                for i, (a, t, secs) in enumerate(rows, 1):
                    make_meter_row(act, ui, pal, box, i, t, a, fmt_dur(secs), secs / mx,
                                   lambda a=a, t=t: self.p.open_track_stats(a, t))
            elif kind == "top_artists":
                rows = s["top_artists"][:n]
                if not rows:
                    box.addView(text("Пока нет данных", 14, pal["gray"]))
                    return
                mx = max(r[1] for r in rows) or 1.0
                for i, (a, secs) in enumerate(rows, 1):
                    make_meter_row(act, ui, pal, box, i, a, "", fmt_dur(secs), secs / mx,
                                   lambda a=a: self.p.open_artist_breakdown(a))
            else:
                rows = s["sources"][:n]
                if not rows:
                    box.addView(text("Пока нет данных (источники учитываются с версии 3.0)", 13, pal["gray"]))
                    return
                mx = max(r[2] for r in rows) or 1.0
                for i, (sid, name, secs) in enumerate(rows, 1):
                    make_meter_row(act, ui, pal, box, i, name or "Чат %d" % sid, "", fmt_dur(secs), secs / mx)

        self.snap_cbs.append(fill)
        return c

    def w_top_tracks(self, W, hl, half):
        return self._top_widget("top_tracks", W, hl, half)

    def w_top_artists(self, W, hl, half):
        return self._top_widget("top_artists", W, hl, half)

    def w_sources(self, W, hl, half):
        return self._top_widget("sources", W, hl, half)


