# ───────────────────── Родные окна Telegram (AlertDialog) ─────────────────────

def _make_listener(iface_name, fn):
    """Прокси ровно того Java-интерфейса, который ждёт метод билдера Telegram."""
    iface = jclass(iface_name)
    mname = "onClick"
    try:
        ms = jclass("java.lang.Class").forName(iface_name).getMethods()
        for m in ms:
            if not m.isDefault() and not jclass("java.lang.reflect.Modifier").isStatic(m.getModifiers()):
                mname = str(m.getName())
                break
    except Exception:
        pass

    def handler(self, *a):
        try:
            w = 0
            try:
                w = int(a[-1])
            except Exception:
                pass
            fn(w)
        except Exception as e:
            log("dialog listener error: %r" % (e,))

    cls = type("_TgListener", (dynamic_proxy(iface),), {mname: handler})
    return cls()


class _TgBuilder:
    """Обёртка над org.telegram.ui.ActionBar.AlertDialog.Builder."""

    def __init__(self, act):
        self.b = jclass("org.telegram.ui.ActionBar.AlertDialog$Builder")(act)
        self._cls = self.b.getClass()

    @staticmethod
    def _fn(listener):
        f = getattr(listener, "fn", listener)
        if f is None:
            return lambda w: None

        def call(w):
            try:
                f(w)
            except TypeError:
                f()
        return call

    def _listener_for(self, name, listener):
        fn = self._fn(listener)
        for m in self._cls.getMethods():
            if str(m.getName()) != name:
                continue
            pt = m.getParameterTypes()
            if len(pt) == 2 and not pt[1].isPrimitive() and pt[1].isInterface():
                return _make_listener(str(pt[1].getName()), fn)
        return _make_listener("android.content.DialogInterface$OnClickListener", fn)

    def setTitle(self, t):
        self.b.setTitle(t)
        return self

    def setMessage(self, t):
        self.b.setMessage(t)
        return self

    def setView(self, v):
        self.b.setView(v)
        return self

    def setPositiveButton(self, text, listener):
        self.b.setPositiveButton(text, self._listener_for("setPositiveButton", listener))
        return self

    def setNegativeButton(self, text, listener):
        self.b.setNegativeButton(text, self._listener_for("setNegativeButton", listener))
        return self

    def setItems(self, items, listener):
        self.b.setItems(items, self._listener_for("setItems", listener))
        return self

    def show(self):
        return self.b.show()


