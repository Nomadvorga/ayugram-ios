def fmt_dur(s):
    s = int(round(s))
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return "%dч %02dм" % (h, m)
    if m:
        return "%dм" % m
    return "%dс" % sec


def fmt_hms(s):
    s = int(s)
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return "%dч %02dм %02dс" % (h, m, sec)
    if m:
        return "%dм %02dс" % (m, sec)
    return "%dс" % sec


def fmt_smart(s):
    if s >= 86400:
        return ("%.1f" % (s / 86400.0)).replace(".", ",") + " дн"
    if s >= 3600:
        h, m = divmod(int(s) // 60, 60)
        return "%dч %02dм" % (h, m)
    if s < 30:
        return "<1 мин"
    return "%d мин" % min(59, max(1, int(round(s / 60.0))))


def fmt_short(s):
    if s >= 3600:
        return "%.1fч" % (s / 3600.0)
    if s >= 60:
        return "%dм" % int(s // 60)
    return "%dс" % int(s)


def fmt_date(ts):
    return time.strftime("%d.%m.%Y", time.localtime(ts))


def with_alpha(c, a):
    v = ((int(a) & 0xFF) << 24) | (int(c) & 0xFFFFFF)
    return v - (1 << 32) if v >= (1 << 31) else v


def hex_color(h):
    v = int(h.lstrip("#"), 16)
    if len(h.lstrip("#")) <= 6:
        v |= 0xFF000000
    return v - (1 << 32) if v >= (1 << 31) else v


def mix(c1, c2, t):
    a, b = int(c1) & 0xFFFFFF, int(c2) & 0xFFFFFF
    out = 0xFF000000
    for sh in (16, 8, 0):
        x, y = (a >> sh) & 255, (b >> sh) & 255
        out |= int(x + (y - x) * t) << sh
    return out - (1 << 32) if out >= (1 << 31) else out


def luminance(c):
    c = int(c) & 0xFFFFFFFF
    r, g, b = (c >> 16) & 255, (c >> 8) & 255, c & 255
    return (0.299 * r + 0.587 * g + 0.114 * b) / 255.0


def ease_out(x):
    x = max(0.0, min(1.0, x))
    return 1.0 - (1.0 - x) ** 3


# ───────────────────────── Тема ─────────────────────────

def theme_color(name, fallback_hex):
    try:
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        key = getattr(Theme, name)
        return int(Theme.getColor(key))
    except Exception as e:
        log("theme color %s failed: %r" % (name, e))
        return hex_color(fallback_hex)


def get_palette():
    pal = {
        "page": theme_color("key_windowBackgroundGray", "#F0F0F0"),
        "card": theme_color("key_windowBackgroundWhite", "#FFFFFF"),
        "text": theme_color("key_windowBackgroundWhiteBlackText", "#000000"),
        "gray": theme_color("key_windowBackgroundWhiteGrayText", "#8A8D93"),
        "accent": theme_color("key_windowBackgroundWhiteBlueText", "#2A9EF1"),
        "bar": theme_color("key_actionBarDefault", "#527DA3"),
        "bar_text": theme_color("key_actionBarDefaultTitle", "#FFFFFF"),
        "divider": theme_color("key_divider", "#1F000000"),
        "white": hex_color("#FFFFFF"),
    }
    if abs(luminance(pal["card"]) - luminance(pal["page"])) < 0.03:
        target = hex_color("#FFFFFF") if luminance(pal["page"]) < 0.5 else hex_color("#000000")
        pal["card"] = mix(pal["page"], target, 0.08)
    return pal


def _s32(c):
    c = int(c) & 0xFFFFFFFF
    return c - 0x100000000 if c >= 0x80000000 else c


def _read_color_field(obj, name):
    try:
        v = int(get_private_field(obj, name))
        return v if v != 0 else None
    except Exception:
        return None


def menu_item_colors(ref=None, tv=None):
    """Цвета пункта меню ⋮: берём у соседнего родного пункта (Chromecast), иначе из темы клиента."""
    text = icon = sel = None
    if ref is not None:
        text = _read_color_field(ref, "textColor")
        icon = _read_color_field(ref, "iconColor")
        sel = _read_color_field(ref, "selectorColor")
        if text is None:
            try:
                text = int(ref.getTextView().getCurrentTextColor())
            except Exception:
                text = None
    if text is None and tv is not None:
        try:
            text = int(tv.getCurrentTextColor())
        except Exception:
            text = None
    if text is None:
        text = theme_color("key_actionBarDefaultSubmenuItem", "#222222")
    if icon is None:
        icon = text if ref is not None else theme_color("key_actionBarDefaultSubmenuItemIcon", "#6E7480")
    if sel is None:
        sel = theme_color("key_listSelector", "#1F000000")
    return text, icon, sel


def style_menu_item(item, ref=None, tv=None):
    t, i, sc = menu_item_colors(ref, tv)
    try:
        item.setColors(_s32(t), _s32(i))
    except Exception as e:
        log("menu item colors failed: %r" % (e,))
    try:
        item.setSelectorColor(_s32(sc))
    except Exception:
        pass


# ───────────────────────── Java-хелперы ─────────────────────────

def jlist(x):
    if x is None:
        return []
    try:
        n = int(x.size())
        return [x.get(i) for i in range(n)]
    except Exception:
        pass
    try:
        return list(x)
    except Exception:
        pass
    try:
        return [x[i] for i in range(len(x))]
    except Exception:
        return []


def _find_super(obj, name):
    c = obj.getClass()
    while c is not None:
        if str(c.getName()) == name:
            return c
        c = c.getSuperclass()
    return None


def file_loader_call(method, params, args, account=None):
    FL = jclass("org.telegram.messenger.FileLoader")
    if account is None:
        try:
            account = int(jclass("org.telegram.messenger.UserConfig").selectedAccount)
        except Exception:
            account = 0
    inst = FL.getInstance(int(account))
    try:
        return getattr(inst, method)(*args)
    except TypeError:
        pass
    try:
        from java import cast
        cargs = [a if t == "boolean" else cast(jclass(t), a) for t, a in zip(params, args)]
        return getattr(inst, method)(*cargs)
    except Exception:
        pass
    ClassCls = jclass("java.lang.Class")
    ObjCls = jclass("java.lang.Object")
    ptypes = []
    for t, a in zip(params, args):
        if t == "boolean":
            ptypes.append(jclass("java.lang.Boolean").TYPE)
        else:
            c = _find_super(a, t)
            if c is None:
                raise TypeError("%s не является %s" % (a.getClass().getName(), t))
            ptypes.append(c)
    m = FL.getClass().getDeclaredMethod(method, jarray(ClassCls)(ptypes))
    m.setAccessible(True)
    return m.invoke(inst, jarray(ObjCls)(list(args)))


def track_from_mo(mo):
    title = str(mo.getMusicTitle() or "").strip() or "Без названия"
    artist = str(mo.getMusicAuthor() or "").strip() or "Неизвестный исполнитель"
    try:
        dur = int(mo.getDuration())
    except Exception:
        dur = 0
    return artist, title, dur


