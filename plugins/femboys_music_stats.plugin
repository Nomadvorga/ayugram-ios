                b.setPositiveButton("Импорт", _DialogChoice(lambda _: self._do_import(str(et.getText()).strip())))
                b.setNegativeButton("Отмена", _DialogChoice(lambda _: None))
                b.show()
            except Exception as e:
                toast("Ошибка окна импорта: %r" % (e,))
        run_on_ui_thread(show)

    def _choice_dialog(self, title, labels, fn):
        def show():
            try:
                act = self._activity()
                if act is None:
                    return
                b = self._build_dialog(act)
                b.setTitle(title)
                b.setItems(jarray(jclass("java.lang.CharSequence"))(labels), _DialogChoice(fn))
                b.setNegativeButton("Отмена", _DialogChoice(lambda _: None))
                b.show()
            except Exception as e:
                toast("Ошибка окна выбора: %r" % (e,))
        run_on_ui_thread(show)

    def restore_dialog(self):
        d, names = self._backup_files(selected_account())
        if not names:
            toast("Автокопий пока нет")
            return

        labels = []
        for n in names:
            try:
                kb = os.path.getsize(os.path.join(d, n)) // 1024
            except Exception:
                kb = 0
            labels.append("%s · %d КБ" % (n[:-3].split("_", 1)[-1], kb))

        def picked(i):
            path = os.path.join(d, names[i])

            def confirm():
                try:
                    act = self._activity()
                    if act is None:
                        return
                    b = self._build_dialog(act)
                    b.setTitle("Восстановить копию?")
                    b.setMessage("Текущая статистика этого аккаунта будет заменена копией от %s." % labels[i].split(" ·")[0])

                    def do():
                        try:
                            self.restore_backup(path)
                            toast("Статистика восстановлена")
                        except Exception as e:
                            log("restore error: %r" % (e,))
                            toast("Не удалось восстановить: %r" % (e,))

                    b.setPositiveButton("Восстановить", _DialogChoice(lambda _: do()))
                    b.setNegativeButton("Отмена", _DialogChoice(lambda _: None))
                    b.show()
                except Exception as e:
                    toast("Ошибка окна восстановления: %r" % (e,))

            run_on_ui_thread(confirm)

        self._choice_dialog("Автокопии (новые сверху)", labels, picked)

    def menu_diagnostics(self):
        st = self.menu_status
        popup = "кнопка ⋮ плеера ещё не создавалась"
        btn = self._opt_btn
        if btn is not None:
            try:
                layout = get_private_field(btn, "popupLayout")
                try:
                    n = int(layout.getItemsCount())
                except Exception:
                    n = int(layout.getChildCount())
                popup = "элементов в меню ⋮: %d" % n
            except Exception as e:
                popup = "popupLayout недоступен: %r" % (e,)
        lines = [
            "Версия плагина: " + __version__,
            "Хук: " + st["hook"],
            "Конструкторов у плеера: %s" % st.get("ctor_count", "?"),
            "Плеер создавался (конструктор): %d" % st["ctor"],
            "Заголовок трека обновлялся: %d" % st["title"],
            "Меню ⋮ открывалось (хуков %d): %d" % (st["toggle"], st["opened"]),
            "Пункт Chromecast замечен (хуков %d): %d" % (st["add_hooks"], st["chromecast"]),
            "Наших пунктов в меню: %d, добавлено раз: %d" % (st["present"], st["injected"]),
            "Нажатий на наши пункты: %d" % st["clicks"],
            "ItemOptions: хуков %d, Chromecast %d" % (st["io_hooks"], st["io_chromecast"]),
            "ActionBarMenuSubItem: хуков %d, Chromecast %d" % (st["sub_hooks"], st["sub_chromecast"]),
            "PopupWindow: хуков %d, показов %d, с Chromecast %d, вставлено %d" % (
                st["popup_hooks"], st["popup_shows"], st["popup_chromecast"], st["popup_injected"]),
            popup,
        ] + ["Стек " + x for x in st["stacks"]]
        if st["error"]:
            lines.append("Ошибка: " + st["error"])

        def show():
            try:
                act = self._activity()
                if act is None:
                    toast(" | ".join(lines)[:290])
                    return
                bld = self._build_dialog(act)
                bld.setTitle("Меню плеера: диагностика")
                bld.setMessage("\n".join(lines))
                bld.setPositiveButton("OK", _DialogChoice(lambda _: None))
                bld.show()
            except Exception as e:
                toast("Ошибка диагностики: %r" % (e,))

        run_on_ui_thread(show)

    # ----- настройки -----
    def _chart_style_item(self):
        self._selector_ok = False
        if Selector is not None:
            try:
                item = Selector(key="chart_style", text="Стиль диаграмм", default=0,
                                items=["Столбцы", "Кольцевая диаграмма"])
                self._selector_ok = True
                return item
            except Exception as e:
                log("selector failed: %r" % (e,))
        return Switch(key="chart_donut", text="Кольцевая диаграмма", default=False, subtext="Иначе — столбцы")

    def _visibility_item(self):
        if Selector is not None:
            try:
                return Selector(key="presence_visibility", text="Кто видит статус", default=0,
                                items=["Все", "Только из белого списка", "Всем, кроме чёрного"])
            except Exception as e:
                log("visibility selector failed: %r" % (e,))
        return Switch(key="presence_visibility", text="Видно всем (иначе — белый список)", default=True)

    def _settings_lyrics(self):
        return [
            Header(text="Источники"),
            Switch(key="lyr_lrclib", text="LRCLIB", default=True),
            Switch(key="lyr_netease", text="NetEase", default=True),
            Switch(key="lyr_qq", text="QQ Музыка", default=True),
            Switch(key="lyr_kugou", text="KuGou", default=True),
            Switch(key="lyr_ovh", text="lyrics.ovh", default=True, subtext="Только текст, без синхронизации"),
            Header(text="Память"),
            Switch(key="lyrics_cache", text="Сохранять на устройство", default=True,
                   subtext="Сохранённые тексты открываются без интернета"),
            Switch(key="lyrics_prefetch", text="Загружать заранее", default=True,
                   subtext="Когда трек начинает играть"),
            Text(text="Открыть текст песни", accent=True, on_click=lambda *a: self.open_lyrics()),
            Text(text=self.lyrics_cache_label(), red=True, on_click=lambda *a: self.clear_lyrics_cache()),
        ]

    def _settings_presence(self):
        return [
            Header(text="Трансляция"),
            Switch(key="presence_enabled", text="Отправлять статус на сервер", default=False,
                   subtext="Сервер хранит только текущий трек"),
            Switch(key="presence_show_profile", text="Показывать статус в профилях", default=True,
                   subtext="Трек, время и полоска прогресса"),
            self._visibility_item(),
            Text(text="Белый список", on_click=lambda *a: self._edit_presence_list("whitelist")),
            Text(text="Чёрный список", on_click=lambda *a: self._edit_presence_list("blacklist")),
            Header(text="Сервер"),
            Text(text="Адрес сервера", on_click=lambda *a: self._edit_presence_setting(
                "presence_server", "Адрес сервера", DEFAULT_PRESENCE_SERVER)),
            Text(text="Токен", on_click=lambda *a: self._edit_presence_setting(
                "presence_token", "Токен", "получи у бота")),
            Text(text="Получить токен: @fms_gettoken_bot", accent=True, on_click=lambda *a: self._open_bot()),
            Text(text="Проверить связь с сервером", on_click=lambda *a: self.presence_test()),
            Divider(text="Адрес сервера можно заменить на свой, только по https. На сервер уходят токен, "
                         "твой ID, текущий трек и ID профилей, которые ты открываешь."),
        ]

    def _settings_data(self):
        return [
            Switch(key="backup_auto", text="Автокопия базы", default=True,
                   subtext="Раз в сутки, последние 5 копий"),
            Text(text="Экспорт JSON", on_click=lambda *a: self.export_json()),
            Text(text="Экспорт CSV", on_click=lambda *a: self.export_csv()),
            Text(text="Отправить копию в Избранное", on_click=lambda *a: self.send_backup_saved()),
            Text(text="Импорт из JSON", on_click=lambda *a: self.import_dialog()),
            Text(text="Восстановить из автокопии", on_click=lambda *a: self.restore_dialog()),
            Text(text="Сбросить все данные", red=True, on_click=lambda *a: self.confirm_reset()),
        ]

    def _settings_diag(self):
        return [
            Text(text="Проверить обложку трека", on_click=lambda *a: self.diagnose_cover()),
            Text(text="Проверить меню плеера", on_click=lambda *a: self.menu_diagnostics()),
        ]

    def create_settings(self):
        items = [
            Header(text="Статистика"),
            Switch(key="enabled", text="Вести учёт", default=True,
                   subtext="Только музыка, без голосовых и кружков"),
            Switch(key="player_menu", text="Пункты в меню ⋮ плеера", default=True,
                   subtext="Статистика, текст и итоги"),
            self._chart_style_item(),
            Text(text="Открыть статистику", accent=True, on_click=lambda *a: self.open_stats()),
            Text(text="Статистика текущего трека", accent=True, on_click=lambda *a: self.open_current_track_stats()),
            Text(text="Итоги периода (картинка)", accent=True, on_click=lambda *a: self.open_recap()),
            Text(text="Редактор интерфейса", accent=True, on_click=lambda *a: self.open_layout_editor()),
            Header(text="Разделы"),
        ]
        sections = (
            ("Тексты песен", self._settings_lyrics),
            ("Трансляция «Сейчас слушает»", self._settings_presence),
            ("Данные и резервные копии", self._settings_data),
            ("Диагностика", self._settings_diag),
        )
        for title, build in sections:
            try:
                items.append(Text(text=title, create_sub_fragment=build))
            except TypeError:
                items.append(Header(text=title))
                items.extend(build())
        items.append(Divider(text="Команды в любом чате: .music [week|month|year|all], .music top [период], "
                                  ".recap [период], .lyrics, .track"))
        return items

    # ----- точки входа -----
    def open_stats(self, period=None):
        period = period or self.stats_period

        def work():
            try:
                snap = self.store.snapshot(period)
                run_on_ui_thread(lambda: self._safe(self._show_stats, snap))
            except Exception as e:
                log("open_stats error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_lyrics(self):
        run_on_ui_thread(lambda: self._safe(self._show_lyrics))

    def open_track_stats(self, artist, title, duration=0):
        def work():
            try:
                a, t = self.store.canon(artist, title)
                ts = self.store.track_stats(a, t)
                if duration and not ts["duration"]:
                    ts["duration"] = duration
                run_on_ui_thread(lambda: self._safe(self._show_track_stats, a, t, ts))
            except Exception as e:
                log("open_track_stats error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_current_track_stats(self):
        cur = self.cur
        if not cur:
            toast("Сейчас ничего не играет")
            return
        self.open_track_stats(cur[0], cur[1], cur[2])

    def open_recap(self, period=None):
        period = period or self.stats_period

        def work():
            try:
                snap = self.store.snapshot(period)
                pal = get_palette()
                bmp = render_recap(snap, period, pal, lambda a, t: cover_file_for(self.store, a, t))
                name = "recap_%s.png" % time.strftime("%Y%m%d_%H%M%S")
                path = os.path.join(self._export_dir(), name)
                fos = jclass("java.io.FileOutputStream")(path)
                try:
                    bmp.compress(jclass("android.graphics.Bitmap$CompressFormat").PNG, 100, fos)
                    fos.flush()
                finally:
                    fos.close()
                run_on_ui_thread(lambda: self._safe(self._show_recap_preview, path, period))
            except Exception as e:
                log("recap error: %r" % (e,))
                toast("MusicStats: не удалось собрать итоги: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_full_list(self, kind, period):
        def work():
            try:
                t0, _p = period_bounds(period, int(time.time()))
                rows = self.store.top_tracks(t0) if kind == "tracks" else self.store.top_artists(t0)
                run_on_ui_thread(lambda: self._safe(self._show_full_list, kind, period, rows))
            except Exception as e:
                log("open_full_list error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_bucket_breakdown(self, buckets, index, origin=None):
        def work():
            try:
                rows = self.store.tracks_for_bucket(buckets[index])
                run_on_ui_thread(lambda: self._safe(self._show_breakdown, "bucket", buckets, index, None, rows, origin))
            except Exception as e:
                log("breakdown error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def open_artist_breakdown(self, artist):
        def work():
            try:
                rows, added = self.store.artist_snapshot(artist)
                run_on_ui_thread(lambda: self._safe(self._show_breakdown, "artist", None, 0, artist, rows, None, added))
            except Exception as e:
                log("artist breakdown error: %r" % (e,))
                toast("MusicStats: ошибка данных: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    # ───────── окно статистики ─────────
    def _show_stats(self, snap):
        StatsWindow(self, snap)

    # ───────── редактор интерфейса ─────────
    def _show_layout_editor(self, reopen):
        scr = Screen(self, "Редактор интерфейса")
        ui, pal, dp, lp, text = scr.ui, scr.pal, scr.dp, scr.lp, scr.text
        if reopen:
            scr.on_dismiss = lambda: self.open_stats()

        head = scr.card()
        head.addView(text("Вид окна статистики", 15, pal["text"], True), lp(-2, -2, b=8))

        def on_mode(m):
            self.set_setting("ui_classic", m == "classic")

        Pills(ui, pal, head, (("tabs", "Вкладки"), ("classic", "Классический")), self.ui_mode(), on_mode, 13.5)
        head.addView(text("«Классический» — одна длинная страница. Порядок, размеры и скрытые виджеты "
                          "действуют в обоих видах; вкладки используются только во «Вкладках».", 12, pal["gray"]),
                     lp(-2, -2, t=8))
        scr.add(head)
        box = ui.vbox()
        scr.add(box, lp(-1, -2))

        def choice(label, selected, enabled, fn):
            tv = text(label, 12.5, pal["white"] if selected else pal["gray"], True)
            tv.setGravity(17)
            tv.setSingleLine(True)
            tv.setPadding(dp(10), dp(8), dp(10), dp(8))
            tv.setBackground(ui.rounded(pal["accent"] if selected else pal["page"], 10))
            if enabled:
                tv.setOnClickListener(_Click(fn))
            else:
                tv.setAlpha(0.35)
            return tv

        def render():
            box.removeAllViews()
            layout = self.load_layout()
            for idx, cfg in enumerate(layout):
                d = WIDGET_DEFS[cfg["id"]]
                c = ui.vbox()
                c.setBackground(ui.rounded(pal["card"], 16))
                c.setPadding(dp(14), dp(12), dp(14), dp(12))
                top = ui.hbox()
                top.setGravity(16)
                top.addView(text(d["title"], 16, pal["text"] if cfg["vis"] else pal["gray"], True, single=True),
                            lp(0, -2, 1.0))

                def upd(i=idx, key=None, val=None):
                    lay = self.load_layout()
                    if key is not None:
                        lay[i][key] = val
                    self.save_layout(lay)
                    render()

                top.addView(choice("Показан" if cfg["vis"] else "Скрыт", cfg["vis"], True,
                                   lambda i=idx, v=not cfg["vis"]: upd(i, "vis", v)), lp(-2, -2))
                c.addView(top)

                row = ui.hbox()
                row.setGravity(16)

                def move(i, step):
                    lay = self.load_layout()
                    j = i + step
                    while 0 <= j < len(lay) and self.ui_mode() == "tabs" and lay[j]["tab"] != lay[i]["tab"]:
                        j += step
                    if 0 <= j < len(lay):
                        lay[i], lay[j] = lay[j], lay[i]
                        self.save_layout(lay)
                    render()

                row.addView(choice("▲", False, idx > 0, lambda i=idx: move(i, -1)), lp(-2, -2, r=6))
                row.addView(choice("▼", False, idx < len(layout) - 1, lambda i=idx: move(i, 1)), lp(-2, -2, r=10))
                row.addView(choice("Вкладка: " + TAB_NAMES[cfg["tab"]], False, True,
                                   lambda i=idx, t=(cfg["tab"] + 1) % len(TAB_NAMES): upd(i, "tab", t)), lp(-2, -2))
                c.addView(row, lp(-2, -2, t=10))

                wrow = ui.hbox()
                wrow.setGravity(16)
                wrow.addView(text("Ширина", 12.5, pal["gray"]), lp(dp(64), -2))
                wrow.addView(choice("½", cfg["w"] == 1, d["min_w"] == 1, lambda i=idx: upd(i, "w", 1)),
                             lp(-2, -2, r=6))
                wrow.addView(choice("Вся", cfg["w"] == 2, True, lambda i=idx: upd(i, "w", 2)), lp(-2, -2))
                c.addView(wrow, lp(-2, -2, t=8))

                if d["max_h"] > 1:
                    hrow = ui.hbox()
                    hrow.setGravity(16)
                    hrow.addView(text("Размер", 12.5, pal["gray"]), lp(dp(64), -2))
                    for lvl in range(1, d["max_h"] + 1):
                        hrow.addView(choice(SIZE_LABELS[lvl], cfg["h"] == lvl, lvl >= d["min_h"],
                                            lambda i=idx, v=lvl: upd(i, "h", v)), lp(-2, -2, r=6))
                    c.addView(hrow, lp(-2, -2, t=8))
                c.addView(text(min_size_text(cfg["id"]), 11.5, pal["gray"]), lp(-2, -2, t=8))
                box.addView(c, lp(-1, -2, b=10))

            reset = scr.pill("Сбросить раскладку", lambda: (self.save_layout(default_layout()), render()))
            box.addView(reset, lp(-2, -2, t=4))

        render()
        scr.show()

    # ───────── окно: полный список ─────────
    def _show_full_list(self, kind, period, rows):
        scr = Screen(self, ("Все треки · " if kind == "tracks" else "Все исполнители · ") + PERIOD_TITLES[period])
        ui, pal, lp, text = scr.ui, scr.pal, scr.lp, scr.text
        act = scr.act
        is_tracks = kind == "tracks"

        head = scr.card()
        row = ui.hbox()
        row.setGravity(16)
        et = jclass("android.widget.EditText")(act)
        et.setSingleLine(True)
        et.setHint("Поиск")
        et.setTextSize(15.0)
        et.setTextColor(jint(pal["text"]))
        et.setHintTextColor(jint(pal["gray"]))
        row.addView(et, lp(0, -2, 1.0, r=8))
        head.addView(row)
        count_tv = text("", 12, pal["gray"])
        head.addView(count_tv, lp(-2, -2, t=8))
        scr.add(head)
        list_card = scr.card()
        box = ui.vbox()
        list_card.addView(box)
        scr.add(list_card, lp(-1, -2))

        def render(q=""):
            box.removeAllViews()
            q = q.strip().lower()
            if is_tracks:
                shown = [r for r in rows if not q or q in ("%s %s" % (r[0], r[1])).lower()]
            else:
                shown = [r for r in rows if not q or q in str(r[0]).lower()]
            count_tv.setText("Найдено: %d из %d" % (len(shown), len(rows)) if q else "Всего: %d" % len(rows))
            if not shown:
                box.addView(text("Ничего не найдено", 14, pal["gray"]))
                return
            mx = (shown[0][2] if is_tracks else shown[0][1]) or 1.0
            for i, r in enumerate(shown[:300], 1):
                if is_tracks:
                    a, t, secs = r
                    make_meter_row(act, ui, pal, box, i, t, a, fmt_dur(secs), secs / mx,
                                   lambda a=a, t=t: self.open_track_stats(a, t))
                else:
                    a, secs = r
                    make_meter_row(act, ui, pal, box, i, a, "", fmt_dur(secs), secs / mx,
                                   lambda a=a: self.open_artist_breakdown(a))

        et.addTextChangedListener(_TextWatcher(render))
        render()
        scr.show()

    # ───────── окно: итоги ─────────
    def _show_recap_preview(self, path, period):
        scr = Screen(self, "Итоги · " + PERIOD_TITLES.get(period, period))
        ui, dp, lp = scr.ui, scr.dp, scr.lp
        act = scr.act
        screen_w = int(act.getResources().getDisplayMetrics().widthPixels)
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        BitmapFactory = jclass("android.graphics.BitmapFactory")

        card = scr.card(0)
        width = screen_w - dp(24)
        height = int(width * 1920.0 / 1080.0)
        iv = ImageView(act)
        iv.setScaleType(ImageScale.FIT_CENTER)
        bmp = BitmapFactory.decodeFile(path)
        if bmp is not None:
            iv.setImageBitmap(bmp)
        card.addView(iv, lp(width, height))
        scr.add(card)

        buttons = scr.card(10)
        row = ui.hbox()
        row.addView(scr.pill("В Избранное", lambda: self._send_saved(path, "image/png", "Музыка · итоги")),
                    lp(-2, -2, r=8))
        row.addView(scr.pill("В Загрузки", lambda: threading.Thread(target=lambda: toast(
            "Сохранено: %s" % (save_public(path, os.path.basename(path), "image/png") or path)),
            daemon=True).start()), lp(-2, -2))
        buttons.addView(row)
        scr.add(buttons)
        scr.show()

    # ───────── окно: текст песни ─────────
    def _show_lyrics(self):
        act = self._activity()
        if act is None:
            toast("MusicStats: не найдено окно приложения")
            return

        ScrollView = jclass("android.widget.ScrollView")
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        Handler = jclass("android.os.Handler")
        Looper = jclass("android.os.Looper")
        Overshoot = jclass("android.view.animation.OvershootInterpolator")
        BitmapFactory = jclass("android.graphics.BitmapFactory")
        Typeface = jclass("android.graphics.Typeface")

        pal = get_palette()
        win = setup_window(act, pal, "Текст песни")
        ui, dlg, root = win.ui, win.dlg, win.root
        dp = ui.dp
        store = self.store
        metrics = act.getResources().getDisplayMetrics()
        screen_w, screen_h = int(metrics.widthPixels), int(metrics.heightPixels)
        handler = Handler(Looper.getMainLooper())

        state = {
            "alive": True, "key": None, "status": None, "idx": -2,
            "views": [], "times": [], "cover_sig": None, "sub": None, "ticks": 0,
        }

        header = ui.vbox()
        header.setGravity(1)
        header.setPadding(dp(20), dp(8), dp(20), dp(10))
        cover_size = min(dp(170), int(screen_w * 0.5))
        cover_iv = ImageView(act)
        cover_iv.setScaleType(ImageScale.FIT_XY)
        header.addView(cover_iv, ui.lp(cover_size, cover_size, t=12, b=14))
        title_tv = ui.text("", 22, pal["text"], True)
        title_tv.setGravity(17)
        title_tv.setMaxLines(2)
        title_tv.setEllipsize(ui.TruncateAt.END)
        header.addView(title_tv, ui.lp(-1, -2))
        artist_tv = ui.text("", 15, pal["gray"], single=True)
        artist_tv.setGravity(17)
        header.addView(artist_tv, ui.lp(-1, -2, t=2))
        sub_tv = ui.text("", 12, pal["accent"])
        sub_tv.setGravity(17)
        header.addView(sub_tv, ui.lp(-1, -2, t=2))
        root.addView(header, ui.lp(-1, -2))

        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setVerticalFadingEdgeEnabled(True)
        scroll.setFadingEdgeLength(dp(48))
        lines_box = ui.vbox()
        lines_box.setPadding(dp(8), int(screen_h * 0.12), dp(8), int(screen_h * 0.3))
        scroll.addView(lines_box)
        root.addView(scroll, ui.lp(-1, 0, 1.0))
        win.cbs.append(lambda t, b: lines_box.setPadding(dp(8), int(screen_h * 0.12), dp(8), int(screen_h * 0.3) + b))

        def line_color(dist):
            if dist == 0:
                return pal["accent"]
            alpha = 225 if dist == 1 else (175 if dist == 2 else 120)
            return with_alpha(pal["text"], alpha)

        def update_cover():
            cur = self.cur
            path, exists = None, False
            if cur:
                path = store.cover_path(cur[0], cur[1])
                exists = os.path.exists(path)
                sig = (cur[0], cur[1], exists)
            else:
                sig = ("none",)
            if sig == state["cover_sig"]:
                return
            state["cover_sig"] = sig
            bmp = None
            if exists:
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, cover_size, float(dp(18)))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(cover_size, float(dp(18)), pal)
            cover_iv.setImageBitmap(bmp)

        def add_message(msg):
            tv = ui.text(msg, 15, pal["gray"])
            tv.setGravity(17)
            tv.setPadding(dp(20), dp(30), dp(20), dp(30))
            lines_box.addView(tv, ui.lp(-1, -2))

        def render():
            cur = self.cur
            lines_box.removeAllViews()
            state["views"] = []
            state["times"] = []
            state["idx"] = -2
            scroll.scrollTo(0, 0)
            if not cur:
                state["status"] = "idle"
                add_message("Включи трек в Telegram, и здесь появится текст")
                return
            entry = self.get_lyrics(cur[0], cur[1], cur[2])
            st = entry.get("status")
            state["status"] = st
            if st == "loading":
                add_message("Ищу текст…")
            elif st == "ok" and entry["lines"]:
                for _t, txt in entry["lines"]:
                    tv = ui.text(txt, 20, line_color(3))
                    tv.setGravity(17)
                    tv.setPadding(dp(16), dp(9), dp(16), dp(9))
                    lines_box.addView(tv, ui.lp(-1, -2))
                    state["views"].append(tv)
                state["times"] = entry["times"]
            elif st == "ok":
                tv = ui.text((entry["plain"] or "")[:4000], 17, pal["text"])
                tv.setGravity(17)
                tv.setPadding(dp(16), dp(10), dp(16), dp(10))
                lines_box.addView(tv, ui.lp(-1, -2))
            elif st == "error":
                add_message("Не удалось загрузить текст: нет сети или сервисы не отвечают, "
                            "а в памяти устройства его ещё нет")
            else:
                add_message("Текст для этого трека не найден")

        def set_track():
            cur = self.cur
            state["key"] = (cur[0], cur[1]) if cur else None
            state["cover_sig"] = None
            if cur:
                title_tv.setText(cur[1])
                artist_tv.setText(cur[0])
            else:
                title_tv.setText("Ничего не играет")
                artist_tv.setText("Включи трек в Telegram")
            update_cover()
            for v in (cover_iv, title_tv, artist_tv):
                v.setAlpha(0.0)
                v.animate().alpha(1.0).setDuration(380).start()
            cover_iv.setScaleX(0.88)
            cover_iv.setScaleY(0.88)
            cover_iv.animate().scaleX(1.0).scaleY(1.0).setDuration(450).setInterpolator(Overshoot(1.6)).start()
            render()

        def highlight(idx):
            if idx == state["idx"]:
                return
            views = state["views"]
            if not views:
                return
            if idx >= 0:
                tv = views[idx]
                if scroll.getHeight() == 0 or tv.getHeight() == 0:
                    return
            old = state["idx"]
            state["idx"] = idx
            for i, v in enumerate(views):
                dist = abs(i - idx) if idx >= 0 else 3
                v.setTextColor(jint(line_color(dist)))
                v.setTypeface(Typeface.DEFAULT, 1 if i == idx else 0)
            if 0 <= old < len(views):
                views[old].animate().scaleX(1.0).scaleY(1.0).setDuration(220).start()
            if idx >= 0:
                tv = views[idx]
                tv.animate().scaleX(1.06).scaleY(1.06).setDuration(260).start()
                target = tv.getTop() - (scroll.getHeight() - tv.getHeight()) // 2
                scroll.smoothScrollTo(0, max(0, int(target)))
            else:
                scroll.smoothScrollTo(0, 0)

        def tick():
            if not state["alive"]:
                return
            try:
                state["ticks"] += 1
                cur = self.cur
                key = (cur[0], cur[1]) if cur else None
                if key != state["key"]:
                    set_track()
                elif cur:
                    entry = self.get_lyrics(cur[0], cur[1], cur[2])
                    if entry.get("status") != state["status"]:
                        render()
                if state["ticks"] % 3 == 0:
                    update_cover()
                    parts = []
                    if cur and self.paused:
                        parts.append("⏸ На паузе")
                    ent = self._lyrics.get((cur[0], cur[1])) if cur else None
                    if ent and ent.get("status") == "ok" and ent.get("source"):
                        parts.append(ent["source"] + (" · из памяти" if ent.get("cached") else ""))
                    sub = " · ".join(parts)
                    if sub != state["sub"]:
                        state["sub"] = sub
                        sub_tv.setText(sub)
                if state["views"]:
                    pos = self.current_position()
                    if pos is not None:
                        idx = bisect.bisect_right(state["times"], pos + 0.15) - 1
                        highlight(idx)
            except Exception as e:
                log("lyrics window tick error: %r" % (e,))
            handler.postDelayed(runnable, 300)

        runnable = _Run(tick)

        def on_dismiss():
            state["alive"] = False
            try:
                handler.removeCallbacksAndMessages(None)
            except Exception:
                pass

        dlg.setOnDismissListener(_Dismiss(on_dismiss))

        set_track()
        dlg.setContentView(root)
        dlg.show()

        win.bar.setAlpha(0.0)
        win.bar.animate().alpha(1.0).setDuration(250).start()
        handler.postDelayed(runnable, 300)

    # ───────── окно: разбор столбца/исполнителя ─────────
    def _show_breakdown(self, kind, buckets, index, artist, rows, origin, added_at=0.0):
        act = self._activity()
        if act is None:
            toast("MusicStats: не найдено окно приложения")
            return

        ScrollView = jclass("android.widget.ScrollView")
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        Handler = jclass("android.os.Handler")
        Looper = jclass("android.os.Looper")
        Decelerate = jclass("android.view.animation.DecelerateInterpolator")
        BitmapFactory = jclass("android.graphics.BitmapFactory")

        is_artist = kind == "artist"
        pal = get_palette()
        win = setup_window(act, pal, ("статистика " + artist) if is_artist else "Статистика")
        ui, dlg, root = win.ui, win.dlg, win.root
        dp, lp, text = ui.dp, ui.lp, ui.text
        store = self.store
        handler = Handler(Looper.getMainLooper())
        st = {"alive": True, "index": index, "gen": 0, "rows": rows, "added_at": float(added_at),
              "ticks": 0, "busy": False}
        covers = {}

        if origin is not None:
            try:
                dlg.getWindow().setBackgroundDrawable(jclass("android.graphics.drawable.ColorDrawable")(jint(0)))
            except Exception:
                pass

        scroll = ScrollView(act)
        scroll.setVerticalScrollBarEnabled(False)
        content = ui.vbox()
        content.setPadding(dp(12), dp(12), dp(12), dp(20))
        scroll.addView(content)
        root.addView(scroll, lp(-1, 0, 1.0))
        win.cbs.append(lambda t, b: content.setPadding(dp(12), dp(12), dp(12), dp(20) + b))

        head = ui.hbox()
        head.setGravity(16)
        left_arrow = text("‹", 34, pal["accent"], True)
        left_arrow.setPadding(dp(10), 0, dp(14), dp(4))
        right_arrow = text("›", 34, pal["accent"], True)
        right_arrow.setPadding(dp(14), 0, dp(10), dp(4))
        mid = ui.vbox()
        label_tv = text("", 17, pal["text"], True)
        label_tv.setGravity(17)
        total_tv = text("", 30, pal["accent"], True)
        total_tv.setGravity(17)
        sub_tv = text("", 13, pal["gray"])
        sub_tv.setGravity(17)
        mid.addView(label_tv, lp(-1, -2))
        mid.addView(total_tv, lp(-1, -2, t=2))
        mid.addView(sub_tv, lp(-1, -2, t=2))
        if not is_artist:
            head.addView(left_arrow, lp(-2, -2))
        head.addView(mid, lp(0, -2, 1.0))
        if not is_artist:
            head.addView(right_arrow, lp(-2, -2))
        content.addView(head, lp(-1, -2, b=8))
        body = ui.vbox()
        content.addView(body, lp(-1, -2))

        def cover(a, t, size, radius):
            key = (a, t, size)
            if key in covers:
                return covers[key]
            bmp = None
            path = store.cover_path(a, t)
            if os.path.exists(path):
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, size, float(radius))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(size, float(radius), pal)
            covers[key] = bmp
            return bmp

        def list_row(box, rank, a, t, secs):
            row = ui.hbox()
            row.setGravity(16)
            row.setPadding(0, dp(7), 0, dp(7))
            rk = text(str(rank), 14, pal["accent"], True)
            rk.setMinWidth(dp(22))
            row.addView(rk, lp(-2, -2))
            iv = ImageView(act)
            iv.setScaleType(ImageScale.FIT_XY)
            iv.setImageBitmap(cover(a, t, dp(52), dp(10)))
            row.addView(iv, lp(dp(52), dp(52), l=2, r=12))
            col = ui.vbox()
            col.addView(text(t, 15, pal["text"], True, single=True))
            col.addView(text(a, 12.5, pal["gray"], single=True))
            row.addView(col, lp(0, -2, 1.0, r=8))
            row.addView(text(fmt_smart(secs), 13, pal["gray"], True), lp(-2, -2))
            row.setOnClickListener(_Click(lambda a=a, t=t: self.open_track_stats(a, t)))
            box.addView(row)

        def seg_color(k):
            return mix(pal["accent"], pal["page"], min(0.78, 0.2 * k))

        def render(rows_, label):
            body.removeAllViews()
            total = sum(r[2] for r in rows_)
            label_tv.setText(label)
            total_tv.setText((fmt_hms if is_artist else fmt_smart)(total) if rows_ else "—")
            sub_tv.setText("треков: %d" % len(rows_))
            if not rows_:
                m = text("В это время ничего не слушал", 15, pal["gray"])
                m.setGravity(17)
                m.setPadding(0, dp(40), 0, dp(40))
                body.addView(m, lp(-1, -2))
                return None

            segs = build_segments(rows_, not is_artist)
            H = dp(300)
            weights = [max(sg["share"], 0.14) for sg in segs]
            bar_col = ui.vbox()
            bar_col.setWeightSum(float(sum(weights)))
            labels_col = ui.vbox()
            labels_col.setWeightSum(float(sum(weights)))
            for k, sg in enumerate(segs):
                seg = View(act)
                seg.setBackground(ui.rounded(seg_color(k), 8))
                bar_col.addView(seg, lp(-1, 0, weights[k], b=3 if k < len(segs) - 1 else 0))
                lab = ui.vbox()
                lab.setGravity(16)
                lab.addView(text(sg["name"], 17 if sg["first"] else 15, pal["text"], True, single=True))
                lab.addView(text(sg["sub"], 12.5, pal["gray"], single=True))
                labels_col.addView(lab, lp(-1, 0, weights[k]))
            section = ui.hbox()
            section.addView(bar_col, lp(dp(92), H, r=14))
            section.addView(labels_col, lp(0, H, 1.0))
            body.addView(section, lp(-1, H, t=6, b=14))

            limit = 30 if is_artist else 8
            list_card = ui.vbox()
            list_card.setBackground(ui.rounded(pal["card"], 16))
            list_card.setPadding(dp(16), dp(12), dp(16), dp(12))
            title = "Все треки исполнителя" if is_artist else "Топ %d треков" % min(limit, len(rows_))
            list_card.addView(text(title, 17, pal["text"], True), lp(-2, -2, b=4))
            for k, (a, t, secs) in enumerate(rows_[:limit], 1):
                list_row(list_card, k, a, t, secs)
            body.addView(list_card, lp(-1, -2))
            return bar_col, labels_col, list_card

        def update_arrows():
            if is_artist:
                return
            left_arrow.setAlpha(0.3 if st["index"] <= 0 else 1.0)
            right_arrow.setAlpha(0.3 if st["index"] >= len(buckets) - 1 else 1.0)

        def zoom_bar(bar_col):
            ox0, oy0, ox1, oy1 = origin
            loc = jarray(jint)([0, 0])
            bar_col.getLocationOnScreen(loc)
            fx, fy = float(loc[0]), float(loc[1])
            fw, fh = float(bar_col.getWidth()), float(bar_col.getHeight())
            if fw <= 0 or fh <= 0:
                bar_col.setAlpha(1.0)
                return
            bar_col.setPivotX(0.0)
            bar_col.setPivotY(0.0)
            bar_col.setScaleX(max(0.02, (ox1 - ox0) / fw))
            bar_col.setScaleY(max(0.02, (oy1 - oy0) / fh))
            bar_col.setTranslationX(ox0 - fx)
            bar_col.setTranslationY(oy0 - fy)
            bar_col.setAlpha(1.0)
            bar_col.animate().scaleX(1.0).scaleY(1.0).translationX(0.0).translationY(0.0) \
                .setDuration(560).setInterpolator(Decelerate(2.2)).start()

        def animate_in(parts):
            bar_col, labels_col, list_card = parts
            for v, delay in ((labels_col, 300), (list_card, 420)):
                v.setAlpha(0.0)
                v.setTranslationY(float(dp(20)))
                v.animate().alpha(1.0).translationY(0.0).setStartDelay(delay).setDuration(380) \
                    .setInterpolator(Decelerate(2.0)).start()
            if origin is None:
                return
            bar_col.setAlpha(0.0)

            def go():
                try:
                    zoom_bar(bar_col)
                except Exception as e:
                    log("zoom error: %r" % (e,))
                    bar_col.setAlpha(1.0)

            handler.postDelayed(_Run(go), 70)

        def go_to(delta):
            if is_artist:
                return
            j = st["index"] + delta
            if not (0 <= j < len(buckets)):
                return
            st["index"] = j
            st["gen"] += 1
            gen = st["gen"]
            direction = 1 if delta > 0 else -1

            def work():
                try:
                    r = store.tracks_for_bucket(buckets[j])
                    run_on_ui_thread(lambda: swap(gen, j, r, direction))
                except Exception as e:
                    log("breakdown switch error: %r" % (e,))

            threading.Thread(target=work, daemon=True).start()

        def swap(gen, j, r, direction):
            if gen != st["gen"] or not st["alive"]:
                return
            dx = float(dp(60) * direction)

            def apply():
                render(r, buckets[j]["label"])
                update_arrows()
                body.setTranslationX(dx)
                body.setAlpha(0.0)
                body.animate().translationX(0.0).alpha(1.0).setDuration(240) \
                    .setInterpolator(Decelerate(2.0)).start()

            body.animate().translationX(-dx).alpha(0.0).setDuration(140).withEndAction(_Run(apply)).start()

        left_arrow.setOnClickListener(_Click(lambda: go_to(-1)))
        right_arrow.setOnClickListener(_Click(lambda: go_to(1)))

        def on_dismiss():
            st["alive"] = False
            try:
                handler.removeCallbacksAndMessages(None)
            except Exception:
                pass

        dlg.setOnDismissListener(_Dismiss(on_dismiss))

        def artist_refresh():
            if st["busy"] or not st["alive"]:
                return
            st["busy"] = True

            def work():
                try:
                    r, a = store.artist_snapshot(artist)
                    run_on_ui_thread(lambda: artist_apply(r, a))
                except Exception as e:
                    log("artist refresh error: %r" % (e,))
                finally:
                    st["busy"] = False

            threading.Thread(target=work, daemon=True).start()

        def artist_apply(r, a):
            if not st["alive"]:
                return
            st["rows"], st["added_at"] = r, float(a)
            render(r, artist)

        def artist_tick():
            if not st["alive"]:
                return
            st["ticks"] += 1
            delta = max(0.0, store.added_artist.get(artist, 0.0) - st["added_at"])
            base = sum(x[2] for x in st["rows"])
            total_tv.setText(fmt_hms(base + delta))
            if st["ticks"] % 3 == 0:
                artist_refresh()
            handler.postDelayed(tick_runnable, 1000)

        tick_runnable = _Run(artist_tick)

        parts = render(rows, artist if is_artist else buckets[index]["label"])
        update_arrows()
        dlg.setContentView(root)
        dlg.show()

        win.bar.setAlpha(0.0)
        win.bar.animate().alpha(1.0).setDuration(250).start()
        if origin is not None:
            root.setAlpha(0.0)
            root.animate().alpha(1.0).setDuration(220).start()
        if parts is not None:
            animate_in(parts)
        if is_artist:
            handler.postDelayed(tick_runnable, 1000)

    # ───────── окно: статистика трека ─────────
    def _show_track_stats(self, artist, title, ts):
        scr = Screen(self, "Статистика трека")
        ui, pal, dp, lp, text = scr.ui, scr.pal, scr.dp, scr.lp, scr.text
        act = scr.act
        store = self.store
        key = (artist, title)
        screen_w = int(act.getResources().getDisplayMetrics().widthPixels)
        ImageView = jclass("android.widget.ImageView")
        ImageScale = jclass("android.widget.ImageView$ScaleType")
        BitmapFactory = jclass("android.graphics.BitmapFactory")

        st = {"ts": ts, "added_at": float(ts.get("added_at", 0.0)), "ticks": 0, "busy": False, "cover": None}
        arrays = {"hod": [0.0] * 24, "wd": [0.0] * 7, "moy": [0.0] * 12}

        def recompute(t):
            hod, wd, moy = [0.0] * 24, [0.0] * 7, [0.0] * 12
            for day, h, secs in t["dh"]:
                hod[int(h)] += secs
                wd[day_wd(day)] += secs
                moy[day_date(day).month - 1] += secs
            arrays["hod"], arrays["wd"], arrays["moy"] = hod, wd, moy

        recompute(ts)

        head = scr.card()
        row = ui.hbox()
        row.setGravity(16)
        cover_size = dp(92)
        cover_iv = ImageView(act)
        cover_iv.setScaleType(ImageScale.FIT_XY)
        row.addView(cover_iv, lp(cover_size, cover_size, r=14))
        col = ui.vbox()
        t_tv = text(title, 18, pal["text"], True)
        t_tv.setMaxLines(3)
        t_tv.setEllipsize(ui.TruncateAt.END)
        col.addView(t_tv)
        col.addView(text(artist, 14, pal["gray"], single=True), lp(-2, -2, t=3))
        len_tv = text("", 13, pal["gray"])
        col.addView(len_tv, lp(-2, -2, t=3))
        row.addView(col, lp(0, -2, 1.0))
        head.addView(row)
        scr.add(head)

        nums = scr.card()
        nums.addView(text("Прослушано", 13, pal["gray"]))
        total_tv = text("0с", 32, pal["accent"], True)
        nums.addView(total_tv, lp(-2, -2, t=2))
        plays_tv = text("", 15, pal["text"], True)
        nums.addView(plays_tv, lp(-2, -2, t=10))
        sess_tv = text("", 13, pal["gray"])
        nums.addView(sess_tv, lp(-2, -2, t=6))
        dates_tv = text("", 13, pal["gray"])
        nums.addView(dates_tv, lp(-2, -2, t=6))
        scr.add(nums)

        chart_card = scr.card()
        chart_w = screen_w - dp(24) - dp(32)
        chart = ChartBox(
            ui, pal, scr.handler, chart_card,
            (("hour", "Часы"), ("wday", "Дни"), ("month", "Месяцы")),
            track_series(arrays), chart_w, dp(220), "hour", nav=False, pill_size=13,
        )
        scr.add(chart_card)

        best = scr.card()
        best.addView(text("Чаще всего ты слушаешь его", 13, pal["gray"]))
        best_tv = text("", 17, pal["text"], True)
        best.addView(best_tv, lp(-2, -2, t=6))
        scr.add(best)

        def live_total():
            extra = max(0.0, store.added_track.get(key, 0.0) - st["added_at"])
            return float(st["ts"]["total"] or 0.0) + extra

        def update_numbers():
            t = st["ts"]
            total = live_total()
            duration = int(t["duration"] or 0)
            total_tv.setText(fmt_hms(total) if total > 0 else "0с")
            if duration > 0:
                len_tv.setText("длина %d:%02d" % (duration // 60, duration % 60))
            else:
                len_tv.setText("длина пока неизвестна")
            if t["sessions"]:
                plays_tv.setText("Прослушиваний: %d · пропусков: %d" % (t["plays"], t["skips"]))
                sess_tv.setText("сеансов: %d · среднее дослушивание: %d%% · целиком: %d" % (
                    t["sessions"], round(t["avg_pct"] * 100), t["full"]))
            else:
                plays_tv.setText("Прослушиваний: — (сеансы считаются с v3.0)")
                sess_tv.setText("")
            playing = self.now_playing == key
            first = t["first"] or (int(time.time()) if playing else None)
            last = int(time.time()) if playing else t["last"]
            if first:
                dates_tv.setText("Первый раз: %s · последний: %s" % (fmt_date(first), fmt_date(last)))
            else:
                dates_tv.setText("По этому треку пока нет данных")
            if total > 0:
                hod, wd, moy = arrays["hod"], arrays["wd"], arrays["moy"]
                th = max(range(24), key=lambda i: hod[i])
                tw = max(range(7), key=lambda i: wd[i])
                tm = max(range(12), key=lambda i: moy[i])
                best_tv.setText("в %02d:00–%02d:00\n%s\nв %s" % (th, (th + 1) % 24, WDAYS_ON[tw], MONTHS_IN[tm]))
            else:
                best_tv.setText("Пока нет данных")

        def update_cover():
            path = store.cover_path(artist, title)
            exists = os.path.exists(path)
            if st["cover"] == exists:
                return
            st["cover"] = exists
            bmp = None
            if exists:
                try:
                    src = BitmapFactory.decodeFile(path)
                    if src is not None:
                        bmp = round_bitmap(src, cover_size, float(dp(14)))
                except Exception as e:
                    log("cover load error: %r" % (e,))
            if bmp is None:
                bmp = placeholder_bitmap(cover_size, float(dp(14)), pal)
            cover_iv.setImageBitmap(bmp)

        def apply_ts(t2):
            if not scr.alive:
                return
            st["ts"] = t2
            st["added_at"] = float(t2.get("added_at", 0.0))
            recompute(t2)
            update_numbers()
            update_cover()
            if not chart.running():
                chart.draw(1.0)

        def refresh():
            if st["busy"] or not scr.alive:
                return
            st["busy"] = True

            def work():
                try:
                    t2 = store.track_stats(artist, title)
                    if not t2["duration"] and st["ts"]["duration"]:
                        t2["duration"] = st["ts"]["duration"]
                    run_on_ui_thread(lambda: apply_ts(t2))
                except Exception as e:
                    log("track refresh error: %r" % (e,))
                finally:
                    st["busy"] = False

            threading.Thread(target=work, daemon=True).start()

        def tick():
            st["ticks"] += 1
            update_numbers()
            if st["ticks"] % 3 == 0:
                refresh()

        scr.on_dismiss = chart.stop

        update_numbers()
        update_cover()
        chart.draw(0.0)
        scr.show()
        scr.ticker(tick, 1000)
        scr.handler.postDelayed(_Run(chart.animate), 350)
