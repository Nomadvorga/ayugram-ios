)

if MethodHook is not None:
    class _PluginHook(MethodHook):
        handler = ""
        tag = ""
        quiet = False

        def __init__(self, plugin):
            self.plugin = plugin

        def _dispatch(self, param):
            try:
                getattr(self.plugin, self.handler)(param)
            except Exception as e:
                if not self.quiet:
                    self.plugin.menu_status["error"] = "%s: %r" % (self.tag, e)
                    log("%s hook error: %r" % (self.tag, e))

    class _AfterHook(_PluginHook):
        def after_hooked_method(self, param):
            self._dispatch(param)

    class _BeforeHook(_PluginHook):
        def before_hooked_method(self, param):
            self._dispatch(param)

    class _PlayerCtorHook(_AfterHook):
        handler, tag = "_player_after_ctor", "ctor"

    class _ItemOptionsHook(_AfterHook):
        handler, tag = "_player_after_item_options", "ItemOptions"

    class _SubItemSeenHook(_AfterHook):
        handler, quiet = "_player_after_subitem", True

    class _PopupShowHook(_BeforeHook):
        handler, tag = "_player_before_popup", "popup"

    class _PlayerAddHook(_AfterHook):
        handler, tag = "_player_after_add", "add"

    class _PlayerToggleHook(_BeforeHook):
        handler, tag = "_player_before_toggle", "toggle"

    class _PlayerTitleHook(_AfterHook):
        handler, quiet = "_player_update_visibility", True

    class _PlayerClickHook(_BeforeHook):
        handler, tag = "_player_before_click", "click"


class _LongClick(dynamic_proxy(jclass("android.view.View$OnLongClickListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onLongClick(self, v):
        try:
            self.fn()
        except Exception as e:
            log("long click error: %r" % (e,))
        return True


def _mmss(s):
    s = max(0, int(s))
    return "%d:%02d" % (s // 60, s % 60)


def now_live_pos(info):
    """Текущая позиция трека у слушателя: позиция на сервере + прошедшее время (если не пауза)."""
    pos = float(info.get("position") or 0)
    if not info.get("paused"):
        pos += float(info.get("age") or 0) + max(0.0, time.time() - float(info.get("fetched") or time.time()))
    dur = float(info.get("duration") or 0)
    if dur > 0:
        pos = min(pos, dur)
    return max(0.0, pos)


class NowRow:
    """Строка профиля: «Сейчас слушает: исполнитель - песня» + тайм-код, прогресс, длительность.

    View type, которого нет в ProfileActivity, попадает в `case VIEW_TYPE_VERSION: default`
    и рисуется как «AyuGram <дата>». Поэтому строка ещё и подменяет эту ячейку, если
    клиент всё же отдал тип 0 / 14.
    """

    def __init__(self, plugin, ctx):
        self.plugin = plugin
        self.uid = 0
        ui = UIKit(ctx)
        pal = get_palette()
        dp = ui.dp
        root = ui.vbox()
        root.setBackgroundColor(jint(0))
        root.setPadding(dp(18), dp(8), dp(18), dp(10))
        self.line = ui.text("", 15, pal["text"], True)
        self.line.setMaxLines(2)
        self.line.setEllipsize(ui.TruncateAt.END)
        root.addView(self.line, ui.lp(-1, -2))
        row = ui.hbox()
        row.setGravity(16)
        self.t_pos = ui.text("0:00", 12, pal["gray"])
        self.t_pos.setMinWidth(dp(36))
        self.t_dur = ui.text("0:00", 12, pal["gray"])
        self.t_dur.setMinWidth(dp(36))
        self.t_dur.setGravity(5)
        self.bar = None
        self.fill = self.rest = None
        try:
            pb = jclass("android.widget.ProgressBar")(ctx, None, jint(0x01010078))
            pb.setMax(1000)
            pb.setProgress(0)
            try:
                CSL = jclass("android.content.res.ColorStateList")
                pb.setProgressTintList(CSL.valueOf(jint(pal["accent"])))
                pb.setProgressBackgroundTintList(CSL.valueOf(jint(with_alpha(pal["gray"], 90))))
            except Exception as e:
                log("progress tint error: %r" % (e,))
            self.bar = pb
            row.addView(self.t_pos, ui.lp(-2, -2, r=8))
            row.addView(pb, ui.lp(0, dp(18), 1.0))
            row.addView(self.t_dur, ui.lp(-2, -2, l=8))
        except Exception as e:
            log("progress bar fallback: %r" % (e,))
            bar = ui.hbox()
            bar.setWeightSum(1.0)
            self.fill = View(ctx)
            self.fill.setBackground(ui.rounded(pal["accent"], 2))
            self.rest = View(ctx)
            self.rest.setBackground(ui.rounded(with_alpha(pal["gray"], 70), 2))
            bar.addView(self.fill, ui.lp(0, dp(4), 0.0))
            bar.addView(self.rest, ui.lp(0, dp(4), 1.0))
            row.addView(self.t_pos, ui.lp(-2, -2))
            row.addView(bar, ui.lp(0, dp(4), 1.0, l=8, r=8))
            row.addView(self.t_dur, ui.lp(-2, -2))
            self.bar = bar
        root.addView(row, ui.lp(-1, -2, t=6))
        try:
            RVLP = jclass("androidx.recyclerview.widget.RecyclerView$LayoutParams")
            root.setLayoutParams(RVLP(-1, -2))
        except Exception as e:
            log("now row layout params error: %r" % (e,))
        root.setOnLongClickListener(_LongClick(lambda: plugin._now_row_menu(self.uid)))
        self.view = root

    def update(self):
        info = self.plugin._now_info(self.uid)
        if info is None or not info.get("artist"):
            self._render_no_track()
            return
        self._render_track(info)

    def _render_track(self, info):
        prefix = "На паузе: " if info.get("paused") else "Сейчас слушает: "
        self.line.setText("%s%s - %s" % (
            prefix,
            info.get("artist") or "—",
            info.get("title") or "—",
        ))
        pos = now_live_pos(info)
        dur = float(info.get("duration") or 0)
        frac = min(1.0, pos / dur) if dur > 0 else 0.0
        self.t_pos.setText(_mmss(pos))
        self.t_dur.setText(_mmss(dur) if dur > 0 else "--:--")
        self._set_progress(frac)

    def _render_no_track(self):
        is_me = self.uid == self.plugin._tg_id()
        if is_me:
            self.line.setText("Сейчас не слушает музыку")
        else:
            st = self.plugin._presence_data.get(self.uid) or {}
            status = st.get("_presence_status")
            if status == "idle":
                self.line.setText("использует FMS · сейчас ничего не слушает")
            elif status == "unregistered":
                self.line.setText("не использует FMS")
            else:
                self.line.setText("проверяю статус…")
        self.t_pos.setText("--:--")
        self.t_dur.setText("--:--")
        self._set_progress(0.0)

    def _set_progress(self, frac):
        if self.fill is not None:
            for v, w in ((self.fill, frac), (self.rest, 1.0 - frac)):
                lp = v.getLayoutParams()
                lp.weight = float(w)
                v.setLayoutParams(lp)
            self.bar.requestLayout()
        else:
            try:
                self.bar.setProgress(int(round(frac * 1000)))
            except Exception as e:
                log("progress set error: %r" % (e,))


if MethodHook is not None:
    class _ProfileUpdateRowsHook(MethodHook):
        def __init__(self, plugin): self.plugin = plugin
        def after_hooked_method(self, param):
            try: self.plugin._profile_after_update_rows(param)
            except Exception as e: log("profile updateRowsIds hook error: %r" % (e,))

    class _ProfileItemTypeHook(MethodHook):
        def __init__(self, plugin): self.plugin = plugin
        def before_hooked_method(self, param):
            try: self.plugin._profile_before_item_type(param)
            except Exception as e: log("profile getItemViewType hook error: %r" % (e,))
        def after_hooked_method(self, param):
            try: self.plugin._profile_after_item_type(param)
            except Exception as e: log("profile getItemViewType after error: %r" % (e,))

    class _ProfileCreateVHHook(MethodHook):
        def __init__(self, plugin): self.plugin = plugin
        def before_hooked_method(self, param):
            try: self.plugin._profile_before_create_vh(param)
            except Exception as e: log("profile onCreateViewHolder hook error: %r" % (e,))
        def after_hooked_method(self, param):
            try: self.plugin._profile_after_create_vh(param)
            except Exception as e: log("profile onCreateViewHolder after error: %r" % (e,))

    class _ProfileBindVHHook(MethodHook):
        def __init__(self, plugin): self.plugin = plugin
        def before_hooked_method(self, param):
            try: self.plugin._profile_before_bind_vh(param)
            except Exception as e: log("profile onBindViewHolder hook error: %r" % (e,))

    class _ProfileEnabledHook(MethodHook):
        def __init__(self, plugin): self.plugin = plugin
        def before_hooked_method(self, param):
            try: self.plugin._profile_before_enabled(param)
            except Exception as e: log("profile isEnabled hook error: %r" % (e,))

    class _ProfileDestroyHook(MethodHook):
        def __init__(self, plugin): self.plugin = plugin
        def after_hooked_method(self, param):
            try: self.plugin._profile_after_destroy(param)
            except Exception as e: log("profile onFragmentDestroy hook error: %r" % (e,))


# ───────────────────────── Плагин ─────────────────────────

class MusicStatsPlugin(BasePlugin):
    def on_plugin_load(self):
        self._stores = {}
        self._stores_lock = threading.Lock()
        self._sess = None
        self._src_known = set()
        self._dur_seen = {}
        self.now_playing = None
        self.cur = None
        self.paused = False
        self._cover_next = {}
        self._cover_tries = {}
        self._lyrics = {}
        self._lyrics_busy = set()
        self._prefetched = set()
        self._last_export = ""
        self.stats_period = "week"
        self.stats_tab = 0
        self._presence_watchers = {}
        self._presence_last_tick = 0.0
        self._presence_data = {}
        self._now_rows = {}          # ident ProfileActivity -> (позиция строки, user id)
        self._now_by_adapter = {}    # ident ListAdapter -> (позиция, user id, ident фрагмента)
        self._open_profiles = {}     # ident ProfileActivity -> fragment
        self._profile_play_state = None
        self._now_views = {}
        self._now_live = []
        self._now_ticking = False
        self._now_handler = None
        self._presence_busy = False
        self._presence_warned = False
        self._presence_playing = False
        self._presence_sig = None
        self._presence_lastpos = None
        self._presence_sent_at = 0.0
        self._presence_acl_sig = None
        self._presence_acl_sent = 0.0
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._loop, name="MusicStatsLoop", daemon=True)
        self._thread.start()
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            log("send hook unavailable: %r" % (e,))
        self.menu_status = {"hook": "не установлен", "injected": 0, "clicks": 0, "opened": 0,
                            "present": 0, "toggle": 0, "error": "", "ctor": 0, "title": 0,
                            "chromecast": 0, "add_hooks": 0, "io_hooks": 0, "io_chromecast": 0,
                            "sub_hooks": 0, "sub_chromecast": 0, "popup_hooks": 0, "popup_shows": 0,
                            "popup_chromecast": 0, "popup_injected": 0, "stacks": []}
        self._opt_btn = None
        self._btn_added = set()
        self._ensuring = False
        self._install_player_menu_hook()
        self._install_profile_hook()
        self._register_menu_items()
        log("loaded v%s, db=%s" % (__version__, db_path(selected_account())))

    def on_plugin_unload(self):
        try:
            self._stop.set()
            self._close_session()
            self._flush_all()
            for stop in list(self._presence_watchers.values()):
                try:
                    stop.set()
                except Exception:
                    pass
            self._presence_watchers.clear()
            with self._stores_lock:
                stores = list(self._stores.values())
                self._stores.clear()
            for st in stores:
                st.close()
        except Exception as e:
            log("unload error: %r" % (e,))

    @property
    def store(self):
        return self.store_for(selected_account())

    def store_for(self, acc):
        acc = int(acc)
        with self._stores_lock:
            st = self._stores.get(acc)
            if st is None:
                st = Store(db_path(acc), cover_dir(), acc)
                self._stores[acc] = st
            return st

    def _flush_all(self):
        with self._stores_lock:
            stores = list(self._stores.values())
        for st in stores:
            try:
                st.flush()
            except Exception as e:
                log("flush all error: %r" % (e,))

    # ----- пункты меню ⋮ -----
    def _install_player_menu_hook(self):
        st = self.menu_status
        if MethodHook is None:
            st["hook"] = "в этой версии клиента нет MethodHook"
            return
        try:
            cls = jclass("org.telegram.ui.Components.AudioPlayerAlert").getClass()
            Boolean = jclass("java.lang.Boolean")
            Integer = jclass("java.lang.Integer")
            ctors = cls.getDeclaredConstructors()
            self.hook_method(ctors[0], _PlayerCtorHook(self))
            st["ctor_count"] = len(ctors)
            try:
                self.hook_method(cls.getDeclaredMethod("updateTitle", Boolean.TYPE), _PlayerTitleHook(self))
            except Exception as e:
                st["error"] = "updateTitle: %r" % (e,)
            self.hook_method(cls.getDeclaredMethod("onSubItemClick", Integer.TYPE), _PlayerClickHook(self))
            try:
                item_cls = jclass("org.telegram.ui.ActionBar.ActionBarMenuItem").getClass()
                for m in item_cls.getDeclaredMethods():
                    if str(m.getName()) == "toggleSubMenu":
                        self.hook_method(m, _PlayerToggleHook(self))
                        st["toggle"] += 1
            except Exception as e:
                st["error"] = "toggleSubMenu: %r" % (e,)
            try:
                item_cls2 = jclass("org.telegram.ui.ActionBar.ActionBarMenuItem").getClass()
                for m in item_cls2.getDeclaredMethods():
                    if str(m.getName()) == "addSubItem":
                        self.hook_method(m, _PlayerAddHook(self))
                        st["add_hooks"] += 1
            except Exception as e:
                st["error"] = "addSubItem: %r" % (e,)
            self._hook_by_name("org.telegram.ui.Components.ItemOptions", ("add",), True,
                               _ItemOptionsHook, "io_hooks", "ItemOptions")
            self._hook_by_name("org.telegram.ui.ActionBar.ActionBarMenuSubItem",
                               ("setTextAndIcon", "setText"), False, _SubItemSeenHook, "sub_hooks", "SubItem")
            self._hook_by_name("android.widget.PopupWindow", ("show",), True, _PopupShowHook,
                               "popup_hooks", "PopupWindow")
            st["hook"] = "установлен"
        except Exception as e:
            st["hook"] = "не удалось установить"
            st["error"] = repr(e)
            log("player menu hook failed: %r" % (e,))

    def _hook_by_name(self, class_name, names, prefix, hook_cls, counter, tag):
        st = self.menu_status
        try:
            cls = jclass(class_name).getClass()
            methods = cls.getDeclaredMethods()
            for i in range(len(methods)):
                m = methods[i]
                nm = str(m.getName())
                ok = any(nm.startswith(x) for x in names) if prefix else nm in names
                if ok:
                    try:
                        self.hook_method(m, hook_cls(self))
                        st[counter] += 1
                    except Exception as e:
                        st["error"] = "%s.%s: %r" % (tag, nm, e)
        except Exception as e:
            st["error"] = "%s: %r" % (tag, e)

    def _arg_texts(self, param):
        out = []
        for a in jlist(param.args):
            if a is None or isinstance(a, (bool, int, float)):
                continue
            try:
                out.append(str(a))
            except Exception:
                pass
        return out

    def _note_stack(self, tag):
        try:
            frames = jclass("java.lang.Throwable")().getStackTrace()
            names = []
            for i in range(len(frames)):
                f = frames[i]
                cn = str(f.getClassName())
                low = cn.lower()
                if "hook" in low or "lsp" in low or cn.startswith("java.lang.Throwable"):
                    continue
                names.append(cn.split(".")[-1] + "." + str(f.getMethodName()))
                if len(names) >= 8:
                    break
            stacks = self.menu_status["stacks"]
            line = tag + ": " + " ← ".join(names)
            if line not in stacks:
                stacks.append(line)
            del stacks[:-4]
        except Exception as e:
            self.menu_status["error"] = "stack: %r" % (e,)

    def _player_action(self, k):
        def run():
            self.menu_status["clicks"] += 1
            if k == 0:
                self.open_stats()
            elif k == 1:
                self.open_lyrics()
            elif k == 2:
                self.open_current_track_stats()
            else:
                self.open_recap()
        return run

    def _player_after_item_options(self, param):
        if self._ensuring or not self.get_setting("player_menu", True):
            return
        if "Chromecast" not in self._arg_texts(param):
            return
        st = self.menu_status
        st["io_chromecast"] += 1
        self._note_stack("ItemOptions")
        self._ensuring = True
        try:
            opts = param.thisObject
            for k, (label, icons) in enumerate(PLAYER_ITEMS):
                opts.add(self._icon_id(*icons), label, _Run(self._player_action(k)))
            st["injected"] += 1
        finally:
            self._ensuring = False

    def _player_after_subitem(self, param):
        if "Chromecast" in self._arg_texts(param):
            self.menu_status["sub_chromecast"] += 1
            self._note_stack("SubItem")

    def _player_before_popup(self, param):
        if not self.get_setting("player_menu", True):
            return
        popup = param.thisObject
        content = popup.getContentView()
        if content is None:
            return
        st = self.menu_status
        st["popup_shows"] += 1
        TextView = jclass("android.widget.TextView")
        LinearLayout = jclass("android.widget.LinearLayout")
        found = []
        labels = [x[0] for x in PLAYER_ITEMS]

        def walk(v, depth):
            if v is None or depth > 14:
                return
            try:
                if isinstance(v, TextView):
                    t = str(v.getText())
                    if t == "Chromecast" or t in labels:
                        found.append((t, v))
            except Exception:
                pass
            try:
                n = int(v.getChildCount())
            except Exception:
                return
            for i in range(n):
                walk(v.getChildAt(i), depth + 1)

        walk(content, 0)
        if not any(t == "Chromecast" for t, _ in found):
            return
        if any(t in labels for t, _ in found):
            return
        st["popup_chromecast"] += 1
        self._note_stack("PopupWindow")
        tv = [v for t, v in found if t == "Chromecast"][0]

        row, parent = tv, tv.getParent()
        while parent is not None:
            is_menu_column = False
            try:
                is_menu_column = (isinstance(parent, LinearLayout)
                                  and int(parent.getOrientation()) == 1 and int(parent.getChildCount()) >= 3)
            except Exception:
                pass
            if is_menu_column:
                break
            row, parent = parent, parent.getParent()
        if parent is None:
            st["error"] = "popup: контейнер меню не найден"
            return

        ctx = parent.getContext()
        density = float(ctx.getResources().getDisplayMetrics().density)
        SubItem = jclass("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
        ref_item = None
        try:
            p0 = tv.getParent()
            if isinstance(p0, SubItem):
                ref_item = p0
        except Exception:
            ref_item = None
        idx = int(parent.indexOfChild(row))

        def make_click(k):
            fn = self._player_action(k)

            def on_click():
                try:
                    popup.dismiss()
                except Exception:
                    pass
                fn()
            return on_click

        for k, (label, icons) in enumerate(PLAYER_ITEMS):
            item = SubItem(ctx, False, False)
            item.setTextAndIcon(label, self._icon_id(*icons))
            style_menu_item(item, ref_item, tv)
            item.setOnClickListener(_Click(make_click(k)))
            parent.addView(item, idx + 1 + k, LinearLayout.LayoutParams(-1, int(48 * density)))
        st["popup_injected"] += 1

    def _icon_id(self, *names):
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        res = ctx.getResources()
        pkg = ctx.getPackageName()
        for n in names:
            try:
                i = int(res.getIdentifier(n, "drawable", pkg))
                if i:
                    return i
            except Exception:
                pass
        return 0

    def _ensure_player_items(self, btn):
        if self._ensuring:
            return
        self._ensuring = True
        try:
            self._ensure_player_items_impl(btn)
        finally:
            self._ensuring = False

    def _ensure_player_items_impl(self, btn):
        System = jclass("java.lang.System")
        ident = int(System.identityHashCode(btn))
        present = 0
        for i, (label, icons) in enumerate(PLAYER_ITEMS):
            iid = PLAYER_ITEM_BASE_ID + i
            exists = ident in self._btn_added
            if not exists:
                btn.addSubItem(iid, self._icon_id(*icons), label)
                self.menu_status["injected"] += 1
            present += 1
            btn.setSubItemShown(iid, True)
        if len(self._btn_added) > 100:
            self._btn_added.clear()
        self._btn_added.add(ident)
        self.menu_status["present"] = present
        self._restyle_player_items(btn)

    def _restyle_player_items(self, btn):
        """Красит наши пункты в цвета темы клиента (как у родных пунктов меню ⋮)."""
        try:
            layout = get_private_field(btn, "popupLayout")
        except Exception:
            return
        SubItem = jclass("org.telegram.ui.ActionBar.ActionBarMenuSubItem")
        labels = set(x[0] for x in PLAYER_ITEMS)
        mine, chromecast, other = [], [], []

        def walk(v, depth):
            if v is None or depth > 12:
                return
            try:
                if isinstance(v, SubItem):
                    txt = ""
                    try:
                        txt = str(v.getTextView().getText())
                    except Exception:
                        pass
                    if txt in labels:
                        mine.append(v)
                    elif txt == "Chromecast":
                        chromecast.append(v)
                    else:
                        other.append(v)
                    return
            except Exception:
                pass
            try:
                n = int(v.getChildCount())
            except Exception:
                return
            for i in range(n):
                walk(v.getChildAt(i), depth + 1)

        try:
            walk(layout, 0)
            ref = chromecast[0] if chromecast else (other[0] if other else None)
            for item in mine:
                style_menu_item(item, ref)
        except Exception as e:
            log("restyle player items failed: %r" % (e,))

    def _player_after_ctor(self, param):
        self.menu_status["ctor"] += 1
        if not self.get_setting("player_menu", True):
            return
        btn = get_private_field(param.thisObject, "optionsButton")
        self._opt_btn = btn
        self._ensure_player_items(btn)

    def _player_update_visibility(self, param):
        self.menu_status["title"] += 1
        if not self.get_setting("player_menu", True):
            return
        btn = get_private_field(param.thisObject, "optionsButton")
        self._opt_btn = btn
        self._ensure_player_items(btn)

    def _player_after_add(self, param):
        if self._ensuring or not self.get_setting("player_menu", True):
            return
        texts = []
        for a in (list(param.args) if param.args is not None else []):
            if a is None or isinstance(a, (bool, int, float)):
                continue
            try:
                texts.append(str(a))
            except Exception:
                pass
        if "Chromecast" not in texts:
            return
        self.menu_status["chromecast"] += 1
        self._ensure_player_items(param.thisObject)

    def _player_before_toggle(self, param):
        btn = self._opt_btn
        if btn is None or not self.get_setting("player_menu", True):
            return
        System = jclass("java.lang.System")
        if int(System.identityHashCode(param.thisObject)) != int(System.identityHashCode(btn)):
            return
        self.menu_status["opened"] += 1
        self._ensure_player_items(btn)

    def _player_before_click(self, param):
        item_id = int(param.args[0])
        idx = item_id - PLAYER_ITEM_BASE_ID
        if not (0 <= idx < len(PLAYER_ITEMS)):
            return
        param.setResult(None)
        self.menu_status["clicks"] += 1
        if idx == 0:
            self.open_stats()
        elif idx == 1:
            self.open_lyrics()
        elif idx == 2:
            self.open_current_track_stats()
        else:
            self.open_recap()

    # ----- пункты меню сообщений/бокового -----
    def _register_menu_items(self):
        try:
            from base_plugin import MenuItemData, MenuItemType
        except Exception as e:
            log("menu api unavailable: %r" % (e,))
            return

        def add(menu_type, text, fn, condition=None):
            try:
                kwargs = dict(menu_type=menu_type, text=text, on_click=fn)
                if condition:
                    kwargs["condition"] = condition
                self.add_menu_item(MenuItemData(**kwargs))
            except Exception as e:
                log("menu item '%s' failed: %r" % (text, e))

        msg_type = getattr(MenuItemType, "MESSAGE_CONTEXT_MENU", None)
        if msg_type is not None:
            cond = "message.isMusic()"
            add(msg_type, "Статистика", lambda *a, **k: self.open_stats(), cond)
            add(msg_type, "Текст", lambda *a, **k: self.open_lyrics(), cond)
            add(msg_type, "Статистика трека",
                lambda *a, **k: self._track_stats_from_context(a[0] if a else None), cond)
        drawer = getattr(MenuItemType, "DRAWER_MENU", None)
        if drawer is not None:
            add(drawer, "Музыка: статистика", lambda *a, **k: self.open_stats())
            add(drawer, "Музыка: текст песни", lambda *a, **k: self.open_lyrics())
            add(drawer, "Музыка: итоги периода", lambda *a, **k: self.open_recap())

    def _track_stats_from_context(self, ctx):
        msg = None
        try:
            msg = ctx.get("message") if isinstance(ctx, dict) else getattr(ctx, "message", None)
        except Exception:
            msg = None
        try:
            if msg is not None and msg.isMusic():
                artist, title, dur = track_from_mo(msg)
                self.open_track_stats(artist, title, dur)
                return
        except Exception as e:
            log("context track error: %r" % (e,))
        self.open_current_track_stats()

    # ----- фоновый учёт -----
    def _loop(self):
        MC = jclass("org.telegram.messenger.MediaController")
        last = time.monotonic()
        last_flush = last
        last_backup = 0.0
        while not self._stop.wait(1.0):
            now = time.monotonic()
            dt = min(now - last, 2.0)
            last = now
            try:
                mc = MC.getInstance()
                mo = mc.getPlayingMessageObject()
                if mo is not None and mo.isMusic():
                    artist, title, dur = track_from_mo(mo)
                    try:
                        acc = int(mo.currentAccount)
                    except Exception:
                        acc = selected_account()
                    store = self.store_for(acc)
                    artist, title = store.canon(artist, title)
                    paused = bool(mc.isMessagePaused())
                    self.cur = (artist, title, dur)
                    self.paused = paused
                    if self.get_setting("lyrics_prefetch", True):
                        self._prefetch_lyrics(artist, title, dur)
                    if self.get_setting("enabled", True):
                        self._maybe_cover(store, mo, artist, title, now)
                        if dur > 0 and self._dur_seen.get((acc, artist, title)) != dur:
                            self._dur_seen[(acc, artist, title)] = dur
                            store.set_duration(artist, title, dur)
                        self._tick_session(store, acc, mo, artist, title, dur, paused, dt)
                    else:
                        self._close_session()
                        self.now_playing = None
                else:
                    self.cur = None
                    self.paused = False
                    self.now_playing = None
                    self._close_session()
            except Exception as e:
                log("tick error: %r" % (e,))
            play_state = (self.cur, bool(self.paused))
            if play_state != self._profile_play_state:
                self._profile_play_state = play_state
                self._refresh_open_profiles()
            if now - last_flush >= 10:
                last_flush = now
                self._flush_all()
            if now - self._presence_last_tick >= 1.0:
                self._presence_last_tick = now
                self._presence_kick()
            if now - last_backup >= 3600:
                last_backup = now
                self._auto_backup()
        self._close_session()
        self._flush_all()

    def _tick_session(self, store, acc, mo, artist, title, dur, paused, dt):
        sess = self._sess
        ident = (acc, artist, title)
        pos = self.current_position()
        if sess is not None and sess["id"] != ident:
            self._close_session()
            sess = None
        if paused:
            self.now_playing = None
            if sess is not None:
                if sess["paused_at"] is None:
                    sess["paused_at"] = time.time()
                elif time.time() - sess["paused_at"] > 120:
                    self._close_session()
            return
        if (sess is not None and pos is not None and sess["last_pos"] is not None
                and pos < sess["last_pos"] - 10 and pos < 5):
            self._close_session()
            sess = None
        if sess is None:
            sess = self._sess = {
                "id": ident, "store": store, "artist": artist, "title": title, "dur": dur,
                "start": int(time.time()), "last_t": time.time(), "secs": 0.0, "last_pos": None,
                "stall": 0, "paused_at": None, "src": self._source_of(mo, acc, store),
            }
        sess["paused_at"] = None
        moved = True
        if pos is not None:
            lp = sess["last_pos"]
            moved = lp is None or abs(pos - lp) > 0.05
            sess["last_pos"] = pos
        sess["stall"] = 0 if moved else sess["stall"] + 1
        self.now_playing = (artist, title)
        if sess["stall"] < 3:
            store.add(int(time.time() // 60 * 60), artist, title, dt)
            sess["secs"] += dt
        sess["last_t"] = time.time()

    def _close_session(self):
        s = self._sess
        self._sess = None
        if not s or s["secs"] < SESSION_MIN_SECS:
            return
        secs, dur = s["secs"], s["dur"]
        counted = 1 if (secs >= PLAY_MIN_SECS or (dur > 0 and secs >= dur * 0.5)) else 0
        pct = min(1.0, secs / dur) if dur > 0 else 0.0
        try:
            s["store"].add_session(s["start"], int(s["last_t"]), s["artist"], s["title"],
                                   secs, dur, pct, counted, s["src"])
        except Exception as e:
            log("session save error: %r" % (e,))

    def _source_of(self, mo, acc, store):
        try:
            did = int(mo.getDialogId())
        except Exception:
            return None
        if not did:
            return None
        key = (acc, did)
        if key not in self._src_known:
            self._src_known.add(key)
            try:
                store.set_source(did, self._resolve_source(acc, did))
            except Exception as e:
                log("source save error: %r" % (e,))
        return did

    def _resolve_source(self, acc, did):
        try:
            me = int(jclass("org.telegram.messenger.UserConfig").getInstance(acc).getClientUserId())
            if did == me:
                return "Избранное"
            mc = jclass("org.telegram.messenger.MessagesController").getInstance(acc)
            Long = jclass("java.lang.Long")
            if did > 0:
                u = mc.getUser(Long(did))
                if u is not None:
                    nm = ("%s %s" % (str(u.first_name or ""), str(u.last_name or ""))).strip()
                    if nm:
                        return nm
            else:
                ch = mc.getChat(Long(-did))
                if ch is not None and ch.title:
                    return str(ch.title)
        except Exception as e:
            log("resolve source error: %r" % (e,))
        return "Чат %d" % did

    # ----- резервные копии -----
    def _backup_files(self, acc):
        d = sub_dir("music_stats_backups")
        pre = "acc%d_" % int(acc)
        try:
            names = sorted([n for n in os.listdir(d) if n.startswith(pre) and n.endswith(".db")], reverse=True)
        except Exception:
            names = []
        return d, names

    def _auto_backup(self):
        if not self.get_setting("backup_auto", True):
            return
        try:
            acc = selected_account()
            d, names = self._backup_files(acc)
            name = "acc%d_%s.db" % (acc, time.strftime("%Y%m%d"))
            if name in names:
                return
            self.store_for(acc).backup_to(os.path.join(d, name))
            d, names = self._backup_files(acc)
            for old in names[5:]:
                try:
                    os.remove(os.path.join(d, old))
                except Exception:
                    pass
            log("backup created: " + name)
        except Exception as e:
            log("backup error: %r" % (e,))

    def restore_backup(self, path):
        acc = selected_account()
        self._close_session()
        with self._stores_lock:
            st = self._stores.pop(acc, None)
        if st is not None:
            st.close()
        dst = db_path(acc)
        shutil.copyfile(path, dst)
        for suf in ("-wal", "-shm"):
            try:
                os.remove(dst + suf)
            except Exception:
                pass
        self.store_for(acc)

    # ----- обложки -----
    def _extract_cover(self, store, mo, artist, title, notes=None):
        path = store.cover_path(artist, title)

        def note(m):
            if notes is not None:
                notes.append(m)
            log("cover: " + m)

        BitmapFactory = jclass("android.graphics.BitmapFactory")
        bmp = None
        acc = None
        try:
            acc = int(mo.currentAccount)
        except Exception:
            acc = None

        try:
            doc = mo.getDocument()
            best = None
            if doc is not None and doc.thumbs is not None:
                for t in jlist(doc.thumbs):
                    nm = str(t.getClass().getSimpleName())
                    if "Stripped" in nm or "Empty" in nm or "Path" in nm:
                        continue
                    if best is None or t.w > best.w:
                        best = t
            if best is None:
                note("A: у трека нет миниатюры")
            else:
                TL = "org.telegram.tgnet.TLObject"
                f = file_loader_call("getPathToAttach", [TL], [best], acc)
                if f is None or not f.exists():
                    f = file_loader_call("getPathToAttach", [TL, "boolean"], [best, True], acc)
                if f is not None and f.exists():
                    bmp = BitmapFactory.decodeFile(str(f.getAbsolutePath()))
                    note("A: ok" if bmp is not None else "A: файл не декодируется")
                else:
                    note("A: файл миниатюры не найден")
        except Exception as e:
            note("A: ошибка %r" % (e,))

        if bmp is None:
            try:
                info = jclass("org.telegram.messenger.MediaController").getInstance().getAudioInfo()
                cover = info.getCover() if info is not None else None
                if cover is not None:
                    bmp = cover
                    note("B: ok")
                else:
                    note("B: в плеере нет обложки")
            except Exception as e:
                note("B: ошибка %r" % (e,))

        if bmp is None:
            try:
                f = file_loader_call("getPathToMessage", ["org.telegram.tgnet.TLRPC$Message"], [mo.messageOwner], acc)
                if f is None or not f.exists():
                    note("C: файл трека не найден")
                else:
                    mmr = jclass("android.media.MediaMetadataRetriever")()
                    try:
                        mmr.setDataSource(str(f.getAbsolutePath()))
                        pic = mmr.getEmbeddedPicture()
                    finally:
                        try:
                            mmr.release()
                        except Exception:
                            pass
                    if pic is None:
                        note("C: в файле нет обложки")
                    else:
                        bmp = BitmapFactory.decodeByteArray(pic, 0, len(pic))
                        note("C: ok" if bmp is not None else "C: не декодируется")
            except Exception as e:
                note("C: ошибка %r" % (e,))

        if bmp is None:
            return False
        try:
            save_cover(bmp, path)
            return True
        except Exception as e:
            note("сохранение: ошибка %r" % (e,))
            return False

    def _maybe_cover(self, store, mo, artist, title, now):
        key = (artist, title)
        if os.path.exists(store.cover_path(artist, title)):
            return
        if self._cover_tries.get(key, 0) >= 12 or now < self._cover_next.get(key, 0):
            return
        self._cover_tries[key] = self._cover_tries.get(key, 0) + 1
        self._cover_next[key] = now + 6
        self._extract_cover(store, mo, artist, title)

    def _info_dialog(self, title, message):
        def show():
            act = self._activity()
            if act is None:
                toast((title + ": " + message.replace("\n", " | "))[:290])
                return
            Builder = _TgBuilder
            bld = Builder(act)
            bld.setTitle(title)
            bld.setMessage(message)
            bld.setPositiveButton("OK", _DialogChoice(lambda _: None))
            bld.show()
        run_on_ui_thread(show)

    def diagnose_cover(self):
        def work():
            try:
                mc = jclass("org.telegram.messenger.MediaController").getInstance()
                mo = mc.getPlayingMessageObject()
                if mo is None or not mo.isMusic():
                    toast("Диагностика: включи трек в Telegram")
                    return
                artist, title, _d = track_from_mo(mo)
                store = self.store
                artist, title = store.canon(artist, title)
                notes = []
                ok = self._extract_cover(store, mo, artist, title, notes)
                self._info_dialog("Обложка: " + ("сохранена" if ok else "не найдена"), "\n".join(notes))
            except Exception as e:
                toast("Диагностика: ошибка %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    # ----- позиция и тексты -----
    def current_position(self):
        try:
            mc = jclass("org.telegram.messenger.MediaController").getInstance()
            mo = mc.getPlayingMessageObject()
            if mo is None:
                return None
            dur = float(mo.getDuration())
            if dur > 0:
                return float(mo.audioProgress) * dur
            return float(mo.audioProgressSec)
        except Exception:
            return None

    def _lyrics_sources(self):
        return [k for k in LYRIC_ORDER if self.get_setting("lyr_" + k, True)]

    def get_lyrics(self, artist, title, duration):
        key = (artist, title)
        entry = self._lyrics.get(key)
        if entry is not None:
            if entry["status"] != "error" or time.time() - entry.get("ts", 0) < 30:
                return entry
        if key in self._lyrics_busy:
            return {"status": "loading"}
        self._lyrics_busy.add(key)
        sources = self._lyrics_sources()
        use_cache = bool(self.get_setting("lyrics_cache", True))

        def work():
            try:
                res = fetch_lyrics(artist, title, duration, sources, use_cache)
            except Exception as e:
                log("lyrics error: %r" % (e,))
                res = {"status": "error", "lines": [], "times": [], "plain": None}
            res["ts"] = time.time()
            self._lyrics[key] = res
            if len(self._lyrics) > 30:
                try:
                    self._lyrics.pop(next(iter(self._lyrics)))
                except Exception:
                    pass
            self._lyrics_busy.discard(key)

        threading.Thread(target=work, daemon=True).start()
        return {"status": "loading"}

    def _prefetch_lyrics(self, artist, title, duration):
        """Заранее качает текст играющего трека, чтобы он уже лежал в памяти устройства."""
        key = (artist, title)
        if key in self._prefetched:
            return
        if len(self._prefetched) > 300:
            self._prefetched.clear()
        self._prefetched.add(key)
        if key not in self._lyrics:
            self.get_lyrics(artist, title, duration)

    def lyrics_cache_label(self):
        n, size = lyrics_cache_stats()
        if not n:
            return "Очистить сохранённые тексты (пусто)"
        return "Очистить сохранённые тексты (%d шт., %d КБ)" % (n, max(1, size // 1024))

    def clear_lyrics_cache(self):
        def work():
            n = lyrics_cache_clear()
            self._lyrics.clear()
            self._prefetched.clear()
            toast("Удалено текстов: %d" % n)
        threading.Thread(target=work, daemon=True).start()

    # ----- общие -----
    def _activity(self):
        try:
            frag = get_last_fragment()
            act = frag.getParentActivity() if frag is not None else None
            if act is not None:
                return act
        except Exception as e:
            log("fragment error: %r" % (e,))
        try:
            return jclass("org.telegram.ui.LaunchActivity").instance
        except Exception as e:
            log("launch activity error: %r" % (e,))
            return None

    def _safe(self, fn, *args):
        try:
            fn(*args)
        except Exception as e:
            import traceback
            log("window error: " + traceback.format_exc())
            try:
                fr = traceback.extract_tb(e.__traceback__)[-1]
                where = "стр. %s: %s" % (fr.lineno, (fr.line or "").strip()[:70])
            except Exception:
                where = "?"
            msg = str(e)
            toast("MusicStats %s" % where)
            for i in range(0, min(len(msg), 360), 70):
                toast(msg[i:i + 70])

    # ----- экспорт / импорт / отправка файлов -----
    def _export_dir(self):
        return sub_dir("music_stats_exports")

    def _send_saved(self, path, mime, caption=""):
        def work():
            try:
                ok, err = send_file_to_saved(path, mime, caption)
                toast("Отправлено в Избранное" if ok else "Не удалось отправить: %s" % err)
            except Exception as e:
                log("send saved error: %r" % (e,))
                toast("Не удалось отправить: %r" % (e,))
        threading.Thread(target=work, daemon=True).start()

    def export_json(self):
        def work():
            try:
                data = self.store.export_data()
                name = "music_stats_%s.json" % time.strftime("%Y%m%d_%H%M%S")
                path = os.path.join(self._export_dir(), name)
                with open(path, "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False)
                where = save_public(path, name, "application/json") or path
                self._last_export = "/storage/emulated/0/Download/" + name
                toast("Экспорт сохранён: %s" % where)
            except Exception as e:
                log("export json error: %r" % (e,))
                toast("Не удалось экспортировать: %r" % (e,))
        threading.Thread(target=work, daemon=True).start()

    def export_csv(self):
        def work():
            try:
                text = self.store.export_csv()
                name = "music_stats_%s.csv" % time.strftime("%Y%m%d_%H%M%S")
                path = os.path.join(self._export_dir(), name)
                with open(path, "w", encoding="utf-8") as f:
                    f.write(text)
                where = save_public(path, name, "text/csv") or path
                toast("CSV сохранён: %s" % where)
            except Exception as e:
                log("export csv error: %r" % (e,))
                toast("Не удалось экспортировать: %r" % (e,))
        threading.Thread(target=work, daemon=True).start()

    def send_backup_saved(self):
        def work():
            try:
                acc = selected_account()
                path = os.path.join(self._export_dir(), "music_stats_backup_%s.db" % time.strftime("%Y%m%d_%H%M%S"))
                self.store_for(acc).backup_to(path)
                ok, err = send_file_to_saved(path, "application/octet-stream", "Музыка · копия статистики")
                toast("Копия отправлена в Избранное" if ok else "Не удалось отправить: %s" % err)
            except Exception as e:
                log("send backup error: %r" % (e,))
                toast("Не удалось отправить копию: %r" % (e,))
        threading.Thread(target=work, daemon=True).start()

    def _do_import(self, path):
        def work():
            try:
                if not path:
                    toast("Путь к файлу не указан")
                    return
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                self.store.import_data(data)
                toast("Импорт завершён")
            except Exception as e:
                log("import error: %r" % (e,))
                toast("Не удалось импортировать: %r" % (e,))
        threading.Thread(target=work, daemon=True).start()

    def confirm_reset(self):
        def show():
            act = self._activity()
            if act is None:
                return
            b = self._build_dialog(act)
            b.setTitle("Сбросить статистику?")
            b.setMessage("Все накопленные данные этого аккаунта будут удалены без возможности восстановления.")
            b.setPositiveButton("Сбросить", _DialogChoice(lambda _: self.store.reset()))
            b.setNegativeButton("Отмена", _DialogChoice(lambda _: None))
            b.show()
        run_on_ui_thread(show)

    # ----- команды -----
    def _send_text(self, params, attr, text):
        try:
            setattr(params, attr, text)
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        except Exception as e:
            log("modify message failed: %r" % (e,))
            toast(text[:200])
            return HookResult(strategy=HookStrategy.CANCEL)

    def on_send_message_hook(self, account, params):
        try:
            attr = "message"
            msg = getattr(params, "message", None)
            if msg is None:
                attr = "text"
                msg = getattr(params, "text", None)
            parts = str(msg).strip().lower().split() if msg is not None else []
            if not parts:
                return HookResult()
            cmd, args = parts[0], parts[1:]
            if cmd in (".music", ".музыка"):
                if not args:
                    self.open_stats()
                    return HookResult(strategy=HookStrategy.CANCEL)
                if args[0] in ("top", "топ"):
                    period = PERIOD_ALIASES.get(args[1], "week") if len(args) > 1 else "week"
                    snap = self.store_for(account).snapshot(period)
                    lines = ["Топ треков · %s" % PERIOD_TITLES[period]]
                    for i, (a, t, s) in enumerate(snap["top_tracks"], 1):
                        lines.append("%d. %s — %s (%s)" % (i, a, t, fmt_smart(s)))
                    if len(lines) == 1:
                        lines.append("пока нет данных")
                    return self._send_text(params, attr, "\n".join(lines))
                period = PERIOD_ALIASES.get(args[0])
                if period:
                    return self._send_text(params, attr, summary_text(self.store_for(account).snapshot(period), period))
                self.open_stats()
                return HookResult(strategy=HookStrategy.CANCEL)
            if cmd in (".recap", ".итоги"):
                self.open_recap(PERIOD_ALIASES.get(args[0], "year") if args else "year")
                return HookResult(strategy=HookStrategy.CANCEL)
            if len(parts) == 1 and parts[0] in (".lyrics", ".текст"):
                self.open_lyrics()
                return HookResult(strategy=HookStrategy.CANCEL)
            if len(parts) == 1 and parts[0] in (".track", ".трек"):
                self.open_current_track_stats()
                return HookResult(strategy=HookStrategy.CANCEL)
        except Exception as e:
            log("hook error: %r" % (e,))
        return HookResult()

    # ----- раскладка / режим -----
    def ui_mode(self):
        try:
            return "classic" if self.get_setting("ui_classic", False) else "tabs"
        except Exception:
            return "tabs"

    def load_layout(self):
        try:
            raw = self.get_setting("layout_json", "")
            return normalize_layout(json.loads(raw) if raw else None)
        except Exception as e:
            log("layout load error: %r" % (e,))
            return default_layout()

    def save_layout(self, layout):
        try:
            self.set_setting("layout_json", json.dumps(layout, ensure_ascii=False))
        except Exception as e:
            log("layout save error: %r" % (e,))

    def open_layout_editor(self, reopen=False):
        run_on_ui_thread(lambda: self._safe(self._show_layout_editor, reopen))

    # ----- стиль графика -----
    def chart_donut(self):
        use_selector = getattr(self, "_selector_ok", Selector is not None)
        try:
            if use_selector:
                return self.get_setting("chart_style", 0) in (1, True)
            return bool(self.get_setting("chart_donut", False))
        except Exception:
            return False

    def set_chart_donut(self, on):
        for k, v in (("chart_style", 1 if on else 0), ("chart_donut", bool(on))):
            try:
                self.set_setting(k, v)
            except Exception as e:
                log("set_setting %s failed: %r" % (k, e))

    # ----- presence -----
    def _tg_id(self, acc=None):
        try:
            a = selected_account() if acc is None else int(acc)
            return int(jclass("org.telegram.messenger.UserConfig").getInstance(a).getClientUserId())
        except Exception:
            return 0

    def _presence_cfg(self):
        srv = str(self.get_setting("presence_server", "") or "").strip().rstrip("/")
        if not srv:
            srv = DEFAULT_PRESENCE_SERVER
        elif not srv.lower().startswith("https://"):
            srv = ""
        return {
            "server": srv,
            "token": str(self.get_setting("presence_token", "") or "").strip(),
            "vis": int(self.get_setting("presence_visibility", 0) or 0),
            "white": str(self.get_setting("presence_whitelist", "") or ""),
            "black": str(self.get_setting("presence_blacklist", "") or ""),
        }

    def _presence_enabled(self):
        return bool(self.get_setting("presence_enabled", False))

    def _ids(self, txt):
        return [int(x) for x in re.findall(r"-?\d+", str(txt))]

    # ----- сеть: передача и получение статуса -----
    def _presence_request(self, method, path, data=None, timeout=6):
        """-> (HTTP-код, dict). Бросает исключение только при сетевой ошибке."""
        cfg = self._presence_cfg()
        body = json.dumps(data).encode("utf-8") if data is not None else None
        headers = {"Authorization": "Bearer " + cfg["token"], "User-Agent": "MusicStatsPresence/3.2"}
        if body is not None:
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(cfg["server"] + path, data=body, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.status, json.loads(r.read().decode("utf-8") or "{}")
        except urllib.error.HTTPError as e:
            try:
                payload = json.loads(e.read().decode("utf-8") or "{}")
            except Exception:
                payload = {}
            return e.code, payload

    def _presence_post(self, payload):
        cfg = self._presence_cfg()
        if not cfg["server"] or not cfg["token"]:
            return 0, {}
        code, res = self._presence_request("POST", "/status", payload)
        if code == 401 and not self._presence_warned:
            self._presence_warned = True
            toast("MusicStats: сервер не принял токен — получи новый у бота (/token)")
        elif code == 200:
            self._presence_warned = False
        return code, res

    def _presence_get(self, tg_id):
        """Статус пользователя: данные трека, {"_presence_status": ...} или None при ошибке."""
        cfg = self._presence_cfg()
        if not cfg["server"] or not cfg["token"]:
            return None
        try:
            code, res = self._presence_request("GET", "/status?user=%d" % int(tg_id))
        except Exception as e:
            log("presence get error: %r" % (e,))
            return None
        if code == 404:
            return {"_presence_status": "unregistered"}
        if code != 200:
            return None
        if res.get("artist"):
            return res
        if res.get("registered") is True:
            return {"_presence_status": "idle"}
        return {"_presence_status": "unregistered"}

    def _presence_kick(self):
        """Раз в секунду из основного цикла: отправка уходит в отдельный поток, чтобы не тормозить учёт."""
        if self._presence_busy:
            return
        self._presence_busy = True

        def work():
            try:
                self._presence_tick()
            except Exception as e:
                log("presence tick error: %r" % (e,))
            finally:
                self._presence_busy = False

        threading.Thread(target=work, daemon=True).start()

    def _presence_tick(self, force=False):
        cfg = self._presence_cfg()
        if not cfg["server"] or not cfg["token"]:
            return
        enabled = self._presence_enabled() and self.get_setting("enabled", True)
        cur = self.cur if enabled else None
        now = time.time()

        if cur is None:
            if self._presence_playing:  # раньше вещали — один раз сообщаем, что музыка остановлена
                code, _r = self._presence_post({"clear": True})
                if code == 200:
                    self._presence_playing = False
                    self._presence_sig = None
                    self._presence_lastpos = None
            return

        artist, title, dur = cur
        paused = bool(self.paused)
        pos = float(self.current_position() or 0.0)
        sig = (artist, title, int(dur or 0), paused)
        lp = self._presence_lastpos
        expected = None
        if lp is not None:
            expected = lp[0] if lp[2] else lp[0] + (now - lp[1])
        seek = expected is not None and abs(pos - expected) > 4.0
        acl_sig = (cfg["vis"], cfg["white"], cfg["black"])

        if not (force or sig != self._presence_sig or seek or acl_sig != self._presence_acl_sig
                or now - self._presence_sent_at >= 15):
            return

        payload = {"tg_id": self._tg_id(), "artist": artist, "title": title, "duration": int(dur or 0),
                   "position": round(pos, 1), "paused": paused}

        if force or acl_sig != self._presence_acl_sig or now - self._presence_acl_sent >= 300:
            payload["visibility"] = cfg["vis"]
            payload["whitelist"] = self._ids(cfg["white"])
            payload["blacklist"] = self._ids(cfg["black"])

        code, _r = self._presence_post(payload)
        if code == 200:
            self._presence_sig = sig
            self._presence_sent_at = now
            self._presence_lastpos = (pos, now, paused)
            self._presence_playing = True
            if "visibility" in payload:
                self._presence_acl_sig = acl_sig
                self._presence_acl_sent = now

    # ----- профиль: установка хуков -----
    def _install_profile_hook(self):
        if MethodHook is None:
            log("profile hook: MethodHook недоступен")
            return
        try:
            cls = jclass("org.telegram.ui.ProfileActivity").getClass()
            self.hook_method(cls.getDeclaredMethod("updateRowsIds"), _ProfileUpdateRowsHook(self))
        except Exception as e:
            log("profile hook (updateRowsIds) failed: %r" % (e,))
            return
        try:
            self.hook_method(cls.getDeclaredMethod("onFragmentDestroy"), _ProfileDestroyHook(self))
        except Exception as e:
            log("profile hook (onFragmentDestroy) failed: %r" % (e,))
        try:
            adapter_cls = jclass("org.telegram.ui.ProfileActivity$ListAdapter").getClass()
            ms = adapter_cls.getDeclaredMethods()
            hooked = set()
            for i in range(len(ms)):
                m = ms[i]
                name, n = str(m.getName()), len(m.getParameterTypes())
                hook = None
                if name == "getItemViewType" and n == 1:
                    hook = _ProfileItemTypeHook
                elif name == "onCreateViewHolder" and n == 2:
                    hook = _ProfileCreateVHHook
                elif name == "onBindViewHolder" and n == 2:
                    hook = _ProfileBindVHHook
                elif name == "isEnabled" and n == 1:
                    hook = _ProfileEnabledHook
                if hook is None or name in hooked:
                    continue
                try:
                    self.hook_method(m, hook(self))
                    hooked.add(name)
                    log("profile hook %s ok" % name)
                except Exception as e:
                    log("profile hook %s failed: %r" % (name, e))
            log("profile hooks: %s" % (", ".join(sorted(hooked)) or "none"))
        except Exception as e:
            log("profile hook (adapter) failed: %r" % (e,))

    # ----- профиль: вспомогательные -----
    NOW_VIEW_TYPE = 6790

    def _ident(self, obj):
        return int(jclass("java.lang.System").identityHashCode(obj))

    def _get_int_field(self, obj, name):
        c = obj.getClass()
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                return int(f.get(obj))
            except Exception:
                c = c.getSuperclass()
        return None

    def _set_int_field(self, obj, name, value):
        c = obj.getClass()
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                f.setInt(obj, int(value))
                return True
            except Exception:
                c = c.getSuperclass()
        return False

    def _find_activity(self, adapter):
        """Внешний ProfileActivity для внутреннего ListAdapter."""
        try:
            f = adapter.getClass().getDeclaredField("this$0")
            f.setAccessible(True)
            return f.get(adapter)
        except Exception:
            pass
        c = adapter.getClass()
        while c is not None:
            fs = c.getDeclaredFields()
            for i in range(len(fs)):
                if str(fs[i].getType().getName()) == "org.telegram.ui.ProfileActivity":
                    try:
                        fs[i].setAccessible(True)
                        return fs[i].get(adapter)
                    except Exception:
                        pass
            c = c.getSuperclass()
        return None

    def _shift_profile_rows(self, frag, p):
        """Вставляем одну строку на позицию p: сдвигаем все индексы строк >= p и rowCount,
        чтобы клики, анимации и остальные строки профиля остались согласованными."""
        c = frag.getClass()
        while c is not None and str(c.getName()) != "org.telegram.ui.ProfileActivity":
            c = c.getSuperclass()
        if c is None:
            raise RuntimeError("ProfileActivity не найден")
        Modifier = jclass("java.lang.reflect.Modifier")
        row_re = re.compile(r"(?i)^(.*row\d*(empty)?|helpsectioncell|botpermission(s?header|s?divider|location|"
                            r"emojistatus|biometry))$")
        fields = c.getDeclaredFields()
        shifted = 0
        for i in range(len(fields)):
            f = fields[i]
            if str(f.getType().getName()) != "int":
                continue
            mod = int(f.getModifiers())
            if Modifier.isStatic(mod) or Modifier.isFinal(mod):
                continue
            name = str(f.getName())
            if name != "rowCount" and not row_re.match(name):
                continue
            f.setAccessible(True)
            v = int(f.getInt(frag))
            if name == "rowCount" or v >= p:
                f.setInt(frag, v + 1)
                shifted += 1
        return shifted

    def _drop_adapter(self, frag_ident):
        dead = [k for k, v in self._now_by_adapter.items() if v[2] == frag_ident]
        for k in dead:
            self._now_by_adapter.pop(k, None)

    def _remember_now(self, frag, ident, pos, uid):
        self._now_rows[ident] = (pos, uid)
        try:
            adapter = get_private_field(frag, "listAdapter")
        except Exception:
            adapter = None
        if adapter is not None:
            self._now_by_adapter[self._ident(adapter)] = (pos, uid, ident)

    def _now_entry_for_adapter(self, adapter):
        ent = self._now_by_adapter.get(self._ident(adapter))
        if ent is not None:
            return ent
        frag = self._find_activity(adapter)
        if frag is None:
            return None
        row = self._now_rows.get(self._ident(frag))
        if row is None:
            return None
        return (row[0], row[1], self._ident(frag))

    def _now_info(self, uid):
        if uid == self._tg_id():
            if self.cur:
                a, t, d = self.cur
                return {"artist": a, "title": t, "duration": d or 0,
                        "position": float(self.current_position() or 0.0),
                        "paused": bool(self.paused), "age": 0.0, "fetched": time.time()}
            # ВАЖНО: Возвращаем статус, чтобы строка создалась, даже если ты ничего не слушаешь
            return {"_presence_status": "idle"}

        data = self._presence_data.get(uid)
        if not data:
            return None

        # Данные считаются устаревшими только если fetched реально установлен и прошло >30 с.
        fetched = data.get("fetched")
        if fetched is not None and time.time() - float(fetched) > 30:
            return None

        # Для строки достаточно наличия трека ИЛИ серверного статуса (idle / unregistered).
        if data.get("artist") or data.get("_presence_status"):
            return data

        return None

    # ----- профиль: хуки -----
    def _profile_after_update_rows(self, param):
        frag = param.thisObject
        ident = self._ident(frag)
        self._now_rows.pop(ident, None)
        self._drop_adapter(ident)
        self._open_profiles[ident] = frag
        if not self.get_setting("presence_show_profile", True):
            return
        if not self.get_setting("enabled", True):
            return
        try:
            uid = int(frag.getDialogId())
        except Exception:
            return
        if uid <= 0:
            return
        me = self._tg_id()
        is_me = uid == me
        cfg = self._presence_cfg()
        if is_me:
            pass
        else:
            if not cfg["server"] or not cfg["token"]:
                return
            self._presence_watch_ensure(frag, ident, uid)
        if self._now_info(uid) is None:
            return
        # Строка версии AyuGram («AyuGram 20261104») — это VIEW_TYPE_VERSION.
        # Если она стоит сразу под шапкой, занимаем её слот, а не вставляем вторую дырку:
        # дырка без своего view type как раз и рисуется текстом версии (default в onCreateViewHolder).
        vr = self._get_int_field(frag, "versionRow")
        base = -1
        for name in ("emptyRow2", "emptyRow"):
            v = self._get_int_field(frag, name)
            if v is not None and v >= 0:
                base = v
                break
        if vr is not None and vr >= 0 and (base < 0 or vr <= base + 4):
            self._set_int_field(frag, "versionRow", -1)
            pos = vr
        else:
            if base < 0:
                return
            pos = base + 1
            try:
                self._shift_profile_rows(frag, pos)
            except Exception as e:
                log("profile shift error: %r" % (e,))
                return
        self._remember_now(frag, ident, pos, uid)
        log("now-row pos=%s uid=%s" % (pos, uid))

    def _profile_before_item_type(self, param):
        ent = self._now_entry_for_adapter(param.thisObject)
        if ent is not None and int(param.args[0]) == int(ent[0]):
            param.setResult(jclass("java.lang.Integer")(int(self.NOW_VIEW_TYPE)))

    def _make_now_holder(self, parent, uid):
        ctx = None
        try:
            if parent is not None:
                ctx = parent.getContext()
        except Exception:
            ctx = None
        if ctx is None:
            try:
                ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            except Exception:
                return None
        row = NowRow(self, ctx)
        row.uid = uid
        Holder = jclass("org.telegram.ui.Components.RecyclerListView$Holder")
        holder = Holder(row.view)
        self._now_views[self._ident(row.view)] = row
        return holder

    def _profile_after_item_type(self, param):
        ent = self._now_entry_for_adapter(param.thisObject)
        if ent is None or int(param.args[0]) != int(ent[0]):
            return
        try:
            cur = param.getResult()
            if cur is not None and int(cur) == self.NOW_VIEW_TYPE:
                return
        except Exception:
            pass
        param.setResult(jclass("java.lang.Integer")(int(self.NOW_VIEW_TYPE)))

    def _profile_wants_now_view(self, adapter, vt):
        if vt != self.NOW_VIEW_TYPE and vt != 0 and vt != 14:
            return None
        ent = self._now_entry_for_adapter(adapter)
        if ent is None:
            return None
        if vt == 14:
            frag = self._find_activity(adapter)
            if frag is not None:
                vr = self._get_int_field(frag, "versionRow")
                if vr is not None and vr >= 0 and int(vr) != int(ent[0]):
                    return None
        return ent

    def _profile_before_create_vh(self, param):
        ent = self._profile_wants_now_view(param.thisObject, int(param.args[1]))
        if ent is None:
            return
        holder = self._make_now_holder(param.args[0], ent[1])
        if holder is not None:
            param.setResult(holder)

    def _profile_after_create_vh(self, param):
        ent = self._profile_wants_now_view(param.thisObject, int(param.args[1]))
        if ent is None:
            return
        try:
            res = param.getResult()
            if res is not None and self._now_views.get(self._ident(res.itemView)) is not None:
                return
        except Exception:
            pass
        holder = self._make_now_holder(param.args[0], ent[1])
        if holder is not None:
            param.setResult(holder)

    def _profile_before_bind_vh(self, param):
        holder = param.args[0]
        row = None
        try:
            row = self._now_views.get(self._ident(holder.itemView))
        except Exception:
            row = None
        if row is None:
            return
        ent = self._now_entry_for_adapter(param.thisObject)
        if ent is not None:
            row.uid = ent[1]
        row.update()
        self._now_register(row)
        param.setResult(None)

    def _profile_before_enabled(self, param):
        holder = param.args[0]
        try:
            if self._now_views.get(self._ident(holder.itemView)) is not None:
                param.setResult(jclass("java.lang.Boolean")(False))
        except Exception:
            pass

    def _profile_after_destroy(self, param):
        frag = param.thisObject
        ident = self._ident(frag)
        self._now_rows.pop(ident, None)
        self._drop_adapter(ident)
        self._open_profiles.pop(ident, None)
        stop = self._presence_watchers.pop(ident, None)
        if stop is not None:
            stop.set()

    def _refresh_open_profiles(self):
        if not self._open_profiles:
            return

        def go():
            for ident, frag in list(self._open_profiles.items()):
                self._profile_refresh(frag, ident)

        try:
            run_on_ui_thread(go)
        except Exception as e:
            log("profile refresh schedule error: %r" % (e,))

    # ----- профиль: опрос сервера -----
    def _presence_watch_ensure(self, frag, ident, uid):
        if ident in self._presence_watchers:
            return
        while len(self._presence_watchers) >= 4:
            try:
                old = next(iter(self._presence_watchers))
                self._presence_watchers.pop(old).set()
            except Exception:
                break
        stop = threading.Event()
        self._presence_watchers[ident] = stop

        def run():
            first = True
            while not stop.is_set():
                if not first and stop.wait(4.0):
                    break
                first = False
                try:
                    data = self._presence_get(uid)
                except Exception as e:
                    log("presence poll error: %r" % (e,))
                    data = None
                prev = self._presence_data.get(uid)
                if data is not None:
                    data["fetched"] = time.time()
                    self._presence_data[uid] = data
                new = self._presence_data.get(uid)
                if (prev is None) != (new is None):
                    run_on_ui_thread(lambda: self._profile_refresh(frag, ident))

        threading.Thread(target=run, name="MusicPresenceWatch", daemon=True).start()

    def _profile_refresh(self, frag, ident):
        if ident not in self._open_profiles and ident not in self._presence_watchers:
            return
        try:
            c = frag.getClass()
            while c is not None and str(c.getName()) != "org.telegram.ui.ProfileActivity":
                c = c.getSuperclass()
            m = c.getDeclaredMethod("updateRowsIds")
            m.setAccessible(True)
            m.invoke(frag, jarray(jclass("java.lang.Object"))([]))
            adapter = get_private_field(frag, "listAdapter")
            if adapter is not None:
                adapter.notifyDataSetChanged()
        except Exception as e:
            log("profile refresh error: %r" % (e,))

    # ----- профиль: живое обновление прогресс-бара -----
    def _now_register(self, row):
        if row not in self._now_live:
            self._now_live.append(row)
        if not self._now_ticking:
            self._now_ticking = True
            Handler = jclass("android.os.Handler")
            Looper = jclass("android.os.Looper")
            self._now_handler = Handler(Looper.getMainLooper())
            self._now_handler.postDelayed(_Run(self._now_ui_tick), 1000)

    def _now_ui_tick(self):
        keep = []
        for r in self._now_live:
            try:
                if r.view.isAttachedToWindow():
                    r.update()
                    keep.append(r)
            except Exception:
                pass
        self._now_live = keep
        if keep and not self._stop.is_set():
            self._now_handler.postDelayed(_Run(self._now_ui_tick), 1000)
        else:
            self._now_ticking = False

    def _now_row_menu(self, uid):
        def show():
            act = self._activity()
            if act is None:
                return
            Builder = _TgBuilder
            b = Builder(act)
            b.setTitle("Мой статус для этого пользователя")
            labels = ["Добавить в белый список", "Добавить в чёрный список"]

            def picked(i):
                key = "presence_whitelist" if i == 0 else "presence_blacklist"
                ids = self._ids(self.get_setting(key, "") or "")
                if uid not in ids:
                    ids.append(uid)
                self.set_setting(key, ", ".join(str(x) for x in ids))
                toast("ID %d добавлен в %s список" % (uid, "белый" if i == 0 else "чёрный"))

            b.setItems(jarray(jclass("java.lang.CharSequence"))(labels), _DialogChoice(picked))
            b.setNegativeButton("Отмена", _DialogChoice(lambda _: None))
            b.show()

        run_on_ui_thread(show)

    def presence_test(self):
        def work():
            try:
                if not self._presence_cfg()["server"]:
                    toast("Укажи адрес сервера (только https://)")
                    return
                self._presence_tick(force=True)
                me = self._tg_id()
                data = self._presence_get(me)

                if data is None:
                    toast("Сервер ответил: пусто (возможно, нет связи или сервер лежит)")
                elif data.get("_presence_status") == "unregistered":
                    toast("Сервер ответил: токен не найден в базе (плагин не привязан)")
                elif data.get("_presence_status") == "idle":
                    toast("Сервер ответил: привязка есть, но музыка сейчас не играет")
                elif data.get("artist"):
                    toast("Сервер ответил: %s — %s" % (data.get('artist'), data.get('title')))
                else:
                    toast("Сервер ответил: %s" % json.dumps(data, ensure_ascii=False)[:180])
            except Exception as e:
                toast("Ошибка: %r" % (e,))

        threading.Thread(target=work, daemon=True).start()

    def _open_bot(self):
        def show():
            try:
                act = self._activity()
                if act is None:
                    return
                Intent = jclass("android.content.Intent")
                Uri = jclass("android.net.Uri")
                intent = Intent(Intent.ACTION_VIEW, Uri.parse("https://t.me/fms_gettoken_bot"))
                intent.setPackage(act.getPackageName())
                act.startActivity(intent)
            except Exception as e:
                log("open bot error: %r" % (e,))
                toast("Не удалось открыть бота: %r" % (e,))
        run_on_ui_thread(show)

    def _make_tg_input(self, act, hint, current=""):
        ui = UIKit(act)
        pal = get_palette()
        dp = ui.dp
        wrap = ui.vbox()
        wrap.setPadding(dp(24), dp(8), dp(24), dp(8))

        try:
            et = jclass("org.telegram.ui.Components.EditTextBoldCursor")(act)
            et.setTextSize(16.0)
            et.setTextColor(jint(pal["text"]))
            et.setHintColor(jint(pal["gray"]))
            try:
                et.setLineColors(jint(pal["accent"]), jint(pal["gray"]), jint(pal["accent"]), jint(pal["gray"]))
            except Exception:
                pass
        except Exception:
            et = jclass("android.widget.EditText")(act)
            et.setTextSize(16.0)
            et.setTextColor(jint(pal["text"]))

        et.setHint(hint)
        if current:
            et.setText(current)
        wrap.addView(et, ui.lp(-1, -2))
        return wrap, et

    def _build_dialog(self, act):
        return _TgBuilder(act)

    def _edit_presence_setting(self, key, title, hint):
        def show():
            try:
                act = self._activity()
                if act is None:
                    return
                wrap, et = self._make_tg_input(act, hint, str(self.get_setting(key, "") or ""))
                b = self._build_dialog(act)
                b.setTitle(title)
                b.setView(wrap)
                b.setPositiveButton("Сохранить", _DialogChoice(lambda _: self.set_setting(key, str(et.getText()).strip())))
                b.setNegativeButton("Отмена", _DialogChoice(lambda _: None))
                b.show()
            except Exception as e:
                toast("Ошибка окна настроек: %r" % (e,))
        run_on_ui_thread(show)

    def _edit_presence_list(self, which):
        key = "presence_" + which
        def show():
            try:
                act = self._activity()
                if act is None:
                    return
                wrap, et = self._make_tg_input(act, "ID через запятую или пробел", str(self.get_setting(key, "") or ""))
                et.setSingleLine(False)
                et.setMinLines(3)
                b = self._build_dialog(act)
                b.setTitle("Белый" if which == "whitelist" else "Чёрный список")
                b.setView(wrap)
                b.setPositiveButton("Сохранить", _DialogChoice(lambda _: self.set_setting(key, str(et.getText()).strip())))
                b.setNegativeButton("Отмена", _DialogChoice(lambda _: None))
                b.show()
            except Exception as e:
                toast("Ошибка окна списка: %r" % (e,))
        run_on_ui_thread(show)

    def import_dialog(self):
        def show():
            try:
                act = self._activity()
                if act is None:
                    return
                wrap, et = self._make_tg_input(act, "/storage/emulated/0/Download/music_stats_….json", getattr(self, "_last_export", ""))
                b = self._build_dialog(act)
