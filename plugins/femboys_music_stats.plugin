class _Insets(dynamic_proxy(OnInsets)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onApplyWindowInsets(self, v, insets):
        try:
            self.fn(int(insets.getSystemWindowInsetTop()), int(insets.getSystemWindowInsetBottom()))
        except Exception as e:
            log("insets error: %r" % (e,))
        return insets


class _TextWatcher(dynamic_proxy(TextWatcher)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def afterTextChanged(self, s):
        try:
            self.fn(str(s) if s is not None else "")
        except Exception as e:
            log("textwatcher error: %r" % (e,))

    def beforeTextChanged(self, s, start, count, after):
        pass

    def onTextChanged(self, s, start, before, count):
        pass


