try:
    from hook_utils import get_private_field
except Exception:  # pragma: no cover
    def get_private_field(obj, name):
        c = obj.getClass()
        while c is not None:
            try:
                f = c.getDeclaredField(name)
                f.setAccessible(True)
                return f.get(obj)
            except Exception:
                c = c.getSuperclass()
        raise AttributeError(name)


