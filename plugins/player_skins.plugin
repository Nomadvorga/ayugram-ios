# ---------------------------------------------------------------- live lyrics (Spotify)

LINE_TIME_FIELDS = ("time", "startTime", "start", "timeMs", "startMs", "begin", "timestamp", "position", "offset")
DOTS_GAP_MS = 3000
DOTS_TEXT = "• • •"
LIVE_BG_SIDE = 8


def lyric_index(starts, pos):
    """Index of the line playing at pos (ms): the last one that has started, -1 before the first."""
    return bisect.bisect_right(starts, pos) - 1


def search_starts(index_at, n, dur_ms):
    """Line start times recovered from the player's own indexAt(ms), for lyrics whose time field is unknown.
    Galloping from the previous start keeps it to roughly fifteen calls a line."""
    limit = int(dur_ms) + 600000 if dur_ms and dur_ms > 0 else 3600000
    starts = []
    lo = 0
    for i in range(n):
        if index_at(limit) < i:
            starts.extend([limit] * (n - i))
            break
        step = 512
        hi = lo + step
        while hi < limit and index_at(hi) < i:
            lo = hi + 1
            step *= 2
            hi = min(limit, lo + step)
        a, b = lo, hi
        while a < b:
            m = (a + b) // 2
            if index_at(m) >= i:
                b = m
            else:
                a = m + 1
        starts.append(a)
        lo = a
    return starts


def starts_agree(index_at, starts):
    """Checks candidate start times against indexAt on a few lines: the line must begin right there."""
    n = len(starts)
    if n == 0 or any(starts[i] > starts[i + 1] for i in range(n - 1)):
        return False
    probes = [i for i in range(n - 1) if starts[i] < starts[i + 1]]
    if not probes:
        return False
    for i in (probes[0], probes[len(probes) // 2], probes[-1]):
        idx = index_at(starts[i] + 1)
        if idx < 0 or idx >= n or starts[idx] != starts[i]:
            return False
        if starts[i] > 2 and index_at(starts[i] - 2) >= i and (i == 0 or starts[i - 1] < starts[i] - 2):
            return False
    return True


def plan_lines(texts, starts, dur_ms):
    """Per line: kind (text / dots / gap), shown text, start, and the end used for the word fill.
    Singing usually stops before the next line starts, so the fill runs for about 0.6 s a word at most."""
    n = len(texts)
    out = []
    if starts is not None and n and starts[0] >= DOTS_GAP_MS and (texts[0] or "").strip():
        out.append({"kind": "dots", "text": DOTS_TEXT, "start": 0, "end": starts[0] - 400})
    for i in range(n):
        text = (texts[i] or "").strip()
        start = starts[i] if starts is not None else 0
        nxt = None
        if starts is not None:
            for j in range(i + 1, n):
                if starts[j] > start:
                    nxt = starts[j]
                    break
            if nxt is None:
                nxt = max(start + 5000, int(dur_ms or 0))
        if not text:
            same = i > 0 and starts is not None and starts[i - 1] == start
            if starts is not None and not same and nxt - start >= DOTS_GAP_MS:
                out.append({"kind": "dots", "text": DOTS_TEXT, "start": start, "end": max(start + 1, nxt - 400)})
            else:
                out.append({"kind": "gap", "text": "", "start": start, "end": start + 1})
            continue
        end = start + 1
        if starts is not None:
            est = max(1500, syllables(text) * 320)
            span = nxt - start
            end = start + int(min(span * 0.92, est)) if span > 0 else start + est
        out.append({"kind": "text", "text": text, "start": start, "end": max(start + 1, end)})
    return out


VOWELS = frozenset("aeiouyAEIOUYаеёиоуыэюяАЕЁИОУЫЭЮЯіїєІЇЄáéíóúàèìòùäöüâêîôûÁÉÍÓÚÀÈÌÒÙÄÖÜÂÊÎÔÛ")


def syllables(text):
    """Rough syllable count: vowel groups; scripts without such vowels count each character."""
    n = 0
    prev = False
    for ch in text:
        v = ch in VOWELS
        if v and not prev:
            n += 1
        prev = v
    if n == 0:
        n = sum(1 for ch in text if ch.isalnum())
    return max(1, n)


def sweep_weights(text):
    """Cumulative fill weights shaped like singing: vowels are held, consonants pass quickly,
    a word start adds a short beat, punctuation almost nothing, spaces nothing."""
    cum = [0.0]
    prev_space = True
    for ch in text:
        if ch.isspace():
            w = 0.0
        elif ch in VOWELS:
            w = 1.6
        elif ch.isalnum():
            w = 0.55
        else:
            w = 0.2
        if w > 0 and prev_space:
            w += 0.6
        prev_space = ch.isspace()
        cum.append(cum[-1] + w)
    return cum


def sweep_at(cum, p):
    """(characters fully lit, how far the next one is lit 0..1) for line progress p."""
    total = cum[-1]
    if total <= 0 or p <= 0:
        return 0, 0.0
    if p >= 1:
        return len(cum) - 1, 0.0
    target = p * total
    k = bisect.bisect_right(cum, target) - 1
    k = max(0, min(k, len(cum) - 2))
    w = cum[k + 1] - cum[k]
    frac = (target - cum[k]) / w if w > 0 else 0.0
    return k, max(0.0, min(1.0, frac))


def corner_pixels(tones, side):
    """A soft four-colour square, the background while no cover is loaded yet."""
    out = []
    for y in range(side):
        ty = y / float(side - 1)
        for x in range(side):
            tx = x / float(side - 1)
            top = mix(tones[0], tones[1], tx)
            bottom = mix(tones[2], tones[3], tx)
            out.append(mix(top, bottom, ty))
    return out


class LiveLyrics:
    """Spotify: an animated full-screen lyrics view in the spirit of Spicy Lyrics, shown over the stock one.

    The text comes from the player's own lyrics view, which is synced by line. Words are lit by spreading the
    line's time over its letters, so the fill is approximate. Inactive lines are dimmed, smaller and blurred
    (Android 12+), the list glides to the current line, a tap on a line seeks there, and a blurred copy of the
    cover slowly turns behind the text. Own code: nothing is taken from the Spicy Lyrics project.

    Built to stay cheap: the background is one tiny bitmap stretched over the screen and turned by a native
    animator; the lit part of a line is a pair of reused spans on one Spannable (no setText, no relayout);
    only lines near the current one are restyled; the Python tick runs often only while a line is filling."""

    TEXT_SP = 24
    DIM = 0.42
    PAUSE_AFTER_TOUCH = 3.0
    WINDOW = 8
    ALPHAS = (1.0, 0.82, 0.66, 0.5, 0.4)

    @_t("LiveLyrics.__init__")
    def __init__(self, ctrl):
        self.c = ctrl
        self.lines = []
        self.starts = []
        self.src = None
        self.synced = False
        self.active = -2
        self.vis = 0.0
        self.lyrics_mode = False
        self.ticking = False
        self.handler = None
        self.runner = None
        self.clock = None
        self.speed = 1.0
        self.orig_at = 0.0
        self.free = False
        self.user_until = 0.0
        self.scroll_anim = None
        self.scroll_pending = False
        self.bg_anims = []
        self.color_key = None
        self.cover_bmp = None
        self.made = 0
        self.sig = None
        self.copy_spans = False
        self.pad_h = -1
        self.hid = None
        self.on_cache = (0.0, True)
        self.sync_at = 0.0
        self.trans_key = None
        self.fields = {}
        self.dim = with_alpha(WHITE, self.DIM)
        self.lit_span = None
        self.edge_spans = []
        self.painted = None
        self.blur_fx = None
        self.near = set()
        try:
            from android.os import Build
            self.blur_ok = int(Build.VERSION.SDK_INT) >= 31
        except Exception:
            _dexc("LiveLyrics.__init__:L2273")
            self.blur_ok = False
        self.build_views()

    # ---- views
    @_t("LiveLyrics.build_views")
    def build_views(self):
        from android.widget import ScrollView, TextView
        c = self.c
        ctx = c.ctx
        dm = ctx.getResources().getDisplayMetrics()
        w, h = int(dm.widthPixels), int(dm.heightPixels)
        diag = int(math.sqrt(w * w + h * h) * 1.06) + 2
        bg = A.FrameLayout(ctx)
        bg.setBackgroundColor(jint(rgb(0x121212)))
        art = A.ImageView(ctx)
        art.setScaleType(A.ImageView.ScaleType.FIT_XY)
        bg.addView(art, flp(diag, diag, 17))
        c.add_view(bg, flp(-1, -1), index=1)
        c.el["live_bg"] = bg
        c.alphas["live_bg"] = 0.0
        self.bg, self.art = bg, art
        sv = ScrollView(ctx)
        sv.setVerticalScrollBarEnabled(False)
        sv.setOverScrollMode(2)
        try:
            sv.setNestedScrollingEnabled(False)
        except Exception:
            pass
        box = A.LinearLayout(ctx)
        box.setOrientation(1)
        sv.addView(box, flp(-1, -2))
        sv.setOnTouchListener(touch_listener(self.on_touch))
        c.add_view(sv, flp(-1, -1))
        c.el["live"] = sv
        c.alphas["live"] = 0.0
        self.sv, self.box = sv, box
        self.spannable = TextView.BufferType.SPANNABLE
        self.click = on_click_view(self.on_line_click)
        self.lit_span = A.ForegroundColorSpan(jint(WHITE))
        self.edge_spans = [A.ForegroundColorSpan(jint(mix(self.dim, WHITE, (q + 0.5) / 4.0))) for q in range(4)]
        if self.blur_ok:
            try:
                from android.graphics import RenderEffect, Shader
                r = F(P(2.2))
                self.blur_fx = RenderEffect.createBlurEffect(r, r, Shader.TileMode.DECAL)
            except Exception:
                self.blur_ok = False
                log_exc("live blur")

    @_t("LiveLyrics.enabled")
    def enabled(self):
        ts, on = self.on_cache
        now = time.time()
        if now - ts > 1.0:
            on = bool(self.c.p.get_setting("spicy_lyrics", True))
            self.on_cache = (now, on)
        return on

    @_t("LiveLyrics.shown")
    def shown(self):
        return self.vis > 0.0 and bool(self.lines)

    # ---- mode / visibility
    @_t("LiveLyrics.transitions")
    def transitions(self, f):
        c = self.c
        mode = c.mode()
        if mode == 1:
            self.lyrics_mode = True
        elif mode == 2:
            self.lyrics_mode = False
        on = self.enabled() and self.lyrics_mode and c.active
        vis = smooth(f) if on else 0.0
        key = (round(vis, 3), bool(self.lines), int(self.sv.getHeight()))
        if key != self.trans_key:
            self.trans_key = key
            self.vis = vis
            if vis > 0.0:
                self.sync(force=not self.lines)
            has = bool(self.lines)
            c.set_alpha("live_bg", vis)
            c.set_alpha("live", vis if has else 0.0)
            c.set_alpha("bg", 0.0 if vis >= 0.999 else 1.0)
            if vis > 0.0:
                self.layout_parts()
                self.start_bg()
            else:
                self.stop_bg()
        self.keep_original(self.vis > 0.0 and bool(self.lines))
        if self.vis > 0.0:
            self.kick()

    @_t("LiveLyrics.keep_original")
    def keep_original(self, hide):
        """Hides the stock lyrics while ours are shown and gives it back exactly as it was."""
        lv = self.c.o["lyricsView"]
        try:
            if hide:
                if self.hid is None:
                    self.hid = (int(lv.getVisibility()), float(lv.getAlpha()))
                if float(lv.getAlpha()) != 0.0:
                    lv.setAlpha(F(0.0))
                if int(lv.getVisibility()) == VISIBLE:
                    lv.setVisibility(INVISIBLE)
            elif self.hid is not None:
                vis, alpha = self.hid
                self.hid = None
                lv.setVisibility(vis)
                lv.setAlpha(F(alpha))
        except Exception:
            log_exc("live original")

    @_t("LiveLyrics.active_changed")
    def active_changed(self, active):
        if not active:
            self.stop_tick()
            self.vis = 0.0
            self.trans_key = None
            self.stop_bg()
            self.keep_original(False)
            self.c.set_alpha("bg", 1.0)

    @_t("LiveLyrics.release")
    def release(self):
        self.stop_tick()
        self.vis = 0.0
        self.stop_bg()
        self.cancel_scroll()
        self.keep_original(False)
        self.c.set_alpha("bg", 1.0)

    @_t("LiveLyrics.layout_parts", True)
    def layout_parts(self):
        h = int(self.sv.getHeight())
        if h > 0 and h != self.pad_h:
            self.pad_h = h
            self.box.setPadding(0, int(h * 0.28), 0, int(h * 0.62))
            self.scroll_pending = True
        self.recolor()

    # ---- background: one tiny blurred bitmap, stretched and slowly turned
    @_t("LiveLyrics.set_cover")
    def set_cover(self, bmp):
        """Blurred, darker, a bit more saturated copy of the cover, made natively: a few downscales with
        filtering average the colours, one upscale smooths them, a colour matrix darkens. No Python pixel loops."""
        try:
            from android.graphics import Canvas, ColorMatrix, ColorMatrixColorFilter, Paint
            B = A.Bitmap
            if int(bmp.getWidth()) <= 0 or int(bmp.getHeight()) <= 0:
                return
            small = bmp
            for side in (128, 32, 8):
                small = B.createScaledBitmap(small, side, side, True)
            soft = B.createScaledBitmap(small, 64, 64, True)
            out = B.createBitmap(64, 64, B.Config.ARGB_8888)
            cm = ColorMatrix()
            cm.setSaturation(F(1.3))
            dim = ColorMatrix()
            dim.setScale(F(0.55), F(0.55), F(0.55), F(1.0))
            cm.postConcat(dim)
            paint = Paint()
            paint.setFilterBitmap(True)
            paint.setColorFilter(ColorMatrixColorFilter(cm))
            Canvas(out).drawBitmap(soft, F(0), F(0), paint)
            self.cover_bmp = out
            self.color_key = None
            if self.vis > 0.0:
                self.recolor()
        except Exception:
            log_exc("live cover")

    @_t("LiveLyrics.recolor")
    def recolor(self):
        st = self.c.stats()
        dom = st["dom"] if st else rgb(0x535353)
        key = (dom, self.cover_bmp is not None)
        if key == self.color_key:
            return
        self.color_key = key
        n = LIVE_BG_SIDE
        art = self.cover_bmp
        if art is None:
            avg = st.get("avg", dom) if st else dom
            h, s, v = hsv_of(dom)
            s = max(s, 0.45) if st and not st.get("neutral") else s * 0.35
            tones = [with_lum(from_hsv(h, s, v), 0.09), with_lum(from_hsv(h + 0.07, s, v), 0.05),
                     with_lum(avg, 0.04), with_lum(from_hsv(h - 0.07, s, v), 0.11)]
            px = corner_pixels(tones, n)
        try:
            if art is None:
                tiny = A.Bitmap.createBitmap(jarray(jint)(px), n, n, A.Bitmap.Config.ARGB_8888)
                art = A.Bitmap.createScaledBitmap(tiny, 64, 64, True)
            self.art.setImageBitmap(art)
            self.bg.setBackground(None)
        except Exception:
            log_exc("live recolor")

    @_t("LiveLyrics.start_bg")
    def start_bg(self):
        if self.bg_anims:
            return
        try:
            from android.animation import ObjectAnimator, PropertyValuesHolder, ValueAnimator
            from android.view.animation import LinearInterpolator, AccelerateDecelerateInterpolator
            turn = ObjectAnimator.ofFloat(self.art, "rotation", jarray(jfloat)([0.0, 360.0]))
            turn.setDuration(jlong(80000))
            turn.setRepeatCount(ValueAnimator.INFINITE)
            turn.setInterpolator(LinearInterpolator())
            holders = [PropertyValuesHolder.ofFloat("scaleX", jarray(jfloat)([1.0, 1.18])),
                       PropertyValuesHolder.ofFloat("scaleY", jarray(jfloat)([1.0, 1.18]))]
            breathe = ObjectAnimator.ofPropertyValuesHolder(self.art, jarray(PropertyValuesHolder)(holders))
            breathe.setDuration(jlong(17000))
            breathe.setRepeatCount(ValueAnimator.INFINITE)
            breathe.setRepeatMode(ValueAnimator.REVERSE)
            breathe.setInterpolator(AccelerateDecelerateInterpolator())
            turn.start()
            breathe.start()
            self.bg_anims = [turn, breathe]
        except Exception:
            log_exc("live bg anim")

    @_t("LiveLyrics.stop_bg")
    def stop_bg(self):
        for an in self.bg_anims:
            try:
                an.cancel()
            except Exception:
                _dexc("LiveLyrics.stop_bg:L2497")
                pass
        self.bg_anims = []

    # ---- lyrics data
    @_t("LiveLyrics.reset")
    def reset(self):
        self.src = None
        self.color_key = None
        self.clear()

    @_t("LiveLyrics.clear")
    def clear(self):
        self.lines = []
        self.starts = []
        self.active = -2
        self.painted = None
        self.near = set()
        self.made = 0
        self.sig = None
        self.trans_key = None
        self.cancel_scroll()
        try:
            self.box.removeAllViews()
            self.sv.setScrollY(0)
        except Exception:
            log_exc("live clear")

    @_t("LiveLyrics.lv_field")
    def lv_field(self, lv, name):
        """Private field of the stock lyrics view through a cached Field (no lookup every time)."""
        f = self.fields.get(name)
        if f is False:
            return get_private_field(lv, name)
        try:
            if f is None:
                k = lv.getClass()
                while k is not None and f is None:
                    try:
                        f = k.getDeclaredField(name)
                        f.setAccessible(True)
                    except Exception:
                        _dexc("LiveLyrics.lv_field:L2539")
                        f = None
                        k = k.getSuperclass()
                self.fields[name] = f if f is not None else False
                if f is None:
                    return get_private_field(lv, name)
            return f.get(lv)
        except Exception:
            _dexc("LiveLyrics.lv_field:L2547")
            self.fields[name] = False
            return get_private_field(lv, name)

    @_t("LiveLyrics.sync")
    def sync(self, force=False):
        """Picks up lyrics the stock view loaded. Checked twice a second, not every frame."""
        now = time.time()
        if not force and now < self.sync_at:
            return bool(self.lines)
        self.sync_at = now + 0.5
        lv = self.c.o["lyricsView"]
        state = as_int(self.lv_field(lv, "state"), 0)
        lyr = self.lv_field(lv, "lyrics") if state == 3 else None
        if lyr is None:
            if self.lines:
                self.clear()
            self.src = None
            return False
        if self.src is not None and lyr.equals(self.src):
            return bool(self.lines)
        sig = self.signature(lyr)
        self.src = lyr
        if self.lines and sig == self.sig:
            return True
        self.build(lyr)
        self.sig = sig
        return bool(self.lines)

    @_t("LiveLyrics.signature")
    def signature(self, lyr):
        try:
            jl = lyr.lines
            n = int(jl.size())
            if n <= 0:
                return (0,)
            return (n, as_bool(lyr.synced), str(jl.get(0).text), str(jl.get(n - 1).text))
        except Exception:
            _dexc("LiveLyrics.signature:L2585")
            return None

    @_t("LiveLyrics.build")
    def build(self, lyr):
        self.clear()
        jl = lyr.lines
        n = int(jl.size())
        if n <= 0:
            return
        items = [jl.get(i) for i in range(n)]
        texts = [str(it.text) if it.text is not None else "" for it in items]
        synced = as_bool(lyr.synced)
        mo = playing()
        dur_ms = int(float(mo.getDuration()) * 1000.0) if mo is not None else 0
        starts = None
        if synced:
            def index_at(ms):
                return as_int(lyr.indexAt(jlong(int(ms))), -1)
            starts = self.field_starts(items, index_at)
            if starts is None:
                starts = search_starts(index_at, n, dur_ms)
        self.synced = starts is not None
        plan = plan_lines(texts, starts, dur_ms)
        for ln in plan:
            ln["view"] = None
            ln["cum"] = sweep_weights(ln["text"])
            ln["mark"] = None
            ln["drawn"] = (0, -1)
            ln["style"] = None
            ln["span"] = None
        self.lines = plan
        self.starts = [ln["start"] for ln in plan]
        self.active = -2
        self.made = 0
        self.scroll_pending = True
        self.trans_key = None
        self.make_views(20)
        log("live lyrics: %d lines, synced=%s" % (n, self.synced))

    @_t("LiveLyrics.make_views")
    def make_views(self, count):
        """Creates the next few line views. Spread over frames, so a new track does not freeze the player."""
        c = self.c
        face = c.font(700)
        far = self.ALPHAS[-1] if self.synced else 1.0
        color = jint(self.dim if self.synced else with_alpha(WHITE, 0.9))
        lp_w, lp_h = -1, -2
        pad = P(24)
        end = min(len(self.lines), self.made + count)
        for i in range(self.made, end):
            ln = self.lines[i]
            tv = A.TextView(c.ctx)
            tv.setTextSize(SP, F(self.TEXT_SP))
            tv.setTypeface(face)
            tv.setIncludeFontPadding(False)
            tv.setPadding(pad, P(10), pad, P(10))
            tv.setTextColor(color)
            tv.setText(ln["text"], self.spannable)
            tv.setPivotX(F(pad))
            if ln["kind"] == "gap":
                tv.setVisibility(GONE)
            elif self.synced:
                tv.setTag(A.Integer(i))
                tv.setOnClickListener(self.click)
                tv.setAlpha(F(far))
                tv.setScaleX(F(0.94))
                tv.setScaleY(F(0.94))
            self.box.addView(tv, A.LinearLayout.LayoutParams(lp_w, lp_h))
            ln["view"] = tv
            ln["style"] = (len(self.ALPHAS) - 1, False) if self.synced else None
        self.made = end
        if self.synced and self.active >= -1:
            self.restyle()

    @_t("LiveLyrics.field_starts")
    def field_starts(self, items, index_at):
        first = items[0]
        for name in LINE_TIME_FIELDS:
            try:
                v = getattr(first, name)
                if callable(v):
                    v = v()
                int(v)
            except Exception:
                _dexc("LiveLyrics.field_starts:L2670")
                continue
            try:
                vals = []
                for it in items:
                    v = getattr(it, name)
                    vals.append(int(v() if callable(v) else v))
            except Exception:
                _dexc("LiveLyrics.field_starts:L2678")
                continue
            for k in (1, 1000):
                cand = [x * k for x in vals]
                if starts_agree(index_at, cand):
                    return cand
        return None

    # ---- frame
    @_t("LiveLyrics.kick")
    def kick(self):
        """Starts the ticker: one Handler and one Runnable for the whole lyrics mode, nothing new per frame."""
        if self.ticking:
            return
        self.ticking = True
        if self.handler is None:
            try:
                from android.os import Handler, Looper
                self.handler = Handler(Looper.getMainLooper())
                self.runner = JRunnable(self.tick)
            except Exception:
                log_exc("live ticker")
                self.handler = None
        self.schedule(16)

    @_t("LiveLyrics.schedule")
    def schedule(self, delay):
        try:
            if self.handler is not None:
                self.handler.postDelayed(self.runner, jlong(int(delay)))
            else:
                ui(self.tick, int(delay))
        except Exception:
            self.ticking = False
            log_exc("live schedule")

    @_t("LiveLyrics.stop_tick", True)
    def stop_tick(self):
        self.ticking = False
        if self.handler is not None:
            try:
                self.handler.removeCallbacks(self.runner)
            except Exception:
                _dexc("LiveLyrics.stop_tick:L2721")
                pass

    @_t("LiveLyrics.tick", True)
    def tick(self):
        c = self.c
        if not self.ticking:
            return
        if c.closed or not c.active or self.vis <= 0.0:
            self.ticking = False
            return
        delay = 250
        try:
            delay = self.frame()
        except Exception:
            log_exc("live frame")
        self.schedule(delay)

    @_t("LiveLyrics.position")
    def position(self):
        """(ms, paused). The player is asked at most every 0.4 s; in between the time runs on the monotonic
        clock at the playback speed. Small jitter of the player clock is smoothed, a seek is taken at once."""
        t = time.monotonic()
        clk = self.clock
        if clk is not None and t - clk[1] < 0.4:
            pos, t0, paused = clk
            return (pos if paused else pos + (t - t0) * 1000.0 * self.speed), paused
        mo = playing()
        if mo is None:
            self.clock = None
            return None, True
        try:
            mc = MediaController.getInstance()
            paused = as_bool(mc.isMessagePaused())
            try:
                self.speed = max(0.25, min(4.0, float(mc.getPlaybackSpeed(True))))
            except Exception:
                _dexc("LiveLyrics.position:L2758")
                self.speed = 1.0
        except Exception:
            _dexc("LiveLyrics.position:L2761")
            paused = False
        pos = float(position_ms(mo))
        try:
            dur_ms = float(mo.getDuration()) * 1000.0
            if dur_ms > 0.0 and pos > dur_ms:
                pos = dur_ms
        except Exception:
            pass
        if clk is not None and not paused and not clk[2]:
            pred = clk[0] + (t - clk[1]) * 1000.0 * self.speed
            if abs(pos - pred) < 120:
                pos = pred + (pos - pred) * 0.25
            elif clk[0] <= pos < pred and (pred - pos) < 600:
                pos = max(pos, clk[0])
        self.clock = (pos, t, paused)
        return pos, paused

    @_t("LiveLyrics.next_wake")
    def next_wake(self, ln, pos):
        """Milliseconds until the fill of the line visibly moves (the next quarter of a character)."""
        cum = ln["cum"]
        total = cum[-1]
        span = float(max(1, ln["end"] - ln["start"]))
        if total <= 0:
            return 120
        k, frac = sweep_at(cum, (pos - ln["start"]) / span)
        n = len(cum) - 1
        while k < n and cum[k + 1] - cum[k] <= 0:
            k += 1
            frac = 0.0
        if k >= n:
            return 120
        w = cum[k + 1] - cum[k]
        target = cum[k] + w * min(1.0, (int(frac * 4) + 1) / 4.0)
        at = ln["start"] + span * target / total
        return max(16, min(120, (at - pos) / max(0.25, self.speed) + 2))

    @_t("LiveLyrics.frame", True)
    def frame(self):
        """One update; returns how long to sleep: ~30 fps only while a line is being filled."""
        had = bool(self.lines)
        has = self.sync()
        if has != had:
            self.trans_key = None
            self.c.set_alpha("live", self.vis if has else 0.0)
            self.keep_original(has)
        now = time.time()
        if now >= self.orig_at:
            self.orig_at = now + 0.5
            self.keep_original(has)
        if not has:
            return 250
        building = self.made < len(self.lines)
        if building:
            self.make_views(12)
        if self.free and time.time() > self.user_until:
            self.free = False
            self.restyle()
            self.scroll_pending = True
        if not self.synced:
            return 250
        pos, paused = self.position()
        if pos is None:
            return 250
        idx = lyric_index(self.starts, pos)
        if idx != self.active:
            self.active = idx
            if self.painted is not None:
                self.unpaint(self.painted)
            self.restyle()
            self.scroll_pending = True
        if self.scroll_pending and not self.free and self.scroll_to_active():
            self.scroll_pending = False
        nxt = self.starts[idx + 1] if idx + 1 < len(self.starts) else None
        wait = 250 if nxt is None else max(16, min(250, (nxt - pos) / max(0.25, self.speed) + 2))
        if building:
            wait = 16
        if 0 <= idx < len(self.lines):
            ln = self.lines[idx]
            if ln["kind"] != "gap" and ln["view"] is not None:
                p = (pos - ln["start"]) / float(max(1, ln["end"] - ln["start"]))
                self.paint(ln, p)
                if p < 1.0 and not paused:
                    wait = min(wait, self.next_wake(ln, pos))
        return 250 if paused and not building else wait

    @_t("LiveLyrics.paint", True)
    def paint(self, ln, p):
        k, frac = sweep_at(ln["cum"], p)
        q = int(frac * 4) if frac > 0 else -1
        mark = (k, q)
        if mark == ln["mark"]:
            return
        ln["mark"] = mark
        if self.painted is not None and self.painted is not ln:
            self.unpaint(self.painted)
        self.painted = ln
        n = len(ln["text"])
        if not self.copy_spans:
            try:
                self.paint_spans(ln, k, q, n)
                return
            except Exception:
                self.copy_spans = True
                log_exc("live spans")
        edge = q if k < n else -1
        s = A.SpannableString(ln["text"])
        if k > 0:
            s.setSpan(self.lit_span, 0, min(k, n), 33)
        if edge >= 0:
            s.setSpan(self.edge_spans[edge], k, k + 1, 33)
        ln["view"].setText(s)
        ln["drawn"] = (k, edge)

    @_t("LiveLyrics.paint_spans", True)
    def paint_spans(self, ln, k, q, n):
        """Moves two reused spans on the line's own Spannable: no setText, no new layout."""
        sp = ln["span"]
        if sp is None:
            tv = ln["view"]
            tv.setText(ln["text"], self.spannable)
            sp = tv.getText()
            try:
                from java import cast
                from android.text import Spannable
                sp = cast(Spannable, sp)
            except Exception:
                _dexc("LiveLyrics.paint_spans:L2881")
                pass
            ln["span"] = sp
        pk, pq = ln["drawn"]
        if k != pk:
            if k > 0:
                sp.setSpan(self.lit_span, 0, min(k, n), 33)
            elif pk > 0:
                sp.removeSpan(self.lit_span)
        edge = q if k < n else -1
        if edge != pq and pq >= 0:
            sp.removeSpan(self.edge_spans[pq])
        if edge >= 0 and (edge != pq or k != pk):
            sp.setSpan(self.edge_spans[edge], k, k + 1, 33)
        ln["drawn"] = (k, edge)

    @_t("LiveLyrics.unpaint", True)
    def unpaint(self, ln):
        if ln["mark"] is None:
            return
        ln["mark"] = None
        sp = ln["span"]
        pk, pq = ln["drawn"]
        try:
            if self.copy_spans or sp is None:
                if ln["view"] is not None and (pk > 0 or pq >= 0):
                    ln["view"].setText(ln["text"])
                    ln["span"] = None
            else:
                if pk > 0:
                    sp.removeSpan(self.lit_span)
                if pq >= 0:
                    sp.removeSpan(self.edge_spans[pq])
        except Exception:
            log_exc("live unpaint")
        ln["drawn"] = (0, -1)
        if self.painted is ln:
            self.painted = None

    @_t("LiveLyrics.restyle")
    def restyle(self):
        """Styles the lines around the current one; the rest keep the far style they were built with."""
        idx = self.active
        n = len(self.lines)
        if idx < 0:
            lo, hi = 0, min(n, self.WINDOW + 1)
        else:
            lo, hi = max(0, idx - self.WINDOW - 1), min(n, idx + self.WINDOW + 2)
        last = len(self.ALPHAS) - 1
        near = set()
        for i in range(lo, hi):
            ln = self.lines[i]
            if ln["kind"] == "gap" or ln["view"] is None:
                continue
            d = min(abs(i - idx), last) if idx >= 0 else last
            if d < last:
                near.add(i)
            style = (d, self.free)
            if style == ln["style"]:
                continue
            ln["style"] = style
            self.style_line(ln, d, self.free)
        for i in self.near - near:
            if lo <= i < hi or i >= n or self.lines[i]["view"] is None:
                continue
            ln = self.lines[i]
            ln["style"] = (last, self.free)
            self.style_line(ln, last, self.free)
        self.near = near

    @_t("LiveLyrics.style_line")
    def style_line(self, ln, d, free):
        """Scale and alpha animate natively. Blur has two states only (the two nearest lines sharp, the rest
        blurred), so a line change flips it on two lines instead of re-rendering six layers."""
        tv = ln["view"]
        sc = 1.0 if d == 0 else 0.94
        tv.animate().scaleX(F(sc)).scaleY(F(sc)).alpha(F(self.ALPHAS[d])).setDuration(jlong(380)).start()
        if self.blur_ok:
            want = (not free) and d >= 2
            if ln.get("blur", False) != want:
                ln["blur"] = want
                try:
                    tv.setRenderEffect(self.blur_fx if want else None)
                except Exception:
                    self.blur_ok = False
                    log_exc("live blur")

    # ---- scrolling and touches
    @_t("LiveLyrics.cancel_scroll")
    def cancel_scroll(self):
        an = self.scroll_anim
        self.scroll_anim = None
        if an is not None:
            try:
                an.cancel()
            except Exception:
                _dexc("LiveLyrics.cancel_scroll:L2977")
                pass

    @_t("LiveLyrics.scroll_to_active")
    def scroll_to_active(self):
        """Glides to the current line. False while that line is not laid out yet (try again next frame)."""
        idx = self.active
        if idx < 0:
            target = 0
        elif idx < len(self.lines) and self.lines[idx]["kind"] != "gap":
            view = self.lines[idx]["view"]
            if view is None or int(view.getHeight()) <= 0 or int(self.sv.getHeight()) <= 0:
                return False
            target = int(view.getTop()) - int(int(self.sv.getHeight()) * 0.28)
        else:
            return True
        max_scroll = max(0, int(self.box.getHeight()) - int(self.sv.getHeight()))
        target = max(0, min(target, max_scroll))
        cur = int(self.sv.getScrollY())
        if abs(cur - target) < 2:
            return True
        if self.scroll_anim is not None and getattr(self, "scroll_target", None) == target:
            try:
                if bool(self.scroll_anim.isRunning()):
                    return True
            except Exception:
                pass
        self.cancel_scroll()
        self.scroll_target = target
        try:
            from android.animation import ObjectAnimator
            from android.view.animation import DecelerateInterpolator
            an = ObjectAnimator.ofInt(self.sv, "scrollY", jarray(jint)([cur, target]))
            an.setDuration(jlong(600))
            an.setInterpolator(DecelerateInterpolator(F(1.8)))
            an.start()
            self.scroll_anim = an
        except Exception:
            log_exc("live scroll")
            self.sv.scrollTo(0, target)
        return True

    @_t("LiveLyrics.on_touch", True)
    def on_touch(self, view, event):
        action = int(event.getActionMasked())
        if action == 0 or (action == 2 and self.user_until != float("inf")):
            self.cancel_scroll()
            self.user_until = float("inf")
            if not self.free:
                self.free = True
                self.restyle()
        elif action in (1, 3):
            self.user_until = time.time() + self.PAUSE_AFTER_TOUCH
            self.kick()
        return False

    @_t("LiveLyrics.on_line_click")
    def on_line_click(self, view):
        try:
            tag = view.getTag()
            self.seek_line(tag if isinstance(tag, int) else int(tag.intValue()))
        except Exception:
            log_exc("live tap")

    @_t("LiveLyrics.seek_line")
    def seek_line(self, i):
        if not self.synced or not (0 <= i < len(self.lines)):
            return
        mo = playing()
        if mo is None:
            return
        dur = float(mo.getDuration()) * 1000.0
        if dur <= 0:
            return
        self.c.seek_to(clamp01((self.lines[i]["start"] + 30) / dur))
        self.user_until = 0.0
        self.free = False
        self.active = -2
        self.clock = None
        self.scroll_pending = True
        self.kick()


SPOTIFY_VIBE_FORM = "pill"


class SpotifySkin(Skin):
    key = "spotify"
    FONT = "spotify"
    TITLE = (19, 700)
    ARTIST = (15, 400)
    SOURCE = (12, 700)
    TIME = (11.5, 400)
    always_dark = True
    fade_main = ("lyric", "lcard", "dislike")
    like_icons = ("plus_circle", "icon", "check_circle", "accent", True)
    back_to_main = True

    @_t("SpotifySkin.__init__")
    def __init__(self, ctrl):
        super().__init__(ctrl)
        self.timer_slot = None
        self.canvas_on = False
        self.line = None
        self.lyrics_state = -1
        self.live = None
        self.vibe_form = None

    @_t("SpotifySkin.release")
    def release(self):
        if self.live is not None:
            self.live.release()

    @_t("SpotifySkin.active_changed")
    def active_changed(self, active):
        if self.live is not None:
            self.live.active_changed(active)

    @_t("SpotifySkin.palette")
    def palette(self, stats, dark):
        if stats is None:
            card = rgb(0x404040)
        elif stats["neutral"]:
            card = with_lum(stats["dom"], 0.045, max_s=0.12)
        else:
            card = with_lum(stats["dom"], 0.045)
        return {
            "background": rgb(0x121212), "bg_top": mix(card, rgb(0x121212), 0.3), "bg_bottom": rgb(0x121212),
            "card": card, "surface": rgb(0x282828), "status": with_alpha(BLACK, 0.2),
            "text": WHITE, "text2": with_alpha(WHITE, 0.7), "icon": WHITE,
            "accent": rgb(0x1ED760), "on_accent": BLACK,
            "fill": WHITE, "track": with_alpha(WHITE, 0.3), "thumb": WHITE,
            "play_bg": WHITE, "play_icon": BLACK,
            "placeholder": rgb(0x282828), "placeholder_icon": rgb(0x7F7F7F), "dark": True,
        }

    @_t("SpotifySkin.build")
    def build(self):
        c = self.c
        p = c.p
        if p.timer_enabled():
            self.timer_slot = "repeat" if int(p.get_setting("timer_place", 0) or 0) == 1 else "row"
        c.make_gradient_bg(status=True)
        c.make_scrims()
        c.make_thumb()
        c.text("caption", 11, 500, gravity=17, color="text", spacing=0.0)
        c.restyle("collapse", "chevron_down", 28.4, tint="icon")
        c.restyle("more", "more_v", 24.8, tint="icon")
        c.restyle("shuffle", "shuffle", 29, keep_bg=True, tint=None)
        if self.timer_slot == "repeat":
            c.hidden_extra.append("repeatButton")
        else:
            c.restyle("repeat", "repeat", 29, keep_bg=True, tint=None)
        c.add("prev", "prev", 39, 48, c.act_prev)
        c.add("play", "pause", 33, 64, c.act_play, bg="oval", tint="play_icon", bg_key="play_bg")
        c.add("next", "next", 39, 48, c.act_next)
        c.add("like", "plus_circle", 34.6, 44, c.act_like)
        c.add("dislike", "x", 38.4, 44, c.act_dislike)
        c.add("devices", "devices", 25.5, 40, c.act_cast)
        c.add("share", "share", 24, 40, c.act_share)
        c.add("queue", "queue", 21, 40, c.act_queue)
        if self.timer_slot is not None:
            c.add("timer", "timer", 28.4, 40, c.act_timer)
        c.text("lyric", 15, 700, color="text")
        c.make_lcard()
        c.make_seek(track_dp=3, fill_dp=3, thumb_dp=12)
        if c.vibe_enabled():
            self.vibe_form = SPOTIFY_VIBE_FORM
            if self.vibe_form == "pill":
                c.make_vibe_pill()
            else:
                c.make_vibe_spotify_card()
            self.fade_main = SpotifySkin.fade_main + ("vibe",)
        try:
            self.live = LiveLyrics(c)
        except Exception:
            self.live = None
            log_exc("live lyrics")

    @property
    def menu_items(self):
        return ("playlist", "speed", "order") if self.timer_slot == "repeat" else ("playlist", "speed")

    @_t("SpotifySkin.geometry")
    def geometry(self, e):
        cl, ct, W, cb, H = e["cl"], e["ct"], e["cw"], e["cb"], e["h"]
        mid = cl + W / 2.0
        g = {}
        hc = ct + P(33)
        g["collapse"] = C(cl + P(32), hc, P(40), P(40))
        g["more"] = C(cl + W - P(32), hc, P(40), P(40))
        g["caption"] = C(mid, ct + P(25), W - P(150), P(16))
        g["source"] = C(mid, ct + P(38.5), W - P(150), P(20))
        g["status"] = (0, 0, e["w"], ct)
        card_top = cb - P(32)
        g["lcard"] = (cl + P(16), card_top, W - P(32), H - card_top + P(24))
        row = cb - P(69)
        g["devices"] = C(cl + P(31), row, P(40), P(40))
        g["queue"] = C(cl + W - P(33), row, P(40), P(40))
        g["share"] = C(cl + W - P(83.3), row, P(40), P(40))
        tr = cb - P(142.2)
        outer = W / 2.0 - P(36.4)
        inner = outer * 0.5075
        g["shuffle"] = C(mid - outer, tr, P(40), P(40))
        right_slot = C(mid + outer, tr, P(40), P(40))
        if self.timer_slot == "repeat":
            g["timer"] = right_slot
        else:
            g["repeat"] = right_slot
            if self.timer_slot == "row":
                g["timer"] = C(cl + W - P(133.5), row, P(40), P(40))
        g["prev"] = C(mid - inner, tr, P(48), P(48))
        g["next"] = C(mid + inner, tr, P(48), P(48))
        g["play"] = C(mid, tr, P(64), P(64))
        sy = cb - P(214.9)
        g["seek"] = (cl + P(24), sy - P(16), W - P(48), P(32))
        ty = cb - P(197.5)
        g["time"] = (cl + P(24), ty - P(9), P(90), P(18))
        g["duration"] = (cl + W - P(24) - P(90), ty - P(9), P(90), P(18))
        rc = cb - P(258.6)
        g["like"] = C(cl + W - P(40), rc, P(44), P(44))
        g["dislike"] = C(cl + W - P(96), rc, P(44), P(44))
        right = cl + W - (P(124) if self.c.wants.get("dislike", False) else P(68))
        g["title"] = (cl + P(24), cb - P(267.8) - P(14), right - cl - P(24), P(28))
        g["artist"] = (cl + P(18), cb - P(248) - P(13), right - cl - P(12), P(26))
        g["thumb"] = (cl + P(24), rc - P(24), P(48), P(48))
        g["lyric"] = (cl + P(24), cb - P(332.7) - P(12), W - P(48), P(24))
        top = ct + P(99.3)
        bottom = cb - P(332.7) - P(93.1)
        if self.vibe_form == "card":
            vh = P(56)
            vy = cb - P(332.7) - P(12) - P(10) - vh
            g["vibe"] = (cl + P(24), vy, W - P(48), vh)
            bottom = min(bottom, vy - P(14))
        elif self.vibe_form == "pill":
            left = cl + P(31) + P(20) + P(10)
            right = (cl + W - P(133.5) if self.timer_slot == "row" else cl + W - P(83.3)) - P(20) - P(10)
            pw = max(P(96), min(P(156), right - left))
            g["vibe"] = (left + (right - left - pw) / 2.0, row - P(16), pw, P(32))
        size = max(0, min(W - P(48), bottom - top))
        g["cover"] = (mid - size / 2.0, top + (bottom - top - size) / 2.0, size, P(7.5))
        side = max(H, e["w"])
        g["cover_full"] = (mid - side / 2.0, (H - side) / 2.0, side, 0)
        g["scrim_top"] = (0, 0, e["w"], ct + P(110))
        g["scrim_bottom"] = (0, int(H * 0.42), e["w"], H - int(H * 0.42))
        ry = ct + P(64)
        g["cover_c"] = (cl + P(24), ry, P(48), P(4))
        g["title_c"] = (cl + P(84), ry - P(4), W - P(84) - P(64), P(28))
        g["artist_c"] = (cl + P(78), ry + P(22), W - P(84) - P(64) + P(12), P(26))
        g["like_c"] = C(cl + W - P(40), ry + P(24), P(44), P(44))
        st, sb = ry + P(48) + P(18), sy - P(30)
        g["stage"] = (cl, st, W, max(P(64), sb - st))
        if self.live is not None:
            g["live_bg"] = (0, 0, e["w"], H)
            g["live"] = g["stage"]
        return g

    @_t("SpotifySkin.canvas")
    def canvas(self):
        return self.c.anim.get("canvas", 0.0)

    @_t("SpotifySkin.cover_rect")
    def cover_rect(self, g):
        return lerp_rect(g["cover"], g["cover_full"], smooth(self.canvas()))

    @_t("SpotifySkin.title_shift")
    def title_shift(self):
        return P(61) * smooth(self.canvas())

    @_t("SpotifySkin.moving")
    def moving(self, g):
        return {"like": (g["like"], g["like_c"])}

    @_t("SpotifySkin.colors")
    def colors(self, pal, pc):
        c = self.c
        if c.lcard_bg is not None:
            c.lcard_bg.setColor(jint(int(pc.buffer)))
        if self.vibe_form == "card" and c.vibe_bg is not None:
            c.vibe_bg.setColor(jint(mix(int(pc.buffer), WHITE, 0.08)))
        if self.vibe_form:
            c.refresh_vibe_text()

    @_t("SpotifySkin.dynamic")
    def dynamic(self):
        c = self.c
        wave = c.p.mywave()
        on = bool(wave is not None and getattr(wave, "active", False))
        if on != c.wants.get("dislike", False):
            c.want("dislike", on)
            c.L.requestLayout()
        timer = c.btn.get("timer")
        if timer is not None and c.pal is not None:
            timer.set_tint(c.pal["accent"] if c.p.timer.active() else c.pal["icon"])
        if self.vibe_form:
            c.set_vibe_locked(c.p.mywave() is None)

    @_t("SpotifySkin.track_changed")
    def track_changed(self, mo):
        c = self.c
        if self.live is not None:
            self.live.reset()
        self.canvas_on = False
        c.anim_set("canvas", 0.0)
        self.line = None
        c.want("lyric", False)
        c.want("thumb", True)
        thumb = c.el.get("thumb")
        if thumb is not None:
            thumb.setImageDrawable(None)
        try:
            caption = c.txt.get("caption")
            if caption is not None and mo is not None:
                caption.setText(T(c.source_kind(mo)))
        except Exception:
            log_exc("caption")
        if self.vibe_form:
            c.refresh_vibe_text(str(mo.getMusicTitle() or "") if mo is not None else "")
        if mo is not None and c.mode() != 1:
            try:
                call(c.sheet, SHEET, "loadLyrics", False)
            except Exception:
                log_exc("load lyrics")

    @_t("SpotifySkin.cover_loaded")
    def cover_loaded(self, mo, bmp):
        thumb = self.c.el.get("thumb")
        if thumb is not None and bmp is not None:
            thumb.setImageBitmap(cover_copy(bmp, 160))
        if self.live is not None and bmp is not None:
            self.live.set_cover(bmp)

    @_t("SpotifySkin.progress", True)
    def progress(self):
        c = self.c
        ready = c.motion_ready()
        if ready != self.canvas_on:
            self.canvas_on = ready
            c.animate("canvas", 1.0 if ready else 0.0, 450)
        if self.live is not None and self.live.shown():
            return
        lv = c.o["lyricsView"]
        state = as_int(get_private_field(lv, "state"), 0)
        if state != self.lyrics_state:
            self.lyrics_state = state
            if state in (1, 3, 4, 5, 6, 0):
                c.want("lcard", state in (1, 3))
        text = None
        if state == 3:
            lyr = get_private_field(lv, "lyrics")
            if lyr is not None and as_bool(lyr.synced):
                mo = playing()
                if mo is not None:
                    idx = as_int(lyr.indexAt(jlong(position_ms(mo))), -1)
                    text = str(lyr.lines.get(idx).text).strip() if idx >= 0 else ""
                    if not text:
                        text = "♪"
        if text != self.line:
            self.line = text
            if text is not None:
                c.txt["lyric"].setText(text)
            c.want("lyric", text is not None)

    @_t("SpotifySkin.transitions")
    def transitions(self, g, f):
        c = self.c
        cv = smooth(self.canvas()) * (1.0 - f)
        for name in ("scrim_top", "scrim_bottom", "thumb"):
            c.set_alpha(name, cv)
        c.set_alpha("status", 1.0 - cv)
        if self.live is not None:
            try:
                self.live.transitions(f)
            except Exception:
                log_exc("live transitions")


class YandexSkin(Skin):
    key = "yandex"
    FONT = "yandex"
    TITLE = (19, 600)
    ARTIST = (15.5, 400)
    SOURCE = (13, 500)
    TIME = (13, 400)
    hide = ("shuffleButton",)
    menu_items = ("playlist", "order", "speed")
    fade_main = ("avatar0", "avatar1", "vibe")
    like_icons = ("heart", "icon2", "heart_fill", "icon_main", False)

    @_t("YandexSkin.__init__")
    def __init__(self, ctrl):
        super().__init__(ctrl)
        self.avatar_n = 1
        self.photo_for = None
        self.avatar_src = {}
        self.swoosh_size = None

    @_t("YandexSkin.palette")
    def palette(self, stats, dark):
        if dark:
            bg = scale(stats["avg"], 0.66) if stats else rgb(0x1E1E1E)
            h, s, _ = hsv_of(bg)
            return {
                "background": bg, "bg_top": bg, "bg_bottom": bg, "surface": mix(bg, WHITE, 0.1),
                "text": with_alpha(WHITE, 0.9), "text2": with_alpha(WHITE, 0.5), "icon": with_alpha(WHITE, 0.55),
                "icon_main": with_alpha(WHITE, 0.92), "icon2": with_alpha(WHITE, 0.5), "icon_dim": with_alpha(WHITE, 0.5),
                "accent": rgb(0xFFFF00), "on_accent": BLACK,
                "fill": WHITE, "track": with_alpha(WHITE, 0.2), "thumb": WHITE,
                "play_bg": rgb(0xFFFF00), "play_icon": BLACK, "card": with_alpha(WHITE, 0.07),
                "pill": with_alpha(WHITE, 0.08), "pill_on": with_alpha(WHITE, 0.16), "peek": with_alpha(WHITE, 0.05),
                "card_a": with_alpha(WHITE, 0.16), "card_b": with_alpha(WHITE, 0.06),
                "vibe1": from_hsv(h, min(s * 0.5, 0.25), 0.93), "vibe2": with_alpha(WHITE, 0.93),
                "placeholder": mix(bg, WHITE, 0.08), "placeholder_icon": with_alpha(WHITE, 0.4), "dark": True,
            }
        base = stats["avg"] if stats else rgb(0xF2F2F2)
        bg = mix(base, WHITE, 0.82)
        h, s, _ = hsv_of(bg)
        return {
            "background": bg, "bg_top": bg, "bg_bottom": bg, "surface": mix(bg, BLACK, 0.04),
            "text": with_alpha(BLACK, 0.9), "text2": with_alpha(BLACK, 0.5), "icon": with_alpha(BLACK, 0.55),
            "icon_main": with_alpha(BLACK, 0.9), "icon2": with_alpha(BLACK, 0.5), "icon_dim": with_alpha(BLACK, 0.5),
            "accent": rgb(0xD4A800), "on_accent": BLACK,
            "fill": BLACK, "track": with_alpha(BLACK, 0.14), "thumb": BLACK,
            "play_bg": rgb(0xFFDD00), "play_icon": BLACK, "card": with_alpha(BLACK, 0.05),
            "pill": with_alpha(BLACK, 0.06), "pill_on": with_alpha(BLACK, 0.12), "peek": with_alpha(BLACK, 0.04),
            "card_a": with_alpha(BLACK, 0.07), "card_b": with_alpha(BLACK, 0.03),
            "vibe1": from_hsv(h, min(s * 2.0, 0.5), 0.45), "vibe2": with_alpha(BLACK, 0.9),
            "placeholder": mix(bg, BLACK, 0.06), "placeholder_icon": with_alpha(BLACK, 0.35), "dark": False,
        }

    @_t("YandexSkin.build")
    def build(self):
        c = self.c
        c.make_peek()
        c.restyle("collapse", "chevron_down", 25.7, tint="icon_dim")
        c.restyle("more", "more_v", 26.7, tint="icon2")
        c.add("cast", "cast_y", 23.3, 40, c.act_cast, tint="icon_dim")
        c.add("qlist", "list_bullets", 26, 40, c.act_queue, tint="icon_dim")
        c.make_avatars()
        c.add("share", "upload", 26.4, 40, c.act_share, tint="icon2")
        c.make_seek(track_dp=2, fill_dp=2, thumb_dp=10)
        c.add("dislike", "heart_off", 24.5, 44, c.act_dislike, tint="icon2")
        c.add("prev", "prev_y", 31.8, 48, c.act_prev, tint="icon_main")
        c.add("play", "pause", 34.9, 64, c.act_play, bg="oval", tint="play_icon", bg_key="play_bg")
        c.add("next", "next_y", 31.8, 48, c.act_next, tint="icon_main")
        c.add("like", "heart", 24.1, 44, c.act_like)
        c.restyle("repeat", "repeat", 25.6, box=(72, 48), bg="pill", tint=None)
        c.add("lyrics", "lyrics_y", 25.5, (72, 48), c.act_lyrics, bg="pill", tint="icon2", bg_key="pill")
        c.add("download", "download", 25.5, (72, 48), c.act_download, bg="pill", tint="icon2", bg_key="pill")
        c.make_vibe_card()

    @_t("YandexSkin.geometry")
    def geometry(self, e):
        cl, ct, W, cb, H = e["cl"], e["ct"], e["cw"], e["cb"], e["h"]
        mid = cl + W / 2.0
        g = {}
        hc = ct + P(24.4)
        g["collapse"] = C(cl + P(24), hc, P(40), P(40))
        g["source"] = C(mid, hc, W - P(176), P(22))
        g["cast"] = C(cl + W - P(72), hc, P(40), P(40))
        g["qlist"] = C(cl + W - P(24), hc, P(40), P(40))
        card_top = cb - P(75.3)
        g["vibe"] = (cl + P(28), card_top, W - P(56), P(51.6))
        g["peek"] = (cl + P(28), cb + P(8.3), W - P(56), P(60))
        pills = cb - P(143.7)
        g["repeat"] = C(cl + P(64), pills, P(72), P(48))
        g["lyrics"] = C(mid, pills, P(72), P(48))
        g["download"] = C(cl + W - P(64), pills, P(72), P(48))
        tr = cb - P(270.6)
        g["dislike"] = C(cl + P(39.5), tr, P(44), P(44))
        g["prev"] = C(mid - P(72), tr, P(48), P(48))
        g["play"] = C(mid, tr, P(64), P(64))
        g["next"] = C(mid + P(72), tr, P(48), P(48))
        g["like"] = C(cl + W - P(40), tr, P(44), P(44))
        sy = cb - P(337.5)
        g["seek"] = (cl + P(28), sy - P(16), W - P(56), P(32))
        ty = cb - P(325.7)
        g["time"] = (cl + P(28), ty - P(9), P(90), P(18))
        g["duration"] = (cl + W - P(28) - P(90), ty - P(9), P(90), P(18))
        row = cb - P(392.6)
        g["avatar0"] = C(cl + P(54), row, P(52), P(52))
        g["avatar1"] = C(cl + P(86), row, P(52), P(52))
        tx = cl + (P(125.1) if self.avatar_n > 1 else P(93.1))
        right = cl + W - P(112)
        g["share"] = C(cl + W - P(88), row, P(40), P(40))
        g["more"] = C(cl + W - P(40), row, P(40), P(40))
        g["title"] = (tx, row - P(9.4) - P(15), right - tx, P(30))
        g["artist"] = (tx - P(6), row + P(9.9) - P(13), right - tx + P(12), P(26))
        top = ct + P(90.6)
        bottom = row - P(49.9)
        size = max(0, min(W - P(56), bottom - top))
        g["cover"] = (mid - size / 2.0, top + (bottom - top - size) / 2.0, size, P(12))
        ry = ct + P(56)
        g["cover_c"] = (cl + P(28), ry, P(52), P(10))
        g["title_c"] = (cl + P(93), ry + P(16.6) - P(15), W - P(93) - P(112), P(30))
        g["artist_c"] = (cl + P(87), ry + P(35.9) - P(13), W - P(93) - P(112) + P(12), P(26))
        g["share_c"] = C(cl + W - P(88), ry + P(26), P(40), P(40))
        g["more_c"] = C(cl + W - P(40), ry + P(26), P(40), P(40))
        st, sb = ry + P(52) + P(16), sy - P(28)
        g["stage"] = (cl, st, W, max(P(64), sb - st))
        return g

    @_t("YandexSkin.moving")
    def moving(self, g):
        return {"share": (g["share"], g["share_c"]), "more": (g["more"], g["more_c"])}

    @_t("YandexSkin.colors")
    def colors(self, pal, pc):
        c = self.c
        if c.vibe_lock is not None:
            c.vibe_lock.setColorFilter(color_filter(pal["vibe2"]))
        if c.vibe_bg is not None:
            c.vibe_bg.setColors(jarray(jint)([pal["card_a"], pal["card_b"], pal["card_a"]]))
        if c.peek_bg is not None:
            c.peek_bg.setColor(jint(pal["peek"]))
        for i in range(2):
            av = c.el.get("avatar%d" % i)
            if av is not None:
                av.getBackground().setColor(jint(pal["placeholder"]))

    @_t("YandexSkin.dynamic")
    def dynamic(self):
        c = self.c
        pal = c.pal
        if pal is None:
            return
        mode = c.mode()
        lyr = c.btn.get("lyrics")
        if lyr is not None:
            lyr.set_tint(pal["icon_main"] if mode == 1 else pal["icon2"])
            lyr.set_bg(pal["pill_on"] if mode == 1 else pal["pill"])
        rep = c.btn.get("repeat")
        if rep is not None:
            rep.set_bg(pal["pill_on"] if int(SharedConfig.repeatMode) != 0 else pal["pill"])
        dl = c.btn.get("download")
        if dl is not None:
            saved = c.p.is_saved()
            dl.set_icon("check" if saved else "download")
            dl.set_tint(pal["icon2"])
            dl.view.setAlpha(F(0.4 if c.noforwards() else 1.0))
        # The card is always shown; without My Wave it is locked and explains where to get the plugin.
        c.set_vibe_locked(c.p.mywave() is None)

    @_t("YandexSkin.track_changed")
    def track_changed(self, mo):
        c = self.c
        title = str(mo.getMusicTitle() or "") if mo is not None else ""
        c.refresh_vibe_text(title)
        names = []
        if mo is not None:
            names = [n for n in ARTIST_SPLIT.split(str(mo.getMusicAuthor() or "")) if n.strip()][:2]
        n = max(1, len(names))
        if n != self.avatar_n:
            self.avatar_n = n
            c.L.requestLayout()
        c.want("avatar1", n > 1)
        self.photo_for = c.track_id
        self.avatar_src = {}
        for i in range(2):
            c.el["avatar%d" % i].setImageDrawable(None)
        if not c.p.photos_enabled():
            return
        for i, name in enumerate(names):
            self._photo(i, name.strip())

    @_t("YandexSkin._photo")
    def _photo(self, i, name):
        c = self.c
        track = self.photo_for

        def apply(path):
            if c.closed or self.photo_for != track or not path:
                return
            try:
                bmp = A.BitmapFactory.decodeFile(path)
                if bmp is not None:
                    c.el["avatar%d" % i].setImageBitmap(bmp)
                    self.avatar_src[i] = "photo"
            except Exception:
                log_exc("avatar")
        path = c.p.photos.request(name, apply)
        if path:
            apply(path)

    @_t("YandexSkin.cover_loaded")
    def cover_loaded(self, mo, bmp):
        c = self.c
        if bmp is None:
            return
        small = None
        for i in range(2):
            av = c.el.get("avatar%d" % i)
            if av is not None and self.avatar_src.get(i) != "photo":
                if small is None:
                    small = cover_copy(bmp, 200)
                av.setImageBitmap(small)
                self.avatar_src[i] = "cover"

    @_t("YandexSkin.transitions")
    def transitions(self, g, f):
        c = self.c
        size = g.get("vibe_size")
        if c.swoosh is not None and size is not None and size != self.swoosh_size:
            self.swoosh_size = size
            c.swoosh.setImageBitmap(swoosh_bitmap(size[0], size[1]))


class SoundCloudSkin(Skin):
    key = "soundcloud"
    FONT = "soundcloud"
    TITLE = (15, 500)
    ARTIST = (15, 400)
    SOURCE = (13, 500)
    TIME = (11, 400)
    always_dark = True
    cover_hidden = True
    hide = ("shuffleButton", "repeatButton", "timeView", "durationView", "headerTitle")
    menu_items = ("playlist", "lyrics", "order", "speed")
    fade_main = ("follow", "comment_bar")
    like_icons = ("heart", "icon", "heart_fill", "accent", False)

    @_t("SoundCloudSkin.__init__")
    def __init__(self, ctrl):
        super().__init__(ctrl)
        self.pill_text = None
        self.vibe_on = False

    @_t("SoundCloudSkin.palette")
    def palette(self, stats, dark):
        return {
            "background": rgb(0x121212), "bg_top": rgb(0x121212), "bg_bottom": rgb(0x121212), "surface": rgb(0x1E1E1E),
            "text": WHITE, "text2": rgb(0xC6C6C6), "icon": WHITE,
            "accent": rgb(0xFF5500), "on_accent": WHITE,
            "fill": rgb(0xFF5500), "track": rgb(0xE6E6E6), "thumb": WHITE,
            "play_bg": with_alpha(BLACK, 0.45), "play_icon": WHITE, "card": rgb(0x121212),
            "light": rgb(0xF3F3F3), "on_light": BLACK, "circle": with_alpha(BLACK, 0.45), "box": BLACK,
            "comment_bg": with_alpha(BLACK, 0.7), "comment_stroke": with_alpha(WHITE, 0.22),
            "placeholder": rgb(0x1E1E1E), "placeholder_icon": rgb(0x7A7A7A), "dark": True,
        }

    @_t("SoundCloudSkin.build")
    def build(self):
        c = self.c
        c.make_art()
        c.restyle("collapse", "chevron_down", 25, bg="oval", tint="on_light", bg_key="light")
        c.add("follow", "person_add", 25, 36, c.act_follow, bg="oval", tint="on_light", bg_key="light")
        c.add("prev", "prev", 30, 56, c.act_prev, bg="oval", tint="icon", bg_key="circle")
        c.add("play", "pause", 34, 72, c.act_play, bg="oval", tint="play_icon", bg_key="play_bg")
        c.add("next", "next", 30, 56, c.act_next, bg="oval", tint="icon", bg_key="circle")
        c.make_wave()
        c.make_time_pill()
        c.make_comment_bar()
        c.add("like", "heart", 25.5, 44, c.act_like)
        c.add("comment", "comment", 25.5, 44, c.act_comment)
        c.add("share", "share", 26.5, 44, c.act_share)
        c.add("queue", "queue_list", 24, 44, c.act_queue)
        c.restyle("more", "more_v", 23.7, tint="icon")
        if c.vibe_enabled():
            c.make_vibe_label()
            self.vibe_on = True
            self.fade_main = SoundCloudSkin.fade_main + ("vibe",)

    @_t("SoundCloudSkin.geometry")
    def geometry(self, e):
        cl, ct, W, cb, H = e["cl"], e["ct"], e["cw"], e["cb"], e["h"]
        mid = cl + W / 2.0
        g = {}
        top = ct + P(8)
        bottom = cb - P(72)
        g["art"] = (cl, top, W, bottom - top)
        g["title"] = (cl + P(16), top + P(58.9), W - P(86), P(23.6))
        g["artist"] = (cl + P(16), top + P(83.3), W - P(86), P(22.9))
        g["title_c"], g["artist_c"] = g["title"], g["artist"]
        if self.vibe_on:
            g["vibe"] = (cl + P(16), top + P(83.3) + P(22.9) + P(7), min(W - P(86), self.c.vibe_label_width()), P(23))
        bx = cl + W - P(34.2)
        g["collapse"] = C(bx, top + P(82.9), P(36), P(36))
        g["follow"] = C(bx, top + P(134.9), P(36), P(36))
        base = bottom - P(143.3)
        g["wave"] = (0, base - P(76), e["w"], P(124))
        g["wave_center"] = mid
        g["tpill_base"] = (mid, base)
        g["comment_bar"] = (cl + P(16), bottom - P(94.9), W - P(32), P(57.8))
        free_top = top + P(153)
        free_bottom = base - P(76) - P(16)
        tc = (free_top + free_bottom) / 2.0
        tc_c = base - P(76) - P(44)
        for name, dx, size in (("prev", -P(84), P(56)), ("play", 0, P(72)), ("next", P(84), P(56))):
            g[name] = C(mid + dx, tc, size, size)
            g[name + "_c"] = C(mid + dx, tc_c, size, size)
        bar = bottom + P(32.2)
        xs = [cl + P(28) + (W - P(68)) * k / 4.0 for k in range(5)]
        for name, x in zip(("like", "comment", "share", "queue"), xs):
            g[name] = C(x, bar, P(44), P(44))
        g["more"] = C(xs[4], bar, P(40), P(40))
        g["cover"] = (cl, top, P(1), 0)
        g["cover_c"] = g["cover"]
        st = top + P(83.3) + P(22.9) + P(14)
        sb = tc_c - P(36) - P(12)
        g["stage"] = (cl, st, W, max(P(64), sb - st))
        return g

    @_t("SoundCloudSkin.moving")
    def moving(self, g):
        return {name: (g[name], g[name + "_c"]) for name in ("prev", "play", "next")}

    @_t("SoundCloudSkin.colors")
    def colors(self, pal, pc):
        c = self.c
        for tv in c.title_views() + c.artist_views():
            if tv is not None:
                tv.setBackgroundColor(jint(pal["box"]))
        if c.wave is not None:
            c.wave.colors(pal["track"], pal["fill"])
        vibe = c.el.get("vibe")
        if self.vibe_on and vibe is not None:
            vibe.setBackgroundColor(jint(pal["box"]))
            c.refresh_vibe_text()
        self.pill_text = None
        self.progress()

    @_t("SoundCloudSkin.dynamic")
    def dynamic(self):
        if self.vibe_on:
            self.c.set_vibe_locked(self.c.p.mywave() is None)

    @_t("SoundCloudSkin.track_changed")
    def track_changed(self, mo):
        c = self.c
        if mo is not None and c.wave is not None:
            c.p.request_wave(c, mo)
        c.update_art()

    @_t("SoundCloudSkin.cover_loaded")
    def cover_loaded(self, mo, bmp):
        self.c.update_art()

    @_t("SoundCloudSkin.progress", True)
    def progress(self):
        c = self.c
        tv = c.txt.get("tpill")
        if tv is None or c.pal is None:
            return
        left = str(c.v["time"].getText() or "")
        right = str(c.v["duration"].getText() or "")
        text = "%s  |  %s" % (left, right)
        if text == self.pill_text:
            return
        self.pill_text = text
        span = A.SpannableString(text)
        start = len(left) + 2
        span.setSpan(A.ForegroundColorSpan(jint(c.pal["text2"])), start + 3, len(text), A.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
        tv.setText(span)
        c.place_time_pill()

    @_t("SoundCloudSkin.transitions")
    def transitions(self, g, f):
        self.c.set_alpha("art", lerp(1.0, 0.25, f))


SKIN_STYLES = (STYLE_SPOTIFY, STYLE_YANDEX, STYLE_SOUNDCLOUD)


def make_skin(style, ctrl):
    """The skin of a style. Spelled out, so it is plain which code runs for which setting."""
    if style == STYLE_SPOTIFY:
        return SpotifySkin(ctrl)
    if style == STYLE_YANDEX:
        return YandexSkin(ctrl)
    return SoundCloudSkin(ctrl)


# ---------------------------------------------------------------- full-screen player controller

class Ctrl:
    ORIGINALS = ("collapseButton", "moreButton", "headerTitle", "headerSubtitle", "lyricsView", "queueView", "coverView",
                 "titleView", "artistView", "profileButton", "seekBar", "timeView", "durationView", "controlsView",
                 "shuffleButton", "repeatButton", "speedButton", "lyricsButton", "queueButton")
    SHORT = {"collapse": "collapseButton", "more": "moreButton", "shuffle": "shuffleButton", "repeat": "repeatButton",
             "source": "headerTitle", "time": "timeView", "duration": "durationView"}
    HIDDEN = ("seekBar", "controlsView", "speedButton", "lyricsButton", "queueButton", "profileButton", "headerSubtitle")

    @_t("Ctrl.__init__")
    def __init__(self, plugin, sheet, style):
        A.init()
        self.p = plugin
        self.sheet = sheet
        self.style = style
        self.L = get_private_field(sheet, "playerLayout")
        if self.L is None:
            raise RuntimeError("playerLayout not found")
        self.ctx = sheet.getContext()
        self.o = {}
        for name in self.ORIGINALS:
            view = get_private_field(sheet, name)
            if view is None:
                raise RuntimeError("player field %s not found" % name)
            self.o[name] = view
        self.v = {short: self.o[full] for short, full in self.SHORT.items()}
        self.rhythm = get_private_field(sheet, "rhythmBackground")
        self.actions = get_private_field(sheet, "actions")
        self.mine = []
        self.el = {}
        self.wants = {}
        self.alphas = {}
        self.vis_state = {}
        self.btn = {}
        self.txt = {}
        self.txt_spec = {}
        self.txt_color = {}
        self.hidden_extra = []
        self.seek = None
        self.wave = None
        self.bg_draw = None
        self.lcard_bg = None
        self.vibe_bg = None
        self.vibe_line2 = None
        self.vibe_col = None
        self.vibe_lock = None
        self.vibe_locked = False
        self.vibe_render = None
        self.vibe_w = 0
        self.swoosh = None
        self.peek_bg = None
        self.anchor = None
        self.geo = None
        self.active = True
        self.closed = False
        self.controls_shown = True
        self.pal = None
        self.track_id = None
        self.title_w = self.artist_w = None
        self.art_for = None
        self.anim = {}
        self.anim_tok = {}
        self.child_count = -1
        self.fails = 0
        self.foreign = []
        self.guard = None
        self.gesture = None
        self.touch_view = None
        self.pinned = []
        self.pin_rect = {}
        self.pin_tr = {}
        self.mine_set = None
        self.skin = make_skin(style, self)
        self.dark = True if self.skin.always_dark else plugin.is_dark()
        self.skin.build()
        for name in ("headerTitle", "collapseButton", "moreButton"):
            try:
                self.o[name].bringToFront()
            except Exception:
                log_exc("bring to front")
        if self.skin.back_to_main:
            self.install_collapse()
            try:
                self.gesture = SwipeGesture(self)
                self.touch_view = plugin.touch_target(self.L, sheet)
            except Exception:
                self.gesture = None
                log_exc("swipe")
        self.make_anchor()
        self.apply_static()
        self.refresh_all()
        self.refresh_colors(False)
        self.update_state()

    # ---- element registry
    @_t("Ctrl.add_view")
    def add_view(self, view, lp, index=None, above_cover=False):
        if above_cover:
            index = int(self.L.indexOfChild(self.o["coverView"])) + 1
        if index is None:
            self.L.addView(view, lp)
        else:
            self.L.addView(view, int(index), lp)
        self.mine.append(view)
        self.mine_java().add(view)

    @_t("Ctrl.mine_java")
    def mine_java(self):
        if self.mine_set is None:
            from java.util import HashSet
            self.mine_set = HashSet()
        return self.mine_set

    @_t("Ctrl.want")
    def want(self, name, on):
        if self.wants.get(name, True) != on:
            self.wants[name] = on
            self.refresh_el(name)

    @_t("Ctrl.set_alpha")
    def set_alpha(self, name, a):
        a = clamp01(a)
        if abs(self.alphas.get(name, 1.0) - a) > 0.001 or name not in self.alphas:
            self.alphas[name] = a
            self.refresh_el(name)

    @_t("Ctrl.refresh_el")
    def refresh_el(self, name):
        view = self.el.get(name)
        if view is None:
            return
        a = self.alphas.get(name, 1.0)
        show = self.active and self.controls_shown and self.wants.get(name, True) and a > 0.01
        vis = VISIBLE if show else INVISIBLE
        if self.vis_state.get(name) != vis:
            self.vis_state[name] = vis
            view.setVisibility(vis)
        view.setAlpha(F(a))

    @_t("Ctrl.refresh_all")
    def refresh_all(self):
        for name in list(self.el.keys()):
            self.refresh_el(name)

    # ---- construction helpers used by skins
    @_t("Ctrl.make_gradient_bg")
    def make_gradient_bg(self, status=False):
        self.bg = A.View(self.ctx)
        self.bg_draw = A.GradientDrawable()
        self.bg_draw.setOrientation(A.GradientDrawable.Orientation.TOP_BOTTOM)
        self.bg.setBackground(self.bg_draw)
        self.add_view(self.bg, flp(-1, -1), index=0)
        self.el["bg"] = self.bg
        if status:
            band = A.View(self.ctx)
            band.setBackgroundColor(jint(with_alpha(BLACK, 0.2)))
            self.add_view(band, flp(-1, P(24)), above_cover=True)
            self.el["status"] = band

    @_t("Ctrl.make_scrims")
    def make_scrims(self):
        for name, colors in (("scrim_top", [with_alpha(BLACK, 0.45), with_alpha(BLACK, 0.0)]),
                             ("scrim_bottom", [with_alpha(BLACK, 0.0), with_alpha(BLACK, 0.55), with_alpha(BLACK, 0.85)])):
            view = A.View(self.ctx)
            d = A.GradientDrawable()
            d.setOrientation(A.GradientDrawable.Orientation.TOP_BOTTOM)
            d.setColors(jarray(jint)(colors))
            view.setBackground(d)
            self.add_view(view, flp(-1, P(100)), above_cover=True)
            self.el[name] = view
            self.alphas[name] = 0.0

    @_t("Ctrl.make_thumb")
    def make_thumb(self):
        view = A.ImageView(self.ctx)
        view.setScaleType(A.ImageView.ScaleType.CENTER_CROP)
        view.setBackground(round_bg(rgb(0x282828), radius=P(4)))
        view.setClipToOutline(True)
        self.add_view(view, flp(P(48), P(48)), above_cover=True)
        self.el["thumb"] = view
        self.alphas["thumb"] = 0.0

    @_t("Ctrl.make_lcard")
    def make_lcard(self):
        box = A.FrameLayout(self.ctx)
        r = P(16)
        self.lcard_bg = round_bg(rgb(0x404040), radii=[r, r, r, r, 0, 0, 0, 0])
        box.setBackground(self.lcard_bg)
        tv = self._new_text(15, 700)
        tv.setText(T("lyrics_preview"))
        box.addView(tv, flp(-2, -2, 51, (P(17), P(17.5), P(17), 0)))
        self.txt["lcard_text"] = tv
        self.txt_spec["lcard_text"] = (15, 700)
        self.txt_color["lcard_text"] = "text"
        box.setOnClickListener(on_click(self.act_lyrics))
        self.add_view(box, flp(-1, P(80)))
        self.el["lcard"] = box
        self.wants["lcard"] = False

    @_t("Ctrl.make_avatars")
    def make_avatars(self):
        for i in range(2):
            view = A.ImageView(self.ctx)
            view.setScaleType(A.ImageView.ScaleType.CENTER_CROP)
            view.setBackground(round_bg(rgb(0x303030), oval=True))
            view.setClipToOutline(True)
            self.add_view(view, flp(P(52), P(52)))
            self.el["avatar%d" % i] = view
        self.wants["avatar1"] = False

    @_t("Ctrl.make_vibe_card")
    def make_vibe_card(self):
        box = A.FrameLayout(self.ctx)
        self.vibe_bg = A.GradientDrawable()
        self.vibe_bg.setOrientation(A.GradientDrawable.Orientation.LEFT_RIGHT)
        self.vibe_bg.setCornerRadius(F(P(20)))
        box.setBackground(self.vibe_bg)
        box.setClipToOutline(True)
        self.swoosh = A.ImageView(self.ctx)
        self.swoosh.setScaleType(A.ImageView.ScaleType.FIT_XY)
        box.addView(self.swoosh, flp(-1, -1))
        col = A.LinearLayout(self.ctx)
        col.setOrientation(A.LinearLayout.VERTICAL)
        col.setGravity(17)
        l1 = self._new_text(13, 400, gravity=17)
        l1.setText(T("vibe_by_track"))
        l2 = self._new_text(19, 700, gravity=17)
        col.addView(l1, A.LinearLayout.LayoutParams(-2, -2))
        col.addView(l2, A.LinearLayout.LayoutParams(-2, -2))
        box.addView(col, flp(-1, -2, 17, (P(16), 0, P(16), 0)))
        for name, tv, spec, colkey in (("vibe1", l1, (13, 400), "vibe1"), ("vibe2", l2, (19, 700), "vibe2")):
            self.txt[name] = tv
            self.txt_spec[name] = spec
            self.txt_color[name] = colkey
        self.vibe_line2 = l2
        self.vibe_col = col
        box.setOnClickListener(on_click(self.act_vibe))
        self.add_view(box, flp(-1, P(52)))
        self.el["vibe"] = box

    @_t("Ctrl.vibe_enabled")
    def vibe_enabled(self):
        return bool(self.p.get_setting("vibe_" + self.skin.key, False))

    @_t("Ctrl._press")
    def _press(self, view, action):
        try:
            view.setScaleX(F(0.96))
            view.setScaleY(F(0.96))
            view.animate().scaleX(F(1.0)).scaleY(F(1.0)).setDuration(jlong(160)).start()
        except Exception:
            _dexc("Ctrl._press:L3993")
            pass
        action()

    @_t("Ctrl.make_vibe_spotify_card")
    def make_vibe_spotify_card(self):
        """Spotify: a rounded card in the cover colour, like Spotify's own cards, with a green play circle."""
        box = A.FrameLayout(self.ctx)
        self.vibe_bg = round_bg(rgb(0x404040), radius=P(8))
        box.setBackground(self.vibe_bg)
        col = A.LinearLayout(self.ctx)
        col.setOrientation(A.LinearLayout.VERTICAL)
        col.setGravity(16)
        l1 = self._new_text(12, 700)
        l1.setText(T("vibe_by_track"))
        l2 = self._new_text(15, 700)
        col.addView(l1, A.LinearLayout.LayoutParams(-1, -2))
        col.addView(l2, A.LinearLayout.LayoutParams(-1, -2))
        box.addView(col, flp(-1, -1, 19, (P(14), 0, P(60), 0)))
        circle = A.ImageView(self.ctx)
        circle.setScaleType(A.ImageView.ScaleType.CENTER)
        circle_bg = round_bg(rgb(0x1ED760), oval=True)
        circle.setBackground(circle_bg)
        box.addView(circle, flp(P(36), P(36), 21, (0, 0, P(12), 0)))
        for name, tv, spec, colkey in (("vibe1", l1, (12, 700), "text2"), ("vibe2", l2, (15, 700), "text")):
            self.txt[name] = tv
            self.txt_spec[name] = spec
            self.txt_color[name] = colkey

        def render(locked, title):
            pal = self.pal or {}
            l2.setText(title or T("vibe_short"))
            circle.setImageBitmap(icon_bitmap("lock" if locked else "play", P(17 if locked else 19)))
            circle.setColorFilter(color_filter(with_alpha(WHITE, 0.85) if locked else pal.get("on_accent", BLACK)))
            circle_bg.setColor(jint(rgb(0x3E3E3E) if locked else pal.get("accent", rgb(0x1ED760))))
            col.setAlpha(F(0.6 if locked else 1.0))
        self._finish_vibe(box, render, flp(-1, P(56)))

    @_t("Ctrl.make_vibe_pill")
    def make_vibe_pill(self):
        """Spotify: a small pill in the bottom row, a green play mark and the name."""
        box = A.LinearLayout(self.ctx)
        box.setOrientation(A.LinearLayout.HORIZONTAL)
        box.setGravity(17)
        box.setPadding(P(12), 0, P(14), 0)
        box.setBackground(round_bg(with_alpha(WHITE, 0.10), radius=P(16)))
        icon = A.ImageView(self.ctx)
        icon.setScaleType(A.ImageView.ScaleType.CENTER)
        tv = self._new_text(13, 700)
        tv.setText(T("vibe_short"))
        lp = A.LinearLayout.LayoutParams(-2, -2)
        lp.leftMargin = P(6)
        box.addView(icon, A.LinearLayout.LayoutParams(P(16), P(16)))
        box.addView(tv, lp)
        self.txt["vibe2"] = tv
        self.txt_spec["vibe2"] = (13, 700)
        self.txt_color["vibe2"] = "text"

        def render(locked, title):
            pal = self.pal or {}
            icon.setImageBitmap(icon_bitmap("lock" if locked else "play", P(14)))
            icon.setColorFilter(color_filter(with_alpha(WHITE, 0.8) if locked else pal.get("accent", rgb(0x1ED760))))
            box.setAlpha(F(0.65 if locked else 1.0))
        self._finish_vibe(box, render, flp(-2, P(32)))

    @_t("Ctrl.make_vibe_label")
    def make_vibe_label(self):
        """SoundCloud: a black box over the artwork, like the title and artist ones, with an orange play mark."""
        from android.graphics.drawable import BitmapDrawable
        tv = self._new_text(13, 500)
        tv.setBackgroundColor(jint(BLACK))
        tv.setPadding(P(6), 0, P(8), 0)
        self.txt["vibe2"] = tv
        self.txt_spec["vibe2"] = (13, 500)
        self.txt_color["vibe2"] = "text"
        res = self.ctx.getResources()

        def render(locked, title):
            pal = self.pal or {}
            text = T("vibe_by_track")
            if locked:
                size = P(13)
                lock = BitmapDrawable(res, icon_bitmap("lock", size))
                lock.setBounds(0, 0, size, size)
                lock.setColorFilter(color_filter(with_alpha(WHITE, 0.85)))
                tv.setCompoundDrawables(lock, None, None, None)
                tv.setCompoundDrawablePadding(P(5))
                tv.setText(text)
                tv.setAlpha(F(0.8))
            else:
                tv.setCompoundDrawables(None, None, None, None)
                s = A.SpannableString("▶  " + text)
                s.setSpan(A.ForegroundColorSpan(jint(pal.get("accent", rgb(0xFF5500)))), 0, 1, 33)
                tv.setText(s)
                tv.setAlpha(F(1.0))
            w = self.vibe_label_width()
            if w != self.vibe_w:
                self.vibe_w = w
                self.L.requestLayout()
        self._finish_vibe(tv, render, flp(-2, P(23)))

    @_t("Ctrl.vibe_label_width")
    def vibe_label_width(self):
        tv = self.el.get("vibe")
        if tv is None:
            return 0
        w = float(tv.getPaint().measureText(str(tv.getText()))) + int(tv.getPaddingLeft()) + int(tv.getPaddingRight())
        if self.vibe_locked:
            w += P(13) + P(5)
        return int(w) + 2

    @_t("Ctrl._finish_vibe")
    def _finish_vibe(self, view, render, lp):
        view.setOnClickListener(on_click(lambda: self._press(view, self.act_vibe)))
        self.add_view(view, lp)
        self.el["vibe"] = view
        self.vibe_render = render
        self.vibe_locked = self.p.mywave() is None
        self.refresh_vibe_text()

    @_t("Ctrl.set_vibe_locked")
    def set_vibe_locked(self, locked):
        if locked != self.vibe_locked:
            self.vibe_locked = locked
            self.refresh_vibe_text()

    @_t("Ctrl.refresh_vibe_text")
    def refresh_vibe_text(self, title=None):
        try:
            self._vibe_text(title)
        except Exception:
            log_exc("wave card")

    @_t("Ctrl._vibe_text")
    def _vibe_text(self, title):
        if self.vibe_render is not None:
            if title is None:
                mo = playing()
                title = str(mo.getMusicTitle() or "") if mo is not None else ""
            self.vibe_render(self.vibe_locked, title)
            return
        tv = self.vibe_line2
        if tv is None:
            return
        if title is None:
            mo = playing()
            title = str(mo.getMusicTitle() or "") if mo is not None else ""
        if self.vibe_locked:
            if self.vibe_lock is None:
                from android.graphics.drawable import BitmapDrawable
                size = P(17)
                self.vibe_lock = BitmapDrawable(self.ctx.getResources(), icon_bitmap("lock", size))
                self.vibe_lock.setBounds(0, 0, size, size)
                if self.pal is not None:
                    self.vibe_lock.setColorFilter(color_filter(self.pal["vibe2"]))
            tv.setCompoundDrawables(self.vibe_lock, None, None, None)
            tv.setCompoundDrawablePadding(P(6))
            tv.setText(title)
        else:
            tv.setCompoundDrawables(None, None, None, None)
            tv.setText("▶ " + title)
        if self.vibe_col is not None:
            self.vibe_col.setAlpha(F(0.55 if self.vibe_locked else 1.0))

