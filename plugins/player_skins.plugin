_RU_LANGS = ("ru", "uk", "be", "kk")
_LANG = {"ru": None, "ts": 0.0}
LOG = []
ERR_SEEN = {}


def _lang_code():
    try:
        loc = LocaleController.getInstance().getCurrentLocale()
        code = str(loc.getLanguage() or "") if loc is not None else ""
        if code:
            return code
    except Exception:
        _dexc("_lang_code:L158")
        pass
    try:
        return str(Locale.getDefault().getLanguage() or "")
    except Exception:
        _dexc("_lang_code:L163")
        return ""


def is_ru():
    now = time.time()
    if _LANG["ru"] is None or now - _LANG["ts"] > 5.0:
        _LANG["ru"] = _lang_code().lower().replace("-", "_").split("_")[0] in _RU_LANGS
        _LANG["ts"] = now
    return _LANG["ru"]


def T(key):
    pair = STR[key]
    return pair[0] if is_ru() else pair[1]


# ---- logging (rewritten) ----
_DEBUG = {"on": False, "max": 400, "max_off": 400, "path": None, "t_persist": 0.0, "plugin": None, "keys": ['fonts', 'fonts_soundcloud', 'fonts_spotify', 'fonts_yandex', 'mini', 'mini_soundcloud', 'mini_spotify', 'mini_yandex', 'others', 'others_soundcloud', 'others_spotify', 'others_yandex', 'photos', 'real_wave', 'spicy_lyrics', 'style', 'swipe_lyrics', 'theme', 'timer', 'timer_place', 'timer_soundcloud', 'timer_spotify', 'timer_yandex', 'vibe_soundcloud', 'vibe_spotify', 'vibe_yandex']}


def _dbg_ts():
    t = time.time()
    return "%s.%03d %-12s" % (time.strftime("%H:%M:%S", time.localtime(t)), int((t % 1) * 1000), threading.current_thread().name[:12])


def log(msg):
    try:
        LOG.append("%s %s" % (_dbg_ts(), msg))
        del LOG[:-_DEBUG["max"]]
    except Exception:
        pass


def log_exc(where):
    """Records an exception once per place, so per-frame hooks cannot flood the log."""
    try:
        n = ERR_SEEN.get(where, 0) + 1
        ERR_SEEN[where] = n
        if n <= 3:
            log("ERROR in %s (#%d):\n%s" % (where, n, traceback.format_exc().strip()))
    except Exception:
        pass
    _derr(where)


def _dlog(msg):
    if _DEBUG["on"]:
        log(msg)


def _dinfo(msg):
    log(msg)


def _dbg_ring():
    return list(LOG)


def _dbg_header():
    out = ["Player Skins %s" % __version__, "verbose: %s, uptime %ds" % ("ON" if _DEBUG["on"] else "off", time.time() - _DBG_T0)]
    out += _dbg_env()
    p = _DEBUG.get("plugin")
    if p is None:
        return out
    def part(label, fn):
        try:
            out.append("%s: %s" % (label, fn()))
        except Exception as e:
            out.append("%s: <%s>" % (label, _tn(e)))
    part("hooks", lambda: p.hooks_ok)
    part("style", lambda: "style=%s theme=%s fonts=%s mini=%s photos=%s timer=%s others=%s" % (
        p.style(), p.get_setting("theme", 0), p.fonts_enabled(), p.per_style("mini"), p.photos_enabled(),
        p.timer_enabled(), p.hide_others()))
    part("controller", lambda: "none" if p.ctrl is None else "active=%s closed=%s fails=%s" % (
        p.ctrl.active, p.ctrl.closed, p.ctrl.fails))
    part("my wave", lambda: "found" if p.mywave() is not None else "not found")
    part("stores", lambda: "likes=%d saved=%d waves=%d" % (len(p.likes.data), len(p.saved.data), len(p.waves.data)))
    part("error counters", lambda: dict(ERR_SEEN))
    return out

# ======================= debug toolkit (added) =======================
# Always on (cheap): error ring with full tracebacks, counters of swallowed exceptions, per-session log file.
# Only with "verbose log" switched on: method tracing, hook / task / network traces, slow-call detection.
_DBG_LOCK = threading.Lock()
_PERSIST_LOCK = threading.Lock()
_DBG_ERRS = {}      # "place | last line" -> [count, first time, last time, traceback]
_DBG_SILENT = {}    # place -> [count, last exception text]
_DBG_SAMPLE = {}    # key -> [window start, calls, not logged]
_DBG_BUCKET = [40.0, 0.0]
_DBG_T0 = time.time()
_DBG_STATS = {}     # label -> [calls, total ms, max ms], filled only while verbose log is on
_SECRETISH = ("key", "secret", "token", "session")
_TOKENISH = re.compile(r"[A-Za-z0-9_\-+=]{20,}")


def _tn(v):
    """Short type name, e.g. ValueError or ArrayList."""
    try:
        return str(type(v)).split("'")[1].rsplit(".", 1)[-1]
    except Exception:
        return "?"


def _dsafe(v, n=60):
    """Short, side-effect free description of a value (never calls repr() on foreign objects)."""
    try:
        if v is None or isinstance(v, (bool, int, float)):
            s = repr(v)
        elif isinstance(v, str):
            # token-like strings (hex / encoded keys) are never shown, only their length
            s = "<str %d>" % len(v) if _TOKENISH.fullmatch(v) else repr(v)
        elif isinstance(v, (list, tuple, set, frozenset, dict)):
            s = "%s[%d]" % (_tn(v), len(v))
        else:
            s = "<%s>" % _tn(v)
        return s if len(s) <= n else s[:n - 1] + "~"
    except Exception:
        return "<?>"


def _dargs(args, kw):
    parts = [_dsafe(a) for a in args[:6]] + ["%s=%s" % (k, _dsafe(v)) for k, v in list(kw.items())[:4]]
    if len(args) > 6:
        parts.append("+%d" % (len(args) - 6))
    return ", ".join(parts)


def _dsample(key, limit=5, window=5.0):
    """True while `key` has logged fewer than `limit` lines in the current `window` seconds; the rest is only counted."""
    now = time.time()
    carry = 0
    with _DBG_LOCK:
        s = _DBG_SAMPLE.get(key)
        if s is None or now - s[0] >= window:
            carry = s[2] if s else 0
            s = _DBG_SAMPLE[key] = [now, 0, 0]
        s[1] += 1
        ok = s[1] <= limit
        if not ok:
            s[2] += 1
    if carry:
        _dlog("%s: +%d calls not logged (sampling)" % (key, carry))
    return ok


def _dbudget():
    """Global cap for trace lines (about 25 per second, bursts up to 40), so tracing cannot flood the log."""
    now = time.time()
    with _DBG_LOCK:
        b = _DBG_BUCKET
        b[0] = min(40.0, b[0] + (now - b[1]) * 25.0) if b[1] else 40.0
        b[1] = now
        if b[0] >= 1.0:
            b[0] -= 1.0
            return True
    return False


def _derr(where):
    """Remembers the exception being handled with its full traceback (always, independent of the verbose switch)."""
    try:
        tb = traceback.format_exc().strip()
        last = tb.splitlines()[-1] if tb else ""
        k = "%s | %s" % (where, last[:140])
        now = time.strftime("%H:%M:%S")
        with _DBG_LOCK:
            rec = _DBG_ERRS.get(k)
            if rec is None:
                if len(_DBG_ERRS) >= 40:
                    _DBG_ERRS.pop(next(iter(_DBG_ERRS)))
                rec = _DBG_ERRS[k] = [0, now, now, tb]
            rec[0] += 1
            rec[2] = now
        _persist()
    except Exception:
        pass


def _dexc(where):
    """Called from an `except` block that swallows an exception: counts it per place and logs the first ones."""
    try:
        with _DBG_LOCK:
            rec = _DBG_SILENT.get(where)
            if rec is None:
                rec = _DBG_SILENT[where] = [0, ""]
            rec[0] += 1
            n = rec[0]
        if n <= 3 or _DEBUG["on"]:
            rec[1] = traceback.format_exc().strip().splitlines()[-1][:200]
        if _DEBUG["on"] and (n <= 3 or n % 200 == 0):
            _dlog("swallowed at %s (#%d) %s" % (where, n, rec[1]))
    except Exception:
        pass


def _trace(fn, label, light, method):
    """Wraps a method: with verbose log on, logs call, result, time and exceptions. `light` = per-frame code:
    only exceptions and slow calls are logged."""
    import functools

    @functools.wraps(fn)
    def w(*a, **kw):
        if not _DEBUG["on"]:
            return fn(*a, **kw)
        full = (not light) and _dsample(label) and _dbudget()
        if full:
            _dlog("-> %s(%s)" % (label, _dargs(a[1:] if method else a, kw)))
        t0 = time.time()
        try:
            r = fn(*a, **kw)
        except BaseException as e:
            if _dsample(label + " !", 5, 30.0):
                _dlog("!! %s raised %s: %s" % (label, _tn(e), str(e)[:160]))
            raise
        dt = (time.time() - t0) * 1000.0
        st = _DBG_STATS.get(label)
        if st is None:
            st = _DBG_STATS[label] = [0, 0.0, 0.0]
        st[0] += 1
        st[1] += dt
        if dt > st[2]:
            st[2] = dt
        if full:
            _dlog("<- %s = %s  %.0fms" % (label, _dsafe(r), dt))
        if dt >= (80.0 if light else 400.0) and _dsample(label + " slow", 3, 30.0):
            _dlog("SLOW %s %.0fms" % (label, dt))
        return r
    return w


def _t(label, light=False, method=True):
    """Decorator for a method; with verbose log on it traces the call (see _trace)."""
    def deco(fn):
        return _trace(fn, label, light, method)
    return deco


class _DThread(threading.Thread):
    """Thread that records start, end and uncaught exceptions."""

    def run(self):
        _dlog("thread start: %s" % self.name)
        try:
            threading.Thread.run(self)
        except BaseException:
            _derr("thread " + str(self.name))
            _dinfo("thread %s died: %s" % (self.name, traceback.format_exc().strip().splitlines()[-1]))
            raise
        finally:
            _dlog("thread end: %s" % self.name)


def _dbg_env():
    out = []
    try:
        from java import jclass
        b = jclass("android.os.Build")
        v = jclass("android.os.Build$VERSION")
        out.append("device: %s %s, Android %s (API %s)" % (b.MANUFACTURER, b.MODEL, v.RELEASE, v.SDK_INT))
    except Exception as e:
        out.append("device: unknown (%s)" % _tn(e))
    try:
        from java import jclass
        bv = jclass("org.telegram.messenger.BuildVars")
        out.append("app: %s (%s)" % (bv.BUILD_VERSION_STRING, bv.BUILD_VERSION))
    except Exception as e:
        out.append("app: unknown (%s)" % _tn(e))
    try:
        from java import jclass
        out.append("locale: %s" % jclass("java.util.Locale").getDefault().toString())
    except Exception:
        pass
    return out


def _dbg_settings():
    p = _DEBUG.get("plugin")
    out = []
    if p is None:
        return out
    for k in _DEBUG["keys"]:
        try:
            v = p.get_setting(k, None)
        except Exception as e:
            v = "<%s>" % _tn(e)
        if any(s in k.lower() for s in _SECRETISH):
            v = "set" if v else "empty"
        out.append("%s=%s" % (k, _dsafe(v, 40)))
    return [", ".join(out[i:i + 5]) for i in range(0, len(out), 5)]


def _dbg_digest(top=8):
    """A few lines for the on-screen diagnostics: most frequent errors and swallowed exceptions."""
    with _DBG_LOCK:
        errs = sorted(_DBG_ERRS.items(), key=lambda kv: -kv[1][0])[:top]
        sil = sorted(_DBG_SILENT.items(), key=lambda kv: -kv[1][0])[:top]
    lines = []
    if errs:
        lines.append("Errors:")
        lines += ["  x%d %s" % (r[0], k) for k, r in errs]
    if sil:
        lines.append("Swallowed exceptions:")
        lines += ["  x%d %s - %s" % (r[0], k, r[1]) for k, r in sil]
    return lines


def _dbg_dump():
    out = ["== header =="]
    try:
        out += _dbg_header()
    except Exception as e:
        out.append("header failed: %r" % (e,))
    out.append("settings:")
    try:
        out += ["  " + l for l in _dbg_settings()]
    except Exception as e:
        out.append("  failed: %r" % (e,))
    with _DBG_LOCK:
        errs = list(_DBG_ERRS.items())
        sil = sorted(_DBG_SILENT.items(), key=lambda kv: -kv[1][0])[:40]
    out += ["", "== errors, always recorded (%d kinds) ==" % len(errs)]
    for k, r in errs:
        out.append("[x%d %s..%s] %s" % (r[0], r[1], r[2], k))
        out.append(r[3])
    out += ["", "== swallowed exceptions: count, place, last =="]
    out += ["x%d  %s  %s" % (r[0], k, r[1]) for k, r in sil]
    out += ["", "== hot spots (verbose only): total ms, calls, avg ms, max ms, method =="] + _dbg_hotspots()
    out += ["", "== log, verbose %s ==" % ("ON" if _DEBUG["on"] else "off")] + _dbg_ring()
    return "\n".join(out)


def _dbg_hotspots(top=25):
    rows = sorted(list(_DBG_STATS.items()), key=lambda kv: -kv[1][1])[:top]
    return ["%9.0f  %7d  %7.3f  %7.1f  %s" % (r[1], r[0], r[1] / max(1, r[0]), r[2], k) for k, r in rows]


def _dbg_prev(n=150):
    p = _DEBUG.get("path")
    try:
        with open(str(p) + ".prev", encoding="utf-8", errors="replace") as f:
            return f.read().splitlines()[-n:]
    except Exception:
        return []


def _dbg_report():
    """Everything for a bug report: this session plus the tail of the previous one (what happened before a crash)."""
    prev = _dbg_prev()
    text = _dbg_dump()
    if prev:
        text += "\n\n== previous session, tail ==\n" + "\n".join(prev)
    return text


def _persist(force=False):
    """Writes the session log to disk (at most every 5 s), so it survives a crash or a restart."""
    p = _DEBUG.get("path")
    now = time.time()
    if not p or (not force and now - _DEBUG["t_persist"] < 5.0):
        return
    if not _PERSIST_LOCK.acquire(False):
        return
    try:
        _DEBUG["t_persist"] = now
        with open(p, "w", encoding="utf-8") as f:
            f.write(_dbg_dump())
    except Exception:
        pass
    finally:
        _PERSIST_LOCK.release()


def _dbg_start(path, plugin):
    """Opens a debug session: keeps the previous session's file as .prev and records the environment."""
    try:
        _DEBUG["plugin"] = plugin
        _DEBUG["path"] = path
        _DEBUG["t_persist"] = 0.0
        if os.path.exists(path):
            os.replace(path, path + ".prev")
    except Exception:
        _dexc("_dbg_start")
    _dinfo("session start, version %s" % __version__)
    for line in _dbg_env():
        _dinfo(line)


def _dbg_stop():
    _dinfo("session end")
    _persist(True)
    _DEBUG["plugin"] = None


def _dbg_set_debug(on):
    on = bool(on)
    _DEBUG["on"] = on
    _DEBUG["max"] = 3000 if on else _DEBUG["max_off"]
    _dinfo("verbose log %s" % ("ON" if on else "off"))
    if on:
        _persist(True)
# ===================== end of debug toolkit =====================


def ui(fn, delay=0):
    def _run():
        try:
            fn()
        except Exception:
            log_exc("ui")
    try:
        if delay:
            run_on_ui_thread(_run, delay)
        else:
            run_on_ui_thread(_run)
    except Exception:
        log_exc("run_on_ui_thread")


def toast(text, kind="show_info"):
    def _show():
        try:
            if kind == "show_success":
                BulletinHelper.show_success(text)
            elif kind == "show_error":
                BulletinHelper.show_error(text)
            else:
                BulletinHelper.show_info(text)
        except Exception:
            _dexc("toast._show:L592")
            pass
    ui(_show)


# ---------------------------------------------------------------- colors

def sgn(c):
    c &= 0xFFFFFFFF
    return c - 0x100000000 if c & 0x80000000 else c


def rgb(v):
    return sgn(0xFF000000 | (v & 0xFFFFFF))


def with_alpha(c, a):
    return sgn(((int(max(0.0, min(1.0, a)) * 255 + 0.5) & 0xFF) << 24) | (c & 0xFFFFFF))


def mix(c1, c2, t):
    t = max(0.0, min(1.0, t))
    out = 0
    for shift in (24, 16, 8, 0):
        a = (c1 >> shift) & 0xFF
        b = (c2 >> shift) & 0xFF
        out |= (int(a + (b - a) * t + 0.5) & 0xFF) << shift
    return sgn(out)


def scale(c, k):
    r, g, b = (c >> 16) & 0xFF, (c >> 8) & 0xFF, c & 0xFF
    return rgb((min(255, int(r * k + 0.5)) << 16) | (min(255, int(g * k + 0.5)) << 8) | min(255, int(b * k + 0.5)))


def hsv_of(c):
    return colorsys.rgb_to_hsv(((c >> 16) & 0xFF) / 255.0, ((c >> 8) & 0xFF) / 255.0, (c & 0xFF) / 255.0)


def from_hsv(h, s, v):
    r, g, b = colorsys.hsv_to_rgb(h % 1.0, max(0.0, min(1.0, s)), max(0.0, min(1.0, v)))
    return rgb((int(r * 255 + 0.5) << 16) | (int(g * 255 + 0.5) << 8) | int(b * 255 + 0.5))


def rel_lum(c):
    def lin(v):
        v /= 255.0
        return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
    return 0.2126 * lin((c >> 16) & 0xFF) + 0.7152 * lin((c >> 8) & 0xFF) + 0.0722 * lin(c & 0xFF)


def with_lum(c, target, max_s=0.9):
    """Same hue, saturation capped, brightness chosen to reach the target relative luminance."""
    h, s, _ = hsv_of(c)
    s = min(s, max_s)
    lo, hi = 0.0, 1.0
    for _ in range(18):
        m = (lo + hi) / 2.0
        if rel_lum(from_hsv(h, s, m)) < target:
            lo = m
        else:
            hi = m
    return from_hsv(h, s, (lo + hi) / 2.0)


WHITE = rgb(0xFFFFFF)
BLACK = rgb(0x000000)


def clamp01(x):
    return 0.0 if x < 0.0 else (1.0 if x > 1.0 else x)


def lerp(a, b, t):
    return a + (b - a) * t


def lerp_rect(a, b, t):
    return tuple(lerp(x, y, t) for x, y in zip(a, b))


def smooth(t):
    t = clamp01(t)
    return t * t * (3.0 - 2.0 * t)


def F(x):
    return jfloat(float(x))


# ---------------------------------------------------------------- java access

class A:
    """Android classes, imported on first use."""
    ready = False

    @classmethod
    def init(cls):
        if cls.ready:
            return
        from android.view import View, ViewGroup, Gravity, ViewTreeObserver
        from android.widget import FrameLayout, ImageView, TextView, LinearLayout
        from android.graphics import Bitmap, BitmapFactory, Canvas, Paint, Path, Rect, PorterDuff, PorterDuffColorFilter, Typeface
        from android.graphics.drawable import GradientDrawable
        from android.text import TextUtils, SpannableString, Spanned
        from android.text.style import ForegroundColorSpan
        from java.lang import Class, Integer, Long
        cls.View, cls.ViewGroup, cls.Gravity, cls.ViewTreeObserver = View, ViewGroup, Gravity, ViewTreeObserver
        cls.FrameLayout, cls.ImageView, cls.TextView, cls.LinearLayout = FrameLayout, ImageView, TextView, LinearLayout
        cls.Bitmap, cls.BitmapFactory, cls.Canvas, cls.Paint, cls.Path, cls.Rect = Bitmap, BitmapFactory, Canvas, Paint, Path, Rect
        cls.PorterDuff, cls.PorterDuffColorFilter, cls.Typeface = PorterDuff, PorterDuffColorFilter, Typeface
        cls.GradientDrawable, cls.TextUtils = GradientDrawable, TextUtils
        cls.SpannableString, cls.Spanned, cls.ForegroundColorSpan = SpannableString, Spanned, ForegroundColorSpan
        cls.Class, cls.Integer, cls.Long = Class, Integer, Long
        cls.density = float(AndroidUtilities.density)
        cls.ready = True


def P(dp):
    return int(dp * A.density + 0.5)


_CLASSES = {}
_FIELDS = {}
_METHODS = {}


def jclass_obj(name):
    c = _CLASSES.get(name)
    if c is None:
        c = A.Class.forName(name, False, ApplicationLoader.applicationContext.getClassLoader())
        _CLASSES[name] = c
    return c


def jfield(cls_name, name):
    key = (cls_name, name)
    f = _FIELDS.get(key)
    if f is None:
        f = jclass_obj(cls_name).getDeclaredField(name)
        f.setAccessible(True)
        _FIELDS[key] = f
    return f


def jmethod(cls_name, name, nparams):
    key = (cls_name, name, nparams)
    m = _METHODS.get(key)
    if m is None:
        for cand in jclass_obj(cls_name).getDeclaredMethods():
            if str(cand.getName()) == name and len(cand.getParameterTypes()) == nparams:
                m = cand
                break
        if m is None:
            raise RuntimeError("method %s.%s/%d not found" % (cls_name, name, nparams))
        m.setAccessible(True)
        _METHODS[key] = m
    return m


def call(obj, cls_name, name, *args):
    return jmethod(cls_name, name, len(args)).invoke(obj, *args)


def color_filter(c):
    return A.PorterDuffColorFilter(jint(c), A.PorterDuff.Mode.SRC_IN)


def exact(v):
    return A.View.MeasureSpec.makeMeasureSpec(max(0, int(v)), EXACTLY)


def place(view, x, y, w, h, *rest):
    x, y, w, h = int(x), int(y), max(0, int(w)), max(0, int(h))
    view.measure(exact(w), exact(h))
    view.layout(x, y, x + w, y + h)


def C(cx, cy, w, h):
    """Rect (x, y, w, h) centered on a point."""
    return (cx - w / 2.0, cy - h / 2.0, w, h)


def flp(w, h, gravity=None, margins=None):
    lp = A.FrameLayout.LayoutParams(int(w), int(h)) if gravity is None else A.FrameLayout.LayoutParams(int(w), int(h), int(gravity))
    if margins is not None:
        lp.setMargins(*[int(m) for m in margins])
    return lp


def res_id(*names):
    ctx = ApplicationLoader.applicationContext
    for name in names:
        try:
            rid = int(ctx.getResources().getIdentifier(name, "drawable", ctx.getPackageName()))
            if rid:
                return rid
        except Exception:
            _dexc("res_id:L790")
            pass
    return 0


_PROXIES = {}


def touch_listener(fn):
    cls = _PROXIES.get("touch")
    if cls is None:
        class _Touch(dynamic_proxy(A.View.OnTouchListener)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def onTouch(self, view, event):
                try:
                    return bool(self.handler(view, event))
                except Exception:
                    log_exc("touch")
                    return False
        cls = _PROXIES["touch"] = _Touch
    return cls(fn)


def predraw_listener(fn):
    """ViewTreeObserver.OnPreDrawListener backed by a Python function; drawing always goes on."""
    cls = _PROXIES.get("predraw")
    if cls is None:
        class _PreDraw(dynamic_proxy(A.ViewTreeObserver.OnPreDrawListener)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def onPreDraw(self):
                try:
                    self.handler()
                except Exception:
                    log_exc("pre-draw")
                return True
        cls = _PROXIES["predraw"] = _PreDraw
    return cls(fn)


def dialog_button(fn):
    """AlertDialog.OnButtonClickListener backed by a Python function."""
    cls = _PROXIES.get("dialog_button")
    if cls is None:
        from org.telegram.ui.ActionBar import AlertDialog

        class _DialogButton(dynamic_proxy(AlertDialog.OnButtonClickListener)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def onClick(self, dialog, which):
                try:
                    self.handler()
                except Exception:
                    log_exc("dialog button")
        cls = _PROXIES["dialog_button"] = _DialogButton
    return cls(fn)


def callback(fn):
    """org.telegram.messenger.Utilities.Callback backed by a Python function."""
    cls = _PROXIES.get("callback")
    if cls is None:
        from org.telegram.messenger import Utilities

        class _Callback(dynamic_proxy(Utilities.Callback)):
            def __init__(self, handler):
                super().__init__()
                self.handler = handler

            def run(self, value):
                try:
                    self.handler(value)
                except Exception:
                    log_exc("callback")
        cls = _PROXIES["callback"] = _Callback
    return cls(fn)


def as_bool(v):
    if isinstance(v, bool):
        return v
    try:
        return bool(v.booleanValue())
    except Exception:
        _dexc("as_bool:L881")
        return bool(v)


def as_int(v, default=0):
    if v is None:
        return default
    if isinstance(v, int):
        return v
    try:
        return int(v.intValue())
    except Exception:
        _dexc("as_int:L893")
        return int(v)


FRAMEWORK_PKGS = ("android.", "androidx.", "java.", "javax.", "com.android.", "dalvik.")


def declaring_class(k, name, nparams):
    """Name of the nearest app class (not the Android framework) in k's hierarchy that declares the method."""
    while k is not None:
        cn = str(k.getName())
        if cn.startswith(FRAMEWORK_PKGS):
            return None
        for m in k.getDeclaredMethods():
            if str(m.getName()) == name and len(m.getParameterTypes()) == nparams:
                return cn
        k = k.getSuperclass()
    return None


def can_scroll_up(view, depth=0):
    """True if the view or anything inside it is scrolled away from its top."""
    try:
        if bool(view.canScrollVertically(-1)):
            return True
    except Exception:
        _dexc("can_scroll_up:L919")
        pass
    if depth >= 6:
        return False
    try:
        n = int(view.getChildCount())
    except Exception:
        _dexc("can_scroll_up:L926")
        return False
    for i in range(n):
        if can_scroll_up(view.getChildAt(i), depth + 1):
            return True
    return False


class SwipeGesture:
    """Spotify: a swipe up on the player opens the lyrics, a swipe down at the top of the lyrics goes back.
    Fed from dispatchTouchEvent before the sheet and its children see the event. Until the gesture is clearly
    vertical, every event passes through untouched, so taps, the seek bar and horizontal swipes keep working.
    Once it is taken, children get ACTION_CANCEL and the rest of the gesture is consumed."""

    @_t("SwipeGesture.__init__")
    def __init__(self, ctrl):
        self.c = ctrl
        try:
            from android.view import ViewConfiguration
            self.slop = float(ViewConfiguration.get(ctrl.ctx).getScaledTouchSlop())
        except Exception:
            _dexc("SwipeGesture.__init__:L947")
            self.slop = float(P(8))
        self.last = None
        self.reset()

    @_t("SwipeGesture.reset")
    def reset(self):
        self.track = None
        self.taken = False
        self.fired = False
        self.x0 = self.y0 = 0.0

    @_t("SwipeGesture.along")
    def along(self, ev):
        dy = float(ev.getRawY()) - self.y0
        return -dy if self.track == "up" else dy

    @_t("SwipeGesture.fire")
    def fire(self):
        self.fired = True
        ui(self.c.act_lyrics if self.track == "up" else self.c.to_main)

    @_t("SwipeGesture.feed")
    def feed(self, ev):
        key = (int(ev.getEventTime()), int(ev.getDownTime()))
        if key == self.last:
            return None
        self.last = key
        action = int(ev.getActionMasked())
        c = self.c
        if action == 0:
            self.reset()
            if c.closed or not c.active or not c.p.get_setting("swipe_lyrics", True):
                return None
            x, y = float(ev.getRawX()), float(ev.getRawY())
            if c.in_seek(x, y):
                return None
            mode = c.mode()
            if mode == 0:
                self.track = "up"
            elif mode == 1 and not can_scroll_up(c.lyrics_area()):
                self.track = "down"
            self.x0, self.y0 = x, y
            return None
        if self.taken:
            if action == 2 and not self.fired and self.along(ev) >= P(56):
                self.fire()
            elif action in (1, 3):
                if action == 1 and not self.fired and self.along(ev) >= P(28):
                    self.fire()
                self.reset()
            return "eat"
        if self.track is None:
            return None
        if action != 2:
            if action in (1, 3, 5):
                self.reset()
            return None
        dx = abs(float(ev.getRawX()) - self.x0)
        along = self.along(ev)
        take = self.slop * (2.0 if self.track == "up" else 0.6)
        if along >= take and along > 1.5 * dx:
            self.taken = True
            return "cancel"
        if dx > self.slop or along < -self.slop:
            self.track = None
        return None


def on_click(fn):
    def handler(view):
        try:
            fn()
        except Exception:
            log_exc("click")
    return OnClickListener(handler)


def on_click_view(fn):
    """Like on_click, but the handler gets the clicked view: one listener can serve many views."""
    def handler(view):
        try:
            fn(view)
        except Exception:
            log_exc("click")
    return OnClickListener(handler)


def round_bg(color, radius=0.0, oval=False, radii=None, stroke=None):
    d = A.GradientDrawable()
    if oval:
        d.setShape(A.GradientDrawable.OVAL)
    elif radii is not None:
        d.setCornerRadii(jarray(jfloat)([float(r) for r in radii]))
    else:
        d.setCornerRadius(F(radius))
    d.setColor(jint(color))
    if stroke is not None:
        d.setStroke(int(stroke[0]), jint(stroke[1]))
    return d


def playing():
    try:
        mo = MediaController.getInstance().getPlayingMessageObject()
        if mo is not None and as_bool(mo.isMusic()):
            return mo
    except Exception:
        _dexc("playing:L1055")
        pass
    return None


def msg_key(mo):
    try:
        return "%d:%d" % (int(mo.getDialogId()), int(mo.getId()))
    except Exception:
        _dexc("msg_key:L1064")
        return None


def position_ms(mo):
    try:
        ms = int(MediaController.getInstance().getProgressMs(mo))
        if ms >= 0:
            return ms
    except Exception:
        _dexc("position_ms:L1074")
        pass
    try:
        return int(float(mo.audioProgress) * float(mo.getDuration()) * 1000.0)
    except Exception:
        _dexc("position_ms:L1079")
        return 0


def cover_copy(bmp, side=720):
    """A private copy of a cover bitmap: the player recycles its own ones."""
    w, h = int(bmp.getWidth()), int(bmp.getHeight())
    s = max(1, min(side, w))
    copy = A.Bitmap.createScaledBitmap(bmp, s, max(1, int(s * h / max(1, w))), True)
    if copy is bmp or copy.equals(bmp):
        copy = bmp.copy(A.Bitmap.Config.ARGB_8888, False)
    return copy


def cover_stats(bmp):
    """Average color and the dominant color by area (or a neutral one) of a cover."""
    n = 12
    small = A.Bitmap.createScaledBitmap(bmp, n, n, True)
    arr = jarray(jint)([0] * (n * n))
    small.getPixels(arr, 0, n, 0, 0, n, n)
    tot = [0, 0, 0]
    buckets = {}
    for v in arr:
        v = int(v)
        r, g, b = (v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF
        tot[0] += r
        tot[1] += g
        tot[2] += b
        h, s, val = colorsys.rgb_to_hsv(r / 255.0, g / 255.0, b / 255.0)
        key = int(h * 12) % 12 if (s > 0.2 and val > 0.15) else -1
        bk = buckets.setdefault(key, [0, 0, 0, 0])
        bk[0] += r
        bk[1] += g
        bk[2] += b
        bk[3] += 1
    count = float(n * n)
    avg = rgb((int(tot[0] / count) << 16) | (int(tot[1] / count) << 8) | int(tot[2] / count))
    gray = buckets.get(-1, [0, 0, 0, 0])
    chroma = [(k, v) for k, v in buckets.items() if k >= 0]
    chroma_total = sum(v[3] for _, v in chroma)
    if chroma and chroma_total > gray[3]:
        def score(kv):
            k = kv[0]
            near = buckets.get((k + 1) % 12, [0, 0, 0, 0])[3] + buckets.get((k - 1) % 12, [0, 0, 0, 0])[3]
            return kv[1][3] + 0.5 * near
        _, bk = max(chroma, key=score)
        neutral = False
    else:
        bk = gray if gray[3] else [tot[0], tot[1], tot[2], int(count)]
        neutral = True
    c = float(bk[3])
    dom = rgb((int(bk[0] / c) << 16) | (int(bk[1] / c) << 8) | int(bk[2] / c))
    return {"avg": avg, "dom": dom, "neutral": neutral}


# ---------------------------------------------------------------- icons

def _mirror(ops):
    out = []
    for op in ops:
        k = op[0]
        if k in ("M", "L"):
            out.append((k, 24 - op[1], op[2]))
        elif k == "C":
            out.append((k, 24 - op[1], op[2], 24 - op[3], op[4], 24 - op[5], op[6]))
        elif k == "R":
            out.append((k, 24 - op[3], op[2], 24 - op[1], op[4], op[5]))
        elif k == "O":
            out.append((k, 24 - op[1], op[2], op[3]))
        else:
            out.append(op)
    return out


