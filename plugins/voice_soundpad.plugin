def _argb(value: int) -> int:
    return value - (1 << 32) if value >= (1 << 31) else value


COLOR_PLAYING = _argb(0xFF34C759)     # зелёный: звук играет
COLOR_LOADING = _argb(0xFFFFCC00)     # жёлтый: звук ещё обрабатывается
COLOR_ON_LOADING = _argb(0xFF2B2B2B)  # тёмный текст на жёлтом

