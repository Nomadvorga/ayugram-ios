# ───────────────────────────── журнал ─────────────────────────────

_logger = None
_debug_enabled = False
_debug_lines = deque(maxlen=300)
_log_file = None  # журнал пишется в файл сразу, чтобы пережить вылет приложения
LOG_MAX_BYTES = 200_000


def debug_log(msg: str):
    if _logger is not None:
        try:
            _logger.debug(msg)
        except Exception:
            pass
    if _debug_enabled:
        line = f"[{time.strftime('%H:%M:%S')}] {msg}"
        _debug_lines.append(line)
        if _log_file:
            try:
                with open(_log_file, "a", encoding="utf-8") as f:
                    f.write(line + "\n")
            except Exception:
                pass


_crash_logger_installed = False
_crash_logger_handler = None


def install_crash_logger():
    """Если приложение упадёт, стек ошибки попадёт в файл журнала (работает при включённой отладке)."""
    global _crash_logger_installed
    if _crash_logger_installed:
        return
    try:
        from java import dynamic_proxy
        from java.io import PrintWriter, StringWriter
        from java.lang import Thread

        class CrashLogger(dynamic_proxy(Thread.UncaughtExceptionHandler)):
            def __init__(self, previous):
                super().__init__()
                self.previous = previous

            def uncaughtException(self, thread, error):
                try:
                    writer = StringWriter()
                    error.printStackTrace(PrintWriter(writer))
                    debug_log(f"!!! КРАШ в потоке {thread.getName()}:\n{writer.toString()}")
                except Exception:
                    pass
                if self.previous is not None:
                    self.previous.uncaughtException(thread, error)

        global _crash_logger_handler
        _crash_logger_handler = CrashLogger(Thread.getDefaultUncaughtExceptionHandler())
        Thread.setDefaultUncaughtExceptionHandler(_crash_logger_handler)
        _crash_logger_installed = True
        debug_log("перехват крашей включён")
    except Exception as e:
        debug_log(f"перехват крашей недоступен: {e}")


def remove_crash_logger():
    """Возвращает прежний обработчик крашей, когда плагин выгружается."""
    global _crash_logger_installed, _crash_logger_handler
    if not _crash_logger_installed:
        return
    try:
        from java.lang import Thread
        handler = _crash_logger_handler
        if handler is not None and Thread.getDefaultUncaughtExceptionHandler() == handler:
            Thread.setDefaultUncaughtExceptionHandler(handler.previous)
    except Exception:
        pass
    _crash_logger_installed = False
    _crash_logger_handler = None


def clear_log():
    _debug_lines.clear()
    try:
        if _log_file and os.path.isfile(_log_file):
            open(_log_file, "w").close()
    except Exception:
        pass


def read_log_tail(limit: int = 300) -> str:
    try:
        if _log_file and os.path.isfile(_log_file):
            with open(_log_file, "r", encoding="utf-8", errors="replace") as f:
                return "".join(f.readlines()[-limit:])
    except Exception:
        pass
    return "\n".join(_debug_lines)


# ───────────────────────────── аудио ─────────────────────────────

class LoadCancelled(Exception):
    pass


class SendCancelled(Exception):
    pass


def _checkpoint(cancel_cb):
    time.sleep(0)
    if cancel_cb and cancel_cb():
        raise LoadCancelled()


def parse_wav_pcm16(data: bytes, name: str = ""):
    if len(data) < 12 or data[:4] != b"RIFF" or data[8:12] != b"WAVE":
        debug_log(f"wav({name}): не RIFF/WAVE")
        return None
    pos = 12
    channels, rate, bits = 1, 44100, 16
    audio = None
    fmt_found = False
    while pos + 8 <= len(data):
        chunk_id = data[pos:pos + 4]
        size = struct.unpack("<I", data[pos + 4:pos + 8])[0]
        body = pos + 8
        if chunk_id == b"fmt " and size >= 16:
            _, channels, rate, _, _, bits = struct.unpack("<HHIIHH", data[body:body + 16])
            fmt_found = True
        elif chunk_id == b"data":
            audio = data[body:body + size]
        pos = body + size + (size % 2)
    if not fmt_found or audio is None or bits != 16:
        debug_log(f"wav({name}): нужен 16-bit PCM WAV (fmt={fmt_found}, data={audio is not None}, bits={bits})")
        return None
    samples = array("h")
    samples.frombytes(audio[: len(audio) - (len(audio) % 2)])
    return samples, channels, rate


def to_mono(samples: array, channels: int, cancel_cb=None) -> array:
    if channels <= 1:
        return samples
    if HAS_AUDIOOP and channels == 2:
        try:
            mono = array("h")
            mono.frombytes(audioop.tomono(samples.tobytes(), 2, 0.5, 0.5))
            return mono
        except Exception as e:
            debug_log(f"to_mono: audioop упал ({e}), считаю вручную")
    mono = array("h")
    for i in range(len(samples) // channels):
        base = i * channels
        mono.append(sum(samples[base:base + channels]) // channels)
        if i % 2000 == 0:
            _checkpoint(cancel_cb)
    return mono


def resample(samples: array, src_rate: int, dst_rate: int, cancel_cb=None) -> array:
    if src_rate == dst_rate or len(samples) < 2:
        return samples
    if HAS_AUDIOOP:
        try:
            converted, _ = audioop.ratecv(samples.tobytes(), 2, 1, src_rate, dst_rate, None)
            out = array("h")
            out.frombytes(converted)
            return out
        except Exception as e:
            debug_log(f"resample: audioop упал ({e}), считаю вручную")
    ratio = dst_rate / src_rate
    last = len(samples) - 1
    out = array("h")
    for i in range(max(1, int(len(samples) * ratio))):
        pos = i / ratio
        idx = int(pos)
        if idx >= last:
            out.append(samples[last])
        else:
            a, b = samples[idx], samples[idx + 1]
            out.append(int(a + (b - a) * (pos - idx)))
        if i % 2000 == 0:
            _checkpoint(cancel_cb)
    return out


def scale_pcm(raw: bytes, gain: float) -> bytes:
    if gain == 1.0:
        return raw
    if HAS_AUDIOOP:
        try:
            return audioop.mul(raw, 2, gain)
        except Exception as e:
            debug_log(f"scale_pcm: audioop упал ({e})")
    samples = array("h")
    samples.frombytes(raw[: len(raw) - (len(raw) % 2)])
    return array("h", (max(-32768, min(32767, int(s * gain))) for s in samples)).tobytes()


def mix_pcm(base: bytes, chunk: array, gain: float) -> bytes:
    if HAS_AUDIOOP:
        try:
            data = scale_pcm(chunk.tobytes(), gain)
            data += b"\x00" * (len(base) - len(data))
            return audioop.add(base, data, 2)
        except Exception as e:
            debug_log(f"mix_pcm: audioop упал ({e}), микширую вручную")
    out = array("h")
    out.frombytes(base)
    for i, s in enumerate(chunk):
        out[i] = max(-32768, min(32767, out[i] + int(s * gain)))
    return out.tobytes()


def decode_via_mediacodec(path: str, name: str = "", cancel_cb=None):
    extractor = None
    codec = None
    try:
        from android.media import MediaCodec, MediaExtractor, MediaFormat

        extractor = MediaExtractor()
        extractor.setDataSource(path)

        track_format = None
        for i in range(extractor.getTrackCount()):
            fmt = extractor.getTrackFormat(i)
            mime = fmt.getString(MediaFormat.KEY_MIME)
            if mime is not None and mime.startswith("audio/"):
                extractor.selectTrack(i)
                track_format = fmt
                break
        if track_format is None:
            debug_log(f"mediacodec({name}): аудиодорожка не найдена")
            return None

        mime = track_format.getString(MediaFormat.KEY_MIME)
        channels = track_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
        rate = track_format.getInteger(MediaFormat.KEY_SAMPLE_RATE)

        codec = MediaCodec.createDecoderByType(mime)
        codec.configure(track_format, None, None, 0)
        codec.start()

        timeout_us = 10000
        chunks = []
        input_done = False
        output_done = False
        info = MediaCodec.BufferInfo()

        while not output_done:
            if cancel_cb and cancel_cb():
                raise LoadCancelled()
            if not input_done:
                in_index = codec.dequeueInputBuffer(timeout_us)
                if in_index >= 0:
                    in_buf = codec.getInputBuffer(in_index)
                    in_buf.clear()
                    size = extractor.readSampleData(in_buf, 0)
                    if size < 0:
                        codec.queueInputBuffer(in_index, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
                        input_done = True
                    else:
                        codec.queueInputBuffer(in_index, 0, size, extractor.getSampleTime(), 0)
                        extractor.advance()

            out_index = codec.dequeueOutputBuffer(info, timeout_us)
            if out_index >= 0:
                out_buf = codec.getOutputBuffer(out_index)
                if info.size > 0:
                    chunk = bytearray(info.size)
                    out_buf.position(info.offset)
                    out_buf.limit(info.offset + info.size)
                    out_buf.get(chunk, 0, info.size)
                    chunks.append(bytes(chunk))
                codec.releaseOutputBuffer(out_index, False)
                if (info.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0:
                    output_done = True
            elif out_index == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED:
                new_format = codec.getOutputFormat()
                channels = new_format.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
                rate = new_format.getInteger(MediaFormat.KEY_SAMPLE_RATE)

        raw = b"".join(chunks)
        if not raw:
            debug_log(f"mediacodec({name}): пустой результат")
            return None
        samples = array("h")
        samples.frombytes(raw[: len(raw) - (len(raw) % 2)])
        debug_log(f"mediacodec({name}): {len(samples)} сэмплов, {channels} кан., {rate} Гц")
        return samples, channels, rate
    except LoadCancelled:
        raise
    except Exception as e:
        import traceback
        debug_log(f"mediacodec({name}): ошибка {e}\n{traceback.format_exc()}")
        return None
    finally:
        for obj, action in ((codec, "stop"), (codec, "release"), (extractor, "release")):
            try:
                if obj is not None:
                    getattr(obj, action)()
            except Exception:
                pass


class Voice:
    __slots__ = ("samples", "pos", "gain", "on_start", "on_end", "started")

    def __init__(self, samples: array, gain: float = 1.0, on_start=None, on_end=None):
        self.samples = samples
        self.pos = 0
        self.gain = gain
        self.on_start = on_start
        self.on_end = on_end
        self.started = False


class SoundEngine:
    MAX_CACHED = 24
    MAX_CACHED_SAMPLES = 60_000_000  # ~120 МБ декодированного звука
    FRAME_FRESH_SEC = 0.5

    def __init__(self):
        self._cache: "OrderedDict[tuple, array]" = OrderedDict()
        self._cache_lock = threading.Lock()
        self._load_locks: dict = {}
        self._mix_lock = threading.Lock()
        self.active: List[Voice] = []
        self.master_gain = 1.0
        self.sample_rate = 48000
        self._cancel_gen: dict = {}
        self.encoding = False  # идёт наше кодирование: хуки записи молчат
        self.last_frame = 0.0
        self.stopped_at = 0.0

    @property
    def recording(self) -> bool:
        """Идёт ли запись прямо сейчас — судим по свежим кадрам с микрофона."""
        return time.time() - self.last_frame < self.FRAME_FRESH_SEC

    def cancel_loading(self, path: str):
        """Прерывает загрузку одного звука (остальные, например предзагрузка, не трогает)."""
        self._cancel_gen[path] = self._cancel_gen.get(path, 0) + 1

    def forget(self, path: str):
        with self._cache_lock:
            for key in [k for k in self._cache if k[0] == path]:
                self._cache.pop(key, None)
        self._load_locks.pop(path, None)

    def _cached(self, key):
        with self._cache_lock:
            samples = self._cache.get(key)
            if samples is not None:
                self._cache.move_to_end(key)
            return samples

    def load_sample(self, path: str) -> Optional[array]:
        key = (path, self.sample_rate)
        samples = self._cached(key)
        if samples is not None:
            return samples

        with self._load_locks.setdefault(path, threading.Lock()):
            samples = self._cached(key)
            if samples is not None:
                return samples
            generation = self._cancel_gen.get(path, 0)

            def cancelled():
                return self._cancel_gen.get(path, 0) != generation

            try:
                name = os.path.basename(path)
                with open(path, "rb") as f:
                    data = f.read()
                if data[:4] == b"RIFF" and data[8:12] == b"WAVE":
                    parsed = parse_wav_pcm16(data, name)
                else:
                    parsed = decode_via_mediacodec(path, name, cancel_cb=cancelled)
                if parsed is None:
                    return None
                samples, channels, src_rate = parsed
                if len(samples) // max(channels, 1) > src_rate * 15:
                    debug_log(f"load({name}): файл длиннее ~15 сек, обработка может быть долгой")
                samples = to_mono(samples, channels, cancelled)
                samples = resample(samples, src_rate, self.sample_rate, cancelled)
            except LoadCancelled:
                debug_log(f"load({os.path.basename(path)}): прервано")
                return None
            except Exception as e:
                import traceback
                debug_log(f"load({path}): ошибка {e}\n{traceback.format_exc()}")
                return None

            with self._cache_lock:
                self._cache[key] = samples
                while len(self._cache) > 1 and (len(self._cache) > self.MAX_CACHED
                                               or sum(len(v) for v in self._cache.values()) > self.MAX_CACHED_SAMPLES):
                    self._cache.popitem(last=False)
            return samples

    def trigger(self, samples: array, gain: float = 1.0, on_start=None, on_end=None):
        voice = Voice(samples, gain, on_start, on_end)
        with self._mix_lock:
            self.active.append(voice)
        return voice

    def clear(self):
        with self._mix_lock:
            self.active.clear()

    def mix_into(self, pcm: bytes) -> bytes:
        started = []
        finished = []
        with self._mix_lock:
            if not self.active:
                return pcm
            mixed = pcm[: len(pcm) - (len(pcm) % 2)]
            frame_len = len(mixed) // 2
            alive = []
            for voice in self.active:
                if not voice.started:
                    voice.started = True
                    debug_log(f"микс: голос стартовал ({len(voice.samples)} сэмплов)")
                    if voice.on_start is not None:
                        started.append(voice.on_start)
                end = min(voice.pos + frame_len, len(voice.samples))
                chunk = voice.samples[voice.pos:end]
                if chunk:
                    mixed = mix_pcm(mixed, chunk, voice.gain * self.master_gain)
                voice.pos = end
                if end < len(voice.samples):
                    alive.append(voice)
                elif voice.on_end is not None:
                    finished.append(voice.on_end)
            self.active = alive

        for callback in started + finished:
            try:
                callback()
            except Exception as e:
                debug_log(f"колбэк микшера упал: {e}")
        return mixed


sound_engine = SoundEngine()


# ───────────────────────────── динамик ─────────────────────────────

_active_tracks = []
_active_tracks_lock = threading.Lock()


def stop_speaker():
    with _active_tracks_lock:
        tracks = list(_active_tracks)
        _active_tracks.clear()
    for track in tracks:
        try:
            track.stop()
            track.release()
        except Exception:
            pass


def set_speaker_volume(gain: float):
    with _active_tracks_lock:
        tracks = list(_active_tracks)
    for track in tracks:
        try:
            track.setVolume(float(gain))
        except Exception:
            pass


def arm_speaker(samples: array, rate: int):
    """Готовит AudioTrack, не запуская его — чтобы стартовать синхронно с микрофоном."""
    try:
        from android.media import AudioFormat, AudioManager, AudioTrack
        from java import jarray

        raw = samples.tobytes()
        channel = AudioFormat.CHANNEL_OUT_MONO
        encoding = AudioFormat.ENCODING_PCM_16BIT
        buf_size = max(AudioTrack.getMinBufferSize(rate, channel, encoding), len(raw))
        track = AudioTrack(AudioManager.STREAM_MUSIC, rate, channel, encoding, buf_size, AudioTrack.MODE_STATIC)
        track.write(jarray("B")(raw), 0, len(raw))
        try:
            track.setVolume(float(sound_engine.master_gain))
        except Exception:
            pass
        debug_log(f"AudioTrack готов: {len(raw)} байт, буфер {buf_size}")
        return track, (len(raw) // 2) / float(rate)
    except Exception as e:
        import traceback
        debug_log(f"arm_speaker: ошибка {e}\n{traceback.format_exc()}")
        return None, 0.0


def fire_speaker(track, duration: float, on_end=None, frames: int = 0):
    if track is None:
        return
    try:
        track.play()
        debug_log("AudioTrack запущен")
    except Exception as e:
        debug_log(f"fire_speaker: ошибка {e}")
        return
    with _active_tracks_lock:
        _active_tracks.append(track)

    def cleanup():
        # конец определяем по позиции головки: после перемотки длительность уже другая
        total = int(frames) if frames else 0
        last, stalled = -1, 0
        deadline = time.time() + duration * 3 + 30
        while time.time() < deadline:
            time.sleep(0.05)
            with _active_tracks_lock:
                if track not in _active_tracks:
                    return  # остановлено снаружи (stop_speaker), колбэк не нужен
            try:
                pos = int(track.getPlaybackHeadPosition()) & 0xFFFFFFFF
            except Exception:
                return
            if total and pos >= total - 1:
                break
            stalled = stalled + 1 if pos == last else 0
            last = pos
            if stalled > 40:  # ~2 с без движения (не считая паузу на перемотку)
                break
        with _active_tracks_lock:
            if track in _active_tracks:
                _active_tracks.remove(track)
        try:
            track.stop()
            track.release()
        except Exception:
            pass
        if on_end is not None:
            try:
                on_end()
            except Exception as e:
                debug_log(f"on_end динамика: {e}")

    threading.Thread(target=cleanup, daemon=True).start()


class Playback:
    """Текущее воспроизведение: позиция и перемотка (микшер и/или динамик)."""

    def __init__(self, path: str, total: int, rate: int, track=None):
        self.path = path
        self.total = max(1, int(total))
        self.rate = rate
        self.track = track
        self.voice = None

    @property
    def duration(self) -> float:
        return self.total / float(self.rate)

    def position(self) -> float:
        voice = self.voice
        if voice is not None and voice.started:
            return min(voice.pos, self.total) / float(self.rate)
        if self.track is not None:
            try:
                return min(int(self.track.getPlaybackHeadPosition()) & 0xFFFFFFFF, self.total) / float(self.rate)
            except Exception:
                pass
        return 0.0

    def seek(self, fraction: float):
        frame = max(0, min(int(fraction * self.total), self.total - 1))
        if self.voice is not None:
            with sound_engine._mix_lock:
                self.voice.pos = frame
        if self.track is not None:
            try:
                self.track.pause()
                self.track.setPlaybackHeadPosition(frame)
                self.track.play()
            except Exception as e:
                debug_log(f"перемотка динамика: {e}")


def format_time(seconds: float) -> str:
    seconds = max(0, int(seconds))
    return f"{seconds // 60}:{seconds % 60:02d}"


# ───────────────────────────── хуки ─────────────────────────────

def get_class(name: str):
    from java.lang import Class
    return Class.forName(name)


class HookGroup:
    def __init__(self, plugin: "VoiceSoundpadPlugin"):
        self.plugin = plugin
        self.unhooks = []

    def hook(self, java_class, name: str, param_types: list, hook) -> bool:
        try:
            method = java_class.getDeclaredMethod(name, *param_types)
            method.setAccessible(True)
            unhook = self.plugin.hook_method(method, hook)
            if unhook:
                self.unhooks.append(unhook)
                debug_log(f"{name} захукан")
                return True
            debug_log(f"{name}: hook_method вернул пусто")
        except Exception as e:
            debug_log(f"{name}: не удалось захукать ({e})")
        return False

    def uninstall(self):
        for unhook in self.unhooks:
            try:
                self.plugin.unhook_method(unhook)
            except Exception:
                pass
        self.unhooks.clear()


class WriteFrameHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if sound_engine.encoding:
            return
        now = time.time()
        fresh = now - sound_engine.last_frame < SoundEngine.FRAME_FRESH_SEC
        sound_engine.last_frame = now
        if not fresh and now - sound_engine.stopped_at > 1.0:
            self.plugin.on_recording_started()  # первый кадр новой записи
        if not sound_engine.active:
            return
        try:
            buf = param.args[0]
            length = min(param.args[1], buf.capacity())
            if length <= 0:
                return
            position, limit = buf.position(), buf.limit()
            buf.position(0)
            buf.limit(length)
            raw = bytearray(length)
            buf.get(raw, 0, length)
            raw = bytes(raw)
            mixed = sound_engine.mix_into(raw)
            if mixed != raw:
                buf.position(0)
                buf.put(mixed, 0, len(mixed))
            buf.limit(limit)
            buf.position(position)
        except Exception as e:
            import traceback
            debug_log(f"writeFrame: ошибка {e}\n{traceback.format_exc()}")


class StartRecordHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if sound_engine.encoding:
            return
        rate = int(param.args[1])
        debug_log(f"startRecord: {rate} Гц")
        sound_engine.sample_rate = rate
        self.plugin.preload_samples()
        self.plugin.on_recording_started()


class StopRecordHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        if self.plugin.in_call or sound_engine.encoding:
            return
        sound_engine.last_frame = 0.0
        sound_engine.stopped_at = time.time()
        sound_engine.clear()
        stop_speaker()
        self.plugin.on_recording_stopped()


class RecordHooks(HookGroup):
    def install(self):
        try:
            from java.lang import Boolean, Integer, Long, String
            from java.nio import ByteBuffer
        except Exception as e:
            debug_log(f"java-типы недоступны: {e}")
            return

        # Новый рекордер Telegram (AudioRecorderV2): кадры идут через AudioRecorderNative.
        try:
            native = get_class("org.telegram.utils.recorder.audio.AudioRecorderNative")
            self.hook(native, "writeFrame", [ByteBuffer, Integer.TYPE], WriteFrameHook(self.plugin))
        except Exception as e:
            debug_log(f"AudioRecorderNative недоступен (старая версия Telegram?): {e}")

        # Старый путь записи и общие точки остановки.
        try:
            cls = get_class("org.telegram.messenger.MediaController")
        except Exception as e:
            debug_log(f"MediaController недоступен: {e}")
            return
        stop = StopRecordHook(self.plugin)
        self.hook(cls, "writeFrame", [ByteBuffer, Integer.TYPE], WriteFrameHook(self.plugin))
        self.hook(cls, "startRecord", [String, Integer.TYPE], StartRecordHook(self.plugin))
        self.hook(cls, "stopRecord", [], stop)
        self.hook(cls, "stopRecording", [Integer.TYPE, Boolean.TYPE, Integer.TYPE, Boolean.TYPE, Long.TYPE], stop)
        self.hook(cls, "cleanRecording", [Boolean.TYPE], stop)


class ImportResultHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if param.args[0] != IMPORT_REQUEST_CODE or param.args[2] is None:
                return
            data = param.args[2]
            uris = []
            clip = data.getClipData()
            if clip is not None:
                uris = [clip.getItemAt(i).getUri() for i in range(clip.getItemCount())]
            elif data.getData() is not None:
                uris = [data.getData()]
            if uris:
                self.plugin.import_uris(param.thisObject.getContentResolver(), uris)
        except Exception as e:
            import traceback
            debug_log(f"импорт: ошибка {e}\n{traceback.format_exc()}")
            self.plugin.notify(f"Ошибка импорта: {e}")

    @staticmethod
    def _display_name(resolver, uri) -> Optional[str]:
        try:
            from android.provider import OpenableColumns
            cursor = resolver.query(uri, None, None, None, None)
            if cursor is None:
                return None
            try:
                idx = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
                if idx >= 0 and cursor.moveToFirst():
                    return cursor.getString(idx)
            finally:
                cursor.close()
        except Exception as e:
            debug_log(f"имя файла: {e}")
        return None

    @staticmethod
    def _read(resolver, uri) -> Optional[bytes]:
        try:
            stream = resolver.openInputStream(uri)
            if stream is None:
                return None
            chunks = []
            buf = bytearray(65536)
            while True:
                n = stream.read(buf)
                if n == -1:
                    break
                chunks.append(bytes(buf[:n]))
            stream.close()
            return b"".join(chunks)
        except Exception as e:
            debug_log(f"чтение файла: {e}")
            return None


class ImportHooks(HookGroup):
    def install(self):
        try:
            from android.content import Intent
            from java.lang import Integer
            cls = get_class("org.telegram.ui.LaunchActivity")
        except Exception as e:
            debug_log(f"LaunchActivity недоступен: {e}")
            return
        self.hook(cls, "onActivityResult", [Integer.TYPE, Integer.TYPE, Intent], ImportResultHook(self.plugin))


def open_plugin_settings(plugin_id: str) -> bool:
    """Открывает экран настроек плагина. Публичного API нет, поэтому перебираем известные варианты
    и пишем в журнал, что нашли, чтобы можно было дописать точный вызов."""
    try:
        from java.lang import Class
        fragment = get_last_fragment()
        if fragment is None:
            return False

        controller_cls = None
        for name in ("com.exteragram.messenger.plugins.PluginsController",):
            try:
                controller_cls = Class.forName(name)
                break
            except Exception:
                continue
        controller = controller_cls.getMethod("getInstance").invoke(None) if controller_cls is not None else None

        if controller is not None:
            for method in controller_cls.getDeclaredMethods():
                name = str(method.getName())
                if "ettings" in name:
                    debug_log(f"PluginsController.{name}({[str(t.getSimpleName()) for t in method.getParameterTypes()]})")

        # 1) готовый экран настроек плагина
        for name in ("com.exteragram.messenger.plugins.ui.PluginSettingsActivity",
                     "com.exteragram.messenger.plugins.PluginSettingsActivity"):
            try:
                cls = Class.forName(name)
            except Exception:
                continue
            plugin = None
            if controller is not None:
                for getter in ("getPlugin", "getPluginById"):
                    try:
                        plugin = controller_cls.getMethod(getter, Class.forName("java.lang.String")).invoke(controller, plugin_id)
                        break
                    except Exception:
                        continue
            for ctor in cls.getConstructors():
                types = [str(t.getSimpleName()) for t in ctor.getParameterTypes()]
                debug_log(f"{name}({types})")
                try:
                    if types == ["String"]:
                        fragment.presentFragment(ctor.newInstance(plugin_id))
                        return True
                    if len(types) == 1 and plugin is not None:
                        fragment.presentFragment(ctor.newInstance(plugin))
                        return True
                except Exception as e:
                    debug_log(f"{name}: {e}")

        # 2) метод контроллера
        if controller is not None:
            for method in controller_cls.getDeclaredMethods():
                name = str(method.getName())
                types = [str(t.getSimpleName()) for t in method.getParameterTypes()]
                if "ettings" in name and name.lower().startswith(("open", "show", "present")) and types in (["String"], ["String", "BaseFragment"], ["BaseFragment", "String"]):
                    method.setAccessible(True)
                    args = [plugin_id if t == "String" else fragment for t in types]
                    method.invoke(controller, *args)
                    return True
    except Exception as e:
        import traceback
        debug_log(f"открытие настроек: {e}\n{traceback.format_exc()}")
    return False


def start_import_picker(context):
    from android.content import Intent
    intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
    intent.addCategory(Intent.CATEGORY_OPENABLE)
    intent.setType("audio/*")
    intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, True)
    context.startActivityForResult(intent, IMPORT_REQUEST_CODE)


# ─────────────── звонки и войс-чаты (сейчас отключено) ───────────────
# Оставлено на будущее. Включается флагом CALL_HOOKS_ENABLED.

VOIP_SERVICE = "org.telegram.messenger.voip.VoIPService"
VOIP_AUDIO_CANDIDATES = [
    "org.webrtc.voiceengine.WebRtcAudioRecord",
    "org.webrtc.audio.WebRtcAudioRecord",
    "org.webrtc.audio.JavaAudioDeviceModule$WebRtcAudioRecord",
]
VOIP_END_FIELDS = [("STATE_ENDED", 11), ("STATE_FAILED", 4), ("STATE_BUSY", 17), ("STATE_HANGING_UP", 10)]


class VoipWriteFrameHook(MethodHook):
    _field = None

    def before_hooked_method(self, param):
        try:
            sound_engine.last_frame = time.time()
            bytes_read = param.args[0]
            if not sound_engine.active or bytes_read is None or bytes_read <= 0:
                return
            instance = param.thisObject
            if VoipWriteFrameHook._field is None:
                field = instance.getClass().getDeclaredField("byteBuffer")
                field.setAccessible(True)
                VoipWriteFrameHook._field = field
            buf = VoipWriteFrameHook._field.get(instance)
            if buf is None:
                return
            capacity = buf.capacity()
            length = min(bytes_read, capacity)
            buf.position(0)
            buf.limit(length)
            raw = bytearray(length)
            buf.get(raw, 0, length)
            raw = bytes(raw)
            mixed = sound_engine.mix_into(raw)
            if mixed != raw:
                buf.position(0)
                buf.put(mixed, 0, len(mixed))
            buf.position(0)
            buf.limit(capacity)
        except Exception as e:
            debug_log(f"voip writeFrame: ошибка {e}")


class VoipStateHook(MethodHook):
    def __init__(self, plugin, established: int, end_states: set):
        self.plugin = plugin
        self.established = established
        self.end_states = end_states

    def after_hooked_method(self, param):
        state = param.args[0]
        if state == self.established:
            self.plugin.in_call = True
            sound_engine.sample_rate = 48000
            self.plugin.preload_samples()
        elif state in self.end_states:
            self.plugin.in_call = False
            sound_engine.clear()
            stop_speaker()


class VoipHooks(HookGroup):
    def install(self):
        try:
            from java.lang import Integer, Long
            service = get_class(VOIP_SERVICE)
        except Exception as e:
            debug_log(f"VoIPService недоступен: {e}")
            return

        def static_int(name, fallback):
            try:
                field = service.getDeclaredField(name)
                field.setAccessible(True)
                return field.getInt(None)
            except Exception:
                return fallback

        established = static_int("STATE_ESTABLISHED", 3)
        end_states = {static_int(name, fallback) for name, fallback in VOIP_END_FIELDS}
        self.hook(service, "dispatchStateChanged", [Integer.TYPE], VoipStateHook(self.plugin, established, end_states))

        for class_name in VOIP_AUDIO_CANDIDATES:
            try:
                cls = get_class(class_name)
            except Exception:
                continue
            if self.hook(cls, "nativeDataIsRecorded", [Integer.TYPE, Long.TYPE], VoipWriteFrameHook()):
                break


# ───────────────────────────── утилиты ─────────────────────────────

def dp(value: int) -> int:
    try:
        from org.telegram.messenger import AndroidUtilities
        return AndroidUtilities.dp(value)
    except Exception:
        return value * 2


def theme_color(key_name: str, fallback: int) -> int:
    try:
        from org.telegram.ui.ActionBar import Theme
        return Theme.getColor(getattr(Theme, key_name))
    except Exception:
        return fallback


def status_bar_height() -> int:
    try:
        from org.telegram.messenger import AndroidUtilities
        return int(AndroidUtilities.statusBarHeight)
    except Exception:
        return dp(24)


def panel_top_offset(fragment) -> int:
    """Верх панели — сразу под шапкой чата, чтобы не закрывать кнопки Telegram."""
    try:
        bar = fragment.getActionBar()
        if bar is not None and bar.getBottom() > 0:
            return int(bar.getBottom())
    except Exception:
        pass
    try:
        from org.telegram.ui.ActionBar import ActionBar
        return status_bar_height() + int(ActionBar.getCurrentActionBarHeight())
    except Exception:
        return status_bar_height() + dp(56)


def screen_y(view, bottom: bool = False) -> int:
    try:
        from java import jarray
        loc = jarray("I")([0, 0])
        view.getLocationOnScreen(loc)
        return int(loc[1]) + (int(view.getHeight()) if bottom else 0)
    except Exception:
        return 0


def tint(color: int, alpha: int) -> int:
    value = (alpha << 24) | (color & 0xFFFFFF)
    return value - (1 << 32) if value >= (1 << 31) else value


def style_chip(view, color: int, text_color: int, fill: int = 0x33, press: int = 0x77, radius: int = 12, label=None):
    """Фон-«таблетка» с нажатым состоянием (StateListDrawable: RippleDrawable ронял Telegram)."""
    from android.graphics.drawable import GradientDrawable, StateListDrawable
    from java import jarray

    def shape(alpha):
        drawable = GradientDrawable()
        drawable.setColor(tint(color, alpha))
        drawable.setCornerRadius(float(dp(radius)))
        return drawable

    states = StateListDrawable()
    states.addState(jarray("I")([STATE_PRESSED]), shape(press))
    states.addState(jarray("I")([]), shape(fill))
    view.setBackground(states)
    (label if label is not None else view).setTextColor(text_color)


def jarray_bytes(data: bytes):
    from java import jarray
    return jarray("B")([b - 256 if b > 127 else b for b in data])


def sounds_dir() -> str:
    path = os.path.join(get_plugins_dir(), "voice_soundpad_sounds")
    ensure_dir_exists(path)
    return path


def sound_files() -> List[str]:
    try:
        return sorted(
            f for f in os.listdir(sounds_dir())
            if f.lower().endswith(AUDIO_EXTENSIONS) and os.path.isfile(os.path.join(sounds_dir(), f))
        )
    except Exception:
        return []


def make_waveform(samples: array, bars: int = 64) -> bytes:
    """Волна для голосового сообщения Telegram: 5-битные значения, упакованные подряд."""
    step = max(1, len(samples) // bars)
    out = bytearray((bars * 5 + 7) // 8 + 1)
    for i in range(bars):
        peak = max((abs(s) for s in samples[i * step:(i + 1) * step]), default=0)
        value = min(31, peak * 31 // 32768)
        bit = i * 5
        index, shift = bit // 8, bit % 8
        out[index] |= (value << shift) & 0xFF
        if shift > 3:
            out[index + 1] |= value >> (8 - shift)
    return bytes(out[: (bars * 5 + 7) // 8])


# ───────────────────────────── плагин ─────────────────────────────

class VoiceSoundpadPlugin(BasePlugin):
    def on_plugin_load(self):
        global _logger, _debug_enabled
        global _log_file
        _logger = getattr(self, "logger", None)
        _debug_enabled = bool(self.get_setting("debug_log", False))
        _log_file = os.path.join(get_plugins_dir(), "voice_soundpad_debug.log")
        try:
            if os.path.isfile(_log_file) and os.path.getsize(_log_file) > LOG_MAX_BYTES:
                os.remove(_log_file)
        except Exception:
            pass
        debug_log(f"=== запуск плагина {__version__} ===")
        if _debug_enabled:
            install_crash_logger()

        self.in_call = False
        self._installed = False
        self._menu_id = None
        self._states = {}    # путь -> "loading" | "playing"
        self._tokens = {}    # путь -> номер запуска (отсекает устаревшие колбэки)
        self._chips = {}     # путь -> части кнопки в открытой панели
        self._playback = None
        self._touch = None
        self._touch_cls = None
        self._text_color = Color.WHITE
        self._accent = Color.parseColor("#2F6FED")
        self._token_seq = 0
        self._collapsed = False
        self._collapse_frac = 0.0
        self._collapse_anim = None
        self._natural_height = 0
        self._rail = None
        self._rail_update = None
        self._scroll_cls = None
        self._anim_cls = None
        self._panel_body = None
        self._handle_label = None
        self._full_height = 0
        self._processing = set()  # файлы, которые обрабатываются после импорта
        self._job_lock = threading.Lock()  # импорт и пересборка идут по очереди
        self._send_job = None   # идущая подготовка голосового для .sounds
        self._toast_view = None
        self._toast_parent = None
        self._encode_lock = threading.Lock()
        self._panel_view = None
        self._panel_parent = None
        self._panel_dy = 0
        self._dock_fragment = None
        self._following = False
        self._auto_opened = False
        self._watching = False
        self._egg_count = 0
        self._egg_last = 0.0
        self.record_hooks = None
        self.import_hooks = None
        self.voip_hooks = None

        self._apply_volume(self.get_setting("volume_pct", 100))
        self.add_on_send_message_hook()
        if self.get_setting("plugin_enabled", True):
            self._install()

    def on_plugin_unload(self):
        try:
            self.stop_all()
            if self._send_job is not None:
                self._send_job["cancel"] = True
            run_on_ui_thread(self.hide_panel)
            run_on_ui_thread(self._hide_send_toast)
        except Exception as e:
            debug_log(f"выгрузка: {e}")
        self._uninstall()
        remove_crash_logger()

    # ── включение / выключение ──

    def _install(self):
        if self._installed:
            return
        self._installed = True

        self.record_hooks = RecordHooks(self)
        self.record_hooks.install()
        self.import_hooks = ImportHooks(self)
        self.import_hooks.install()
        if CALL_HOOKS_ENABLED:
            self.voip_hooks = VoipHooks(self)
            self.voip_hooks.install()

        for icon in ("msg_unmute", None):
            try:
                kwargs = {"icon": icon} if icon else {}
                self._menu_id = self.add_menu_item(MenuItemData(
                    menu_type=MenuItemType.CHAT_ACTION_MENU,
                    text="Звуки",
                    on_click=lambda ctx: run_on_ui_thread(self.open_settings),
                    **kwargs,
                ))
                break
            except Exception as e:
                debug_log(f"пункт меню (icon={icon}): {e}")
        self.preload_samples()

    def _uninstall(self):
        if not self._installed:
            return
        self._installed = False
        for group in (self.record_hooks, self.import_hooks, self.voip_hooks):
            if group is not None:
                group.uninstall()
        self.record_hooks = self.import_hooks = self.voip_hooks = None
        if self._menu_id is not None:
            try:
                self.remove_menu_item(self._menu_id)
            except Exception:
                pass
            self._menu_id = None
        run_on_ui_thread(self.hide_panel)
        self.stop_all()

    def _on_enabled_change(self, enabled: bool):
        if enabled:
            self._install()
        else:
            self._uninstall()
        self.notify("Voice Soundpad включён" if enabled else "Voice Soundpad выключен")

    # ── команды в чате ──

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        text = getattr(params, "message", None)
        if not isinstance(text, str):
            return HookResult()
        text = text.strip()
        cancel = HookResult(strategy=HookStrategy.CANCEL)

        if text == ".soundpad":
            enabled = not self.get_setting("plugin_enabled", True)
            self.set_setting("plugin_enabled", enabled, reload_settings=True)
            self._on_enabled_change(enabled)
            return cancel

        if not text.startswith(".sounds") or not self.get_setting("plugin_enabled", True):
            return HookResult()

        arg = text[len(".sounds"):].strip()
        if not arg.isdigit() or not 1 <= int(arg) <= MAX_SLOTS:
            self.notify(f"Использование: .sounds 1-{MAX_SLOTS}")
            return cancel
        filename = self.get_setting(f"slot_{int(arg) - 1}_file", "")
        path = os.path.join(sounds_dir(), filename) if filename else ""
        if not os.path.isfile(path):
            self.notify(f"Слот {arg} пуст — назначьте звук в настройках плагина")
            return cancel
        peer = getattr(params, "peer", None)
        if peer is None:
            self.notify("Не удалось определить чат")
            return cancel

        threading.Thread(target=self._send_sound, args=(account, peer, path), daemon=True).start()
        return cancel

    def _send_sound(self, account: int, peer, path: str):
        if self._send_job is not None:
            self.notify("Уже готовлю другой звук — подождите или отмените")
            return
        job = {"cancel": False, "done": False, "path": path}
        self._send_job = job

        def show_later():
            time.sleep(0.3)  # если голосовое уже в кэше, плашка не мелькает
            if not job["done"]:
                run_on_ui_thread(lambda: self._show_send_toast(job))

        threading.Thread(target=show_later, daemon=True).start()
        try:
            if self._send_as_voice(account, peer, path):
                return
            if job["cancel"]:
                raise SendCancelled()
            from client_utils import send_audio
            self.notify("Голосовое не собралось, отправляю как аудио")
            send_audio(peer, path)
        except SendCancelled:
            self.notify("Отправка отменена")
        except Exception as e:
            debug_log(f".sounds: ошибка отправки {e}")
            self.notify("Не удалось отправить звук")
        finally:
            job["done"] = True
            self._send_job = None
            run_on_ui_thread(self._hide_send_toast)

    def _check_cancel(self):
        job = self._send_job
        if job is not None and job["cancel"]:
            raise SendCancelled()

    def _cancel_send(self, job):
        job["cancel"] = True
        sound_engine.cancel_loading(job["path"])
        self._hide_send_toast()
        self.notify("Отменяю…")

    def _show_send_toast(self, job):
        """Плашка над чатом: круговая загрузка и крестик для отмены."""
        if job["done"] or self._toast_view is not None:
            return
        try:
            from android import R as AndroidR
            from android.graphics.drawable import GradientDrawable
            from android.widget import ProgressBar

            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return
            parent = activity.getWindow().getDecorView().findViewById(AndroidR.id.content)
            background = theme_color("key_chat_messagePanelBackground", theme_color("key_dialogBackground", Color.parseColor("#1F1F1F")))
            text_color = theme_color("key_windowBackgroundWhiteBlackText", theme_color("key_dialogTextBlack", Color.WHITE))
            muted = theme_color("key_windowBackgroundWhiteGrayText", theme_color("key_dialogTextGray2", Color.GRAY))
            accent = self._accent_color(theme_color("key_chat_messagePanelVoiceBackground", Color.parseColor("#2F6FED")))

            row = LinearLayout(activity)
            row.setOrientation(LinearLayout.HORIZONTAL)
            row.setGravity(Gravity.CENTER_VERTICAL)
            row.setPadding(dp(14), dp(8), dp(4), dp(8))
            shape = GradientDrawable()
            shape.setColor(tint(background, 0xF2))
            shape.setCornerRadius(float(dp(22)))
            row.setBackground(shape)
            row.setElevation(float(dp(6)))
            row.setClickable(True)

            spinner = ProgressBar(activity)
            spinner.setIndeterminate(True)
            try:
                from android.graphics import PorterDuff
                spinner.getIndeterminateDrawable().setColorFilter(accent, PorterDuff.Mode.SRC_IN)
            except Exception:
                pass
            row.addView(spinner, LinearLayout.LayoutParams(dp(22), dp(22)))

            label = TextView(activity)
            label.setText("Готовлю голосовое…")
            label.setTextColor(text_color)
            label.setTextSize(14.0)
            label.setSingleLine(True)
            label_lp = LinearLayout.LayoutParams(-2, -2)
            label_lp.leftMargin = dp(10)
            row.addView(label, label_lp)

            close = TextView(activity)
            close.setText("✕")
            close.setTextColor(muted)
            close.setTextSize(16.0)
            close.setPadding(dp(14), dp(6), dp(12), dp(6))
            close.setOnClickListener(self._safe_click(lambda v: self._cancel_send(job)))
            row.addView(close)

            lp = FrameLayout.LayoutParams(-2, -2)
            lp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL
            lp.topMargin = panel_top_offset(fragment) + dp(8)
            parent.addView(row, lp)
            row.setAlpha(0.0)
            row.setTranslationY(float(-dp(16)))
            row.animate().alpha(1.0).translationY(0.0).setDuration(260).setInterpolator(self._interpolator()).start()
            self._toast_view, self._toast_parent = row, parent
        except Exception as e:
            import traceback
            debug_log(f"плашка отправки: {e}\n{traceback.format_exc()}")

    def _hide_send_toast(self):
        view, parent = self._toast_view, self._toast_parent
        self._toast_view = self._toast_parent = None
        if view is None:
            return

        def remove():
            try:
                parent.removeView(view)
            except Exception:
                pass

        try:
            view.animate().alpha(0.0).translationY(float(-dp(16))).setDuration(200).setInterpolator(self._interpolator()).withEndAction(R(remove)).start()
        except Exception:
            remove()

    def _voice_file(self, path: str) -> Optional[str]:
        """Кодирует звук в Opus-файл голосового сообщения встроенным кодировщиком Telegram (с кэшем)."""
        from java.lang import Class, Integer
        from java.nio import ByteBuffer, ByteOrder
        from org.telegram.messenger import MediaController

        cache_dir = os.path.join(sounds_dir(), ".voice")
        ensure_dir_exists(cache_dir)
        stamp = int(os.path.getmtime(path))
        out = os.path.join(cache_dir, f"{os.path.splitext(os.path.basename(path))[0]}_{stamp}.ogg")
        if os.path.isfile(out) and os.path.getsize(out) > 0:
            return out

        started = time.time()
        samples = sound_engine.load_sample(path)
        self._check_cancel()
        if not samples:
            return None
        if sound_engine.sample_rate != VOICE_RATE:
            samples = resample(samples, sound_engine.sample_rate, VOICE_RATE)
        raw = samples.tobytes()[:VOICE_MAX_SECONDS * VOICE_RATE * 2]

        controller = MediaController.getInstance()
        cls = controller.getClass()
        string_class = Class.forName("java.lang.String")
        buffer_class = Class.forName("java.nio.ByteBuffer")
        start = cls.getDeclaredMethod("startRecord", string_class, Integer.TYPE)
        write = cls.getDeclaredMethod("writeFrame", buffer_class, Integer.TYPE)
        stop = cls.getDeclaredMethod("stopRecord")
        for method in (start, write, stop):
            method.setAccessible(True)

        tmp = out + ".part"
        with self._encode_lock:
            if sound_engine.recording:
                debug_log("кодирование отложено: идёт запись")
                return None
            sound_engine.encoding = True
            try:
                if int(start.invoke(controller, tmp, Integer(VOICE_RATE))) == 0:
                    debug_log("startRecord вернул 0")
                    return None
                try:
                    buffer = ByteBuffer.allocateDirect(VOICE_FRAME_BYTES)
                    buffer.order(ByteOrder.nativeOrder())
                    from java import jarray
                    frame_size = Integer(VOICE_FRAME_BYTES)
                    padded = raw + b"\x00" * (-len(raw) % VOICE_FRAME_BYTES)
                    data = jarray("B")(padded)  # один раз на весь звук, а не по байтам на каждый кадр
                    cancelled = False
                    for i in range(0, len(padded), VOICE_FRAME_BYTES):
                        job = self._send_job
                        if job is not None and job["cancel"]:
                            cancelled = True
                            break
                        buffer.clear()
                        buffer.put(data, i, VOICE_FRAME_BYTES)
                        buffer.rewind()
                        write.invoke(controller, buffer, frame_size)
                finally:
                    stop.invoke(controller)
                if cancelled:
                    try:
                        os.remove(tmp)
                    except OSError:
                        pass
                    raise SendCancelled()
            finally:
                sound_engine.encoding = False
        if not os.path.isfile(tmp) or os.path.getsize(tmp) == 0:
            return None
        os.replace(tmp, out)
        debug_log(f"голосовое готово за {time.time() - started:.1f} с")
        return out

    def _send_as_voice(self, account: int, peer, path: str) -> bool:
        try:
            from org.telegram.messenger import MediaController, SendMessagesHelper, SharedConfig, UserConfig
            from org.telegram.tgnet import ConnectionsManager, TLRPC
            from java import jarray

            ogg = self._voice_file(path)
            self._check_cancel()
            if not ogg:
                return False
            decoded = sound_engine.load_sample(path)
            duration = len(decoded) / float(sound_engine.sample_rate) if decoded else 0.0

            document = TLRPC.TL_document()
            document.file_reference = jarray("B")([])
            document.dc_id = -2147483648  # Integer.MIN_VALUE: локальный файл, как у записанных гс
            document.id = SharedConfig.getLastLocalId()
            document.user_id = UserConfig.getInstance(account).getClientUserId()
            document.mime_type = "audio/ogg"
            document.date = ConnectionsManager.getInstance(account).getCurrentTime()
            document.size = int(os.path.getsize(ogg))

            audio = TLRPC.TL_documentAttributeAudio()
            audio.voice = True
            audio.duration = float(duration)
            waveform = MediaController.getWaveform(ogg)
            if waveform is not None:
                audio.waveform = waveform
                audio.flags |= 4
            document.attributes.add(audio)
            SharedConfig.saveConfig()

            def send():
                try:
                    params = SendMessagesHelper.SendMessageParams.of(
                        document, None, ogg, int(peer), None, None, None, None, None, None,
                        True, 0, 0, 0, None, None, False)
                    SendMessagesHelper.getInstance(account).sendMessage(params)
                except Exception as e:
                    import traceback
                    debug_log(f".sounds: sendMessage упал {e}\n{traceback.format_exc()}")
                    self.notify("Не удалось отправить голосовое")

            self._check_cancel()
            run_on_ui_thread(send)
            debug_log(f".sounds: голосовое отправлено ({os.path.basename(ogg)}, {duration:.1f} с)")
            return True
        except SendCancelled:
            raise
        except Exception as e:
            import traceback
            debug_log(f".sounds: голосовое не собралось ({e})\n{traceback.format_exc()}")
            return False

    # ── панель со звуками ──

    def open_settings(self):
        """Пункт «Звуки» в меню чата ведёт в настройки плагина."""
        if open_plugin_settings(__id__):
            return
        self.notify("Не удалось открыть настройки — открываю панель")
        self.toggle_panel()

    def toggle_panel(self):
        if self._panel_view is not None:
            self.hide_panel()
        else:
            self.show_panel()

    def on_recording_started(self):
        if self._watching or self.in_call or self._panel_view is not None:
            return
        if not self.get_setting("auto_panel", True):
            return
        self._watching = True
        debug_log("запись началась — открываю панель")
        run_on_ui_thread(lambda: self.show_panel(True))
        threading.Thread(target=self._watch_recording, daemon=True).start()

    def on_recording_stopped(self):
        debug_log("запись остановлена")
        self._reset_states()
        if self._auto_opened:
            run_on_ui_thread(self.hide_panel)

    def _watch_recording(self):
        """Страховка: если хуки остановки не сработали, закрываем панель, когда кадры пропали."""
        try:
            time.sleep(1.0)
            while self._panel_view is not None and self._auto_opened:
                if not sound_engine.recording:
                    sound_engine.stopped_at = time.time()
                    run_on_ui_thread(self.hide_panel)
                    break
                time.sleep(0.3)
        finally:
            self._watching = False

    def show_panel(self, auto: bool = False):
        if self._panel_view is not None:
            return
        if not auto:
            self._collapsed = False  # из меню всегда открываем развёрнутой
        self._collapse_frac = 1.0 if self._collapsed else 0.0
        self._natural_height = 0
        try:
            fragment = get_last_fragment()
            activity = fragment.getParentActivity() if fragment is not None else None
            if activity is None:
                return
            placement = self._dock_layout(fragment)
            if placement is not None:
                parent, index, docked, lp, dy = placement
            else:
                self._dock_fragment = None
                # Запасной вариант: панель под шапкой чата.
                from android import R as AndroidR
                parent = activity.getWindow().getDecorView().findViewById(AndroidR.id.content)
                index, docked = -1, False
                top = panel_top_offset(fragment)
                height = max(dp(200), int(parent.getHeight() * PANEL_BOTTOM_RATIO) - top)
                self._full_height = height
                lp = FrameLayout.LayoutParams(-1, self._panel_height(height))
                lp.gravity = Gravity.TOP
                lp.topMargin = top
                dy = -dp(24)
            view = self._build_panel(activity, docked)
            self._measure_natural(view, parent, docked, lp)
            if docked and self._natural_height:
                bottom, height, _ = self._dock_metrics(parent, fragment)
                lp.height = self._panel_height(height)
                lp.topMargin = bottom - lp.height
            elif not docked and self._natural_height:
                self._full_height = min(self._full_height, self._natural_height)
                lp.height = self._panel_height(self._full_height)
            parent.addView(view, index, lp)
            view.setAlpha(0.0)
            view.setTranslationY(float(dy))
            view.animate().alpha(1.0).translationY(0.0).setDuration(260).setInterpolator(self._interpolator()).start()
            self._panel_dy = dy
            self._panel_view, self._panel_parent = view, parent
            self._auto_opened = auto
            if docked and not self._following:
                self._following = True
                threading.Thread(target=self._follow_input, daemon=True).start()
        except Exception as e:
            import traceback
            debug_log(f"панель: ошибка {e}\n{traceback.format_exc()}")

    def _dock_metrics(self, container, fragment):
        """(нижний край, высота): панель стоит над строкой сообщения и не заходит под шапку чата."""
        bottom = int(container.getInputBubbleTop()) - dp(7) - dp(PANEL_GAP_DP)
        bar = fragment.getActionBar()
        limit = max(0, screen_y(bar, True) - screen_y(container)) if bar is not None else 0
        available = bottom - limit
        height = min(int(container.getHeight() * PANEL_HEIGHT_RATIO), available)
        if self._natural_height:
            height = min(height, self._natural_height)  # панель не занимает пустое место
        return bottom, height, available

    def _measure_natural(self, view, parent, docked: bool, lp):
        """Высота панели по содержимому: пустое место не занимаем."""
        try:
            width = parent.getWidth() - (dp(16) if docked else 0)
            if width <= 0:
                return
            body = self._panel_body
            if body is not None:
                body.setVisibility(View.VISIBLE)
            view.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
                         View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED))
            self._natural_height = int(view.getMeasuredHeight())
            self._apply_collapsed_ui()
        except Exception as e:
            debug_log(f"замер панели: {e}")
            self._natural_height = 0

    def _dock_layout(self, fragment):
        """Положение над строкой сообщения; None, если контейнера нет (старая версия Telegram) или он не подошёл."""
        try:
            container = getattr(fragment, "chatInputViewsContainer", None)
            if container is None or container.getHeight() <= 0:
                return None
            bottom, height, _ = self._dock_metrics(container, fragment)
            height = self._panel_height(height)
            lp = FrameLayout.LayoutParams(-1, height)
            lp.gravity = Gravity.TOP
            lp.topMargin = bottom - height
            lp.leftMargin = lp.rightMargin = dp(8)
            self._dock_fragment = fragment
            return container, 0, True, lp, dp(40)
        except Exception as e:
            debug_log(f"стыковка со строкой сообщения не удалась ({e}), панель встанет под шапкой")
            return None

    def _sync_panel(self):
        """Подгоняет панель под строку сообщения: при клавиатуре она поднимается и сжимается."""
        view, container, fragment = self._panel_view, self._panel_parent, self._dock_fragment
        if view is None or fragment is None or container is None:
            return
        try:
            if container.getHeight() <= 0:
                return
            bottom, height, available = self._dock_metrics(container, fragment)
            if available < dp(COLLAPSED_DP if self._collapse_frac > 0.5 else PANEL_MIN_DP):
                if view.getVisibility() != View.GONE:
                    view.setVisibility(View.GONE)
                return
            if view.getVisibility() != View.VISIBLE:
                view.setVisibility(View.VISIBLE)
            height = self._panel_height(height)
            lp = view.getLayoutParams()
            if lp.height != height or lp.topMargin != bottom - height:
                lp.height = height
                lp.topMargin = bottom - height
                view.setLayoutParams(lp)
            if self._rail_update is not None:
                self._rail_update()
        except Exception as e:
            debug_log(f"подгонка панели: {e}")

    def _follow_input(self):
        """Пока панель открыта, следим за положением строки сообщения (клавиатура, многострочный текст)."""
        try:
            while True:
                while self._panel_view is not None and self._dock_fragment is not None:
                    run_on_ui_thread(self._sync_panel)
                    time.sleep(0.04)
                time.sleep(0.05)
                if self._panel_view is None or self._dock_fragment is None:
                    break
        finally:
            self._following = False

    def hide_panel(self):
        view, parent = self._panel_view, self._panel_parent
        self._panel_view = self._panel_parent = None
        self._dock_fragment = None
        self._auto_opened = False
        self._rail = self._rail_update = None
        if self._collapse_anim is not None:
            try:
                self._collapse_anim.cancel()
            except Exception:
                pass
        if view is None:
            return

        def remove():
            try:
                parent.removeView(view)
            except Exception:
                pass

        try:
            view.animate().alpha(0.0).translationY(float(self._panel_dy)).setDuration(200).setInterpolator(self._interpolator()).withEndAction(R(remove)).start()
        except Exception:
            remove()

    def _build_panel(self, context, docked: bool = False):
        from android.graphics.drawable import GradientDrawable, StateListDrawable
        from android.text import TextUtils
        from java import jarray

        # цвета панели ввода и кнопки записи, чтобы панель выглядела родной
        background_color = theme_color("key_chat_messagePanelBackground",
                                       theme_color("key_dialogBackground", Color.parseColor("#1F1F1F")))
        title_color = theme_color("key_windowBackgroundWhiteBlackText",
                                  theme_color("key_dialogTextBlack", Color.WHITE))
        muted = theme_color("key_windowBackgroundWhiteGrayText",
                            theme_color("key_dialogTextGray2", Color.GRAY))
        accent = self._accent_color(theme_color("key_chat_messagePanelVoiceBackground",
                                                theme_color("key_featuredStickers_addButton", Color.parseColor("#2F6FED"))))
        red = theme_color("key_text_RedBold", Color.parseColor("#E64C3C"))
        self._accent = accent
        self._chips = {}
        self._text_color = title_color

        def button(text, color, on_click):
            view = TextView(context)
            view.setText(text)
            view.setTextSize(14.0)
            view.setGravity(Gravity.CENTER)
            view.setSingleLine(True)
            view.setEllipsize(TextUtils.TruncateAt.END)
            view.setPadding(dp(8), dp(12), dp(8), dp(12))
            style_chip(view, color, color)
            view.setOnClickListener(self._safe_click(lambda v: (self._tap_feedback(v), on_click(v))))
            return view

        def sound_chip(text, path):
            """Кнопка звука: внутри полоса прогресса и время; удержание и движение пальцем перематывает."""
            chip = FrameLayout(context)
            fill = View(context)
            fill_bg = GradientDrawable()
            fill_bg.setColor(tint(COLOR_PLAYING, 0xDD))
            fill.setBackground(fill_bg)  # без скругления: по краям обрезает сама кнопка
            fill.setVisibility(View.INVISIBLE)
            chip.setClipToOutline(True)
            chip.addView(fill, FrameLayout.LayoutParams(0, -1))

            box = LinearLayout(context)
            box.setOrientation(LinearLayout.VERTICAL)
            box.setPadding(dp(8), dp(9), dp(8), dp(9))
            name = TextView(context)
            name.setText(text)
            name.setTextSize(14.0)
            name.setGravity(Gravity.CENTER)
            name.setSingleLine(True)
            name.setEllipsize(TextUtils.TruncateAt.END)
            clock = TextView(context)
            clock.setText("0:00 / 0:00")
            clock.setTextSize(11.0)
            clock.setGravity(Gravity.CENTER)
            clock.setSingleLine(True)
            clock.setVisibility(View.INVISIBLE)
            box.addView(name, LinearLayout.LayoutParams(-1, -2))
            box.addView(clock, LinearLayout.LayoutParams(-1, -2))
            chip.addView(box, FrameLayout.LayoutParams(-1, -2))

            style_chip(chip, accent, accent, label=name)
            chip.setClickable(True)
            chip.setOnClickListener(self._safe_click(lambda v: (self._tap_feedback(v), self.play(path))))
            chip.setTag(path)
            chip.setOnTouchListener(self._make_touch(path))
            self._chips[path] = (chip, fill, name, clock)
            return chip

        def cell(weight=0.0):
            lp = LinearLayout.LayoutParams(0 if weight else -1, -2, weight)
            lp.setMargins(dp(4), dp(4), dp(4), dp(4))
            return lp

        shape = GradientDrawable()
        if docked:
            # скруглена со всех сторон, как остров строки сообщения
            glass = int(self.get_setting("panel_style_index", 0)) == 0
            shape.setColor(tint(background_color, 0xE6 if glass else 0xFF))
            shape.setCornerRadius(float(dp(12 if int(self.get_setting("corner_index", 0)) == 1 else 22)))
        else:
            radius = float(dp(18))
            shape.setColor(background_color)
            shape.setCornerRadii(jarray("F")([0.0, 0.0, 0.0, 0.0, radius, radius, radius, radius]))

        root = LinearLayout(context)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setBackground(shape)
        if not docked:
            root.setElevation(float(dp(8)))
        root.setClickable(True)
        root.setPadding(dp(16), 0, dp(16), dp(12))

        # язычок сверху по центру: сворачивает панель вниз, повторное нажатие разворачивает
        handle = FrameLayout(context)
        handle_label = TextView(context)
        handle_label.setTextColor(muted)
        handle_label.setTextSize(11.0)
        handle_label.setGravity(Gravity.CENTER)
        handle.addView(handle_label, FrameLayout.LayoutParams(-1, -1))
        handle.setOnClickListener(self._safe_click(lambda v: (self._tap_feedback(v), self._toggle_collapse())))
        root.addView(handle, LinearLayout.LayoutParams(-1, dp(COLLAPSED_DP)))
        self._handle_label = handle_label

        body = LinearLayout(context)
        body.setOrientation(LinearLayout.VERTICAL)
        self._panel_body = body

        header = LinearLayout(context)
        header.setOrientation(LinearLayout.HORIZONTAL)
        header.setGravity(Gravity.CENTER_VERTICAL)
        title = TextView(context)
        title.setText("Звуки")
        title.setTextColor(title_color)
        title.setTextSize(17.0)
        title.setTypeface(title.getTypeface(), 1)
        close = TextView(context)
        close.setText("✕")
        close.setTextColor(muted)
        close.setTextSize(18.0)
        close.setPadding(dp(12), dp(8), dp(4), dp(8))
        close.setOnClickListener(self._safe_click(lambda v: self.hide_panel()))
        header.addView(title, LinearLayout.LayoutParams(0, -2, 1.0))
        try:
            header.addView(self._build_volume(context, title_color, accent), LinearLayout.LayoutParams(dp(116), dp(32)))
        except Exception as e:
            import traceback
            debug_log(f"слайдер громкости не создан: {e}\n{traceback.format_exc()}")
        header.addView(close)
        body.addView(header)

        slots = self.get_slots()
        if not slots or not sound_engine.recording:
            hint = TextView(context)
            hint.setTextColor(muted)
            hint.setTextSize(13.0)
            hint.setPadding(dp(4), 0, dp(4), dp(8))
            hint.setText("Звуков пока нет. Добавьте их в настройках плагина." if not slots
                         else "Запись не идёт — звук играет через динамик.")
            body.addView(hint)

        grid = LinearLayout(context)
        grid.setOrientation(LinearLayout.VERTICAL)
        for i in range(0, len(slots), PANEL_COLUMNS):
            row = LinearLayout(context)
            row.setOrientation(LinearLayout.HORIZONTAL)
            chunk = slots[i:i + PANEL_COLUMNS]
            for path, label in chunk:
                chip = sound_chip(label, path)
                self._paint(path)
                row.addView(chip, cell(1.0))
            for _ in range(PANEL_COLUMNS - len(chunk)):
                row.addView(View(context), cell(1.0))
            grid.addView(row)
        scroll = ScrollView(context)
        scroll.setVerticalScrollBarEnabled(False)
        scroll.setOverScrollMode(View.OVER_SCROLL_NEVER)
        scroll.setNestedScrollingEnabled(True)
        scroll.addView(grid)
        self._rail = self._rail_update = None
        if len(slots) >= RAIL_MIN_SOUNDS:
            area = LinearLayout(context)
            area.setOrientation(LinearLayout.HORIZONTAL)
            area.addView(scroll, LinearLayout.LayoutParams(0, -1, 1.0))
            area.addView(self._build_rail(context, scroll, grid, muted), LinearLayout.LayoutParams(dp(16), -1))
            body.addView(area, LinearLayout.LayoutParams(-1, 0, 1.0))
        else:
            body.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1.0))

        if slots:
            body.addView(button("Стоп", red, lambda v: self.stop_all()), cell())
        root.addView(body, LinearLayout.LayoutParams(-1, 0, 1.0))
        self._apply_collapsed_ui()
        return root

    def _build_volume(self, context, text_color, accent):
        """Слайдер громкости: таблетка с заливкой, внутри значок динамика и процент."""
        from android.graphics.drawable import ColorDrawable, GradientDrawable
        from java import dynamic_proxy, jarray

        percent = max(0, min(100, int(self.get_setting("volume_pct", 100))))
        radius = float(dp(16))

        pill = FrameLayout(context)
        pill_bg = GradientDrawable()
        pill_bg.setColor(tint(text_color, 0x1F))
        pill_bg.setCornerRadius(radius)
        pill.setBackground(pill_bg)

        width = dp(116)
        fill = View(context)
        fill_bg = GradientDrawable()
        fill_bg.setColor(tint(accent, 0xAA))
        fill.setBackground(fill_bg)
        pill.setClipToOutline(True)  # заливка обрезается по скруглению таблетки

        def set_fill(value):
            lp = fill.getLayoutParams()
            lp.width = int(width * value / 100.0)
            fill.setLayoutParams(lp)

        bar = SeekBar(context)  # прозрачный, только принимает касания
        bar.setMax(100)
        bar.setPadding(0, 0, 0, 0)
        bar.setProgressDrawable(ColorDrawable(0))
        bar.setThumb(None)
        bar.setProgress(percent)

        label = TextView(context)
        label.setTextColor(text_color)
        label.setTextSize(13.0)
        label.setGravity(Gravity.CENTER)
        label.setSingleLine(True)

        def show(value):
            label.setText(("🔇 " if value == 0 else "🔊 ") + f"{value}%")
            set_fill(value)

        pill.addView(fill, FrameLayout.LayoutParams(int(width * percent / 100.0), -1))
        show(percent)
        plugin = self

        class VolumeListener(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
            def onProgressChanged(self, seek_bar, progress, from_user):
                try:
                    show(int(progress))
                    if from_user:
                        plugin._apply_volume(int(progress))
                except Exception as e:
                    debug_log(f"слайдер: {e}")

            def onStartTrackingTouch(self, seek_bar):
                try:
                    seek_bar.getParent().requestDisallowInterceptTouchEvent(True)
                except Exception:
                    pass

            def onStopTrackingTouch(self, seek_bar):
                try:
                    plugin.set_setting("volume_pct", int(seek_bar.getProgress()))
                except Exception as e:
                    debug_log(f"слайдер: сохранение {e}")

        bar.setOnSeekBarChangeListener(VolumeListener())
        pill.addView(label, FrameLayout.LayoutParams(-1, -1))
        pill.addView(bar, FrameLayout.LayoutParams(-1, -1))
        return pill

    def _apply_volume(self, percent):
        try:
            gain = max(0, min(100, int(percent))) / 100.0
        except Exception:
            gain = 1.0
        sound_engine.master_gain = gain
        set_speaker_volume(gain)

    # ── состояния кнопок ──

    def _set_state(self, path: str, state: Optional[str], token: Optional[int] = None):
        if token is not None and self._tokens.get(path) != token:
            return  # колбэк от уже остановленного запуска
        if state is None:
            self._states.pop(path, None)
        else:
            self._states[path] = state
        run_on_ui_thread(lambda: self._paint(path))

    def _paint(self, path: str):
        parts = self._chips.get(path)
        if parts is None:
            return
        chip, fill, name, clock = parts
        try:
            state = "loading" if path in self._processing else self._states.get(path)
            if state == "playing":
                style_chip(chip, COLOR_PLAYING, self._text_color, 0x40, 0x66, label=name)
                fill.setVisibility(View.VISIBLE)
                clock.setVisibility(View.VISIBLE)
                self._update_progress(path)
                return
            if state == "loading":
                style_chip(chip, COLOR_LOADING, COLOR_ON_LOADING, 0xE6, 0xFF, label=name)
            else:
                style_chip(chip, self._accent, self._accent, label=name)
            fill.setVisibility(View.INVISIBLE)
            clock.setVisibility(View.INVISIBLE)
        except Exception as e:
            debug_log(f"перекраска кнопки: {e}")

    def _update_progress(self, path: str, fraction: Optional[float] = None):
        parts = self._chips.get(path)
        playback = self._playback
        if parts is None or playback is None or playback.path != path:
            return
        chip, fill, name, clock = parts
        try:
            position = playback.position() if fraction is None else fraction * playback.duration
            ratio = max(0.0, min(1.0, position / playback.duration))
            width = int(chip.getWidth() * ratio)
            lp = fill.getLayoutParams()
            if lp.width != width:
                lp.width = width
                fill.setLayoutParams(lp)
            clock.setText(f"{format_time(position)} / {format_time(playback.duration)}")
        except Exception as e:
            debug_log(f"прогресс: {e}")

    def _start_ticker(self, path: str, token: int):
        def tick():
            while self._tokens.get(path) == token and self._states.get(path) == "playing":
                touch = self._touch
                if not (touch and touch.get("path") == path and touch.get("seek")):
                    run_on_ui_thread(lambda: self._update_progress(path))
                time.sleep(0.1)

        threading.Thread(target=tick, daemon=True).start()

    def _make_touch(self, path: str):
        from java import dynamic_proxy
        if self._touch_cls is None:
            plugin = self

            class ChipTouch(dynamic_proxy(View.OnTouchListener)):
                def onTouch(self, view, event):
                    try:
                        tag = str(view.getTag())
                        if tag == "__rail__":
                            return bool(plugin._on_rail_touch(view, event))
                        return bool(plugin._on_chip_touch(tag, view, event))
                    except Exception as e:
                        import traceback
                        debug_log(f"касание: {e}\n{traceback.format_exc()}")
                        return False

            self._touch_cls = ChipTouch
        return self._touch_cls()

    def _build_rail(self, context, scroll, grid, color):
        """Узкий вертикальный ползунок прокрутки справа: тянешь вверх-вниз, список едет."""
        from android.graphics.drawable import GradientDrawable
        from java import dynamic_proxy

        rail = FrameLayout(context)
        rail.setTag("__rail__")
        track = View(context)
        track_bg = GradientDrawable()
        track_bg.setColor(tint(color, 0x30))
        track_bg.setCornerRadius(float(dp(2)))
        track.setBackground(track_bg)
        track_lp = FrameLayout.LayoutParams(dp(4), -1)
        track_lp.gravity = Gravity.CENTER_HORIZONTAL
        rail.addView(track, track_lp)

        thumb = View(context)
        thumb_bg = GradientDrawable()
        thumb_bg.setColor(tint(color, 0xCC))
        thumb_bg.setCornerRadius(float(dp(3)))
        thumb.setBackground(thumb_bg)
        thumb_lp = FrameLayout.LayoutParams(dp(6), dp(28))
        thumb_lp.gravity = Gravity.CENTER_HORIZONTAL | Gravity.TOP
        rail.addView(thumb, thumb_lp)

        def update():
            try:
                rail_h, view_h, total = int(rail.getHeight()), int(scroll.getHeight()), int(grid.getHeight())
                if rail_h <= 0 or total <= 0:
                    return
                size = max(dp(24), int(rail_h * min(1.0, view_h / float(total))))
                span = max(1, total - view_h)
                frac = min(1.0, max(0.0, scroll.getScrollY() / float(span)))
                lp = thumb.getLayoutParams()
                top = int(frac * (rail_h - size))
                if lp.height != size or lp.topMargin != top:
                    lp.height, lp.topMargin = size, top
                    thumb.setLayoutParams(lp)
            except Exception as e:
                debug_log(f"ползунок прокрутки: {e}")

        if self._scroll_cls is None:
            class RailScroll(dynamic_proxy(View.OnScrollChangeListener)):
                def onScrollChange(self, view, x, y, old_x, old_y):
                    fn = plugin_ref._rail_update
                    if fn is not None:
                        fn()

            plugin_ref = self
            self._scroll_cls = RailScroll
        scroll.setOnScrollChangeListener(self._scroll_cls())
        rail.setOnTouchListener(self._make_touch("__rail__"))
        self._rail = (scroll, grid)
        self._rail_update = update
        rail.post(R(update))
        return rail

    def _on_rail_touch(self, view, event) -> bool:
        rail = self._rail
        if rail is None:
            return False
        scroll, grid = rail
        action = int(event.getActionMasked())
        if action == 0:
            try:
                view.getParent().requestDisallowInterceptTouchEvent(True)
            except Exception:
                pass
        if action in (0, 2):
            height = max(1, int(view.getHeight()))
            frac = max(0.0, min(1.0, float(event.getY()) / height))
            scroll.scrollTo(0, int(frac * max(0, int(grid.getHeight()) - int(scroll.getHeight()))))
        return True

    def _on_chip_touch(self, path: str, view, event) -> bool:
        """Пока звук играет: касание останавливает его, а удержание с движением перематывает."""
        action = int(event.getActionMasked())
        touch = self._touch
        if action == 0:  # DOWN
            if self._states.get(path) != "playing":
                self._touch = None
                return False
            self._touch = {"path": path, "x": float(event.getX()), "seek": False, "fraction": 0.0}
            try:
                view.getParent().requestDisallowInterceptTouchEvent(True)
                view.setPressed(True)
            except Exception:
                pass
            return True
        if not touch or touch.get("path") != path:
            return False
        if action == 2:  # MOVE
            if not touch["seek"] and abs(float(event.getX()) - touch["x"]) > dp(6):
                touch["seek"] = True
            if touch["seek"]:
                width = max(1, int(view.getWidth()))
                touch["fraction"] = max(0.0, min(1.0, float(event.getX()) / width))
                self._update_progress(path, touch["fraction"])
            return True
        if action in (1, 3):  # UP / CANCEL
            self._touch = None
            try:
                view.setPressed(False)
            except Exception:
                pass
            if action == 1:
                if touch["seek"]:
                    touch["fraction"] = max(0.0, min(1.0, float(event.getX()) / max(1, int(view.getWidth()))))
                    playback = self._playback
                    if playback is not None and playback.path == path:
                        playback.seek(touch["fraction"])
                else:
                    self._tap_feedback(view)
                    self.stop_all()
            return True
        return True

    def _reset_states(self):
        paths = list(self._states)
        self._states.clear()
        self._tokens.clear()
        self._playback = None
        self._touch = None
        for path in paths:
            run_on_ui_thread(lambda p=path: self._paint(p))

    @staticmethod
    def _interpolator():
        """Кривая, как в анимациях Telegram (ease-out quint)."""
        try:
            from org.telegram.ui.Components import CubicBezierInterpolator
            return CubicBezierInterpolator.EASE_OUT_QUINT
        except Exception:
            from android.view.animation import DecelerateInterpolator
            return DecelerateInterpolator(2.0)

    def _accent_color(self, default: int) -> int:
        try:
            value = ACCENTS[int(self.get_setting("accent_index", 0))][1]
        except Exception:
            value = None
        return Color.parseColor(value) if value else default

    def _panel_height(self, expanded: int) -> int:
        expanded = max(dp(PANEL_MIN_DP), expanded)
        collapsed = dp(COLLAPSED_DP)
        return int(expanded + (collapsed - expanded) * self._collapse_frac)

    def _apply_collapsed_ui(self):
        body, label = self._panel_body, self._handle_label
        frac = self._collapse_frac
        if body is not None:
            body.setVisibility(View.GONE if frac >= 0.98 else View.VISIBLE)
            body.setAlpha(max(0.0, 1.0 - frac * 1.4))
        if label is not None:
            label.setRotation(180.0 * frac)

    def _toggle_collapse(self):
        self._collapsed = not self._collapsed
        self._animate_collapse(1.0 if self._collapsed else 0.0)

    def _animate_collapse(self, target: float):
        from android.animation import ValueAnimator
        from java import dynamic_proxy, jarray

        if self._collapse_anim is not None:
            try:
                self._collapse_anim.cancel()
            except Exception:
                pass
        if self._anim_cls is None:
            plugin = self

            class CollapseUpdate(dynamic_proxy(ValueAnimator.AnimatorUpdateListener)):
                def onAnimationUpdate(self, animator):
                    try:
                        plugin._set_collapse_frac(float(animator.getAnimatedValue()))
                    except Exception as e:
                        debug_log(f"анимация сворачивания: {e}")

            self._anim_cls = CollapseUpdate
        try:
            animator = ValueAnimator.ofFloat(jarray("F")([float(self._collapse_frac), float(target)]))
            animator.setDuration(280)
            animator.setInterpolator(self._interpolator())
            animator.addUpdateListener(self._anim_cls())
            self._collapse_anim = animator
            animator.start()
        except Exception as e:
            debug_log(f"анимация не запустилась ({e}), сворачиваю сразу")
            self._set_collapse_frac(float(target))

    def _set_collapse_frac(self, frac: float):
        self._collapse_frac = max(0.0, min(1.0, frac))
        self._apply_collapsed_ui()
        view = self._panel_view
        if view is None:
            return
        if self._dock_fragment is not None:
            self._sync_panel()
        else:
            lp = view.getLayoutParams()
            lp.height = self._panel_height(self._full_height)
            view.setLayoutParams(lp)

    def _safe_click(self, fn):
        """Ошибка в обработчике не должна долетать до интерфейсного потока и ронять Telegram."""
        def handler(view):
            try:
                fn(view)
            except Exception as e:
                import traceback
                debug_log(f"клик: ошибка {e}\n{traceback.format_exc()}")
        return OnClickListener(handler)

    def _tap_feedback(self, view):
        """Вибро-отклик (подсветку нажатия даёт сама кнопка)."""
        if not self.get_setting("haptics", True):
            return
        try:
            from android.view import HapticFeedbackConstants
            view.performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP)
        except Exception as e:
            debug_log(f"вибро: {e}")

    def play(self, path: str):
        """Нажатие на активный звук останавливает его, на другой — глушит текущий и включает новый."""
        if path in self._processing:
            return  # ещё обрабатывается после импорта
        if path in self._states:
            self.stop_all()
            return
        if self._states:
            self.stop_all()
        recording = sound_engine.recording
        mode = self._mode() if recording else "speaker"
        name = os.path.basename(path)
        debug_log(f"play {name}: режим={mode}, запись={recording}")
        self._token_seq += 1
        token = self._token_seq
        self._tokens[path] = token
        self._set_state(path, "loading", token)

        def ended():
            self._set_state(path, None, token)

        def started():
            self._set_state(path, "playing", token)
            self._start_ticker(path, token)

        def work():
            try:
                samples = sound_engine.load_sample(path)
                if self._tokens.get(path) != token:
                    return  # пока грузилось, нажали стоп или другой звук
                if not samples:
                    debug_log(f"play {name}: сэмплы не загрузились")
                    self._set_state(path, None, token)
                    return
                rate = sound_engine.sample_rate
                debug_log(f"play {name}: сэмплов {len(samples)}, {rate} Гц")
                if mode == "mic":
                    playback = Playback(path, len(samples), rate)
                    self._playback = playback
                    playback.voice = sound_engine.trigger(samples, on_start=started, on_end=ended)
                elif mode == "speaker":
                    track, duration = arm_speaker(samples, rate)
                    self._playback = Playback(path, len(samples), rate, track)
                    started()
                    fire_speaker(track, duration, on_end=ended, frames=len(samples))
                else:
                    track, duration = arm_speaker(samples, rate)
                    playback = Playback(path, len(samples), rate, track)
                    self._playback = playback

                    def start_both():
                        started()
                        fire_speaker(track, duration, on_end=ended, frames=len(samples))

                    playback.voice = sound_engine.trigger(samples, on_start=start_both)
                debug_log(f"play {name}: запущено ({mode})")
            except Exception as e:
                import traceback
                debug_log(f"play {name}: ошибка {e}\n{traceback.format_exc()}")
                self._set_state(path, None, token)

        threading.Thread(target=work, daemon=True).start()

    def stop_all(self):
        for path in list(self._states):
            sound_engine.cancel_loading(path)
        sound_engine.clear()
        stop_speaker()
        self._reset_states()

    def _mode(self) -> str:
        return {0: "mic", 1: "speaker"}.get(self.get_setting("playback_mode_index", 2), "both")

    # ── слоты и файлы ──

    def get_slots(self) -> List[tuple]:
        slots, seen = [], set()
        for i in range(MAX_SLOTS):
            filename = self.get_setting(f"slot_{i}_file", "")
            if not filename or filename in seen:
                continue  # один звук — одна кнопка
            path = os.path.join(sounds_dir(), filename)
            if os.path.isfile(path):
                seen.add(filename)
                label = self.get_setting(f"slot_{i}_label", "") or os.path.splitext(filename)[0]
                slots.append((path, label))
        return slots

    def slot_of(self, filename: str) -> Optional[int]:
        for i in range(MAX_SLOTS):
            if self.get_setting(f"slot_{i}_file", "") == filename:
                return i
        return None

    def assign_free_slot(self, filename: str) -> Optional[int]:
        if self.slot_of(filename) is not None:
            return None
        for i in range(MAX_SLOTS):
            if not self.get_setting(f"slot_{i}_file", ""):
                self.set_setting(f"slot_{i}_file", filename)
                return i
        return None

    def assign_slot(self, index: int, filename: str) -> bool:
        """Назначает звук на слот; один звук нельзя повесить на два слота."""
        if filename:
            other = self.slot_of(filename)
            if other is not None and other != index:
                self.notify(f"Этот звук уже назначен на слот {other + 1}")
                self._refresh_settings()
                return False
        self.set_setting(f"slot_{index}_file", filename)
        self._refresh_settings()
        return True

    def preload_samples(self):
        def work():
            for path, _ in self.get_slots()[:8]:
                sound_engine.load_sample(path)

        threading.Thread(target=work, daemon=True).start()

    def _process_file(self, filename: str) -> bool:
        """Декодирует звук в кэш; пока идёт обработка, кнопка жёлтая и не нажимается."""
        path = os.path.join(sounds_dir(), filename)
        sound_engine.forget(path)
        self._processing.add(path)
        run_on_ui_thread(lambda: self._paint(path))
        try:
            return bool(sound_engine.load_sample(path))
        except Exception as e:
            import traceback
            debug_log(f"обработка {filename}: {e}\n{traceback.format_exc()}")
            return False
        finally:
            self._processing.discard(path)
            run_on_ui_thread(lambda: self._paint(path))

    def import_uris(self, resolver, uris: list):
        """Импорт одного или нескольких файлов в фоне, по очереди; уведомления без спама."""
        threading.Thread(target=self._import_job, args=(resolver, list(uris)), daemon=True).start()

    def _import_job(self, resolver, uris: list):
        with self._job_lock:
            total = len(uris)
            added, same, no_slot, failed = [], [], [], []
            if total > 1:
                self.notify(f"Импорт: {total} файлов, это займёт немного времени…")
            for uri in uris:
                try:
                    raw = ImportResultHook._read(resolver, uri)
                    if raw is None:
                        failed.append("?")
                        continue
                    name = ImportResultHook._display_name(resolver, uri) or f"sound_{int(time.time())}.wav"
                    safe = "".join(c for c in name if c.isalnum() or c in "._- ").strip(" .") or f"sound_{int(time.time())}"
                    path = os.path.join(sounds_dir(), safe)
                    if os.path.isfile(path) and os.path.getsize(path) == len(raw):
                        with open(path, "rb") as f:
                            if f.read() == raw:
                                same.append(safe)
                                if self.slot_of(safe) is None and self.assign_free_slot(safe) is None:
                                    no_slot.append(safe)
                                continue
                    with open(path, "wb") as f:
                        f.write(raw)
                    slot = self.slot_of(safe)
                    if slot is None:
                        slot = self.assign_free_slot(safe)
                        if slot is None:
                            no_slot.append(safe)
                    where = f" · слот {slot + 1}" if slot is not None else ""
                    if total == 1:
                        self.notify(f"Обрабатываю звук: {safe}{where}…")
                    if self._process_file(safe):
                        added.append(safe)
                        if total == 1:
                            self.notify(f"Звук обработан: {safe}{where}")
                    else:
                        failed.append(safe)
                        if total == 1:
                            self.notify(f"Не удалось обработать звук: {safe}")
                except Exception as e:
                    import traceback
                    debug_log(f"импорт: {e}\n{traceback.format_exc()}")
                    failed.append("?")
            if total == 1:
                if same and not added and not failed:
                    slot = self.slot_of(same[0])
                    self.notify(f"Такой звук уже есть: {same[0]}" + (f" · слот {slot + 1}" if slot is not None else ""))
                elif no_slot:
                    self.notify(f"Нет свободных слотов (всего {MAX_SLOTS}) — освободите слот в настройках")
            else:
                parts = [f"добавлено {len(added)}"]
                if same:
                    parts.append(f"уже было {len(same)}")
                if no_slot:
                    parts.append(f"без слота {len(no_slot)}")
                if failed:
                    parts.append(f"с ошибкой {len(failed)}")
                self.notify("Импорт завершён: " + ", ".join(parts))
        self._refresh_settings()

    def reprocess_all(self):
        """Обрабатывает все звуки заново (после обновления плагина или если звук играет с задержкой)."""
        files = sound_files()
        if not files:
            self.notify("Звуков пока нет")
            return

        def work():
            with self._job_lock:
                self.notify(f"Обрабатываю звуки заново: {len(files)}…")
                ok = sum(1 for f in files if self._process_file(f))
                self.notify(f"Обработано: {ok} из {len(files)}")

        threading.Thread(target=work, daemon=True).start()

    def clear_voice_cache(self):
        removed = 0
        folder = os.path.join(sounds_dir(), ".voice")
        try:
            for name in os.listdir(folder):
                try:
                    os.remove(os.path.join(folder, name))
                    removed += 1
                except OSError:
                    pass
        except OSError:
            pass
        self.notify(f"Кэш голосовых очищен: {removed}")

    def delete_sound(self, filename: str):
        try:
            os.remove(os.path.join(sounds_dir(), filename))
            sound_engine.forget(os.path.join(sounds_dir(), filename))
            for i in range(MAX_SLOTS):
                if self.get_setting(f"slot_{i}_file", "") == filename:
                    self.set_setting(f"slot_{i}_file", "")
            self.notify(f"Удалено: {filename}")
        except Exception as e:
            debug_log(f"удаление {filename}: {e}")
            self.notify(f"Не удалось удалить {filename}")
        self._refresh_settings()

    # ── настройки ──

    def create_settings(self) -> List[Any]:
        return [
            Header(text="Voice Soundpad"),
            Switch(
                key="plugin_enabled",
                text="Включить плагин",
                subtext="Панель выезжает сверху при записи, её можно открыть и из меню чата (⋮). Команды: .sounds 1-8, .soundpad",
                default=True,
                on_change=self._on_enabled_change,
            ),
            Divider(),
            Header(text="Звуки"),
            Text(text="Слоты", subtext="Назначить звуки на кнопки", icon="msg_folder", create_sub_fragment=self._slots_page),
            Text(text="Добавить звуки", icon="msg_addbot", accent=True, on_click=self._on_import_click),
            Text(text="Импорт", subtext="Пачкой, пересборка, кэш", icon="msg_download", create_sub_fragment=self._import_page),
            Text(text="Удалить звуки", icon="msg_delete", create_sub_fragment=self._delete_page),
            Divider(),
            Text(text="Оформление", subtext="Цвет, фон, скругление", icon="msg_theme", create_sub_fragment=self._theme_page),
            Divider(),
            Header(text="Воспроизведение"),
            Switch(key="auto_panel", text="Открывать при записи", subtext="Панель со звуками выезжает сама, когда начинается запись", default=True),
            Switch(key="haptics", text="Вибро-отклик", subtext="Короткий отклик при нажатии на звук. Если вибрацию слышно в записи — отключите", default=True),
            Selector(
                key="playback_mode_index",
                text="Куда играть при записи",
                default=2,
                items=["В микрофон", "В динамик", "В микрофон и динамик"],
            ),
            Divider(),
            Header(text="Отладка"),
            Switch(key="debug_log", text="Журнал отладки", default=False, on_change=self._on_debug_change),
            Text(text="Скопировать журнал", icon="msg_copy", on_click=self._copy_log),
            Text(text="Очистить журнал", icon="msg_delete", on_click=self._clear_log),
            Divider(),
            Text(text="made by @tapesix", on_click=self._egg_tap),
        ]

    def _slots_page(self) -> List[Any]:
        files = sound_files()
        rows: List[Any] = []
        for i in range(MAX_SLOTS):
            current = self.get_setting(f"slot_{i}_file", "")
            # уже занятые другими слотами звуки скрыты, чтобы не назначить один звук дважды
            taken = {self.get_setting(f"slot_{j}_file", "") for j in range(MAX_SLOTS) if j != i}
            available = [f for f in files if f not in taken]
            index = available.index(current) + 1 if current in available else 0
            self.set_setting(f"slot_{i}_file_index", index)
            rows += [
                Header(text=f"Слот {i + 1}"),
                Selector(
                    key=f"slot_{i}_file_index",
                    text="Звук",
                    default=index,
                    items=["(не выбрано)"] + available,
                    on_change=lambda n, i=i, f=available: self.assign_slot(i, f[n - 1] if n > 0 else ""),
                ),
                Input(key=f"slot_{i}_label", text="Подпись", default="", subtext="По умолчанию — имя файла"),
                Divider(),
            ]
        return rows

    def _import_page(self) -> List[Any]:
        files = sound_files()
        used = sum(1 for i in range(MAX_SLOTS) if self.get_setting(f"slot_{i}_file", ""))
        return [
            Header(text="Импорт"),
            Text(text="Добавить звуки", subtext="Можно сразу несколько файлов", icon="msg_addbot", accent=True, on_click=self._on_import_click),
            Text(text="Обработать все заново", subtext="После обновления или при задержке", icon="msg_retry", on_click=lambda v: self.reprocess_all()),
            Text(text="Очистить кэш голосовых", subtext="Для .sounds, пересоберётся само", icon="msg_clear", on_click=lambda v: self.clear_voice_cache()),
            Divider(),
            Text(text=f"Звуков: {len(files)}"),
            Text(text=f"Занято слотов: {used} из {MAX_SLOTS}"),
        ]

    def _theme_page(self) -> List[Any]:
        def reopen(_value):
            run_on_ui_thread(self.hide_panel)  # новое оформление видно при следующем открытии

        return [
            Header(text="Оформление"),
            Selector(key="accent_index", text="Цвет", default=0, items=[name for name, _ in ACCENTS], on_change=reopen),
            Selector(key="panel_style_index", text="Фон панели", default=0, items=["Полупрозрачный", "Сплошной"], on_change=reopen),
            Selector(key="corner_index", text="Скругление", default=0, items=["Мягкое", "Строгое"], on_change=reopen),
            Text(text="Зелёная кнопка — звук играет"),
            Text(text="Жёлтая — звук обрабатывается"),
        ]

    def _delete_page(self) -> List[Any]:
        files = sound_files()
        if not files:
            return [Header(text="Удаление звуков"), Text(text="Нет сохранённых звуков")]
        rows: List[Any] = [Header(text="Нажмите на звук, чтобы удалить")]
        for filename in files:
            slot = self.slot_of(filename)
            rows.append(Text(
                text=filename,
                subtext=f"Слот {slot + 1}" if slot is not None else None,
                icon="msg_delete",
                red=True,
                on_click=lambda v, f=filename: self.delete_sound(f),
            ))
        return rows

    def _refresh_settings(self):
        try:
            self.set_setting("_refresh", str(time.time()), reload_settings=True)
        except Exception:
            pass

    def _on_debug_change(self, enabled: bool):
        global _debug_enabled
        _debug_enabled = bool(enabled)
        if enabled:
            install_crash_logger()

    def _clear_log(self, view):
        clear_log()
        self.notify("Журнал очищен")

    def _copy_log(self, view):
        copy_to_clipboard(read_log_tail() or "(журнал пуст — включите его и повторите действие)")

    def _on_import_click(self, view):
        try:
            start_import_picker(view.getContext())
        except Exception as e:
            debug_log(f"пикер файлов: {e}")
            self.notify("Не удалось открыть выбор файла")

    # ── пасхалка ──

    def _egg_tap(self, view):
        now = time.time()
        if now - self._egg_last > 2.0:
            self._egg_count = 0
        self._egg_last = now
        self._egg_count += 1
        if self._egg_count >= 5:
            self._egg_count = 0
            self._easter_egg()

    def _easter_egg(self):
        run_on_ui_thread(self._show_egg)

    def _show_egg(self):
        try:
            from android.app import Dialog
            from android.graphics import BitmapFactory
            from android.graphics.drawable import ColorDrawable, GradientDrawable
            from android.util import Base64
            from android.widget import ImageView

            fragment = get_last_fragment()
            context = fragment.getParentActivity() if fragment is not None else None
            if context is None:
                return
            data = Base64.decode(EGG_IMAGE, Base64.DEFAULT)
            bitmap = BitmapFactory.decodeByteArray(data, 0, len(data))
            if bitmap is None:
                return

            image = ImageView(context)
            image.setImageBitmap(bitmap)
            image.setAdjustViewBounds(True)
            image.setScaleType(ImageView.ScaleType.FIT_CENTER)
            frame = FrameLayout(context)
            shape = GradientDrawable()
            shape.setColor(Color.BLACK)
            shape.setCornerRadius(float(dp(16)))
            frame.setBackground(shape)
            frame.setClipToOutline(True)
            frame.setPadding(dp(2), dp(2), dp(2), dp(2))
            frame.addView(image, FrameLayout.LayoutParams(-1, -2))

            dialog = Dialog(context)
            dialog.requestWindowFeature(1)
            dialog.setContentView(frame)
            window = dialog.getWindow()
            if window is not None:
                window.setBackgroundDrawable(ColorDrawable(0))
                window.setLayout(int(context.getResources().getDisplayMetrics().widthPixels * 0.88), -2)
            frame.setOnClickListener(self._safe_click(lambda v: dialog.dismiss()))
            dialog.setCanceledOnTouchOutside(True)
            dialog.show()
        except Exception as e:
            import traceback
            debug_log(f"пасхалка: {e}\n{traceback.format_exc()}")
            self.notify("🥚")

    # ── прочее ──

    def notify(self, text: str):
        try:
            run_on_ui_thread(lambda: BulletinHelper.show_info(text))
        except Exception:
            debug_log(text)


