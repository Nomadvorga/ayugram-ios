_WORDS = {}
_HEADS = set()
for _ln in _WORDS_SRC.strip().splitlines():
    _ln = _ln.strip()
    if not _ln or "=" not in _ln:
        continue
    _k, _v = _ln.split("=", 1)
    _head = _k.startswith("*")
    _k = _k.lstrip("*")
    _parts = _v.split("|")
    if len(_parts) == 3:
        _WORDS[_k] = tuple(_parts)
        if _head:
            _HEADS.add(_k)

