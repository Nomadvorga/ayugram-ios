+        if !hasNeighbor {
+            return Self(outgoingY: sign * height * (1 - 1 / (p * 0.18 + 1)), incomingY: 0, outgoingAlpha: 1, incomingAlpha: 0, outgoingScale: 1, incomingScale: 0.8)
